import FV7z.Nda.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NWindows::NFile::NName::NormalizeDirPathPrefix(AString&)` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (23, 53, 73, 112; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Nda
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_64 : Wpt := fun F Wl Q => wp F Wl o4 (Q 73)
theorem c_64 (prof : Profile) : Sp prof nda nda_at 64 W_64 := Sp.blk_then (blk_64 prof) (Sp.skip 73)

def W_37 : Wpt := fun F Wl Q => wp F Wl o3 (Q 53)
theorem c_37 (prof : Profile) : Sp prof nda nda_at 37 W_37 := Sp.blk_then (blk_37 prof) (Sp.skip 53)

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → W_64 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_37 F Wl Q g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof nda nda_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_35 prof) (c_64 prof) (c_37 prof))

def W_11 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → W_32 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → Q 23 g (rfz f) V)
theorem c_11 (prof : Profile) : Sp prof nda nda_at 11 W_11 :=
  Sp.blk_then (blk_11 prof) (Sp.jcc_then (spj_21 prof) (c_32 prof) (Sp.skip 23))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 23 g (rfz f) V) ∧
    (f.cond 4 = false → W_11 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof nda nda_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_9 prof) (Sp.skip 23) (c_11 prof))

def W_78 : Wpt := fun F Wl Q => wp F Wl o5 (Q 92)
theorem c_78 (prof : Profile) : Sp prof nda nda_at 78 W_78 := Sp.blk_then (blk_78 prof) (Sp.skip 92)

def W_92 : Wpt := fun F Wl Q => wp F Wl o6 (Q 112)
theorem c_92 (prof : Profile) : Sp prof nda nda_at 92 W_92 := Sp.blk_then (blk_92 prof) (Sp.skip 112)

/-- The cut points. -/
def cuts : List Nat := [0, 78, 92]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 78 then W_78 else
  if ℓ = 92 then W_92 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof nda nda_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_78 prof) <|
  Sp.table (c_92 prof) <|
  Sp.never ℓ

end FV7z.Nda
