import FV7z.Ug1.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UString::Grow_1` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (44, 54; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ug1
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_33 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 6 = true → Q 42 g (rfz f) V) ∧
    (f.cond 6 = false → Q 37 g (rfz f) V)
theorem c_33 (prof : Profile) : Sp prof ug1 ug1_at 33 W_33 :=
  Sp.blk_then (blk_33 prof) (Sp.jcc_then (spj_35 prof) (Sp.skip 42) (Sp.skip 37))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 7 = true → Q 37 g (rfz f) V) ∧
    (f.cond 7 = false → W_33 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof ug1 ug1_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_31 prof) (Sp.skip 37) (c_33 prof))

def W_37 : Wpt := fun F Wl Q => wp F Wl o2 (Q 42)
theorem c_37 (prof : Profile) : Sp prof ug1 ug1_at 37 W_37 := Sp.blk_then (blk_37 prof) (Sp.skip 42)

def W_42 : Wpt := fun F Wl Q => wp F Wl o3 (Q 44)
theorem c_42 (prof : Profile) : Sp prof ug1 ug1_at 42 W_42 := Sp.blk_then (blk_42 prof) (Sp.skip 44)

def W_50 : Wpt := fun F Wl Q => wp F Wl o4 (Q 54)
theorem c_50 (prof : Profile) : Sp prof ug1 ug1_at 50 W_50 := Sp.blk_then (blk_50 prof) (Sp.skip 54)

/-- The cut points. -/
def cuts : List Nat := [0, 37, 42, 50]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 37 then W_37 else
  if ℓ = 42 then W_42 else
  if ℓ = 50 then W_50 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ug1 ug1_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_37 prof) <|
  Sp.table (c_42 prof) <|
  Sp.table (c_50 prof) <|
  Sp.never ℓ

end FV7z.Ug1
