import FV7z.C3.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CrcGenerateTable` (PLAN.md G3, constructors)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (106; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.C3
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 16)
theorem c_0 (prof : Profile) : Sp prof c3 c3_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 16)

def W_16 : Wpt := fun F Wl Q => wp F Wl o1 (Q 32)
theorem c_16 (prof : Profile) : Sp prof c3 c3_at 16 W_16 := Sp.blk_then (blk_16 prof) (Sp.skip 32)

def W_69 : Wpt := fun F Wl Q => wp F Wl o4 (Q 80)
theorem c_69 (prof : Profile) : Sp prof c3 c3_at 69 W_69 := Sp.blk_then (blk_69 prof) (Sp.skip 80)

def W_53 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 5 = true → Q 16 g (rfz f) V) ∧
    (f.cond 5 = false → W_69 F Wl Q g (rfz f) V)
theorem c_53 (prof : Profile) : Sp prof c3 c3_at 53 W_53 :=
  Sp.blk_then (blk_53 prof) (Sp.jcc_then (spj_67 prof) (Sp.skip 16) (c_69 prof))

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 32 g (rfz f) V) ∧
    (f.cond 5 = false → W_53 F Wl Q g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof c3 c3_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_51 prof) (Sp.skip 32) (c_53 prof))

def W_80 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 5 = true → Q 80 g (rfz f) V) ∧
    (f.cond 5 = false → Q 106 g (rfz f) V)
theorem c_80 (prof : Profile) : Sp prof c3 c3_at 80 W_80 :=
  Sp.blk_then (blk_80 prof) (Sp.jcc_then (spj_104 prof) (Sp.skip 80) (Sp.skip 106))

/-- The cut points. -/
def cuts : List Nat := [0, 16, 32, 80]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 16 then W_16 else
  if ℓ = 32 then W_32 else
  if ℓ = 80 then W_80 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof c3 c3_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_16 prof) <|
  Sp.table (c_32 prof) <|
  Sp.table (c_80 prof) <|
  Sp.never ℓ

end FV7z.C3
