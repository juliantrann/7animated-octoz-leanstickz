import FV7z.Fdn.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NWindows::NFile::NFind::CFileInfo::Find_DontFill_Name` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (48, 69, 108, 109; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Fdn
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 48)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof fdn fdn_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 48)

def W_63 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 69)
theorem c_63 (prof : Profile) (fb : Addr) : SpF prof fdn fdn_at fb 63 (W_63 fb) :=
  SpF.blk_then (blk_63 prof) (SpF.skip 69)

def W_53 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 79 g (rfz f) V) ∧
    (f.cond 5 = false → W_63 fb F Wl Q g (rfz f) V)
theorem c_53 (prof : Profile) (fb : Addr) : SpF prof fdn fdn_at fb 53 (W_53 fb) :=
  SpF.blk_then (blk_53 prof) (SpF.jcc_then (spj_61 prof fb) (SpF.skip 79) (c_63 prof fb))

def W_74 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 79)
theorem c_74 (prof : Profile) (fb : Addr) : SpF prof fdn fdn_at fb 74 (W_74 fb) :=
  SpF.blk_then (blk_74 prof) (SpF.skip 79)

def W_98 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 (Q 108)
theorem c_98 (prof : Profile) (fb : Addr) : SpF prof fdn fdn_at fb 98 (W_98 fb) :=
  SpF.blk_then (blk_98 prof) (SpF.skip 108)

def W_79 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o4 fb) fun g f V =>
    (f.cond 5 = true → Q 109 g (rfz f) V) ∧
    (f.cond 5 = false → W_98 fb F Wl Q g (rfz f) V)
theorem c_79 (prof : Profile) (fb : Addr) : SpF prof fdn fdn_at fb 79 (W_79 fb) :=
  SpF.blkF_then (blk_79 prof fb) (SpF.jcc_then (spj_96 prof fb) (SpF.skip 109) (c_98 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 53, 74, 79]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 53 then W_53 fb else
  if ℓ = 74 then W_74 fb else
  if ℓ = 79 then W_79 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof fdn fdn_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_53 prof fb) <|
  SpF.table (c_74 prof fb) <|
  SpF.table (c_79 prof fb) <|
  SpF.never ℓ

end FV7z.Fdn
