/-- The cut points. -/
def cuts : List Nat := [0, 128, 148, 196, 228, 256, 268, 279, 290, 301, 722]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 128 then W_128 fb else
  if ℓ = 148 then W_148 fb else
  if ℓ = 196 then W_196 fb else
  if ℓ = 228 then W_228 fb else
  if ℓ = 256 then W_256 fb else
  if ℓ = 268 then W_268 fb else
  if ℓ = 279 then W_279 fb else
  if ℓ = 290 then W_290 fb else
  if ℓ = 301 then W_301 fb else
  if ℓ = 722 then W_722 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof cal cal_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_128 prof fb) <|
  SpF.table (c_148 prof fb) <|
  SpF.table (c_196 prof fb) <|
  SpF.table (c_228 prof fb) <|
  SpF.table (c_256 prof fb) <|
  SpF.table (c_268 prof fb) <|
  SpF.table (c_279 prof fb) <|
  SpF.table (c_290 prof fb) <|
  SpF.table (c_301 prof fb) <|
  SpF.table (c_722 prof fb) <|
  SpF.never ℓ

