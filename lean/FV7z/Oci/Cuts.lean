def W_220 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o12 fb) fun g f V =>
    (f.cond 5 = true → Q 263 g (rfz f) V) ∧
    (f.cond 5 = false → W_236 fb F Wl Q g (rfz f) V)
theorem c_220 (prof : Profile) (fb : Addr) : SpF prof oci oci_at fb 220 (W_220 fb) :=
  SpF.blkF_then (blk_220 prof fb) (SpF.jcc_then (spj_234 prof fb) (SpF.skip 263) (c_236 prof fb))

def W_261 (fb : Addr) : Wpt := fun F Wl Q g f V =>
    Q 220 g (rfz f) V
theorem c_261 (prof : Profile) (fb : Addr) : SpF prof oci oci_at fb 261 (W_261 fb) :=
  SpF.jmp_then (spj_261 prof fb) (SpF.skip 220)

/-- The cut points. -/
def cuts : List Nat := [0, 53, 72, 98, 111, 121, 163, 177, 198, 214, 220, 261]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 53 then W_53 fb else
  if ℓ = 72 then W_72 fb else
  if ℓ = 98 then W_98 fb else
  if ℓ = 111 then W_111 fb else
  if ℓ = 121 then W_121 fb else
  if ℓ = 163 then W_163 fb else
  if ℓ = 177 then W_177 fb else
  if ℓ = 198 then W_198 fb else
  if ℓ = 214 then W_214 fb else
  if ℓ = 220 then W_220 fb else
  if ℓ = 261 then W_261 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof oci oci_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_53 prof fb) <|
  SpF.table (c_72 prof fb) <|
  SpF.table (c_98 prof fb) <|
  SpF.table (c_111 prof fb) <|
  SpF.table (c_121 prof fb) <|
  SpF.table (c_163 prof fb) <|
  SpF.table (c_177 prof fb) <|
  SpF.table (c_198 prof fb) <|
  SpF.table (c_214 prof fb) <|
  SpF.table (c_220 prof fb) <|
  SpF.table (c_261 prof fb) <|
  SpF.never ℓ

end FV7z.Oci
