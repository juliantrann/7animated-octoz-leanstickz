    (f.cond 4 = true → Q 256 g (rfz f) V) ∧
    (f.cond 4 = false → Q 220 g (rfz f) V)
theorem c_214 (prof : Profile) (fb : Addr) : SpF prof oci oci_at fb 214 (W_214 fb) :=
