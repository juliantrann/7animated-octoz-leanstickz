import FV7z.Oci.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `COpenCallbackImp::Init2` (PLAN.md §M, M1)

The 12 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (48, 93, 106, 158, 172, 193, 209, 248, 256, 263; the `ret`).
`Wt` is the table of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Oci
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 48)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof oci oci_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 48)

def W_60 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 72)
theorem c_60 (prof : Profile) (fb : Addr) : SpF prof oci oci_at fb 60 (W_60 fb) :=
  SpF.blk_then (blk_60 prof) (SpF.skip 72)

def W_53 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 121 g (rfz f) V) ∧
    (f.cond 4 = false → W_60 fb F Wl Q g (rfz f) V)
theorem c_53 (prof : Profile) (fb : Addr) : SpF prof oci oci_at fb 53 (W_53 fb) :=
  SpF.blk_then (blk_53 prof) (SpF.jcc_then (spj_58 prof fb) (SpF.skip 121) (c_60 prof fb))

def W_85 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → Q 98 g (rfz f) V) ∧
    (f.cond 4 = false → Q 93 g (rfz f) V)
theorem c_85 (prof : Profile) (fb : Addr) : SpF prof oci oci_at fb 85 (W_85 fb) :=
  SpF.blk_then (blk_85 prof) (SpF.jcc_then (spj_91 prof fb) (SpF.skip 98) (SpF.skip 93))

def W_72 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 111 g (rfz f) V) ∧
    (f.cond 4 = false → W_85 fb F Wl Q g (rfz f) V)
theorem c_72 (prof : Profile) (fb : Addr) : SpF prof oci oci_at fb 72 (W_72 fb) :=
  SpF.blk_then (blk_72 prof) (SpF.jcc_then (spj_83 prof fb) (SpF.skip 111) (c_85 prof fb))

def W_98 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 (Q 106)
theorem c_98 (prof : Profile) (fb : Addr) : SpF prof oci oci_at fb 98 (W_98 fb) :=
  SpF.blk_then (blk_98 prof) (SpF.skip 106)

def W_111 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    (f.cond 5 = true → Q 72 g (rfz f) V) ∧
    (f.cond 5 = false → Q 121 g (rfz f) V)
theorem c_111 (prof : Profile) (fb : Addr) : SpF prof oci oci_at fb 111 (W_111 fb) :=
  SpF.blk_then (blk_111 prof) (SpF.jcc_then (spj_119 prof fb) (SpF.skip 72) (SpF.skip 121))

def W_121 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o7 (Q 158)
theorem c_121 (prof : Profile) (fb : Addr) : SpF prof oci oci_at fb 121 (W_121 fb) :=
