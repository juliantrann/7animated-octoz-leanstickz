    (f.cond 4 = true → Q 214 g (rfz f) V) ∧
    (f.cond 4 = false → Q 209 g (rfz f) V)
theorem c_198 (prof : Profile) (fb : Addr) : SpF prof oci oci_at fb 198 (W_198 fb) :=
  SpF.blk_then (blk_198 prof) (SpF.jcc_then (spj_207 prof fb) (SpF.skip 214) (SpF.skip 209))

