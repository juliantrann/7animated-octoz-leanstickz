import FV7z.Hsh.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__hash_string` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (79, 80, 90; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Hsh
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_88 : Wpt := fun F Wl Q => wp F Wl o6 (Q 90)
theorem c_88 (prof : Profile) : Sp prof hsh hsh_at 88 W_88 := Sp.blk_then (blk_88 prof) (Sp.skip 90)

def W_33 : Wpt := fun F Wl Q => wp F Wl o2 (Q 40)
theorem c_33 (prof : Profile) : Sp prof hsh hsh_at 33 W_33 := Sp.blk_then (blk_33 prof) (Sp.skip 40)

def W_11 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 80 g (rfz f) V) ∧
    (f.cond 4 = false → W_33 F Wl Q g (rfz f) V)
theorem c_11 (prof : Profile) : Sp prof hsh hsh_at 11 W_11 :=
  Sp.blk_then (blk_11 prof) (Sp.jcc_then (spj_31 prof) (Sp.skip 80) (c_33 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → W_88 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_11 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof hsh hsh_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_9 prof) (c_88 prof) (c_11 prof))

def W_62 : Wpt := fun F Wl Q => wp F Wl o4 (Q 72)
theorem c_62 (prof : Profile) : Sp prof hsh hsh_at 62 W_62 := Sp.blk_then (blk_62 prof) (Sp.skip 72)

def W_40 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 72 g (rfz f) V) ∧
    (f.cond 4 = false → W_62 F Wl Q g (rfz f) V)
theorem c_40 (prof : Profile) : Sp prof hsh hsh_at 40 W_40 :=
  Sp.blk_then (blk_40 prof) (Sp.jcc_then (spj_60 prof) (Sp.skip 72) (c_62 prof))

def W_72 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 5 = true → Q 40 g (rfz f) V) ∧
    (f.cond 5 = false → Q 79 g (rfz f) V)
theorem c_72 (prof : Profile) : Sp prof hsh hsh_at 72 W_72 :=
  Sp.blk_then (blk_72 prof) (Sp.jcc_then (spj_77 prof) (Sp.skip 40) (Sp.skip 79))

/-- The cut points. -/
def cuts : List Nat := [0, 40, 72]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 40 then W_40 else
  if ℓ = 72 then W_72 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof hsh hsh_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_40 prof) <|
  Sp.table (c_72 prof) <|
  Sp.never ℓ

end FV7z.Hsh
