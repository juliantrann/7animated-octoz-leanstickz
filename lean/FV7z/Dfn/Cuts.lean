/-- The cut points. -/
def cuts : List Nat := [0, 77, 90, 118, 126, 184, 206, 220, 234, 252, 277, 291]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 77 then W_77 fb else
  if ℓ = 90 then W_90 fb else
  if ℓ = 118 then W_118 fb else
  if ℓ = 126 then W_126 fb else
  if ℓ = 184 then W_184 fb else
  if ℓ = 206 then W_206 fb else
  if ℓ = 220 then W_220 fb else
  if ℓ = 234 then W_234 fb else
  if ℓ = 252 then W_252 fb else
  if ℓ = 277 then W_277 fb else
  if ℓ = 291 then W_291 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof dfn dfn_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_77 prof fb) <|
  SpF.table (c_90 prof fb) <|
  SpF.table (c_118 prof fb) <|
  SpF.table (c_126 prof fb) <|
  SpF.table (c_184 prof fb) <|
  SpF.table (c_206 prof fb) <|
  SpF.table (c_220 prof fb) <|
  SpF.table (c_234 prof fb) <|
  SpF.table (c_252 prof fb) <|
  SpF.table (c_277 prof fb) <|
  SpF.table (c_291 prof fb) <|
  SpF.never ℓ

