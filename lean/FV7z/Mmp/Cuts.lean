import FV7z.Mmp.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__mmap` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (36, 48, 49, 56, 85, 110; the `ret`). `Wt` is the table of the
cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Mmp
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_80 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 4 = true → Q 25 g (rfz f) V) ∧
    (f.cond 4 = false → Q 85 g (rfz f) V)
theorem c_80 (prof : Profile) (fb : Addr) : SpF prof mmp mmp_at fb 80 (W_80 fb) :=
  SpF.blk_then (blk_80 prof) (SpF.jcc_then (spj_83 prof fb) (SpF.skip 25) (SpF.skip 85))

def W_13 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → W_80 fb F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 25 g (rfz f) V)
theorem c_13 (prof : Profile) (fb : Addr) : SpF prof mmp mmp_at fb 13 (W_13 fb) :=
  SpF.blk_then (blk_13 prof) (SpF.jcc_then (spj_23 prof fb) (c_80 prof fb) (SpF.skip 25))

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → Q 56 g (rfz f) V) ∧
    (f.cond 5 = false → W_13 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof mmp mmp_at fb 0 (W_0 fb) :=
  SpF.blk_then (blk_0 prof) (SpF.jcc_then (spj_11 prof fb) (SpF.skip 56) (c_13 prof fb))

def W_25 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 36)
theorem c_25 (prof : Profile) (fb : Addr) : SpF prof mmp mmp_at fb 25 (W_25 fb) :=
  SpF.blk_then (blk_25 prof) (SpF.skip 36)

def W_144 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o6 fb) fun g f V =>
    Q 46 g (rfz f) V
theorem c_144 (prof : Profile) (fb : Addr) : SpF prof mmp mmp_at fb 144 (W_144 fb) :=
  SpF.blkF_then (blk_144 prof fb) (SpF.jmp_then (spj_163 prof fb) (SpF.skip 46))

def W_38 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 7 = true → W_144 fb F Wl Q g (rfz f) V) ∧
    (f.cond 7 = false → Q 46 g (rfz f) V)
theorem c_38 (prof : Profile) (fb : Addr) : SpF prof mmp mmp_at fb 38 (W_38 fb) :=
  SpF.blk_then (blk_38 prof) (SpF.jcc_then (spj_44 prof fb) (c_144 prof fb) (SpF.skip 46))

def W_46 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 (Q 48)
theorem c_46 (prof : Profile) (fb : Addr) : SpF prof mmp mmp_at fb 46 (W_46 fb) :=
  SpF.blk_then (blk_46 prof) (SpF.skip 48)

/-- The cut points. -/
def cuts : List Nat := [0, 25, 38, 46]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 25 then W_25 fb else
  if ℓ = 38 then W_38 fb else
  if ℓ = 46 then W_46 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof mmp mmp_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_25 prof fb) <|
  SpF.table (c_38 prof fb) <|
  SpF.table (c_46 prof fb) <|
  SpF.never ℓ

end FV7z.Mmp
