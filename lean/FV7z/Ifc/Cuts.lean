import FV7z.Ifc.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CInFileStream::CInFileStream` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (122, 134, 177; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ifc
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 122)
theorem c_0 (prof : Profile) : Sp prof ifc ifc_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 122)

def W_127 : Wpt := fun F Wl Q => wp F Wl o1 (Q 134)
theorem c_127 (prof : Profile) : Sp prof ifc ifc_at 127 W_127 := Sp.blk_then (blk_127 prof) (Sp.skip 134)

def W_139 : Wpt := fun F Wl Q => wp F Wl o2 (Q 177)
theorem c_139 (prof : Profile) : Sp prof ifc ifc_at 139 W_139 := Sp.blk_then (blk_139 prof) (Sp.skip 177)

/-- The cut points. -/
def cuts : List Nat := [0, 127, 139]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 127 then W_127 else
  if ℓ = 139 then W_139 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ifc ifc_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_127 prof) <|
  Sp.table (c_139 prof) <|
  Sp.never ℓ

end FV7z.Ifc
