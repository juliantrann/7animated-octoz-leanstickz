def W_252 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o15 fun g f V =>
    (f.cond 4 = true → Q 49 g (rfz f) V) ∧
    (f.cond 4 = false → Q 261 g (rfz f) V)
theorem c_252 (prof : Profile) (fb : Addr) : SpF prof fch fch_at fb 252 (W_252 fb) :=
