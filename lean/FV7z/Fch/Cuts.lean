def W_266 (fb : Addr) : Wpt := fun F Wl Q g f V =>
    Q 49 g (rfz f) V
theorem c_266 (prof : Profile) (fb : Addr) : SpF prof fch fch_at fb 266 (W_266 fb) :=
  SpF.jmp_then (spj_266 prof fb) (SpF.skip 49)

/-- The cut points. -/
def cuts : List Nat := [0, 37, 49, 110, 131, 165, 224, 234, 252, 266]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 37 then W_37 fb else
  if ℓ = 49 then W_49 fb else
  if ℓ = 110 then W_110 fb else
  if ℓ = 131 then W_131 fb else
  if ℓ = 165 then W_165 fb else
  if ℓ = 224 then W_224 fb else
  if ℓ = 234 then W_234 fb else
  if ℓ = 252 then W_252 fb else
  if ℓ = 266 then W_266 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof fch fch_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_37 prof fb) <|
  SpF.table (c_49 prof fb) <|
  SpF.table (c_110 prof fb) <|
  SpF.table (c_131 prof fb) <|
  SpF.table (c_165 prof fb) <|
  SpF.table (c_224 prof fb) <|
  SpF.table (c_234 prof fb) <|
  SpF.table (c_252 prof fb) <|
  SpF.table (c_266 prof fb) <|
  SpF.never ℓ

end FV7z.Fch
