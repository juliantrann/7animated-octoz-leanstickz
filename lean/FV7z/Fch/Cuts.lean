import FV7z.Fch.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `FindCharset` (PLAN.md §M, M1)

The 10 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (82, 105, 126, 160, 229, 261, 279, 284; the `ret`). `Wt` is
the table of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Fch
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 37)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof fch fch_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 37)

def W_88 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 (Q 105)
theorem c_88 (prof : Profile) (fb : Addr) : SpF prof fch fch_at fb 88 (W_88 fb) :=
  SpF.blk_then (blk_88 prof) (SpF.skip 105)

def W_37 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → W_88 fb F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → Q 49 g (rfz f) V)
theorem c_37 (prof : Profile) (fb : Addr) : SpF prof fch fch_at fb 37 (W_37 fb) :=
  SpF.blk_then (blk_37 prof) (SpF.jcc_then (spj_47 prof fb) (c_88 prof fb) (SpF.skip 49))

def W_69 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 82)
theorem c_69 (prof : Profile) (fb : Addr) : SpF prof fch fch_at fb 69 (W_69 fb) :=
  SpF.blk_then (blk_69 prof) (SpF.skip 82)

def W_49 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o2 fb) fun g f V =>
    (f.cond 5 = true → Q 279 g (rfz f) V) ∧
    (f.cond 5 = false → W_69 fb F Wl Q g (rfz f) V)
theorem c_49 (prof : Profile) (fb : Addr) : SpF prof fch fch_at fb 49 (W_49 fb) :=
  SpF.blkF_then (blk_49 prof fb) (SpF.jcc_then (spj_63 prof fb) (SpF.skip 279) (c_69 prof fb))

def W_121 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o6 (Q 126)
theorem c_121 (prof : Profile) (fb : Addr) : SpF prof fch fch_at fb 121 (W_121 fb) :=
