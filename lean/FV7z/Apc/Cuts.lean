import FV7z.Apc.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `AString::operator+=(const char *)` (PLAN.md §M, M1)

The 6 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (42, 80, 92; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Apc
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_21 : Wpt := fun F Wl Q => wp F Wl o1 (Q 24)
theorem c_21 (prof : Profile) : Sp prof apc apc_at 21 W_21 := Sp.blk_then (blk_21 prof) (Sp.skip 24)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 37 g (rfz f) V) ∧
    (f.cond 4 = false → W_21 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof apc apc_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_19 prof) (Sp.skip 37) (c_21 prof))

def W_24 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 24 g (rfz f) V) ∧
    (f.cond 5 = false → Q 37 g (rfz f) V)
theorem c_24 (prof : Profile) : Sp prof apc apc_at 24 W_24 :=
  Sp.blk_then (blk_24 prof) (Sp.jcc_then (spj_35 prof) (Sp.skip 24) (Sp.skip 37))

def W_37 : Wpt := fun F Wl Q => wp F Wl o3 (Q 42)
theorem c_37 (prof : Profile) : Sp prof apc apc_at 37 W_37 := Sp.blk_then (blk_37 prof) (Sp.skip 42)

def W_47 : Wpt := fun F Wl Q => wp F Wl o4 (Q 64)
theorem c_47 (prof : Profile) : Sp prof apc apc_at 47 W_47 := Sp.blk_then (blk_47 prof) (Sp.skip 64)

def W_64 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 5 = true → Q 64 g (rfz f) V) ∧
    (f.cond 5 = false → Q 80 g (rfz f) V)
theorem c_64 (prof : Profile) : Sp prof apc apc_at 64 W_64 :=
  Sp.blk_then (blk_64 prof) (Sp.jcc_then (spj_78 prof) (Sp.skip 64) (Sp.skip 80))

def W_85 : Wpt := fun F Wl Q => wp F Wl o6 (Q 92)
theorem c_85 (prof : Profile) : Sp prof apc apc_at 85 W_85 := Sp.blk_then (blk_85 prof) (Sp.skip 92)

/-- The cut points. -/
def cuts : List Nat := [0, 24, 37, 47, 64, 85]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 24 then W_24 else
  if ℓ = 37 then W_37 else
  if ℓ = 47 then W_47 else
  if ℓ = 64 then W_64 else
  if ℓ = 85 then W_85 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof apc apc_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_24 prof) <|
  Sp.table (c_37 prof) <|
  Sp.table (c_47 prof) <|
  Sp.table (c_64 prof) <|
  Sp.table (c_85 prof) <|
  Sp.never ℓ

end FV7z.Apc
