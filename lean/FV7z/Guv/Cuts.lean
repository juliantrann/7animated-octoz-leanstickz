import FV7z.Guv.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `GetUInt64Value` (PLAN.md §M, M1)

The 11 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (63, 76, 112, 125, 244; the `ret`). `Wt` is the table of the
cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Guv
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 63)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof guv guv_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 63)

def W_120 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 (Q 125)
theorem c_120 (prof : Profile) (fb : Addr) : SpF prof guv guv_at fb 120 (W_120 fb) :=
  SpF.blk_then (blk_120 prof) (SpF.skip 125)

def W_66 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → W_120 fb F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 73 g (rfz f) V)
theorem c_66 (prof : Profile) (fb : Addr) : SpF prof guv guv_at fb 66 (W_66 fb) :=
  SpF.blk_then (blk_66 prof) (SpF.jcc_then (spj_71 prof fb) (c_120 prof fb) (SpF.skip 73))

def W_73 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 76)
theorem c_73 (prof : Profile) (fb : Addr) : SpF prof guv guv_at fb 73 (W_73 fb) :=
  SpF.blk_then (blk_73 prof) (SpF.skip 76)

def W_101 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 (Q 112)
theorem c_101 (prof : Profile) (fb : Addr) : SpF prof guv guv_at fb 101 (W_101 fb) :=
  SpF.blk_then (blk_101 prof) (SpF.skip 112)

def W_81 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o3 fb) fun g f V =>
    (f.cond 5 = true → Q 244 g (rfz f) V) ∧
    (f.cond 5 = false → W_101 fb F Wl Q g (rfz f) V)
theorem c_81 (prof : Profile) (fb : Addr) : SpF prof guv guv_at fb 81 (W_81 fb) :=
  SpF.blkF_then (blk_81 prof fb) (SpF.jcc_then (spj_95 prof fb) (SpF.skip 244) (c_101 prof fb))

def W_131 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    ∃ tgt, tgt < guv.length ∧ g.get (regOf 0) = Addr.add guv_at tgt ∧ Q tgt g (rfz f) V
theorem c_131 (prof : Profile) (fb : Addr) : SpF prof guv guv_at fb 131 (W_131 fb) :=
  SpF.blkA_then (blk_131 prof) (spj_149 prof fb)

def W_160 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o7 (Q 173)
theorem c_160 (prof : Profile) (fb : Addr) : SpF prof guv guv_at fb 160 (W_160 fb) :=
  SpF.blk_then (blk_160 prof) (SpF.skip 173)

def W_173 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    Q 73 g (rfz f) V
theorem c_173 (prof : Profile) (fb : Addr) : SpF prof guv guv_at fb 173 (W_173 fb) :=
  SpF.blk_then (blk_173 prof) (SpF.jmp_then (spj_176 prof fb) (SpF.skip 73))

def W_184 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o9 fun g f V =>
    Q 173 g (rfz f) V
theorem c_184 (prof : Profile) (fb : Addr) : SpF prof guv guv_at fb 184 (W_184 fb) :=
  SpF.blk_then (blk_184 prof) (SpF.jmp_then (spj_196 prof fb) (SpF.skip 173))

def W_208 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o10 fun g f V =>
    Q 173 g (rfz f) V
theorem c_208 (prof : Profile) (fb : Addr) : SpF prof guv guv_at fb 208 (W_208 fb) :=
  SpF.blk_then (blk_208 prof) (SpF.jmp_then (spj_221 prof fb) (SpF.skip 173))

def W_224 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o11 fun g f V =>
    Q 173 g (rfz f) V
theorem c_224 (prof : Profile) (fb : Addr) : SpF prof guv guv_at fb 224 (W_224 fb) :=
  SpF.blk_then (blk_224 prof) (SpF.jmp_then (spj_237 prof fb) (SpF.skip 173))

def W_240 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o12 fun g f V =>
    Q 173 g (rfz f) V
theorem c_240 (prof : Profile) (fb : Addr) : SpF prof guv guv_at fb 240 (W_240 fb) :=
  SpF.blk_then (blk_240 prof) (SpF.jmp_then (spj_242 prof fb) (SpF.skip 173))

/-- The cut points. -/
def cuts : List Nat := [0, 66, 73, 81, 131, 160, 173, 184, 208, 224, 240]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 66 then W_66 fb else
  if ℓ = 73 then W_73 fb else
  if ℓ = 81 then W_81 fb else
  if ℓ = 131 then W_131 fb else
  if ℓ = 160 then W_160 fb else
  if ℓ = 173 then W_173 fb else
  if ℓ = 184 then W_184 fb else
  if ℓ = 208 then W_208 fb else
  if ℓ = 224 then W_224 fb else
  if ℓ = 240 then W_240 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof guv guv_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_66 prof fb) <|
  SpF.table (c_73 prof fb) <|
  SpF.table (c_81 prof fb) <|
  SpF.table (c_131 prof fb) <|
  SpF.table (c_160 prof fb) <|
  SpF.table (c_173 prof fb) <|
  SpF.table (c_184 prof fb) <|
  SpF.table (c_208 prof fb) <|
  SpF.table (c_224 prof fb) <|
  SpF.table (c_240 prof fb) <|
  SpF.never ℓ

end FV7z.Guv
