/-- The cut points. -/
def cuts : List Nat := [0, 32, 51, 53, 65, 93, 110, 129, 139, 170, 184, 200, 253, 266, 287, 300]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 32 then W_32 else
  if ℓ = 51 then W_51 else
  if ℓ = 53 then W_53 else
  if ℓ = 65 then W_65 else
  if ℓ = 93 then W_93 else
  if ℓ = 110 then W_110 else
  if ℓ = 129 then W_129 else
  if ℓ = 139 then W_139 else
  if ℓ = 170 then W_170 else
  if ℓ = 184 then W_184 else
  if ℓ = 200 then W_200 else
  if ℓ = 253 then W_253 else
  if ℓ = 266 then W_266 else
  if ℓ = 287 then W_287 else
  if ℓ = 300 then W_300 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof rdf rdf_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_32 prof) <|
  Sp.table (c_51 prof) <|
  Sp.table (c_53 prof) <|
  Sp.table (c_65 prof) <|
  Sp.table (c_93 prof) <|
  Sp.table (c_110 prof) <|
  Sp.table (c_129 prof) <|
  Sp.table (c_139 prof) <|
  Sp.table (c_170 prof) <|
  Sp.table (c_184 prof) <|
  Sp.table (c_200 prof) <|
  Sp.table (c_253 prof) <|
  Sp.table (c_266 prof) <|
  Sp.table (c_287 prof) <|
  Sp.table (c_300 prof) <|
  Sp.never ℓ

