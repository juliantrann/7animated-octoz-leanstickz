/-- The cut points. -/
def cuts : List Nat := [0, 93, 169, 189, 248, 304, 343, 381, 407, 427]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 93 then W_93 else
  if ℓ = 169 then W_169 else
  if ℓ = 189 then W_189 else
  if ℓ = 248 then W_248 else
  if ℓ = 304 then W_304 else
  if ℓ = 343 then W_343 else
  if ℓ = 381 then W_381 else
  if ℓ = 407 then W_407 else
  if ℓ = 427 then W_427 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof tls tls_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_93 prof) <|
  Sp.table (c_169 prof) <|
  Sp.table (c_189 prof) <|
  Sp.table (c_248 prof) <|
  Sp.table (c_304 prof) <|
  Sp.table (c_343 prof) <|
  Sp.table (c_381 prof) <|
  Sp.table (c_407 prof) <|
  Sp.table (c_427 prof) <|
  Sp.never ℓ

