def JccAt (prof : Profile) (cc : Cond) (j len tgt : Nat) : Prop :=
  ∃ rel, Dec prof.feat scm j (FV7z.mk (.jcc cc) 64 [.rel rel] len) ∧ (j + len + rel) % 2 ^ 64 = tgt % 2 ^ 64

