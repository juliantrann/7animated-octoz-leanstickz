import FV7z.Dsp.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CDirItems::ScanProgress` (PLAN.md §M, M1)

The 1 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (38, 50; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Dsp
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_48 : Wpt := fun F Wl Q => wp F Wl o2 (Q 50)
theorem c_48 (prof : Profile) : Sp prof dsp dsp_at 48 W_48 := Sp.blk_then (blk_48 prof) (Sp.skip 50)

def W_19 : Wpt := fun F Wl Q => wp F Wl o1 (Q 38)
theorem c_19 (prof : Profile) : Sp prof dsp dsp_at 19 W_19 := Sp.blk_then (blk_19 prof) (Sp.skip 38)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → W_48 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_19 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof dsp dsp_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_17 prof) (c_48 prof) (c_19 prof))

/-- The cut points. -/
def cuts : List Nat := [0]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof dsp dsp_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.never ℓ

end FV7z.Dsp
