import FV7z.Ach.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `AString::operator+=(char)` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (48, 56; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ach
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 56 g (rfz f) V) ∧
    (f.cond 4 = false → Q 23 g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof ach ach_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_21 prof) (Sp.skip 56) (Sp.skip 23))

def W_23 : Wpt := fun F Wl Q => wp F Wl o1 (Q 48)
theorem c_23 (prof : Profile) : Sp prof ach ach_at 23 W_23 := Sp.blk_then (blk_23 prof) (Sp.skip 48)

def W_61 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    Q 23 g (rfz f) V
theorem c_61 (prof : Profile) : Sp prof ach ach_at 61 W_61 :=
  Sp.blk_then (blk_61 prof) (Sp.jmp_then (spj_64 prof) (Sp.skip 23))

/-- The cut points. -/
def cuts : List Nat := [0, 23, 61]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 23 then W_23 else
  if ℓ = 61 then W_61 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ach ach_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_23 prof) <|
  Sp.table (c_61 prof) <|
  Sp.never ℓ

end FV7z.Ach
