import FV7z.Gbp.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `Archive_GetItemBoolProp` (PLAN.md §M, M1)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (59, 94, 126, 134, 139; the `ret`). `Wt` is the table of the
cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Gbp
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 59)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof gbp gbp_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 59)

def W_128 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o7 (Q 134)
theorem c_128 (prof : Profile) (fb : Addr) : SpF prof gbp gbp_at fb 128 (W_128 fb) :=
  SpF.blk_then (blk_128 prof) (SpF.skip 134)

def W_79 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 91)
theorem c_79 (prof : Profile) (fb : Addr) : SpF prof gbp gbp_at fb 79 (W_79 fb) :=
  SpF.blk_then (blk_79 prof) (SpF.skip 91)

def W_69 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → W_128 fb F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_79 fb F Wl Q g (rfz f) V)
theorem c_69 (prof : Profile) (fb : Addr) : SpF prof gbp gbp_at fb 69 (W_69 fb) :=
  SpF.blk_then (blk_69 prof) (SpF.jcc_then (spj_77 prof fb) (c_128 prof fb) (c_79 prof fb))

def W_62 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 91 g (rfz f) V) ∧
    (f.cond 5 = false → W_69 fb F Wl Q g (rfz f) V)
theorem c_62 (prof : Profile) (fb : Addr) : SpF prof gbp gbp_at fb 62 (W_62 fb) :=
  SpF.blk_then (blk_62 prof) (SpF.jcc_then (spj_67 prof fb) (SpF.skip 91) (c_69 prof fb))

def W_91 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 (Q 94)
theorem c_91 (prof : Profile) (fb : Addr) : SpF prof gbp gbp_at fb 91 (W_91 fb) :=
  SpF.blk_then (blk_91 prof) (SpF.skip 94)

def W_115 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o6 (Q 126)
theorem c_115 (prof : Profile) (fb : Addr) : SpF prof gbp gbp_at fb 115 (W_115 fb) :=
  SpF.blk_then (blk_115 prof) (SpF.skip 126)

def W_99 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o5 fb) fun g f V =>
    (f.cond 5 = true → Q 139 g (rfz f) V) ∧
    (f.cond 5 = false → W_115 fb F Wl Q g (rfz f) V)
theorem c_99 (prof : Profile) (fb : Addr) : SpF prof gbp gbp_at fb 99 (W_99 fb) :=
  SpF.blkF_then (blk_99 prof fb) (SpF.jcc_then (spj_113 prof fb) (SpF.skip 139) (c_115 prof fb))

def W_137 (fb : Addr) : Wpt := fun F Wl Q g f V =>
    Q 91 g (rfz f) V
theorem c_137 (prof : Profile) (fb : Addr) : SpF prof gbp gbp_at fb 137 (W_137 fb) :=
  SpF.jmp_then (spj_137 prof fb) (SpF.skip 91)

/-- The cut points. -/
def cuts : List Nat := [0, 62, 91, 99, 137]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 62 then W_62 fb else
  if ℓ = 91 then W_91 fb else
  if ℓ = 99 then W_99 fb else
  if ℓ = 137 then W_137 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof gbp gbp_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_62 prof fb) <|
  SpF.table (c_91 prof fb) <|
  SpF.table (c_99 prof fb) <|
  SpF.table (c_137 prof fb) <|
  SpF.never ℓ

end FV7z.Gbp
