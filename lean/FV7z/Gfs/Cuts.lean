import FV7z.Gfs.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NWindows::NFile::NDir::GetFullPathAndSplit` (PLAN.md §M, M1)

The 7 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (21, 36, 54, 88, 102; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Gfs
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 21)
theorem c_0 (prof : Profile) : Sp prof gfs gfs_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 21)

def W_96 : Wpt := fun F Wl Q => wp F Wl o7 (Q 102)
theorem c_96 (prof : Profile) : Sp prof gfs gfs_at 96 W_96 := Sp.blk_then (blk_96 prof) (Sp.skip 102)

def W_26 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → W_96 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 33 g (rfz f) V)
theorem c_26 (prof : Profile) : Sp prof gfs gfs_at 26 W_26 :=
  Sp.blk_then (blk_26 prof) (Sp.jcc_then (spj_31 prof) (c_96 prof) (Sp.skip 33))

def W_33 : Wpt := fun F Wl Q => wp F Wl o2 (Q 36)
theorem c_33 (prof : Profile) : Sp prof gfs gfs_at 33 W_33 := Sp.blk_then (blk_33 prof) (Sp.skip 36)

def W_41 : Wpt := fun F Wl Q => wp F Wl o3 (Q 54)
theorem c_41 (prof : Profile) : Sp prof gfs gfs_at 41 W_41 := Sp.blk_then (blk_41 prof) (Sp.skip 54)

def W_65 : Wpt := fun F Wl Q => wp F Wl o5 (Q 77)
theorem c_65 (prof : Profile) : Sp prof gfs gfs_at 65 W_65 := Sp.blk_then (blk_65 prof) (Sp.skip 77)

def W_59 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 3 = true → Q 77 g (rfz f) V) ∧
    (f.cond 3 = false → W_65 F Wl Q g (rfz f) V)
theorem c_59 (prof : Profile) : Sp prof gfs gfs_at 59 W_59 :=
  Sp.blk_then (blk_59 prof) (Sp.jcc_then (spj_63 prof) (Sp.skip 77) (c_65 prof))

def W_77 : Wpt := fun F Wl Q => wp F Wl o6 (Q 88)
theorem c_77 (prof : Profile) : Sp prof gfs gfs_at 77 W_77 := Sp.blk_then (blk_77 prof) (Sp.skip 88)

def W_107 : Wpt := fun F Wl Q g f V =>
    Q 33 g (rfz f) V
theorem c_107 (prof : Profile) : Sp prof gfs gfs_at 107 W_107 :=
  Sp.jmp_then (spj_107 prof) (Sp.skip 33)

/-- The cut points. -/
def cuts : List Nat := [0, 26, 33, 41, 59, 77, 107]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 26 then W_26 else
  if ℓ = 33 then W_33 else
  if ℓ = 41 then W_41 else
  if ℓ = 59 then W_59 else
  if ℓ = 77 then W_77 else
  if ℓ = 107 then W_107 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof gfs gfs_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_26 prof) <|
  Sp.table (c_33 prof) <|
  Sp.table (c_41 prof) <|
  Sp.table (c_59 prof) <|
  Sp.table (c_77 prof) <|
  Sp.table (c_107 prof) <|
  Sp.never ℓ

end FV7z.Gfs
