import FV7z.Psp.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `PrintSpaces` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (35, 44, 45; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Psp
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 35)
theorem c_0 (prof : Profile) : Sp prof psp psp_at 0 W_0 := Sp.blkA_then (blk_0 prof) (Sp.skip 35)

def W_40 : Wpt := fun F Wl Q => wp F Wl o1 (Q 44)
theorem c_40 (prof : Profile) : Sp prof psp psp_at 40 W_40 := Sp.blk_then (blk_40 prof) (Sp.skip 44)

/-- The cut points. -/
def cuts : List Nat := [0, 40]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 40 then W_40 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof psp psp_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_40 prof) <|
  Sp.never ℓ

end FV7z.Psp
