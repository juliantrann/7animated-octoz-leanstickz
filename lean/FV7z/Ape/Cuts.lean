import FV7z.Ape.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `AString::operator+=(const AString &)` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (20, 67, 82; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ape
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 20)
theorem c_0 (prof : Profile) : Sp prof ape ape_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 20)

def W_25 : Wpt := fun F Wl Q => wp F Wl o1 (Q 48)
theorem c_25 (prof : Profile) : Sp prof ape ape_at 25 W_25 := Sp.blk_then (blk_25 prof) (Sp.skip 48)

def W_64 : Wpt := fun F Wl Q => wp F Wl o3 (Q 67)
theorem c_64 (prof : Profile) : Sp prof ape ape_at 64 W_64 := Sp.blk_then (blk_64 prof) (Sp.skip 67)

def W_48 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 48 g (rfz f) V) ∧
    (f.cond 5 = false → W_64 F Wl Q g (rfz f) V)
theorem c_48 (prof : Profile) : Sp prof ape ape_at 48 W_48 :=
  Sp.blk_then (blk_48 prof) (Sp.jcc_then (spj_62 prof) (Sp.skip 48) (c_64 prof))

def W_72 : Wpt := fun F Wl Q => wp F Wl o4 (Q 82)
theorem c_72 (prof : Profile) : Sp prof ape ape_at 72 W_72 := Sp.blk_then (blk_72 prof) (Sp.skip 82)

/-- The cut points. -/
def cuts : List Nat := [0, 25, 48, 72]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 25 then W_25 else
  if ℓ = 48 then W_48 else
  if ℓ = 72 then W_72 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ape ape_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_25 prof) <|
  Sp.table (c_48 prof) <|
  Sp.table (c_72 prof) <|
  Sp.never ℓ

end FV7z.Ape
