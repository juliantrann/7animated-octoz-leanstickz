import FV7z.Rfw.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UString::ReverseFind` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (44, 53; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Rfw
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_11 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    Q 29 g (rfz f) V
theorem c_11 (prof : Profile) : Sp prof rfw rfw_at 11 W_11 :=
  Sp.blk_then (blk_11 prof) (Sp.jmp_then (spj_18 prof) (Sp.skip 29))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 48 g (rfz f) V) ∧
    (f.cond 4 = false → W_11 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof rfw rfw_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_9 prof) (Sp.skip 48) (c_11 prof))

def W_24 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 48 g (rfz f) V) ∧
    (f.cond 4 = false → Q 29 g (rfz f) V)
theorem c_24 (prof : Profile) : Sp prof rfw rfw_at 24 W_24 :=
  Sp.blk_then (blk_24 prof) (Sp.jcc_then (spj_27 prof) (Sp.skip 48) (Sp.skip 29))

def W_37 : Wpt := fun F Wl Q => wp F Wl o4 (Q 44)
theorem c_37 (prof : Profile) : Sp prof rfw rfw_at 37 W_37 := Sp.blk_then (blk_37 prof) (Sp.skip 44)

def W_29 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 5 = true → W_24 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → W_37 F Wl Q g (rfz f) V)
theorem c_29 (prof : Profile) : Sp prof rfw rfw_at 29 W_29 :=
  Sp.blk_then (blk_29 prof) (Sp.jcc_then (spj_35 prof) (c_24 prof) (c_37 prof))

def W_48 : Wpt := fun F Wl Q => wp F Wl o5 (Q 53)
theorem c_48 (prof : Profile) : Sp prof rfw rfw_at 48 W_48 := Sp.blk_then (blk_48 prof) (Sp.skip 53)

/-- The cut points. -/
def cuts : List Nat := [0, 29, 48]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 29 then W_29 else
  if ℓ = 48 then W_48 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof rfw rfw_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_29 prof) <|
  Sp.table (c_48 prof) <|
  Sp.never ℓ

end FV7z.Rfw
