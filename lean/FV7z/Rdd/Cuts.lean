theorem c_193 (prof : Profile) (fb : Addr) : SpF prof rdd rdd_at fb 193 (W_193 fb) :=
  SpF.blk_then (blk_193 prof) (SpF.skip 204)

/-- The cut points. -/
def cuts : List Nat := [0, 56, 80, 109, 133, 162, 176, 193]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 56 then W_56 fb else
  if ℓ = 80 then W_80 fb else
  if ℓ = 109 then W_109 fb else
  if ℓ = 133 then W_133 fb else
  if ℓ = 162 then W_162 fb else
  if ℓ = 176 then W_176 fb else
  if ℓ = 193 then W_193 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof rdd rdd_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_56 prof fb) <|
  SpF.table (c_80 prof fb) <|
  SpF.table (c_109 prof fb) <|
  SpF.table (c_133 prof fb) <|
  SpF.table (c_162 prof fb) <|
  SpF.table (c_176 prof fb) <|
  SpF.table (c_193 prof fb) <|
  SpF.never ℓ

end FV7z.Rdd
