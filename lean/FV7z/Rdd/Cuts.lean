theorem c_80 (prof : Profile) (fb : Addr) : SpF prof rdd rdd_at fb 80 (W_80 fb) :=
  SpF.blk_then (blk_80 prof) (SpF.jcc_then (spj_107 prof fb) (SpF.skip 176) (SpF.skip 109))

def W_118 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 (Q 128)
theorem c_118 (prof : Profile) (fb : Addr) : SpF prof rdd rdd_at fb 118 (W_118 fb) :=
