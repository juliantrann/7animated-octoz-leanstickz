def W_109 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 2 = true → Q 80 g (rfz f) V) ∧
    (f.cond 2 = false → W_118 fb F Wl Q g (rfz f) V)
theorem c_109 (prof : Profile) (fb : Addr) : SpF prof rdd rdd_at fb 109 (W_109 fb) :=
