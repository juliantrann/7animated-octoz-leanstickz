import FV7z.Rdd.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__readdir` (PLAN.md §M, M1)

The 8 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (52, 128, 188, 204, 217, 249, 253, 275; the `ret`). `Wt` is
the table of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Rdd
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_47 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 52)
theorem c_47 (prof : Profile) (fb : Addr) : SpF prof rdd rdd_at fb 47 (W_47 fb) :=
  SpF.blk_then (blk_47 prof) (SpF.skip 52)

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) fun g f V =>
    (f.cond 5 = true → Q 253 g (rfz f) V) ∧
    (f.cond 5 = false → W_47 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof rdd rdd_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.jcc_then (spj_41 prof fb) (SpF.skip 253) (c_47 prof fb))

def W_56 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    Q 109 g (rfz f) V
theorem c_56 (prof : Profile) (fb : Addr) : SpF prof rdd rdd_at fb 56 (W_56 fb) :=
  SpF.blk_then (blk_56 prof) (SpF.jmp_then (spj_68 prof fb) (SpF.skip 109))

def W_80 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
