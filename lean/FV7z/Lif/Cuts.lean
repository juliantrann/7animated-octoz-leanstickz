import FV7z.Lif.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__libc_init_first` (PLAN.md G3, startup)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (29, 65, 78, 88, 122; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Lif
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_96 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → Q 45 g (rfz f) V) ∧
    (f.cond 4 = false → Q 122 g (rfz f) V)
theorem c_96 (prof : Profile) : Sp prof lif lif_at 96 W_96 :=
  Sp.blkA_then (blk_96 prof) (Sp.jcc_then (spj_120 prof) (Sp.skip 45) (Sp.skip 122))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → W_96 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 29 g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof lif lif_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_27 prof) (c_96 prof) (Sp.skip 29))

def W_45 : Wpt := fun F Wl Q => wp F Wl o1 (Q 65)
theorem c_45 (prof : Profile) : Sp prof lif lif_at 45 W_45 := Sp.blkA_then (blk_45 prof) (Sp.skip 65)

def W_70 : Wpt := fun F Wl Q => wp F Wl o2 (Q 78)
theorem c_70 (prof : Profile) : Sp prof lif lif_at 70 W_70 := Sp.blk_then (blk_70 prof) (Sp.skip 78)

def W_83 : Wpt := fun F Wl Q => wp F Wl o3 (Q 88)
theorem c_83 (prof : Profile) : Sp prof lif lif_at 83 W_83 := Sp.blk_then (blk_83 prof) (Sp.skip 88)

def W_127 : Wpt := fun F Wl Q g f V =>
    Q 45 g (rfz f) V
theorem c_127 (prof : Profile) : Sp prof lif lif_at 127 W_127 :=
  Sp.jmp_then (spj_127 prof) (Sp.skip 45)

/-- The cut points. -/
def cuts : List Nat := [0, 45, 70, 83, 127]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 45 then W_45 else
  if ℓ = 70 then W_70 else
  if ℓ = 83 then W_83 else
  if ℓ = 127 then W_127 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof lif lif_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_45 prof) <|
  Sp.table (c_70 prof) <|
  Sp.table (c_83 prof) <|
  Sp.table (c_127 prof) <|
  Sp.never ℓ

end FV7z.Lif
