import FV7z.Gcf.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `Get_Correct_FsFile_Name` (PLAN.md §M, M1)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (14, 31, 55, 72, 87; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Gcf
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 14)
theorem c_0 (prof : Profile) : Sp prof gcf gcf_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 14)

def W_28 : Wpt := fun F Wl Q => wp F Wl o2 (Q 31)
theorem c_28 (prof : Profile) : Sp prof gcf gcf_at 28 W_28 := Sp.blk_then (blk_28 prof) (Sp.skip 31)

def W_19 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 64 g (rfz f) V) ∧
    (f.cond 4 = false → W_28 F Wl Q g (rfz f) V)
theorem c_19 (prof : Profile) : Sp prof gcf gcf_at 19 W_19 :=
  Sp.blk_then (blk_19 prof) (Sp.jcc_then (spj_26 prof) (Sp.skip 64) (c_28 prof))

def W_45 : Wpt := fun F Wl Q => wp F Wl o4 (Q 55)
theorem c_45 (prof : Profile) : Sp prof gcf gcf_at 45 W_45 := Sp.blk_then (blk_45 prof) (Sp.skip 55)

def W_36 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 64 g (rfz f) V) ∧
    (f.cond 4 = false → W_45 F Wl Q g (rfz f) V)
theorem c_36 (prof : Profile) : Sp prof gcf gcf_at 36 W_36 :=
  Sp.blk_then (blk_36 prof) (Sp.jcc_then (spj_43 prof) (Sp.skip 64) (c_45 prof))

def W_64 : Wpt := fun F Wl Q => wp F Wl o5 (Q 72)
theorem c_64 (prof : Profile) : Sp prof gcf gcf_at 64 W_64 := Sp.blk_then (blk_64 prof) (Sp.skip 72)

def W_77 : Wpt := fun F Wl Q => wp F Wl o4 (Q 87)
theorem c_77 (prof : Profile) : Sp prof gcf gcf_at 77 W_77 := Sp.blk_then (blk_77 prof) (Sp.skip 87)

/-- The cut points. -/
def cuts : List Nat := [0, 19, 36, 64, 77]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 19 then W_19 else
  if ℓ = 36 then W_36 else
  if ℓ = 64 then W_64 else
  if ℓ = 77 then W_77 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof gcf gcf_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_19 prof) <|
  Sp.table (c_36 prof) <|
  Sp.table (c_64 prof) <|
  Sp.table (c_77 prof) <|
  Sp.never ℓ

end FV7z.Gcf
