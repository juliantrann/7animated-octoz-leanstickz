import FV7z.Scp.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CExtractScanConsole::ScanProgress` (PLAN.md §M, M1)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (74, 86, 100, 109, 155, 156; the `ret`). `Wt` is the table of
the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Scp
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_42 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 74)
theorem c_42 (prof : Profile) (fb : Addr) : SpF prof scp scp_at fb 42 (W_42 fb) :=
  SpF.blk_then (blk_42 prof) (SpF.skip 74)

def W_33 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 114 g (rfz f) V) ∧
    (f.cond 5 = false → W_42 fb F Wl Q g (rfz f) V)
theorem c_33 (prof : Profile) (fb : Addr) : SpF prof scp scp_at fb 33 (W_33 fb) :=
  SpF.blk_then (blk_33 prof) (SpF.jcc_then (spj_40 prof fb) (SpF.skip 114) (c_42 prof fb))

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) fun g f V =>
    (f.cond 4 = true → Q 114 g (rfz f) V) ∧
    (f.cond 4 = false → W_33 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof scp scp_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.jcc_then (spj_31 prof fb) (SpF.skip 114) (c_33 prof fb))

def W_79 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 86)
theorem c_79 (prof : Profile) (fb : Addr) : SpF prof scp scp_at fb 79 (W_79 fb) :=
  SpF.blk_then (blk_79 prof) (SpF.skip 86)

def W_91 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → Q 105 g (rfz f) V) ∧
    (f.cond 4 = false → Q 100 g (rfz f) V)
theorem c_91 (prof : Profile) (fb : Addr) : SpF prof scp scp_at fb 91 (W_91 fb) :=
  SpF.blk_then (blk_91 prof) (SpF.jcc_then (spj_98 prof fb) (SpF.skip 105) (SpF.skip 100))

def W_105 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 (Q 109)
theorem c_105 (prof : Profile) (fb : Addr) : SpF prof scp scp_at fb 105 (W_105 fb) :=
  SpF.blk_then (blk_105 prof) (SpF.skip 109)

def W_149 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o7 (Q 155)
theorem c_149 (prof : Profile) (fb : Addr) : SpF prof scp scp_at fb 149 (W_149 fb) :=
  SpF.blk_then (blk_149 prof) (SpF.skip 155)

def W_114 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o6 fb) fun g f V =>
    (f.cond 5 = true → Q 156 g (rfz f) V) ∧
    (f.cond 5 = false → W_149 fb F Wl Q g (rfz f) V)
theorem c_114 (prof : Profile) (fb : Addr) : SpF prof scp scp_at fb 114 (W_114 fb) :=
  SpF.blkF_then (blk_114 prof fb) (SpF.jcc_then (spj_147 prof fb) (SpF.skip 156) (c_149 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 79, 91, 105, 114]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 79 then W_79 fb else
  if ℓ = 91 then W_91 fb else
  if ℓ = 105 then W_105 fb else
  if ℓ = 114 then W_114 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof scp scp_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_79 prof fb) <|
  SpF.table (c_91 prof fb) <|
  SpF.table (c_105 prof fb) <|
  SpF.table (c_114 prof fb) <|
  SpF.never ℓ

end FV7z.Scp
