import FV7z.Dmc.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__default_morecore` (PLAN.md G3, `malloc`)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (8, 30; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Dmc
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 8)
theorem c_0 (prof : Profile) : Sp prof dmc dmc_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 8)

def W_13 : Wpt := fun F Wl Q => wp F Wl o1 (Q 30)
theorem c_13 (prof : Profile) : Sp prof dmc dmc_at 13 W_13 := Sp.blk_then (blk_13 prof) (Sp.skip 30)

/-- The cut points. -/
def cuts : List Nat := [0, 13]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 13 then W_13 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof dmc dmc_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_13 prof) <|
  Sp.never ℓ

end FV7z.Dmc
