import FV7z.Usm.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UnicodeStringToMultiByte (const UString &, UINT)` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (38, 62, 95, 96; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Usm
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 38)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof usm usm_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 38)

def W_43 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 62)
theorem c_43 (prof : Profile) (fb : Addr) : SpF prof usm usm_at fb 43 (W_43 fb) :=
  SpF.blk_then (blk_43 prof) (SpF.skip 62)

def W_83 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 95)
theorem c_83 (prof : Profile) (fb : Addr) : SpF prof usm usm_at fb 83 (W_83 fb) :=
  SpF.blk_then (blk_83 prof) (SpF.skip 95)

def W_67 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o2 fb) fun g f V =>
    (f.cond 5 = true → Q 96 g (rfz f) V) ∧
    (f.cond 5 = false → W_83 fb F Wl Q g (rfz f) V)
theorem c_67 (prof : Profile) (fb : Addr) : SpF prof usm usm_at fb 67 (W_67 fb) :=
  SpF.blkF_then (blk_67 prof fb) (SpF.jcc_then (spj_81 prof fb) (SpF.skip 96) (c_83 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 43, 67]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 43 then W_43 fb else
  if ℓ = 67 then W_67 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof usm usm_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_43 prof fb) <|
  SpF.table (c_67 prof fb) <|
  SpF.never ℓ

end FV7z.Usm
