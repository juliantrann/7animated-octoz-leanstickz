/-- The cut points. -/
def cuts : List Nat := [0, 52, 83, 114, 164]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 52 then W_52 fb else
  if ℓ = 83 then W_83 fb else
  if ℓ = 114 then W_114 fb else
  if ℓ = 164 then W_164 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof mnx mnx_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_52 prof fb) <|
  SpF.table (c_83 prof fb) <|
  SpF.table (c_114 prof fb) <|
  SpF.table (c_164 prof fb) <|
  SpF.never ℓ

