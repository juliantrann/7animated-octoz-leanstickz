import FV7z.Ost.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `COpenCallbackConsole::Open_SetTotal` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (79; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ost
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_112 : Wpt := fun F Wl Q => wp F Wl o9 fun g f V =>
    Q 60 g (rfz f) V
theorem c_112 (prof : Profile) : Sp prof ost ost_at 112 W_112 :=
  Sp.blk_then (blk_112 prof) (Sp.jmp_then (spj_123 prof) (Sp.skip 60))

def W_92 : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    Q 60 g (rfz f) V
theorem c_92 (prof : Profile) : Sp prof ost ost_at 92 W_92 :=
  Sp.blk_then (blk_92 prof) (Sp.jmp_then (spj_106 prof) (Sp.skip 60))

def W_80 : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    (f.cond 4 = true → W_112 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_92 F Wl Q g (rfz f) V)
theorem c_80 (prof : Profile) : Sp prof ost ost_at 80 W_80 :=
  Sp.blk_then (blk_80 prof) (Sp.jcc_then (spj_90 prof) (c_112 prof) (c_92 prof))

def W_50 : Wpt := fun F Wl Q => wp F Wl o5 (Q 60)
theorem c_50 (prof : Profile) : Sp prof ost ost_at 50 W_50 := Sp.blk_then (blk_50 prof) (Sp.skip 60)

def W_31 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → Q 60 g (rfz f) V) ∧
    (f.cond 4 = false → W_50 F Wl Q g (rfz f) V)
theorem c_31 (prof : Profile) : Sp prof ost ost_at 31 W_31 :=
  Sp.blk_then (blk_31 prof) (Sp.jcc_then (spj_48 prof) (Sp.skip 60) (c_50 prof))

def W_26 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → W_80 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_31 F Wl Q g (rfz f) V)
theorem c_26 (prof : Profile) : Sp prof ost ost_at 26 W_26 :=
  Sp.blk_then (blk_26 prof) (Sp.jcc_then (spj_29 prof) (c_80 prof) (c_31 prof))

def W_20 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 60 g (rfz f) V) ∧
    (f.cond 5 = false → W_26 F Wl Q g (rfz f) V)
theorem c_20 (prof : Profile) : Sp prof ost ost_at 20 W_20 :=
  Sp.blk_then (blk_20 prof) (Sp.jcc_then (spj_24 prof) (Sp.skip 60) (c_26 prof))

def W_13 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 60 g (rfz f) V) ∧
    (f.cond 4 = false → W_20 F Wl Q g (rfz f) V)
theorem c_13 (prof : Profile) : Sp prof ost ost_at 13 W_13 :=
  Sp.blk_then (blk_13 prof) (Sp.jcc_then (spj_18 prof) (Sp.skip 60) (c_20 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → Q 60 g (rfz f) V) ∧
    (f.cond 5 = false → W_13 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof ost ost_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_11 prof) (Sp.skip 60) (c_13 prof))

def W_60 : Wpt := fun F Wl Q => wp F Wl o6 (Q 79)
theorem c_60 (prof : Profile) : Sp prof ost ost_at 60 W_60 := Sp.blk_then (blk_60 prof) (Sp.skip 79)

/-- The cut points. -/
def cuts : List Nat := [0, 60]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 60 then W_60 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ost ost_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_60 prof) <|
  Sp.never ℓ

end FV7z.Ost
