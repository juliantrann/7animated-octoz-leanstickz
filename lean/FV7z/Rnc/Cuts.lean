import FV7z.Rnc.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__read_nocancel` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (6, 16, 43; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Rnc
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o0 (Q 6)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof rnc rnc_at fb 0 (W_0 fb) :=
  SpF.blk_then (blk_0 prof) (SpF.skip 6)

def W_24 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o2 fb) (Q 43)
theorem c_24 (prof : Profile) (fb : Addr) : SpF prof rnc rnc_at fb 24 (W_24 fb) :=
  SpF.blkF_then (blk_24 prof fb) (SpF.skip 43)

def W_8 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 7 = true → W_24 fb F Wl Q g (rfz f) V) ∧
    (f.cond 7 = false → Q 16 g (rfz f) V)
theorem c_8 (prof : Profile) (fb : Addr) : SpF prof rnc rnc_at fb 8 (W_8 fb) :=
  SpF.blk_then (blk_8 prof) (SpF.jcc_then (spj_14 prof fb) (c_24 prof fb) (SpF.skip 16))

/-- The cut points. -/
def cuts : List Nat := [0, 8]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 8 then W_8 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof rnc rnc_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_8 prof fb) <|
  SpF.never ℓ

end FV7z.Rnc
