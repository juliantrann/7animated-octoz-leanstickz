import FV7z.Gpi.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CHandler::GetArchivePropertyInfo` (PLAN.md §M, M1)

The 1 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (48, 61; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Gpi
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_56 : Wpt := fun F Wl Q => wp F Wl o2 (Q 61)
theorem c_56 (prof : Profile) : Sp prof gpi gpi_at 56 W_56 := Sp.blk_then (blk_56 prof) (Sp.skip 61)

def W_9 : Wpt := fun F Wl Q => wp F Wl o1 (Q 48)
theorem c_9 (prof : Profile) : Sp prof gpi gpi_at 9 W_9 := Sp.blkA_then (blk_9 prof) (Sp.skip 48)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 7 = true → W_56 F Wl Q g (rfz f) V) ∧
    (f.cond 7 = false → W_9 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof gpi gpi_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_7 prof) (c_56 prof) (c_9 prof))

/-- The cut points. -/
def cuts : List Nat := [0]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof gpi gpi_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.never ℓ

end FV7z.Gpi
