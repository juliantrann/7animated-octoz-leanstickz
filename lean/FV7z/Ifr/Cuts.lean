theorem c_72 (prof : Profile) (fb : Addr) : SpF prof ifr ifr_at fb 72 (W_72 fb) :=
  SpF.blk_then (blk_72 prof) (SpF.jcc_then (spj_76 prof fb) (SpF.skip 752) (c_82 prof fb))

