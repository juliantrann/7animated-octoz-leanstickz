  SpF.blk_then (blk_696 prof) (SpF.jmp_then (spj_730 prof fb) (SpF.skip 307))

/-- The cut points. -/
def cuts : List Nat := [0, 90, 307, 696]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 90 then W_90 fb else
  if ℓ = 307 then W_307 fb else
  if ℓ = 696 then W_696 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof ifr ifr_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_90 prof fb) <|
  SpF.table (c_307 prof fb) <|
  SpF.table (c_696 prof fb) <|
  SpF.never ℓ

end FV7z.Ifr
