import FV7z.Fkd.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `FindFile_KeepDots` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (16, 92, 104; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Fkd
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 16)
theorem c_0 (prof : Profile) : Sp prof fkd fkd_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 16)

def W_112 : Wpt := fun F Wl Q => wp F Wl o12 fun g f V =>
    Q 88 g (rfz f) V
theorem c_112 (prof : Profile) : Sp prof fkd fkd_at 112 W_112 :=
  Sp.blk_then (blk_112 prof) (Sp.jmp_then (spj_115 prof) (Sp.skip 88))

def W_80 : Wpt := fun F Wl Q => wp F Wl o9 (Q 88)
theorem c_80 (prof : Profile) : Sp prof fkd fkd_at 80 W_80 := Sp.blk_then (blk_80 prof) (Sp.skip 88)

def W_74 : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    (f.cond 5 = true → Q 97 g (rfz f) V) ∧
    (f.cond 5 = false → W_80 F Wl Q g (rfz f) V)
theorem c_74 (prof : Profile) : Sp prof fkd fkd_at 74 W_74 :=
  Sp.blk_then (blk_74 prof) (Sp.jcc_then (spj_78 prof) (Sp.skip 97) (c_80 prof))

def W_65 : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    (f.cond 4 = true → W_112 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_74 F Wl Q g (rfz f) V)
theorem c_65 (prof : Profile) : Sp prof fkd fkd_at 65 W_65 :=
  Sp.blk_then (blk_65 prof) (Sp.jcc_then (spj_72 prof) (c_112 prof) (c_74 prof))

def W_61 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    (f.cond 5 = true → Q 97 g (rfz f) V) ∧
    (f.cond 5 = false → W_65 F Wl Q g (rfz f) V)
theorem c_61 (prof : Profile) : Sp prof fkd fkd_at 61 W_61 :=
  Sp.blk_then (blk_61 prof) (Sp.jcc_then (spj_63 prof) (Sp.skip 97) (c_65 prof))

def W_53 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 4 = true → Q 88 g (rfz f) V) ∧
    (f.cond 4 = false → W_61 F Wl Q g (rfz f) V)
theorem c_53 (prof : Profile) : Sp prof fkd fkd_at 53 W_53 :=
  Sp.blk_then (blk_53 prof) (Sp.jcc_then (spj_59 prof) (Sp.skip 88) (c_61 prof))

def W_48 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → Q 88 g (rfz f) V) ∧
    (f.cond 4 = false → W_53 F Wl Q g (rfz f) V)
theorem c_48 (prof : Profile) : Sp prof fkd fkd_at 48 W_48 :=
  Sp.blk_then (blk_48 prof) (Sp.jcc_then (spj_51 prof) (Sp.skip 88) (c_53 prof))

def W_35 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 5 = true → Q 97 g (rfz f) V) ∧
    (f.cond 5 = false → W_48 F Wl Q g (rfz f) V)
theorem c_35 (prof : Profile) : Sp prof fkd fkd_at 35 W_35 :=
  Sp.blk_then (blk_35 prof) (Sp.jcc_then (spj_46 prof) (Sp.skip 97) (c_48 prof))

def W_28 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 97 g (rfz f) V) ∧
    (f.cond 4 = false → W_35 F Wl Q g (rfz f) V)
theorem c_28 (prof : Profile) : Sp prof fkd fkd_at 28 W_28 :=
  Sp.blk_then (blk_28 prof) (Sp.jcc_then (spj_33 prof) (Sp.skip 97) (c_35 prof))

def W_21 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 97 g (rfz f) V) ∧
    (f.cond 4 = false → W_28 F Wl Q g (rfz f) V)
theorem c_21 (prof : Profile) : Sp prof fkd fkd_at 21 W_21 :=
  Sp.blk_then (blk_21 prof) (Sp.jcc_then (spj_26 prof) (Sp.skip 97) (c_28 prof))

def W_88 : Wpt := fun F Wl Q => wp F Wl o10 (Q 92)
theorem c_88 (prof : Profile) : Sp prof fkd fkd_at 88 W_88 := Sp.blk_then (blk_88 prof) (Sp.skip 92)

def W_97 : Wpt := fun F Wl Q => wp F Wl o11 (Q 104)
theorem c_97 (prof : Profile) : Sp prof fkd fkd_at 97 W_97 := Sp.blk_then (blk_97 prof) (Sp.skip 104)

/-- The cut points. -/
def cuts : List Nat := [0, 21, 88, 97]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 21 then W_21 else
  if ℓ = 88 then W_88 else
  if ℓ = 97 then W_97 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof fkd fkd_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_21 prof) <|
  Sp.table (c_88 prof) <|
  Sp.table (c_97 prof) <|
  Sp.never ℓ

end FV7z.Fkd
