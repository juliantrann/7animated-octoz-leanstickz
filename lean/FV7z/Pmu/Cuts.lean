import FV7z.Pmu.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `pthread_mutex_unlock` (PLAN.md G3, pthread)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (27, 43, 54, 64, 80, 112; the `ret`). `Wt` is the table of the
cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Pmu
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_20 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 80 g (rfz f) V) ∧
    (f.cond 5 = false → Q 27 g (rfz f) V)
theorem c_20 (prof : Profile) : Sp prof pmu pmu_at 20 W_20 :=
  Sp.blk_then (blk_20 prof) (Sp.jcc_then (spj_25 prof) (Sp.skip 80) (Sp.skip 27))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → Q 64 g (rfz f) V) ∧
    (f.cond 5 = false → W_20 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof pmu pmu_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_18 prof) (Sp.skip 64) (c_20 prof))

def W_31 : Wpt := fun F Wl Q => wp F Wl o2 (Q 43)
theorem c_31 (prof : Profile) : Sp prof pmu pmu_at 31 W_31 := Sp.blk_then (blk_31 prof) (Sp.skip 43)

def W_50 : Wpt := fun F Wl Q => wp F Wl o4 (Q 54)
theorem c_50 (prof : Profile) : Sp prof pmu pmu_at 50 W_50 := Sp.blk_then (blk_50 prof) (Sp.skip 54)

def W_45 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 15 = true → Q 112 g (rfz f) V) ∧
    (f.cond 15 = false → W_50 F Wl Q g (rfz f) V)
theorem c_45 (prof : Profile) : Sp prof pmu pmu_at 45 W_45 :=
  Sp.blk_then (blk_45 prof) (Sp.jcc_then (spj_48 prof) (Sp.skip 112) (c_50 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 31, 45]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 31 then W_31 else
  if ℓ = 45 then W_45 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof pmu pmu_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_31 prof) <|
  Sp.table (c_45 prof) <|
  Sp.never ℓ

end FV7z.Pmu
