import FV7z.Cpt.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NWildcard::CCensorNode::CheckPathCurrent` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (74, 93, 108; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Cpt
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_46 : Wpt := fun F Wl Q g f V =>
    Q 96 g (rfz f) V
theorem c_46 (prof : Profile) : Sp prof cpt cpt_at 46 W_46 :=
  Sp.jmp_then (spj_46 prof) (Sp.skip 96)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → Q 58 g (rfz f) V) ∧
    (f.cond 5 = false → W_46 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof cpt cpt_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_44 prof) (Sp.skip 58) (c_46 prof))

def W_58 : Wpt := fun F Wl Q => wp F Wl o2 (Q 74)
theorem c_58 (prof : Profile) : Sp prof cpt cpt_at 58 W_58 := Sp.blk_then (blk_58 prof) (Sp.skip 74)

def W_48 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 6 = true → Q 96 g (rfz f) V) ∧
    (f.cond 6 = false → Q 58 g (rfz f) V)
theorem c_48 (prof : Profile) : Sp prof cpt cpt_at 48 W_48 :=
  Sp.blk_then (blk_48 prof) (Sp.jcc_then (spj_56 prof) (Sp.skip 96) (Sp.skip 58))

def W_83 : Wpt := fun F Wl Q => wp F Wl o4 (Q 93)
theorem c_83 (prof : Profile) : Sp prof cpt cpt_at 83 W_83 := Sp.blk_then (blk_83 prof) (Sp.skip 93)

def W_79 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → W_48 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_83 F Wl Q g (rfz f) V)
theorem c_79 (prof : Profile) : Sp prof cpt cpt_at 79 W_79 :=
  Sp.blk_then (blk_79 prof) (Sp.jcc_then (spj_81 prof) (c_48 prof) (c_83 prof))

def W_96 : Wpt := fun F Wl Q => wp F Wl o5 (Q 108)
theorem c_96 (prof : Profile) : Sp prof cpt cpt_at 96 W_96 := Sp.blk_then (blk_96 prof) (Sp.skip 108)

/-- The cut points. -/
def cuts : List Nat := [0, 58, 79, 96]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 58 then W_58 else
  if ℓ = 79 then W_79 else
  if ℓ = 96 then W_96 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof cpt cpt_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_58 prof) <|
  Sp.table (c_79 prof) <|
  Sp.table (c_96 prof) <|
  Sp.never ℓ

end FV7z.Cpt
