import FV7z.Afd.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `AString::Find` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (13, 26, 33; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Afd
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 13)
theorem c_0 (prof : Profile) : Sp prof afd afd_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 13)

def W_27 : Wpt := fun F Wl Q => wp F Wl o3 (Q 33)
theorem c_27 (prof : Profile) : Sp prof afd afd_at 27 W_27 := Sp.blk_then (blk_27 prof) (Sp.skip 33)

def W_23 : Wpt := fun F Wl Q => wp F Wl o2 (Q 26)
theorem c_23 (prof : Profile) : Sp prof afd afd_at 23 W_23 := Sp.blk_then (blk_23 prof) (Sp.skip 26)

def W_18 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → W_27 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_23 F Wl Q g (rfz f) V)
theorem c_18 (prof : Profile) : Sp prof afd afd_at 18 W_18 :=
  Sp.blk_then (blk_18 prof) (Sp.jcc_then (spj_21 prof) (c_27 prof) (c_23 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 18]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 18 then W_18 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof afd afd_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_18 prof) <|
  Sp.never ℓ

end FV7z.Afd
