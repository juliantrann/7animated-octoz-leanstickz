import FV7z.Iag.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `InStream_AtBegin_GetSize` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (27, 36, 58; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Iag
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 27)
theorem c_0 (prof : Profile) : Sp prof iag iag_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 27)

def W_30 : Wpt := fun F Wl Q => wp F Wl o1 (Q 36)
theorem c_30 (prof : Profile) : Sp prof iag iag_at 30 W_30 := Sp.blk_then (blk_30 prof) (Sp.skip 36)

def W_41 : Wpt := fun F Wl Q => wp F Wl o2 (Q 58)
theorem c_41 (prof : Profile) : Sp prof iag iag_at 41 W_41 := Sp.blk_then (blk_41 prof) (Sp.skip 58)

/-- The cut points. -/
def cuts : List Nat := [0, 30, 41]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 30 then W_30 else
  if ℓ = 41 then W_41 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof iag iag_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_30 prof) <|
  Sp.table (c_41 prof) <|
  Sp.never ℓ

end FV7z.Iag
