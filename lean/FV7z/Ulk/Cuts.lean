def cuts : List Nat := [0, 106, 135, 189]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 106 then W_106 fb else
  if ℓ = 135 then W_135 fb else
  if ℓ = 189 then W_189 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof ulk ulk_at fb ℓ (Wt fb ℓ) :=
