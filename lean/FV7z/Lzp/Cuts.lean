import FV7z.Lzp.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `LzFindPrepare` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (8, 34, 40, 76; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Lzp
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 8)
theorem c_0 (prof : Profile) : Sp prof lzp lzp_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 8)

def W_23 : Wpt := fun F Wl Q => wp F Wl o2 (Q 34)
theorem c_23 (prof : Profile) : Sp prof lzp lzp_at 23 W_23 := Sp.blkA_then (blk_23 prof) (Sp.skip 34)

def W_13 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 40 g (rfz f) V) ∧
    (f.cond 5 = false → W_23 F Wl Q g (rfz f) V)
theorem c_13 (prof : Profile) : Sp prof lzp lzp_at 13 W_13 :=
  Sp.blk_then (blk_13 prof) (Sp.jcc_then (spj_21 prof) (Sp.skip 40) (c_23 prof))

def W_45 : Wpt := fun F Wl Q => wp F Wl o3 (Q 76)
theorem c_45 (prof : Profile) : Sp prof lzp lzp_at 45 W_45 := Sp.blkA_then (blk_45 prof) (Sp.skip 76)

/-- The cut points. -/
def cuts : List Nat := [0, 13, 45]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 13 then W_13 else
  if ℓ = 45 then W_45 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof lzp lzp_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_13 prof) <|
  Sp.table (c_45 prof) <|
  Sp.never ℓ

end FV7z.Lzp
