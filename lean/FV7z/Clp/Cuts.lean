/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 66 then W_66 else
  if ℓ = 68 then W_68 else
  if ℓ = 76 then W_76 else
  if ℓ = 91 then W_91 else
  if ℓ = 106 then W_106 else
  if ℓ = 130 then W_130 else
  if ℓ = 202 then W_202 else
  if ℓ = 245 then W_245 else
  if ℓ = 284 then W_284 else
  if ℓ = 309 then W_309 else
  if ℓ = 314 then W_314 else
  if ℓ = 334 then W_334 else
  if ℓ = 339 then W_339 else
  if ℓ = 352 then W_352 else
  if ℓ = 367 then W_367 else
  if ℓ = 380 then W_380 else
  if ℓ = 395 then W_395 else
  if ℓ = 408 then W_408 else
  if ℓ = 424 then W_424 else
  if ℓ = 437 then W_437 else
  if ℓ = 453 then W_453 else
  if ℓ = 469 then W_469 else
  if ℓ = 485 then W_485 else
  if ℓ = 492 then W_492 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof clp clp_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_66 prof) <|
  Sp.table (c_68 prof) <|
  Sp.table (c_76 prof) <|
  Sp.table (c_91 prof) <|
  Sp.table (c_106 prof) <|
  Sp.table (c_130 prof) <|
  Sp.table (c_202 prof) <|
  Sp.table (c_245 prof) <|
  Sp.table (c_284 prof) <|
  Sp.table (c_309 prof) <|
  Sp.table (c_314 prof) <|
  Sp.table (c_334 prof) <|
  Sp.table (c_339 prof) <|
  Sp.table (c_352 prof) <|
  Sp.table (c_367 prof) <|
  Sp.table (c_380 prof) <|
  Sp.table (c_395 prof) <|
  Sp.table (c_408 prof) <|
  Sp.table (c_424 prof) <|
  Sp.table (c_437 prof) <|
  Sp.table (c_453 prof) <|
  Sp.table (c_469 prof) <|
  Sp.table (c_485 prof) <|
  Sp.table (c_492 prof) <|
