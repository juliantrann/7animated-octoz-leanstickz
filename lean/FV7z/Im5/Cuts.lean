/-- The cut points. -/
def cuts : List Nat := [0, 512, 1115, 2012]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 512 then W_512 fb else
  if ℓ = 1115 then W_1115 fb else
  if ℓ = 2012 then W_2012 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof imm imm_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_512 prof fb) <|
  SpF.table (c_1115 prof fb) <|
  SpF.table (c_2012 prof fb) <|
  SpF.never ℓ

