import FV7z.Ufs.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `us2fs (const wchar_t *)` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (36, 49, 63, 94, 95; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ufs
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 36)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof ufs ufs_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 36)

def W_41 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 49)
theorem c_41 (prof : Profile) (fb : Addr) : SpF prof ufs ufs_at fb 41 (W_41 fb) :=
  SpF.blk_then (blk_41 prof) (SpF.skip 49)

def W_54 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 68 g (rfz f) V) ∧
    (f.cond 4 = false → Q 63 g (rfz f) V)
theorem c_54 (prof : Profile) (fb : Addr) : SpF prof ufs ufs_at fb 54 (W_54 fb) :=
  SpF.blk_then (blk_54 prof) (SpF.jcc_then (spj_61 prof fb) (SpF.skip 68) (SpF.skip 63))

def W_84 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 (Q 94)
theorem c_84 (prof : Profile) (fb : Addr) : SpF prof ufs ufs_at fb 84 (W_84 fb) :=
  SpF.blk_then (blk_84 prof) (SpF.skip 94)

def W_68 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o3 fb) fun g f V =>
    (f.cond 5 = true → Q 95 g (rfz f) V) ∧
    (f.cond 5 = false → W_84 fb F Wl Q g (rfz f) V)
theorem c_68 (prof : Profile) (fb : Addr) : SpF prof ufs ufs_at fb 68 (W_68 fb) :=
  SpF.blkF_then (blk_68 prof fb) (SpF.jcc_then (spj_82 prof fb) (SpF.skip 95) (c_84 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 41, 54, 68]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 41 then W_41 fb else
  if ℓ = 54 then W_54 fb else
  if ℓ = 68 then W_68 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof ufs ufs_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_41 prof fb) <|
  SpF.table (c_54 prof fb) <|
  SpF.table (c_68 prof fb) <|
  SpF.never ℓ

end FV7z.Ufs
