import FV7z.Bsg.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__bsd_signal.part.0` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (57, 75, 103, 152, 153; the `ret`). `Wt` is the table of the
cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Bsg
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 57)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof bsg bsg_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 57)

def W_60 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 75)
theorem c_60 (prof : Profile) (fb : Addr) : SpF prof bsg bsg_at fb 60 (W_60 fb) :=
  SpF.blk_then (blk_60 prof) (SpF.skip 75)

def W_80 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 103)
theorem c_80 (prof : Profile) (fb : Addr) : SpF prof bsg bsg_at fb 80 (W_80 fb) :=
  SpF.blkA_then (blk_80 prof) (SpF.skip 103)

def W_145 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 (Q 152)
theorem c_145 (prof : Profile) (fb : Addr) : SpF prof bsg bsg_at fb 145 (W_145 fb) :=
  SpF.blk_then (blk_145 prof) (SpF.skip 152)

def W_108 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o3 fb) fun g f V =>
    (f.cond 5 = true → Q 153 g (rfz f) V) ∧
    (f.cond 5 = false → W_145 fb F Wl Q g (rfz f) V)
theorem c_108 (prof : Profile) (fb : Addr) : SpF prof bsg bsg_at fb 108 (W_108 fb) :=
  SpF.blkF_then (blk_108 prof fb) (SpF.jcc_then (spj_143 prof fb) (SpF.skip 153) (c_145 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 60, 80, 108]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 60 then W_60 fb else
  if ℓ = 80 then W_80 fb else
  if ℓ = 108 then W_108 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof bsg bsg_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_60 prof fb) <|
  SpF.table (c_80 prof fb) <|
  SpF.table (c_108 prof fb) <|
  SpF.never ℓ

end FV7z.Bsg
