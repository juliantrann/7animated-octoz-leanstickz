import FV7z.Npu.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CStdOutStream::NormalizePrint_UString_Path` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (21, 32, 51; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Npu
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 21)
theorem c_0 (prof : Profile) : Sp prof npu npu_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 21)

def W_26 : Wpt := fun F Wl Q => wp F Wl o1 (Q 32)
theorem c_26 (prof : Profile) : Sp prof npu npu_at 26 W_26 := Sp.blk_then (blk_26 prof) (Sp.skip 32)

def W_37 : Wpt := fun F Wl Q => wp F Wl o2 (Q 51)
theorem c_37 (prof : Profile) : Sp prof npu npu_at 37 W_37 := Sp.blk_then (blk_37 prof) (Sp.skip 51)

/-- The cut points. -/
def cuts : List Nat := [0, 26, 37]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 26 then W_26 else
  if ℓ = 37 then W_37 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof npu npu_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_26 prof) <|
  Sp.table (c_37 prof) <|
  Sp.never ℓ

end FV7z.Npu
