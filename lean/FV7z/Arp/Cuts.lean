import FV7z.Arp.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `AString::ReverseFind_PathSepar` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (51, 58; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Arp
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_24 : Wpt := fun F Wl Q g f V =>
    Q 56 g (rfz f) V
theorem c_24 (prof : Profile) : Sp prof arp arp_at 24 W_24 :=
  Sp.jmp_then (spj_24 prof) (Sp.skip 56)

def W_11 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 41 g (rfz f) V) ∧
    (f.cond 5 = false → W_24 F Wl Q g (rfz f) V)
theorem c_11 (prof : Profile) : Sp prof arp arp_at 11 W_11 :=
  Sp.blk_then (blk_11 prof) (Sp.jcc_then (spj_22 prof) (Sp.skip 41) (c_24 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 46 g (rfz f) V) ∧
    (f.cond 4 = false → W_11 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof arp arp_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_9 prof) (Sp.skip 46) (c_11 prof))

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 56 g (rfz f) V) ∧
    (f.cond 4 = false → Q 41 g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof arp arp_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_39 prof) (Sp.skip 56) (Sp.skip 41))

def W_41 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 5 = true → W_32 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → Q 46 g (rfz f) V)
theorem c_41 (prof : Profile) : Sp prof arp arp_at 41 W_41 :=
  Sp.blk_then (blk_41 prof) (Sp.jcc_then (spj_44 prof) (c_32 prof) (Sp.skip 46))

def W_46 : Wpt := fun F Wl Q => wp F Wl o4 (Q 51)
theorem c_46 (prof : Profile) : Sp prof arp arp_at 46 W_46 := Sp.blk_then (blk_46 prof) (Sp.skip 51)

def W_56 : Wpt := fun F Wl Q => wp F Wl o5 (Q 58)
theorem c_56 (prof : Profile) : Sp prof arp arp_at 56 W_56 := Sp.blk_then (blk_56 prof) (Sp.skip 58)

/-- The cut points. -/
def cuts : List Nat := [0, 41, 46, 56]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 41 then W_41 else
  if ℓ = 46 then W_46 else
  if ℓ = 56 then W_56 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof arp arp_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_41 prof) <|
  Sp.table (c_46 prof) <|
  Sp.table (c_56 prof) <|
  Sp.never ℓ

end FV7z.Arp
