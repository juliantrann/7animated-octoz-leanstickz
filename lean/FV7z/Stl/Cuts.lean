  if ℓ = 296 then W_296 fb else
  if ℓ = 332 then W_332 fb else
  if ℓ = 345 then W_345 fb else
  if ℓ = 368 then W_368 fb else
  if ℓ = 390 then W_390 fb else
  if ℓ = 432 then W_432 fb else
  if ℓ = 448 then W_448 fb else
  if ℓ = 604 then W_604 fb else
  if ℓ = 745 then W_745 fb else
  if ℓ = 748 then W_748 fb else
  if ℓ = 790 then W_790 fb else
  if ℓ = 927 then W_927 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof stl stl_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_80 prof fb) <|
  SpF.table (c_99 prof fb) <|
  SpF.table (c_133 prof fb) <|
