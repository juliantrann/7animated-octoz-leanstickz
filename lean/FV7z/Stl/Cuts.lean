/-- The cut points. -/
def cuts : List Nat := [0, 80, 99, 133, 150, 171, 216, 223, 265, 291, 296, 332, 345, 368, 390, 432, 448, 604, 745, 748, 790, 927]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 80 then W_80 fb else
  if ℓ = 99 then W_99 fb else
  if ℓ = 133 then W_133 fb else
  if ℓ = 150 then W_150 fb else
  if ℓ = 171 then W_171 fb else
  if ℓ = 216 then W_216 fb else
  if ℓ = 223 then W_223 fb else
