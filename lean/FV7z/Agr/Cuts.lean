import FV7z.Agr.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `AString::Grow` (PLAN.md §M, M1)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (58, 70, 80, 88; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Agr
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_43 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 6 = true → Q 56 g (rfz f) V) ∧
    (f.cond 6 = false → Q 51 g (rfz f) V)
theorem c_43 (prof : Profile) : Sp prof agr agr_at 43 W_43 :=
  Sp.blk_then (blk_43 prof) (Sp.jcc_then (spj_49 prof) (Sp.skip 56) (Sp.skip 51))

def W_16 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 7 = true → Q 51 g (rfz f) V) ∧
    (f.cond 7 = false → W_43 F Wl Q g (rfz f) V)
theorem c_16 (prof : Profile) : Sp prof agr agr_at 16 W_16 :=
  Sp.blk_then (blk_16 prof) (Sp.jcc_then (spj_41 prof) (Sp.skip 51) (c_43 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 3 = true → Q 88 g (rfz f) V) ∧
    (f.cond 3 = false → W_16 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof agr agr_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_14 prof) (Sp.skip 88) (c_16 prof))

def W_51 : Wpt := fun F Wl Q => wp F Wl o3 (Q 56)
theorem c_51 (prof : Profile) : Sp prof agr agr_at 51 W_51 := Sp.blk_then (blk_51 prof) (Sp.skip 56)

def W_56 : Wpt := fun F Wl Q => wp F Wl o4 (Q 58)
theorem c_56 (prof : Profile) : Sp prof agr agr_at 56 W_56 := Sp.blk_then (blk_56 prof) (Sp.skip 58)

def W_64 : Wpt := fun F Wl Q => wp F Wl o5 (Q 70)
theorem c_64 (prof : Profile) : Sp prof agr agr_at 64 W_64 := Sp.blk_then (blk_64 prof) (Sp.skip 70)

def W_76 : Wpt := fun F Wl Q => wp F Wl o6 (Q 80)
theorem c_76 (prof : Profile) : Sp prof agr agr_at 76 W_76 := Sp.blk_then (blk_76 prof) (Sp.skip 80)

/-- The cut points. -/
def cuts : List Nat := [0, 51, 56, 64, 76]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 51 then W_51 else
  if ℓ = 56 then W_56 else
  if ℓ = 64 then W_64 else
  if ℓ = 76 then W_76 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof agr agr_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_51 prof) <|
  Sp.table (c_56 prof) <|
  Sp.table (c_64 prof) <|
  Sp.table (c_76 prof) <|
  Sp.never ℓ

end FV7z.Agr
