import FV7z.Mun.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__munmap` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (9, 19, 36; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Mun
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o0 (Q 9)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof mun mun_at fb 0 (W_0 fb) :=
  SpF.blk_then (blk_0 prof) (SpF.skip 9)

def W_20 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o2 fb) (Q 36)
theorem c_20 (prof : Profile) (fb : Addr) : SpF prof mun mun_at fb 20 (W_20 fb) :=
  SpF.blkF_then (blk_20 prof fb) (SpF.skip 36)

def W_11 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 3 = true → W_20 fb F Wl Q g (rfz f) V) ∧
    (f.cond 3 = false → Q 19 g (rfz f) V)
theorem c_11 (prof : Profile) (fb : Addr) : SpF prof mun mun_at fb 11 (W_11 fb) :=
  SpF.blk_then (blk_11 prof) (SpF.jcc_then (spj_17 prof fb) (c_20 prof fb) (SpF.skip 19))

/-- The cut points. -/
def cuts : List Nat := [0, 11]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 11 then W_11 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof mun mun_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_11 prof fb) <|
  SpF.never ℓ

end FV7z.Mun
