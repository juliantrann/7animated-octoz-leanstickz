def cuts : List Nat := [0, 48, 80, 102, 115, 119, 129, 139, 157, 170, 185, 200, 224, 247, 260, 265, 275]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 48 then W_48 else
  if ℓ = 80 then W_80 else
  if ℓ = 102 then W_102 else
  if ℓ = 115 then W_115 else
