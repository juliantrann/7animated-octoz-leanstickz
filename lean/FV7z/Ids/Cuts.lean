import FV7z.Ids.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NWindows::NFile::NFind::CDirEntry::IsDots() const` (PLAN.md §M, M1)

The 1 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (23, 58; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ids
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_51 : Wpt := fun F Wl Q => wp F Wl o4 (Q 58)
theorem c_51 (prof : Profile) : Sp prof ids ids_at 51 W_51 := Sp.blk_then (blk_51 prof) (Sp.skip 58)

def W_41 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 23 g (rfz f) V) ∧
    (f.cond 4 = false → W_51 F Wl Q g (rfz f) V)
theorem c_41 (prof : Profile) : Sp prof ids ids_at 41 W_41 :=
  Sp.blk_then (blk_41 prof) (Sp.jcc_then (spj_49 prof) (Sp.skip 23) (c_51 prof))

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 23 g (rfz f) V) ∧
    (f.cond 5 = false → W_41 F Wl Q g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof ids ids_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_39 prof) (Sp.skip 23) (c_41 prof))

def W_12 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 6 = true → W_32 F Wl Q g (rfz f) V) ∧
    (f.cond 6 = false → Q 23 g (rfz f) V)
theorem c_12 (prof : Profile) : Sp prof ids ids_at 12 W_12 :=
  Sp.blk_then (blk_12 prof) (Sp.jcc_then (spj_21 prof) (c_32 prof) (Sp.skip 23))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → Q 23 g (rfz f) V) ∧
    (f.cond 5 = false → W_12 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof ids ids_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_10 prof) (Sp.skip 23) (c_12 prof))

/-- The cut points. -/
def cuts : List Nat := [0]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ids ids_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.never ℓ

end FV7z.Ids
