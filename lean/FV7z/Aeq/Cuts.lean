def cuts : List Nat := [0, 24, 45, 56, 88, 109, 128, 184, 232, 280, 328]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 24 then W_24 else
  if ℓ = 45 then W_45 else
  if ℓ = 56 then W_56 else
  if ℓ = 88 then W_88 else
  if ℓ = 109 then W_109 else
  if ℓ = 128 then W_128 else
  if ℓ = 184 then W_184 else
  if ℓ = 232 then W_232 else
  if ℓ = 280 then W_280 else
  if ℓ = 328 then W_328 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof aeq aeq_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_24 prof) <|
  Sp.table (c_45 prof) <|
  Sp.table (c_56 prof) <|
  Sp.table (c_88 prof) <|
  Sp.table (c_109 prof) <|
  Sp.table (c_128 prof) <|
  Sp.table (c_184 prof) <|
  Sp.table (c_232 prof) <|
  Sp.table (c_280 prof) <|
  Sp.table (c_328 prof) <|
  Sp.never ℓ

