import FV7z.Sdp.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__strdup` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (14, 26, 52, 63; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Sdp
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 14)
theorem c_0 (prof : Profile) : Sp prof sdp sdp_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 14)

def W_19 : Wpt := fun F Wl Q => wp F Wl o1 (Q 26)
theorem c_19 (prof : Profile) : Sp prof sdp sdp_at 19 W_19 := Sp.blk_then (blk_19 prof) (Sp.skip 26)

def W_57 : Wpt := fun F Wl Q => wp F Wl o4 (Q 63)
theorem c_57 (prof : Profile) : Sp prof sdp sdp_at 57 W_57 := Sp.blk_then (blk_57 prof) (Sp.skip 63)

def W_36 : Wpt := fun F Wl Q => wp F Wl o3 (Q 52)
theorem c_36 (prof : Profile) : Sp prof sdp sdp_at 36 W_36 := Sp.blk_then (blk_36 prof) (Sp.skip 52)

def W_31 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → W_57 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_36 F Wl Q g (rfz f) V)
theorem c_31 (prof : Profile) : Sp prof sdp sdp_at 31 W_31 :=
  Sp.blk_then (blk_31 prof) (Sp.jcc_then (spj_34 prof) (c_57 prof) (c_36 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 19, 31]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 19 then W_19 else
  if ℓ = 31 then W_31 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof sdp sdp_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_19 prof) <|
  Sp.table (c_31 prof) <|
  Sp.never ℓ

end FV7z.Sdp
