import FV7z.Sis.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NCompress::NLzma::CDecoder::SetInStream` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (27, 45, 63; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Sis
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_21 : Wpt := fun F Wl Q => wp F Wl o1 (Q 27)
theorem c_21 (prof : Profile) : Sp prof sis sis_at 21 W_21 := Sp.blk_then (blk_21 prof) (Sp.skip 27)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 30 g (rfz f) V) ∧
    (f.cond 4 = false → W_21 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof sis sis_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_19 prof) (Sp.skip 30) (c_21 prof))

def W_42 : Wpt := fun F Wl Q => wp F Wl o3 (Q 45)
theorem c_42 (prof : Profile) : Sp prof sis sis_at 42 W_42 := Sp.blk_then (blk_42 prof) (Sp.skip 45)

def W_30 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 48 g (rfz f) V) ∧
    (f.cond 4 = false → W_42 F Wl Q g (rfz f) V)
theorem c_30 (prof : Profile) : Sp prof sis sis_at 30 W_30 :=
  Sp.blk_then (blk_30 prof) (Sp.jcc_then (spj_40 prof) (Sp.skip 48) (c_42 prof))

def W_48 : Wpt := fun F Wl Q => wp F Wl o4 (Q 63)
theorem c_48 (prof : Profile) : Sp prof sis sis_at 48 W_48 := Sp.blk_then (blk_48 prof) (Sp.skip 63)

/-- The cut points. -/
def cuts : List Nat := [0, 30, 48]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 30 then W_30 else
  if ℓ = 48 then W_48 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof sis sis_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_30 prof) <|
  Sp.table (c_48 prof) <|
  Sp.never ℓ

end FV7z.Sis
