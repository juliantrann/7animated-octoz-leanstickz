import FV7z.Ocf.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `COpenCallbackConsole::Open_Finished` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (30, 41, 50; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ocf
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_17 : Wpt := fun F Wl Q => wp F Wl o2 (Q 30)
theorem c_17 (prof : Profile) : Sp prof ocf ocf_at 17 W_17 := Sp.blk_then (blk_17 prof) (Sp.skip 30)

def W_11 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 48 g (rfz f) V) ∧
    (f.cond 5 = false → W_17 F Wl Q g (rfz f) V)
theorem c_11 (prof : Profile) : Sp prof ocf ocf_at 11 W_11 :=
  Sp.blk_then (blk_11 prof) (Sp.jcc_then (spj_15 prof) (Sp.skip 48) (c_17 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 48 g (rfz f) V) ∧
    (f.cond 4 = false → W_11 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof ocf ocf_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_9 prof) (Sp.skip 48) (c_11 prof))

def W_35 : Wpt := fun F Wl Q => wp F Wl o3 (Q 41)
theorem c_35 (prof : Profile) : Sp prof ocf ocf_at 35 W_35 := Sp.blk_then (blk_35 prof) (Sp.skip 41)

def W_48 : Wpt := fun F Wl Q => wp F Wl o4 (Q 50)
theorem c_48 (prof : Profile) : Sp prof ocf ocf_at 48 W_48 := Sp.blk_then (blk_48 prof) (Sp.skip 50)

/-- The cut points. -/
def cuts : List Nat := [0, 35, 48]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 35 then W_35 else
  if ℓ = 48 then W_48 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ocf ocf_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_35 prof) <|
  Sp.table (c_48 prof) <|
  Sp.never ℓ

end FV7z.Ocf
