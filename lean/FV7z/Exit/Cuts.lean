import FV7z.Exit.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `_Exit` (PLAN.md §M, M1)

The 1 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (36, 52, 54; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Exit
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_47 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 52)
theorem c_47 (prof : Profile) (fb : Addr) : SpF prof ext ext_at fb 47 (W_47 fb) :=
  SpF.blk_then (blk_47 prof) (SpF.skip 52)

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    W_47 fb F Wl Q g (rfz f) V
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof ext ext_at fb 0 (W_0 fb) :=
  SpF.blk_then (blk_0 prof) (SpF.jmp_then (spj_24 prof fb) (c_47 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof ext ext_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.never ℓ

end FV7z.Exit
