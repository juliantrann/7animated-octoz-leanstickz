import FV7z.Utr.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UString::TrimRight` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (69; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Utr
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_16 : Wpt := fun F Wl Q => wp F Wl o1 (Q 32)
theorem c_16 (prof : Profile) : Sp prof utr utr_at 16 W_16 := Sp.blk_then (blk_16 prof) (Sp.skip 32)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 69 g (rfz f) V) ∧
    (f.cond 4 = false → W_16 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof utr utr_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_14 prof) (Sp.skip 69) (c_16 prof))

def W_85 : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    Q 59 g (rfz f) V
theorem c_85 (prof : Profile) : Sp prof utr utr_at 85 W_85 :=
  Sp.blk_then (blk_85 prof) (Sp.jmp_then (spj_88 prof) (Sp.skip 59))

def W_80 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    (f.cond 4 = true → Q 69 g (rfz f) V) ∧
    (f.cond 4 = false → W_85 F Wl Q g (rfz f) V)
theorem c_80 (prof : Profile) : Sp prof utr utr_at 80 W_80 :=
  Sp.blk_then (blk_80 prof) (Sp.jcc_then (spj_83 prof) (Sp.skip 69) (c_85 prof))

def W_45 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 5 = true → W_80 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → Q 50 g (rfz f) V)
theorem c_45 (prof : Profile) : Sp prof utr utr_at 45 W_45 :=
  Sp.blk_then (blk_45 prof) (Sp.jcc_then (spj_48 prof) (c_80 prof) (Sp.skip 50))

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 6 = true → Q 50 g (rfz f) V) ∧
    (f.cond 6 = false → W_45 F Wl Q g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof utr utr_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_43 prof) (Sp.skip 50) (c_45 prof))

def W_50 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 5 = true → Q 32 g (rfz f) V) ∧
    (f.cond 5 = false → Q 59 g (rfz f) V)
theorem c_50 (prof : Profile) : Sp prof utr utr_at 50 W_50 :=
  Sp.blk_then (blk_50 prof) (Sp.jcc_then (spj_57 prof) (Sp.skip 32) (Sp.skip 59))

def W_59 : Wpt := fun F Wl Q => wp F Wl o5 (Q 69)
theorem c_59 (prof : Profile) : Sp prof utr utr_at 59 W_59 := Sp.blk_then (blk_59 prof) (Sp.skip 69)

/-- The cut points. -/
def cuts : List Nat := [0, 32, 50, 59]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 32 then W_32 else
  if ℓ = 50 then W_50 else
  if ℓ = 59 then W_59 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof utr utr_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_32 prof) <|
  Sp.table (c_50 prof) <|
  Sp.table (c_59 prof) <|
  Sp.never ℓ

end FV7z.Utr
