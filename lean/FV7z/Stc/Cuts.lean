import FV7z.Stc.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NWindows::NFile::NIO::CFileBase::seekToCur` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (15, 24; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Stc
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 15)
theorem c_0 (prof : Profile) : Sp prof stc stc_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 15)

def W_20 : Wpt := fun F Wl Q => wp F Wl o1 (Q 24)
theorem c_20 (prof : Profile) : Sp prof stc stc_at 20 W_20 := Sp.blk_then (blk_20 prof) (Sp.skip 24)

/-- The cut points. -/
def cuts : List Nat := [0, 20]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 20 then W_20 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof stc stc_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_20 prof) <|
  Sp.never ℓ

end FV7z.Stc
