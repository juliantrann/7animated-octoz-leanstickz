  if ℓ = 298 then W_298 else
  if ℓ = 309 then W_309 else
  if ℓ = 355 then W_355 else
  if ℓ = 373 then W_373 else
  if ℓ = 393 then W_393 else
  if ℓ = 432 then W_432 else
  if ℓ = 462 then W_462 else
  if ℓ = 475 then W_475 else
  if ℓ = 500 then W_500 else
  if ℓ = 508 then W_508 else
  if ℓ = 533 then W_533 else
  if ℓ = 538 then W_538 else
  if ℓ = 544 then W_544 else
  if ℓ = 589 then W_589 else
  if ℓ = 631 then W_631 else
  if ℓ = 640 then W_640 else
  if ℓ = 647 then W_647 else
  fun _ _ _ _ _ _ => False

