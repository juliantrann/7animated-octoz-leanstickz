import FV7z.Pco.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `_pthread_cleanup_pop` (PLAN.md §M, M1)

The 1 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (31, 40; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Pco
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_21 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 31)
theorem c_21 (prof : Profile) (fb : Addr) : SpF prof pco pco_at fb 21 (W_21 fb) :=
  SpF.blk_then (blk_21 prof) (SpF.skip 31)

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) fun g f V =>
    (f.cond 4 = true → Q 40 g (rfz f) V) ∧
    (f.cond 4 = false → W_21 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof pco pco_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.jcc_then (spj_19 prof fb) (SpF.skip 40) (c_21 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof pco pco_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.never ℓ

end FV7z.Pco
