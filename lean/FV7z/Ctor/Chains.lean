/-- Each constructor of `chains`: the entry of `.init_array` its number says, its prologue and its calls. -/
theorem chain_at (prof : Profile) : ∀ x ∈ chains, csuTg x.1 = sti_at.add x.2.1 ∧
    BlkA prof sti sti_at x.2.1 (x.2.1 + 8) [Op.nop, Op.sub 64 4 (.i 8)] ∧ CallsAt prof (x.2.1 + 8) x.2.2 := by
  intro x hx
  simp only [chains, List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact ⟨by decide +kernel, pb160 prof, cs160 prof⟩
  · exact ⟨by decide +kernel, pb656 prof, cs656 prof⟩
  · exact ⟨by decide +kernel, pb784 prof, cs784 prof⟩
  · exact ⟨by decide +kernel, pb928 prof, cs928 prof⟩
  · exact ⟨by decide +kernel, pb976 prof, cs976 prof⟩
  · exact ⟨by decide +kernel, pb1264 prof, cs1264 prof⟩
  · exact ⟨by decide +kernel, pb1680 prof, cs1680 prof⟩
  · exact ⟨by decide +kernel, pb2416 prof, cs2416 prof⟩

