import FV7z.Dde.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NWindows::NFile::NFind::DoesDirExist` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (37, 95, 96; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Dde
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 37)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof dde dde_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 37)

def W_52 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 69)
theorem c_52 (prof : Profile) (fb : Addr) : SpF prof dde dde_at fb 52 (W_52 fb) :=
  SpF.blk_then (blk_52 prof) (SpF.skip 69)

def W_42 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 69 g (rfz f) V) ∧
    (f.cond 5 = false → W_52 fb F Wl Q g (rfz f) V)
theorem c_42 (prof : Profile) (fb : Addr) : SpF prof dde dde_at fb 42 (W_42 fb) :=
  SpF.blk_then (blk_42 prof) (SpF.jcc_then (spj_50 prof fb) (SpF.skip 69) (c_52 prof fb))

def W_88 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 (Q 95)
theorem c_88 (prof : Profile) (fb : Addr) : SpF prof dde dde_at fb 88 (W_88 fb) :=
  SpF.blk_then (blk_88 prof) (SpF.skip 95)

def W_69 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o3 fb) fun g f V =>
    (f.cond 5 = true → Q 96 g (rfz f) V) ∧
    (f.cond 5 = false → W_88 fb F Wl Q g (rfz f) V)
theorem c_69 (prof : Profile) (fb : Addr) : SpF prof dde dde_at fb 69 (W_69 fb) :=
  SpF.blkF_then (blk_69 prof fb) (SpF.jcc_then (spj_86 prof fb) (SpF.skip 96) (c_88 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 42, 69]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 42 then W_42 fb else
  if ℓ = 69 then W_69 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof dde dde_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_42 prof fb) <|
  SpF.table (c_69 prof fb) <|
  SpF.never ℓ

end FV7z.Dde
