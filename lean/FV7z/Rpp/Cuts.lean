import FV7z.Rpp.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UString::ReverseFind_PathSepar` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (35, 47; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Rpp
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    Q 25 g (rfz f) V
theorem c_0 (prof : Profile) : Sp prof rpp rpp_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jmp_then (spj_14 prof) (Sp.skip 25))

def W_40 : Wpt := fun F Wl Q => wp F Wl o4 (Q 47)
theorem c_40 (prof : Profile) : Sp prof rpp rpp_at 40 W_40 := Sp.blk_then (blk_40 prof) (Sp.skip 47)

def W_16 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → W_40 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 25 g (rfz f) V)
theorem c_16 (prof : Profile) : Sp prof rpp rpp_at 16 W_16 :=
  Sp.blk_then (blk_16 prof) (Sp.jcc_then (spj_23 prof) (c_40 prof) (Sp.skip 25))

def W_30 : Wpt := fun F Wl Q => wp F Wl o3 (Q 35)
theorem c_30 (prof : Profile) : Sp prof rpp rpp_at 30 W_30 := Sp.blk_then (blk_30 prof) (Sp.skip 35)

def W_25 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → W_16 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → W_30 F Wl Q g (rfz f) V)
theorem c_25 (prof : Profile) : Sp prof rpp rpp_at 25 W_25 :=
  Sp.blk_then (blk_25 prof) (Sp.jcc_then (spj_28 prof) (c_16 prof) (c_30 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 25]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 25 then W_25 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof rpp rpp_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_25 prof) <|
  Sp.never ℓ

end FV7z.Rpp
