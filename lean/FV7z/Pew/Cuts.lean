/-- The cut points. -/
def cuts : List Nat := [0, 64, 79, 87, 126, 141, 168, 183, 195, 206, 214, 228, 264, 279]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 64 then W_64 fb else
  if ℓ = 79 then W_79 fb else
  if ℓ = 87 then W_87 fb else
  if ℓ = 126 then W_126 fb else
  if ℓ = 141 then W_141 fb else
  if ℓ = 168 then W_168 fb else
  if ℓ = 183 then W_183 fb else
  if ℓ = 195 then W_195 fb else
  if ℓ = 206 then W_206 fb else
  if ℓ = 214 then W_214 fb else
  if ℓ = 228 then W_228 fb else
  if ℓ = 264 then W_264 fb else
  if ℓ = 279 then W_279 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof pew pew_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_64 prof fb) <|
  SpF.table (c_79 prof fb) <|
  SpF.table (c_87 prof fb) <|
  SpF.table (c_126 prof fb) <|
  SpF.table (c_141 prof fb) <|
  SpF.table (c_168 prof fb) <|
  SpF.table (c_183 prof fb) <|
  SpF.table (c_195 prof fb) <|
  SpF.table (c_206 prof fb) <|
  SpF.table (c_214 prof fb) <|
  SpF.table (c_228 prof fb) <|
  SpF.table (c_264 prof fb) <|
  SpF.table (c_279 prof fb) <|
  SpF.never ℓ

