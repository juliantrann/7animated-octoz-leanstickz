/-- The cut points. -/
def cuts : List Nat := [0, 48, 86, 146, 164, 208]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 48 then W_48 else
  if ℓ = 86 then W_86 else
  if ℓ = 146 then W_146 else
  if ℓ = 164 then W_164 else
  if ℓ = 208 then W_208 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof nef nef_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_48 prof) <|
  Sp.table (c_86 prof) <|
  Sp.table (c_146 prof) <|
  Sp.table (c_164 prof) <|
  Sp.table (c_208 prof) <|
  Sp.never ℓ

