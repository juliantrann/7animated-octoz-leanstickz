import FV7z.Ffl.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__fortify_fail` (PLAN.md §M, M1)

The 1 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (37; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ffl
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_24 : Wpt := fun F Wl Q => wp F Wl o1 (Q 37)
theorem c_24 (prof : Profile) : Sp prof ffl ffl_at 24 W_24 := Sp.blk_then (blk_24 prof) (Sp.skip 37)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (W_24 F Wl Q)
theorem c_0 (prof : Profile) : Sp prof ffl ffl_at 0 W_0 := Sp.blkA_then (blk_0 prof) (c_24 prof)

/-- The cut points. -/
def cuts : List Nat := [0]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ffl ffl_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.never ℓ

end FV7z.Ffl
