import FV7z.C70.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `csuTg 70` (PLAN.md G3, constructors)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (1514; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.C70
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf
open FV7z.Ctor (sti sti_at sti_length)

def W_1440 : Wpt := fun F Wl Q => wp F Wl o0 (Q 1464)
theorem c_1440 (prof : Profile) : Sp prof sti sti_at 1440 W_1440 := Sp.blkA_then (blk_1440 prof) (Sp.skip 1464)

def W_1464 : Wpt := fun F Wl Q => wp F Wl o1 (Q 1472)
theorem c_1464 (prof : Profile) : Sp prof sti sti_at 1464 W_1464 := Sp.blk_then (blk_1464 prof) (Sp.skip 1472)

def W_1496 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 5 = true → Q 1464 g (rfz f) V) ∧
    (f.cond 5 = false → Q 1514 g (rfz f) V)
theorem c_1496 (prof : Profile) : Sp prof sti sti_at 1496 W_1496 :=
  Sp.blk_then (blk_1496 prof) (Sp.jcc_then (spj_1512 prof) (Sp.skip 1464) (Sp.skip 1514))

def W_1472 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 1472 g (rfz f) V) ∧
    (f.cond 5 = false → W_1496 F Wl Q g (rfz f) V)
theorem c_1472 (prof : Profile) : Sp prof sti sti_at 1472 W_1472 :=
  Sp.blk_then (blk_1472 prof) (Sp.jcc_then (spj_1494 prof) (Sp.skip 1472) (c_1496 prof))

/-- The cut points. -/
def cuts : List Nat := [1440, 1464, 1472]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 1440 then W_1440 else
  if ℓ = 1464 then W_1464 else
  if ℓ = 1472 then W_1472 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof sti sti_at ℓ (Wt ℓ) :=
  Sp.table (c_1440 prof) <|
  Sp.table (c_1464 prof) <|
  Sp.table (c_1472 prof) <|
  Sp.never ℓ

end FV7z.C70
