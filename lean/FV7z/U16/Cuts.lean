def cuts : List Nat := [0, 109, 116, 125, 141, 174, 192, 201, 209, 272, 295, 299, 312, 392, 409, 413, 492]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 109 then W_109 else
  if ℓ = 116 then W_116 else
  if ℓ = 125 then W_125 else
  if ℓ = 141 then W_141 else
  if ℓ = 174 then W_174 else
  if ℓ = 192 then W_192 else
  if ℓ = 201 then W_201 else
  if ℓ = 209 then W_209 else
  if ℓ = 272 then W_272 else
  if ℓ = 295 then W_295 else
  if ℓ = 299 then W_299 else
  if ℓ = 312 then W_312 else
  if ℓ = 392 then W_392 else
  if ℓ = 409 then W_409 else
  if ℓ = 413 then W_413 else
  if ℓ = 492 then W_492 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof u16 u16_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_109 prof) <|
  Sp.table (c_116 prof) <|
  Sp.table (c_125 prof) <|
  Sp.table (c_141 prof) <|
  Sp.table (c_174 prof) <|
  Sp.table (c_192 prof) <|
  Sp.table (c_201 prof) <|
  Sp.table (c_209 prof) <|
  Sp.table (c_272 prof) <|
  Sp.table (c_295 prof) <|
  Sp.table (c_299 prof) <|
  Sp.table (c_312 prof) <|
  Sp.table (c_392 prof) <|
  Sp.table (c_409 prof) <|
  Sp.table (c_413 prof) <|
  Sp.table (c_492 prof) <|
