import FV7z.U2s.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `ConvertUInt32ToString` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (66, 178; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.U2s
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_72 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 (Q 88)
theorem c_72 (prof : Profile) (fb : Addr) : SpF prof u2s u2s_at fb 72 (W_72 fb) :=
  SpF.blk_then (blk_72 prof) (SpF.skip 88)

def W_33 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 39)
theorem c_33 (prof : Profile) (fb : Addr) : SpF prof u2s u2s_at fb 33 (W_33 fb) :=
  SpF.blk_then (blk_33 prof) (SpF.skip 39)

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) fun g f V =>
    (f.cond 7 = true → W_72 fb F Wl Q g (rfz f) V) ∧
    (f.cond 7 = false → W_33 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof u2s u2s_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.jcc_then (spj_31 prof fb) (c_72 prof fb) (c_33 prof fb))

def W_59 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 66)
theorem c_59 (prof : Profile) (fb : Addr) : SpF prof u2s u2s_at fb 59 (W_59 fb) :=
  SpF.blk_then (blk_59 prof) (SpF.skip 66)

def W_39 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o2 fb) fun g f V =>
    (f.cond 5 = true → Q 178 g (rfz f) V) ∧
    (f.cond 5 = false → W_59 fb F Wl Q g (rfz f) V)
theorem c_39 (prof : Profile) (fb : Addr) : SpF prof u2s u2s_at fb 39 (W_39 fb) :=
  SpF.blkF_then (blk_39 prof fb) (SpF.jcc_then (spj_57 prof fb) (SpF.skip 178) (c_59 prof fb))

def W_134 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    Q 155 g (rfz f) V
theorem c_134 (prof : Profile) (fb : Addr) : SpF prof u2s u2s_at fb 134 (W_134 fb) :=
  SpF.blk_then (blk_134 prof) (SpF.jmp_then (spj_147 prof fb) (SpF.skip 155))

def W_88 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 7 = true → Q 88 g (rfz f) V) ∧
    (f.cond 7 = false → W_134 fb F Wl Q g (rfz f) V)
theorem c_88 (prof : Profile) (fb : Addr) : SpF prof u2s u2s_at fb 88 (W_88 fb) :=
  SpF.blk_then (blk_88 prof) (SpF.jcc_then (spj_132 prof fb) (SpF.skip 88) (c_134 prof fb))

def W_152 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o7 (Q 155)
theorem c_152 (prof : Profile) (fb : Addr) : SpF prof u2s u2s_at fb 152 (W_152 fb) :=
  SpF.blk_then (blk_152 prof) (SpF.skip 155)

def W_170 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o9 fun g f V =>
    Q 39 g (rfz f) V
theorem c_170 (prof : Profile) (fb : Addr) : SpF prof u2s u2s_at fb 170 (W_170 fb) :=
  SpF.blk_then (blk_170 prof) (SpF.jmp_then (spj_173 prof fb) (SpF.skip 39))

def W_155 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    (f.cond 5 = true → W_152 fb F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → W_170 fb F Wl Q g (rfz f) V)
theorem c_155 (prof : Profile) (fb : Addr) : SpF prof u2s u2s_at fb 155 (W_155 fb) :=
  SpF.blk_then (blk_155 prof) (SpF.jcc_then (spj_168 prof fb) (c_152 prof fb) (c_170 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 39, 88, 155]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 39 then W_39 fb else
  if ℓ = 88 then W_88 fb else
  if ℓ = 155 then W_155 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof u2s u2s_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_39 prof fb) <|
  SpF.table (c_88 prof fb) <|
  SpF.table (c_155 prof fb) <|
  SpF.never ℓ

end FV7z.U2s
