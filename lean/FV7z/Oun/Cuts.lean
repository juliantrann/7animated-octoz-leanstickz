import FV7z.Oun.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CStdOutStream::operator<< (unsigned)` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (38, 50, 81, 82; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Oun
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 38)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof oun oun_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 38)

def W_43 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 50)
theorem c_43 (prof : Profile) (fb : Addr) : SpF prof oun oun_at fb 43 (W_43 fb) :=
  SpF.blk_then (blk_43 prof) (SpF.skip 50)

def W_71 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 81)
theorem c_71 (prof : Profile) (fb : Addr) : SpF prof oun oun_at fb 71 (W_71 fb) :=
  SpF.blk_then (blk_71 prof) (SpF.skip 81)

def W_55 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o2 fb) fun g f V =>
    (f.cond 5 = true → Q 82 g (rfz f) V) ∧
    (f.cond 5 = false → W_71 fb F Wl Q g (rfz f) V)
theorem c_55 (prof : Profile) (fb : Addr) : SpF prof oun oun_at fb 55 (W_55 fb) :=
  SpF.blkF_then (blk_55 prof fb) (SpF.jcc_then (spj_69 prof fb) (SpF.skip 82) (c_71 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 43, 55]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 43 then W_43 fb else
  if ℓ = 55 then W_55 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof oun oun_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_43 prof fb) <|
  SpF.table (c_55 prof fb) <|
  SpF.never ℓ

end FV7z.Oun
