import FV7z.Sos.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NCompress::NLzma::CDecoder::SetOutStreamSizeResume` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (15, 47; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Sos
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 15)
theorem c_0 (prof : Profile) : Sp prof sos sos_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 15)

def W_21 : Wpt := fun F Wl Q => wp F Wl o1 (Q 28)
theorem c_21 (prof : Profile) : Sp prof sos sos_at 21 W_21 := Sp.blk_then (blk_21 prof) (Sp.skip 28)

def W_19 : Wpt := fun F Wl Q g f V =>
    (f.cond 4 = true → Q 28 g (rfz f) V) ∧
    (f.cond 4 = false → W_21 F Wl Q g (rfz f) V)
theorem c_19 (prof : Profile) : Sp prof sos sos_at 19 W_19 :=
  Sp.jcc_then (spj_19 prof) (Sp.skip 28) (c_21 prof)

def W_28 : Wpt := fun F Wl Q => wp F Wl o2 (Q 47)
theorem c_28 (prof : Profile) : Sp prof sos sos_at 28 W_28 := Sp.blk_then (blk_28 prof) (Sp.skip 47)

/-- The cut points. -/
def cuts : List Nat := [0, 19, 28]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 19 then W_19 else
  if ℓ = 28 then W_28 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof sos sos_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_19 prof) <|
  Sp.table (c_28 prof) <|
  Sp.never ℓ

end FV7z.Sos
