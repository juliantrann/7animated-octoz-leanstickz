import FV7z.Ucw.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UString::UString(const wchar_t*)` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (55, 73; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ucw
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_80 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    Q 52 g (rfz f) V
theorem c_80 (prof : Profile) : Sp prof ucw ucw_at 80 W_80 :=
  Sp.blk_then (blk_80 prof) (Sp.jmp_then (spj_88 prof) (Sp.skip 52))

def W_20 : Wpt := fun F Wl Q => wp F Wl o1 (Q 32)
theorem c_20 (prof : Profile) : Sp prof ucw ucw_at 20 W_20 := Sp.blk_then (blk_20 prof) (Sp.skip 32)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → W_80 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_20 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof ucw ucw_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_18 prof) (c_80 prof) (c_20 prof))

def W_48 : Wpt := fun F Wl Q => wp F Wl o3 (Q 52)
theorem c_48 (prof : Profile) : Sp prof ucw ucw_at 48 W_48 := Sp.blk_then (blk_48 prof) (Sp.skip 52)

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 32 g (rfz f) V) ∧
    (f.cond 5 = false → W_48 F Wl Q g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof ucw ucw_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_46 prof) (Sp.skip 32) (c_48 prof))

def W_52 : Wpt := fun F Wl Q => wp F Wl o4 (Q 55)
theorem c_52 (prof : Profile) : Sp prof ucw ucw_at 52 W_52 := Sp.blk_then (blk_52 prof) (Sp.skip 55)

def W_60 : Wpt := fun F Wl Q => wp F Wl o5 (Q 73)
theorem c_60 (prof : Profile) : Sp prof ucw ucw_at 60 W_60 := Sp.blk_then (blk_60 prof) (Sp.skip 73)

/-- The cut points. -/
def cuts : List Nat := [0, 32, 52, 60]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 32 then W_32 else
  if ℓ = 52 then W_52 else
  if ℓ = 60 then W_60 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ucw ucw_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_32 prof) <|
  Sp.table (c_52 prof) <|
  Sp.table (c_60 prof) <|
  Sp.never ℓ

end FV7z.Ucw
