import FV7z.Aui.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `AString::Add_UInt32` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (20, 33, 50; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Aui
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 20)
theorem c_0 (prof : Profile) : Sp prof aui aui_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 20)

def W_25 : Wpt := fun F Wl Q => wp F Wl o1 (Q 33)
theorem c_25 (prof : Profile) : Sp prof aui aui_at 25 W_25 := Sp.blk_then (blk_25 prof) (Sp.skip 33)

def W_38 : Wpt := fun F Wl Q => wp F Wl o2 (Q 50)
theorem c_38 (prof : Profile) : Sp prof aui aui_at 38 W_38 := Sp.blk_then (blk_38 prof) (Sp.skip 50)

/-- The cut points. -/
def cuts : List Nat := [0, 25, 38]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 25 then W_25 else
  if ℓ = 38 then W_38 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof aui aui_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_25 prof) <|
  Sp.table (c_38 prof) <|
  Sp.never ℓ

end FV7z.Aui
