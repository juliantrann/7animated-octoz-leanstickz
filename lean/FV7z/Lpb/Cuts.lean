import FV7z.Lpb.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `LzmaDec_AllocateProbs` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (36, 68, 87, 105; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Lpb
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 36)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof lpb lpb_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 36)

def W_72 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 (Q 87)
theorem c_72 (prof : Profile) (fb : Addr) : SpF prof lpb lpb_at fb 72 (W_72 fb) :=
  SpF.blk_then (blk_72 prof) (SpF.skip 87)

def W_41 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → W_72 fb F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 45 g (rfz f) V)
theorem c_41 (prof : Profile) (fb : Addr) : SpF prof lpb lpb_at fb 41 (W_41 fb) :=
  SpF.blk_then (blk_41 prof) (SpF.jcc_then (spj_43 prof fb) (c_72 prof fb) (SpF.skip 45))

def W_61 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 68)
theorem c_61 (prof : Profile) (fb : Addr) : SpF prof lpb lpb_at fb 61 (W_61 fb) :=
  SpF.blk_then (blk_61 prof) (SpF.skip 68)

def W_45 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o2 fb) fun g f V =>
    (f.cond 5 = true → Q 105 g (rfz f) V) ∧
    (f.cond 5 = false → W_61 fb F Wl Q g (rfz f) V)
theorem c_45 (prof : Profile) (fb : Addr) : SpF prof lpb lpb_at fb 45 (W_45 fb) :=
  SpF.blkF_then (blk_45 prof fb) (SpF.jcc_then (spj_59 prof fb) (SpF.skip 105) (c_61 prof fb))

def W_96 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    Q 45 g (rfz f) V
theorem c_96 (prof : Profile) (fb : Addr) : SpF prof lpb lpb_at fb 96 (W_96 fb) :=
  SpF.blk_then (blk_96 prof) (SpF.jmp_then (spj_103 prof fb) (SpF.skip 45))

def W_92 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 45 g (rfz f) V) ∧
    (f.cond 5 = false → W_96 fb F Wl Q g (rfz f) V)
theorem c_92 (prof : Profile) (fb : Addr) : SpF prof lpb lpb_at fb 92 (W_92 fb) :=
  SpF.blk_then (blk_92 prof) (SpF.jcc_then (spj_94 prof fb) (SpF.skip 45) (c_96 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 41, 45, 92]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 41 then W_41 fb else
  if ℓ = 45 then W_45 fb else
  if ℓ = 92 then W_92 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof lpb lpb_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_41 prof fb) <|
  SpF.table (c_45 prof fb) <|
  SpF.table (c_92 prof fb) <|
  SpF.never ℓ

end FV7z.Lpb
