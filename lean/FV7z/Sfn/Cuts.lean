/-- The cut points. -/
def cuts : List Nat := [0, 66, 79, 106, 114, 144, 208, 287, 325, 345, 361, 384, 400, 449, 520, 558, 578, 594]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 66 then W_66 fb else
  if ℓ = 79 then W_79 fb else
  if ℓ = 106 then W_106 fb else
  if ℓ = 114 then W_114 fb else
  if ℓ = 144 then W_144 fb else
  if ℓ = 208 then W_208 fb else
  if ℓ = 287 then W_287 fb else
  if ℓ = 325 then W_325 fb else
  if ℓ = 345 then W_345 fb else
  if ℓ = 361 then W_361 fb else
  if ℓ = 384 then W_384 fb else
  if ℓ = 400 then W_400 fb else
  if ℓ = 449 then W_449 fb else
  if ℓ = 520 then W_520 fb else
  if ℓ = 558 then W_558 fb else
  if ℓ = 578 then W_578 fb else
  if ℓ = 594 then W_594 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof sfn sfn_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_66 prof fb) <|
  SpF.table (c_79 prof fb) <|
  SpF.table (c_106 prof fb) <|
  SpF.table (c_114 prof fb) <|
  SpF.table (c_144 prof fb) <|
  SpF.table (c_208 prof fb) <|
  SpF.table (c_287 prof fb) <|
  SpF.table (c_325 prof fb) <|
  SpF.table (c_345 prof fb) <|
  SpF.table (c_361 prof fb) <|
  SpF.table (c_384 prof fb) <|
  SpF.table (c_400 prof fb) <|
  SpF.table (c_449 prof fb) <|
  SpF.table (c_520 prof fb) <|
  SpF.table (c_558 prof fb) <|
  SpF.table (c_578 prof fb) <|
  SpF.table (c_594 prof fb) <|
  SpF.never ℓ

