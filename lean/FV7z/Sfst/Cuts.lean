import FV7z.Sfst.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `SetFrom_stat` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (105; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Sfst
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_25 : Wpt := fun F Wl Q => wp F Wl o1 (Q 29)
theorem c_25 (prof : Profile) : Sp prof sfst sfst_at 25 W_25 := Sp.blk_then (blk_25 prof) (Sp.skip 29)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 29 g (rfz f) V) ∧
    (f.cond 4 = false → W_25 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof sfst sfst_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_23 prof) (Sp.skip 29) (c_25 prof))

def W_29 : Wpt := fun F Wl Q => wp F Wl o2 (Q 105)
theorem c_29 (prof : Profile) : Sp prof sfst sfst_at 29 W_29 := Sp.blk_then (blk_29 prof) (Sp.skip 105)

/-- The cut points. -/
def cuts : List Nat := [0, 29]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 29 then W_29 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof sfst sfst_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_29 prof) <|
  Sp.never ℓ

end FV7z.Sfst
