import FV7z.Pvd.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CPropVariant::~CPropVariant` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (42, 51, 52, 56; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Pvd
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_22 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 2 = true → Q 52 g (rfz f) V) ∧
    (f.cond 2 = false → Q 38 g (rfz f) V)
theorem c_22 (prof : Profile) : Sp prof pvd pvd_at 22 W_22 :=
  Sp.blk_then (blk_22 prof) (Sp.jcc_then (spj_36 prof) (Sp.skip 52) (Sp.skip 38))

def W_13 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 7 = true → Q 38 g (rfz f) V) ∧
    (f.cond 7 = false → W_22 F Wl Q g (rfz f) V)
theorem c_13 (prof : Profile) : Sp prof pvd pvd_at 13 W_13 :=
  Sp.blk_then (blk_13 prof) (Sp.jcc_then (spj_20 prof) (Sp.skip 38) (c_22 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 6 = true → Q 56 g (rfz f) V) ∧
    (f.cond 6 = false → W_13 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof pvd pvd_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_11 prof) (Sp.skip 56) (c_13 prof))

def W_38 : Wpt := fun F Wl Q => wp F Wl o3 (Q 42)
theorem c_38 (prof : Profile) : Sp prof pvd pvd_at 38 W_38 := Sp.blk_then (blk_38 prof) (Sp.skip 42)

def W_47 : Wpt := fun F Wl Q => wp F Wl o4 (Q 51)
theorem c_47 (prof : Profile) : Sp prof pvd pvd_at 47 W_47 := Sp.blk_then (blk_47 prof) (Sp.skip 51)

/-- The cut points. -/
def cuts : List Nat := [0, 38, 47]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 38 then W_38 else
  if ℓ = 47 then W_47 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof pvd pvd_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_38 prof) <|
  Sp.table (c_47 prof) <|
  Sp.never ℓ

end FV7z.Pvd
