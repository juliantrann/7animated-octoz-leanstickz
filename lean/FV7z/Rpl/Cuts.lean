import FV7z.Rpl.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `AString::Replace` (PLAN.md §M, M1)

The 8 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (72, 85, 107, 132, 143, 166; the `ret`). `Wt` is the table of
the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Rpl
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_136 : Wpt := fun F Wl Q => wp F Wl o10 (Q 143)
theorem c_136 (prof : Profile) : Sp prof rpl rpl_at 136 W_136 := Sp.blk_then (blk_136 prof) (Sp.skip 143)

def W_27 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → W_136 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 45 g (rfz f) V)
theorem c_27 (prof : Profile) : Sp prof rpl rpl_at 27 W_27 :=
  Sp.blk_then (blk_27 prof) (Sp.jcc_then (spj_43 prof) (c_136 prof) (Sp.skip 45))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 118 g (rfz f) V) ∧
    (f.cond 4 = false → W_27 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof rpl rpl_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_25 prof) (Sp.skip 118) (c_27 prof))

def W_53 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    Q 100 g (rfz f) V
theorem c_53 (prof : Profile) : Sp prof rpl rpl_at 53 W_53 :=
  Sp.blk_then (blk_53 prof) (Sp.jmp_then (spj_55 prof) (Sp.skip 100))

def W_45 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 118 g (rfz f) V) ∧
    (f.cond 4 = false → W_53 F Wl Q g (rfz f) V)
theorem c_45 (prof : Profile) : Sp prof rpl rpl_at 45 W_45 :=
  Sp.blk_then (blk_45 prof) (Sp.jcc_then (spj_51 prof) (Sp.skip 118) (c_53 prof))

def W_77 : Wpt := fun F Wl Q => wp F Wl o5 (Q 85)
theorem c_77 (prof : Profile) : Sp prof rpl rpl_at 77 W_77 := Sp.blk_then (blk_77 prof) (Sp.skip 85)

def W_90 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    (f.cond 6 = true → Q 118 g (rfz f) V) ∧
    (f.cond 6 = false → Q 100 g (rfz f) V)
theorem c_90 (prof : Profile) : Sp prof rpl rpl_at 90 W_90 :=
  Sp.blk_then (blk_90 prof) (Sp.jcc_then (spj_98 prof) (Sp.skip 118) (Sp.skip 100))

def W_100 : Wpt := fun F Wl Q => wp F Wl o7 (Q 107)
theorem c_100 (prof : Profile) : Sp prof rpl rpl_at 100 W_100 := Sp.blk_then (blk_100 prof) (Sp.skip 107)

def W_64 : Wpt := fun F Wl Q => wp F Wl o4 (Q 72)
theorem c_64 (prof : Profile) : Sp prof rpl rpl_at 64 W_64 := Sp.blk_then (blk_64 prof) (Sp.skip 72)

def W_112 : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    (f.cond 9 = true → W_64 F Wl Q g (rfz f) V) ∧
    (f.cond 9 = false → Q 118 g (rfz f) V)
theorem c_112 (prof : Profile) : Sp prof rpl rpl_at 112 W_112 :=
  Sp.blk_then (blk_112 prof) (Sp.jcc_then (spj_116 prof) (c_64 prof) (Sp.skip 118))

def W_118 : Wpt := fun F Wl Q => wp F Wl o9 (Q 132)
theorem c_118 (prof : Profile) : Sp prof rpl rpl_at 118 W_118 := Sp.blk_then (blk_118 prof) (Sp.skip 132)

def W_152 : Wpt := fun F Wl Q => wp F Wl o9 (Q 166)
theorem c_152 (prof : Profile) : Sp prof rpl rpl_at 152 W_152 := Sp.blk_then (blk_152 prof) (Sp.skip 166)

def W_148 : Wpt := fun F Wl Q => wp F Wl o11 fun g f V =>
    (f.cond 5 = true → Q 45 g (rfz f) V) ∧
    (f.cond 5 = false → W_152 F Wl Q g (rfz f) V)
theorem c_148 (prof : Profile) : Sp prof rpl rpl_at 148 W_148 :=
  Sp.blk_then (blk_148 prof) (Sp.jcc_then (spj_150 prof) (Sp.skip 45) (c_152 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 45, 77, 90, 100, 112, 118, 148]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 45 then W_45 else
  if ℓ = 77 then W_77 else
  if ℓ = 90 then W_90 else
  if ℓ = 100 then W_100 else
  if ℓ = 112 then W_112 else
  if ℓ = 118 then W_118 else
  if ℓ = 148 then W_148 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof rpl rpl_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_45 prof) <|
  Sp.table (c_77 prof) <|
  Sp.table (c_90 prof) <|
  Sp.table (c_100 prof) <|
  Sp.table (c_112 prof) <|
  Sp.table (c_118 prof) <|
  Sp.table (c_148 prof) <|
  Sp.never ℓ

end FV7z.Rpl
