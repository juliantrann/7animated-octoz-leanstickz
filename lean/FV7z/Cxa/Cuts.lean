import FV7z.Cxa.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__cxa_atexit` (PLAN.md G3, startup)

The 7 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (47, 61, 75, 103, 112, 130, 145, 152, 176, 192, 233, 237, 264,
290; the `ret`). `Wt` is the table of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by
`tools/blk_gen.py`.
-/
namespace FV7z.Cxa
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_42 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 47)
theorem c_42 (prof : Profile) (fb : Addr) : SpF prof cxa cxa_at fb 42 (W_42 fb) :=
  SpF.blk_then (blk_42 prof) (SpF.skip 47)

def W_27 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o1 fb) fun g f V =>
    (f.cond 5 = true → Q 152 g (rfz f) V) ∧
    (f.cond 5 = false → W_42 fb F Wl Q g (rfz f) V)
theorem c_27 (prof : Profile) (fb : Addr) : SpF prof cxa cxa_at fb 27 (W_27 fb) :=
  SpF.blkF_then (blk_27 prof fb) (SpF.jcc_then (spj_40 prof fb) (SpF.skip 152) (c_42 prof fb))

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 264 g (rfz f) V) ∧
    (f.cond 4 = false → W_27 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof cxa cxa_at fb 0 (W_0 fb) :=
  SpF.blk_then (blk_0 prof) (SpF.jcc_then (spj_21 prof fb) (SpF.skip 264) (c_27 prof fb))

def W_54 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 61)
theorem c_54 (prof : Profile) (fb : Addr) : SpF prof cxa cxa_at fb 54 (W_54 fb) :=
  SpF.blkA_then (blk_54 prof) (SpF.skip 61)

def W_66 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → Q 237 g (rfz f) V) ∧
    (f.cond 4 = false → Q 75 g (rfz f) V)
theorem c_66 (prof : Profile) (fb : Addr) : SpF prof cxa cxa_at fb 66 (W_66 fb) :=
  SpF.blk_then (blk_66 prof) (SpF.jcc_then (spj_69 prof fb) (SpF.skip 237) (SpF.skip 75))

def W_80 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o5 fb) (Q 103)
theorem c_80 (prof : Profile) (fb : Addr) : SpF prof cxa cxa_at fb 80 (W_80 fb) :=
  SpF.blkF_then (blk_80 prof fb) (SpF.skip 103)

def W_108 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o6 (Q 112)
theorem c_108 (prof : Profile) (fb : Addr) : SpF prof cxa cxa_at fb 108 (W_108 fb) :=
  SpF.blk_then (blk_108 prof) (SpF.skip 112)

def W_116 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o7 fb) fun g f V =>
    (f.cond 5 = true → Q 192 g (rfz f) V) ∧
    (f.cond 5 = false → Q 130 g (rfz f) V)
theorem c_116 (prof : Profile) (fb : Addr) : SpF prof cxa cxa_at fb 116 (W_116 fb) :=
  SpF.blkF_then (blk_116 prof fb) (SpF.jcc_then (spj_128 prof fb) (SpF.skip 192) (SpF.skip 130))

def W_137 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o8 (Q 145)
theorem c_137 (prof : Profile) (fb : Addr) : SpF prof cxa cxa_at fb 137 (W_137 fb) :=
  SpF.blk_then (blk_137 prof) (SpF.skip 145)

/-- The cut points. -/
def cuts : List Nat := [0, 54, 66, 80, 108, 116, 137]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 54 then W_54 fb else
  if ℓ = 66 then W_66 fb else
  if ℓ = 80 then W_80 fb else
  if ℓ = 108 then W_108 fb else
  if ℓ = 116 then W_116 fb else
  if ℓ = 137 then W_137 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof cxa cxa_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_54 prof fb) <|
  SpF.table (c_66 prof fb) <|
  SpF.table (c_80 prof fb) <|
  SpF.table (c_108 prof fb) <|
  SpF.table (c_116 prof fb) <|
  SpF.table (c_137 prof fb) <|
  SpF.never ℓ

end FV7z.Cxa
