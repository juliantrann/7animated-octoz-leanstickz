import FV7z.Fmi.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `find_module_idx` (PLAN.md §M, M1)

The 7 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (46, 66, 78, 118, 186, 219; the `ret`). `Wt` is the table of
the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Fmi
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 46)
theorem c_0 (prof : Profile) : Sp prof fmi fmi_at 0 W_0 := Sp.blkA_then (blk_0 prof) (Sp.skip 46)

def W_51 : Wpt := fun F Wl Q => wp F Wl o1 (Q 66)
theorem c_51 (prof : Profile) : Sp prof fmi fmi_at 51 W_51 := Sp.blkA_then (blk_51 prof) (Sp.skip 66)

def W_68 : Wpt := fun F Wl Q => wp F Wl o2 (Q 78)
theorem c_68 (prof : Profile) : Sp prof fmi fmi_at 68 W_68 := Sp.blk_then (blk_68 prof) (Sp.skip 78)

def W_80 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    Q 147 g (rfz f) V
theorem c_80 (prof : Profile) : Sp prof fmi fmi_at 80 W_80 :=
  Sp.blk_then (blk_80 prof) (Sp.jmp_then (spj_94 prof) (Sp.skip 147))

def W_192 : Wpt := fun F Wl Q => wp F Wl o10 (Q 219)
theorem c_192 (prof : Profile) : Sp prof fmi fmi_at 192 W_192 := Sp.blk_then (blk_192 prof) (Sp.skip 219)

def W_123 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    (f.cond 4 = true → W_192 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 127 g (rfz f) V)
theorem c_123 (prof : Profile) : Sp prof fmi fmi_at 123 W_123 :=
  Sp.blk_then (blk_123 prof) (Sp.jcc_then (spj_125 prof) (c_192 prof) (Sp.skip 127))

def W_127 : Wpt := fun F Wl Q => wp F Wl o7 (Q 147)
theorem c_127 (prof : Profile) : Sp prof fmi fmi_at 127 W_127 := Sp.blk_then (blk_127 prof) (Sp.skip 147)

def W_105 : Wpt := fun F Wl Q => wp F Wl o5 (Q 118)
theorem c_105 (prof : Profile) : Sp prof fmi fmi_at 105 W_105 := Sp.blk_then (blk_105 prof) (Sp.skip 118)

def W_96 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 3 = true → Q 127 g (rfz f) V) ∧
    (f.cond 3 = false → W_105 F Wl Q g (rfz f) V)
theorem c_96 (prof : Profile) : Sp prof fmi fmi_at 96 W_96 :=
  Sp.blk_then (blk_96 prof) (Sp.jcc_then (spj_103 prof) (Sp.skip 127) (c_105 prof))

def W_167 : Wpt := fun F Wl Q => wp F Wl o9 (Q 186)
theorem c_167 (prof : Profile) : Sp prof fmi fmi_at 167 W_167 := Sp.blk_then (blk_167 prof) (Sp.skip 186)

def W_147 : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    (f.cond 5 = true → W_96 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → W_167 F Wl Q g (rfz f) V)
theorem c_147 (prof : Profile) : Sp prof fmi fmi_at 147 W_147 :=
  Sp.blk_then (blk_147 prof) (Sp.jcc_then (spj_165 prof) (c_96 prof) (c_167 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 51, 68, 80, 123, 127, 147]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 51 then W_51 else
  if ℓ = 68 then W_68 else
  if ℓ = 80 then W_80 else
  if ℓ = 123 then W_123 else
  if ℓ = 127 then W_127 else
  if ℓ = 147 then W_147 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof fmi fmi_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_51 prof) <|
  Sp.table (c_68 prof) <|
  Sp.table (c_80 prof) <|
  Sp.table (c_123 prof) <|
  Sp.table (c_127 prof) <|
  Sp.table (c_147 prof) <|
  Sp.never ℓ

end FV7z.Fmi
