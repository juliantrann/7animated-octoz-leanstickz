import FV7z.Sse.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CPU_IsSupported_SSE41` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (32, 67, 68; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Sse
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 32)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof sse sse_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 32)

def W_63 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 67)
theorem c_63 (prof : Profile) (fb : Addr) : SpF prof sse sse_at fb 63 (W_63 fb) :=
  SpF.blk_then (blk_63 prof) (SpF.skip 67)

def W_37 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o1 fb) fun g f V =>
    (f.cond 5 = true → Q 68 g (rfz f) V) ∧
    (f.cond 5 = false → W_63 fb F Wl Q g (rfz f) V)
theorem c_37 (prof : Profile) (fb : Addr) : SpF prof sse sse_at fb 37 (W_37 fb) :=
  SpF.blkF_then (blk_37 prof fb) (SpF.jcc_then (spj_61 prof fb) (SpF.skip 68) (c_63 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 37]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 37 then W_37 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof sse sse_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_37 prof fb) <|
  SpF.never ℓ

end FV7z.Sse
