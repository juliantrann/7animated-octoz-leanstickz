def cuts : List Nat := [0, 37, 43, 48, 98, 127, 135, 144, 152, 156, 164, 252, 256, 303]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 37 then W_37 fb else
  if ℓ = 43 then W_43 fb else
  if ℓ = 48 then W_48 fb else
  if ℓ = 98 then W_98 fb else
  if ℓ = 127 then W_127 fb else
  if ℓ = 135 then W_135 fb else
  if ℓ = 144 then W_144 fb else
  if ℓ = 152 then W_152 fb else
  if ℓ = 156 then W_156 fb else
  if ℓ = 164 then W_164 fb else
  if ℓ = 252 then W_252 fb else
  if ℓ = 256 then W_256 fb else
  if ℓ = 303 then W_303 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof mcn mcn_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_37 prof fb) <|
  SpF.table (c_43 prof fb) <|
  SpF.table (c_48 prof fb) <|
  SpF.table (c_98 prof fb) <|
  SpF.table (c_127 prof fb) <|
  SpF.table (c_135 prof fb) <|
  SpF.table (c_144 prof fb) <|
  SpF.table (c_152 prof fb) <|
  SpF.table (c_156 prof fb) <|
  SpF.table (c_164 prof fb) <|
  SpF.table (c_252 prof fb) <|
  SpF.table (c_256 prof fb) <|
  SpF.table (c_303 prof fb) <|
  SpF.never ℓ

