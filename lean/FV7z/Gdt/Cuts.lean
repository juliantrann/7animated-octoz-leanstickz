import FV7z.Gdt.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__getdtablesize` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (32, 68, 69; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Gdt
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 32)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof gdt gdt_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 32)

def W_64 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 68)
theorem c_64 (prof : Profile) (fb : Addr) : SpF prof gdt gdt_at fb 64 (W_64 fb) :=
  SpF.blk_then (blk_64 prof) (SpF.skip 68)

def W_37 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o1 fb) fun g f V =>
    (f.cond 5 = true → Q 69 g (rfz f) V) ∧
    (f.cond 5 = false → W_64 fb F Wl Q g (rfz f) V)
theorem c_37 (prof : Profile) (fb : Addr) : SpF prof gdt gdt_at fb 37 (W_37 fb) :=
  SpF.blkF_then (blk_37 prof fb) (SpF.jcc_then (spj_62 prof fb) (SpF.skip 69) (c_64 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 37]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 37 then W_37 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof gdt gdt_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_37 prof fb) <|
  SpF.never ℓ

end FV7z.Gdt
