import FV7z.Uca.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UString::UString(const char*)` (PLAN.md §M, M1)

The 7 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (60, 119, 130; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Uca
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_128 : Wpt := fun F Wl Q => wp F Wl o9 (Q 130)
theorem c_128 (prof : Profile) : Sp prof uca uca_at 128 W_128 := Sp.blk_then (blk_128 prof) (Sp.skip 130)

def W_20 : Wpt := fun F Wl Q => wp F Wl o1 (Q 32)
theorem c_20 (prof : Profile) : Sp prof uca uca_at 20 W_20 := Sp.blk_then (blk_20 prof) (Sp.skip 32)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → W_128 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_20 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof uca uca_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_18 prof) (c_128 prof) (c_20 prof))

def W_50 : Wpt := fun F Wl Q => wp F Wl o3 (Q 60)
theorem c_50 (prof : Profile) : Sp prof uca uca_at 50 W_50 := Sp.blk_then (blk_50 prof) (Sp.skip 60)

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 32 g (rfz f) V) ∧
    (f.cond 5 = false → W_50 F Wl Q g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof uca uca_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_48 prof) (Sp.skip 32) (c_50 prof))

def W_72 : Wpt := fun F Wl Q => wp F Wl o5 (Q 80)
theorem c_72 (prof : Profile) : Sp prof uca uca_at 72 W_72 := Sp.blk_then (blk_72 prof) (Sp.skip 80)

def W_65 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → Q 100 g (rfz f) V) ∧
    (f.cond 4 = false → W_72 F Wl Q g (rfz f) V)
theorem c_65 (prof : Profile) : Sp prof uca uca_at 65 W_65 :=
  Sp.blk_then (blk_65 prof) (Sp.jcc_then (spj_70 prof) (Sp.skip 100) (c_72 prof))

def W_80 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    (f.cond 5 = true → Q 80 g (rfz f) V) ∧
    (f.cond 5 = false → Q 100 g (rfz f) V)
theorem c_80 (prof : Profile) : Sp prof uca uca_at 80 W_80 :=
  Sp.blk_then (blk_80 prof) (Sp.jcc_then (spj_98 prof) (Sp.skip 80) (Sp.skip 100))

def W_100 : Wpt := fun F Wl Q => wp F Wl o7 (Q 103)
theorem c_100 (prof : Profile) : Sp prof uca uca_at 100 W_100 := Sp.blk_then (blk_100 prof) (Sp.skip 103)

def W_103 : Wpt := fun F Wl Q => wp F Wl o8 (Q 119)
theorem c_103 (prof : Profile) : Sp prof uca uca_at 103 W_103 := Sp.blk_then (blk_103 prof) (Sp.skip 119)

def W_135 : Wpt := fun F Wl Q => wp F Wl o10 fun g f V =>
    Q 103 g (rfz f) V
theorem c_135 (prof : Profile) : Sp prof uca uca_at 135 W_135 :=
  Sp.blk_then (blk_135 prof) (Sp.jmp_then (spj_138 prof) (Sp.skip 103))

/-- The cut points. -/
def cuts : List Nat := [0, 32, 65, 80, 100, 103, 135]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 32 then W_32 else
  if ℓ = 65 then W_65 else
  if ℓ = 80 then W_80 else
  if ℓ = 100 then W_100 else
  if ℓ = 103 then W_103 else
  if ℓ = 135 then W_135 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof uca uca_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_32 prof) <|
  Sp.table (c_65 prof) <|
  Sp.table (c_80 prof) <|
  Sp.table (c_100 prof) <|
  Sp.table (c_103 prof) <|
  Sp.table (c_135 prof) <|
  Sp.never ℓ

end FV7z.Uca
