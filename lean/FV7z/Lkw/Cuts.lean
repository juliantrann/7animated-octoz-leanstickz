import FV7z.Lkw.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NWindows::NFile::NIO::SetSymLink(char const*, char const*)` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (17, 31; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Lkw
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 17)
theorem c_0 (prof : Profile) : Sp prof lkw lkw_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 17)

def W_22 : Wpt := fun F Wl Q => wp F Wl o1 (Q 31)
theorem c_22 (prof : Profile) : Sp prof lkw lkw_at 22 W_22 := Sp.blk_then (blk_22 prof) (Sp.skip 31)

/-- The cut points. -/
def cuts : List Nat := [0, 22]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 22 then W_22 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof lkw lkw_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_22 prof) <|
  Sp.never ℓ

end FV7z.Lkw
