import FV7z.Gdn.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__getdents` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (25, 35, 36, 59; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Gdn
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o0 (Q 25)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof gdn gdn_at fb 0 (W_0 fb) :=
  SpF.blk_then (blk_0 prof) (SpF.skip 25)

def W_40 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o2 fb) (Q 59)
theorem c_40 (prof : Profile) (fb : Addr) : SpF prof gdn gdn_at fb 40 (W_40 fb) :=
  SpF.blkF_then (blk_40 prof fb) (SpF.skip 59)

def W_27 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 7 = true → W_40 fb F Wl Q g (rfz f) V) ∧
    (f.cond 7 = false → Q 35 g (rfz f) V)
theorem c_27 (prof : Profile) (fb : Addr) : SpF prof gdn gdn_at fb 27 (W_27 fb) :=
  SpF.blk_then (blk_27 prof) (SpF.jcc_then (spj_33 prof fb) (c_40 prof fb) (SpF.skip 35))

/-- The cut points. -/
def cuts : List Nat := [0, 27]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 27 then W_27 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof gdn gdn_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_27 prof fb) <|
  SpF.never ℓ

end FV7z.Gdn
