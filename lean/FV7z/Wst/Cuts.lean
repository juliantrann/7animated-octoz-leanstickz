import FV7z.Wst.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `WriteStream` (PLAN.md §M, M1)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (95, 140, 159; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Wst
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_37 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    Q 73 g (rfz f) V
theorem c_37 (prof : Profile) (fb : Addr) : SpF prof wst wst_at fb 37 (W_37 fb) :=
  SpF.blk_then (blk_37 prof) (SpF.jmp_then (spj_57 prof fb) (SpF.skip 73))

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) fun g f V =>
    (f.cond 4 = true → Q 144 g (rfz f) V) ∧
    (f.cond 4 = false → W_37 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof wst wst_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.jcc_then (spj_35 prof fb) (SpF.skip 144) (c_37 prof fb))

def W_73 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 (Q 95)
theorem c_73 (prof : Profile) (fb : Addr) : SpF prof wst wst_at fb 73 (W_73 fb) :=
  SpF.blk_then (blk_73 prof) (SpF.skip 95)

def W_152 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o9 fun g f V =>
    Q 112 g (rfz f) V
theorem c_152 (prof : Profile) (fb : Addr) : SpF prof wst wst_at fb 152 (W_152 fb) :=
  SpF.blk_then (blk_152 prof) (SpF.jmp_then (spj_157 prof fb) (SpF.skip 112))

def W_68 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 144 g (rfz f) V) ∧
    (f.cond 4 = false → Q 73 g (rfz f) V)
theorem c_68 (prof : Profile) (fb : Addr) : SpF prof wst wst_at fb 68 (W_68 fb) :=
  SpF.blk_then (blk_68 prof) (SpF.jcc_then (spj_71 prof fb) (SpF.skip 144) (SpF.skip 73))

def W_64 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → W_152 fb F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_68 fb F Wl Q g (rfz f) V)
theorem c_64 (prof : Profile) (fb : Addr) : SpF prof wst wst_at fb 64 (W_64 fb) :=
  SpF.blk_then (blk_64 prof) (SpF.jcc_then (spj_66 prof fb) (c_152 prof fb) (c_68 prof fb))

def W_98 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 4 = true → W_64 fb F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 112 g (rfz f) V)
theorem c_98 (prof : Profile) (fb : Addr) : SpF prof wst wst_at fb 98 (W_98 fb) :=
  SpF.blk_then (blk_98 prof) (SpF.jcc_then (spj_110 prof fb) (c_64 prof fb) (SpF.skip 112))

def W_128 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o7 (Q 140)
theorem c_128 (prof : Profile) (fb : Addr) : SpF prof wst wst_at fb 128 (W_128 fb) :=
  SpF.blk_then (blk_128 prof) (SpF.skip 140)

def W_112 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o6 fb) fun g f V =>
    (f.cond 5 = true → Q 159 g (rfz f) V) ∧
    (f.cond 5 = false → W_128 fb F Wl Q g (rfz f) V)
theorem c_112 (prof : Profile) (fb : Addr) : SpF prof wst wst_at fb 112 (W_112 fb) :=
  SpF.blkF_then (blk_112 prof fb) (SpF.jcc_then (spj_126 prof fb) (SpF.skip 159) (c_128 prof fb))

def W_144 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    Q 112 g (rfz f) V
theorem c_144 (prof : Profile) (fb : Addr) : SpF prof wst wst_at fb 144 (W_144 fb) :=
  SpF.blk_then (blk_144 prof) (SpF.jmp_then (spj_146 prof fb) (SpF.skip 112))

/-- The cut points. -/
def cuts : List Nat := [0, 73, 98, 112, 144]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 73 then W_73 fb else
  if ℓ = 98 then W_98 fb else
  if ℓ = 112 then W_112 fb else
  if ℓ = 144 then W_144 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof wst wst_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_73 prof fb) <|
  SpF.table (c_98 prof fb) <|
  SpF.table (c_112 prof fb) <|
  SpF.table (c_144 prof fb) <|
  SpF.never ℓ

end FV7z.Wst
