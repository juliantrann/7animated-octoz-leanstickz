import FV7z.Ocv.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CObjectVector<CRecordVector<unsigned>>::~CObjectVector` (PLAN.md §M, M1)

The 6 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (50, 63, 91, 100; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ocv
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_21 : Wpt := fun F Wl Q => wp F Wl o1 (Q 32)
theorem c_21 (prof : Profile) : Sp prof ocv ocv_at 21 W_21 := Sp.blk_then (blk_21 prof) (Sp.skip 32)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 82 g (rfz f) V) ∧
    (f.cond 4 = false → W_21 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof ocv ocv_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_19 prof) (Sp.skip 82) (c_21 prof))

def W_41 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 55 g (rfz f) V) ∧
    (f.cond 4 = false → Q 50 g (rfz f) V)
theorem c_41 (prof : Profile) : Sp prof ocv ocv_at 41 W_41 :=
  Sp.blk_then (blk_41 prof) (Sp.jcc_then (spj_48 prof) (Sp.skip 55) (Sp.skip 50))

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 72 g (rfz f) V) ∧
    (f.cond 4 = false → W_41 F Wl Q g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof ocv ocv_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_39 prof) (Sp.skip 72) (c_41 prof))

def W_55 : Wpt := fun F Wl Q => wp F Wl o4 (Q 63)
theorem c_55 (prof : Profile) : Sp prof ocv ocv_at 55 W_55 := Sp.blk_then (blk_55 prof) (Sp.skip 63)

def W_68 : Wpt := fun F Wl Q => wp F Wl o5 (Q 72)
theorem c_68 (prof : Profile) : Sp prof ocv ocv_at 68 W_68 := Sp.blk_then (blk_68 prof) (Sp.skip 72)

def W_72 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    (f.cond 5 = true → Q 32 g (rfz f) V) ∧
    (f.cond 5 = false → Q 82 g (rfz f) V)
theorem c_72 (prof : Profile) : Sp prof ocv ocv_at 72 W_72 :=
  Sp.blk_then (blk_72 prof) (Sp.jcc_then (spj_80 prof) (Sp.skip 32) (Sp.skip 82))

def W_96 : Wpt := fun F Wl Q => wp F Wl o8 (Q 100)
theorem c_96 (prof : Profile) : Sp prof ocv ocv_at 96 W_96 := Sp.blk_then (blk_96 prof) (Sp.skip 100)

def W_87 : Wpt := fun F Wl Q => wp F Wl o8 (Q 91)
theorem c_87 (prof : Profile) : Sp prof ocv ocv_at 87 W_87 := Sp.blk_then (blk_87 prof) (Sp.skip 91)

def W_82 : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    (f.cond 4 = true → W_96 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_87 F Wl Q g (rfz f) V)
theorem c_82 (prof : Profile) : Sp prof ocv ocv_at 82 W_82 :=
  Sp.blk_then (blk_82 prof) (Sp.jcc_then (spj_85 prof) (c_96 prof) (c_87 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 32, 55, 68, 72, 82]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 32 then W_32 else
  if ℓ = 55 then W_55 else
  if ℓ = 68 then W_68 else
  if ℓ = 72 then W_72 else
  if ℓ = 82 then W_82 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ocv ocv_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_32 prof) <|
  Sp.table (c_55 prof) <|
  Sp.table (c_68 prof) <|
  Sp.table (c_72 prof) <|
  Sp.table (c_82 prof) <|
  Sp.never ℓ

end FV7z.Ocv
