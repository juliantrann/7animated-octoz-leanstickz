import FV7z.Osv.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `_dl_discover_osversion` (PLAN.md G3, startup)

The 7 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (20, 176, 187, 212, 223; the `ret`). `Wt` is the table of the
cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Osv
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 20)
theorem c_0 (prof : Profile) : Sp prof osv osv_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 20)

def W_41 : Wpt := fun F Wl Q => wp F Wl o2 (Q 46)
theorem c_41 (prof : Profile) : Sp prof osv osv_at 41 W_41 := Sp.blk_then (blk_41 prof) (Sp.skip 46)

def W_25 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 176 g (rfz f) V) ∧
    (f.cond 5 = false → W_41 F Wl Q g (rfz f) V)
theorem c_25 (prof : Profile) : Sp prof osv osv_at 25 W_25 :=
  Sp.blk_then (blk_25 prof) (Sp.jcc_then (spj_35 prof) (Sp.skip 176) (c_41 prof))

def W_77 : Wpt := fun F Wl Q => wp F Wl o5 (Q 80)
theorem c_77 (prof : Profile) : Sp prof osv osv_at 77 W_77 := Sp.blk_then (blk_77 prof) (Sp.skip 80)

def W_57 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 7 = true → Q 103 g (rfz f) V) ∧
    (f.cond 7 = false → W_77 F Wl Q g (rfz f) V)
theorem c_57 (prof : Profile) : Sp prof osv osv_at 57 W_57 :=
  Sp.blk_then (blk_57 prof) (Sp.jcc_then (spj_75 prof) (Sp.skip 103) (c_77 prof))

def W_46 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 7 = true → Q 145 g (rfz f) V) ∧
    (f.cond 7 = false → W_57 F Wl Q g (rfz f) V)
theorem c_46 (prof : Profile) : Sp prof osv osv_at 46 W_46 :=
  Sp.blk_then (blk_46 prof) (Sp.jcc_then (spj_55 prof) (Sp.skip 145) (c_57 prof))

def W_80 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    (f.cond 6 = true → Q 80 g (rfz f) V) ∧
    (f.cond 6 = false → Q 103 g (rfz f) V)
theorem c_80 (prof : Profile) : Sp prof osv osv_at 80 W_80 :=
  Sp.blk_then (blk_80 prof) (Sp.jcc_then (spj_101 prof) (Sp.skip 80) (Sp.skip 103))

def W_139 : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    (f.cond 4 = true → Q 127 g (rfz f) V) ∧
    (f.cond 4 = false → Q 145 g (rfz f) V)
theorem c_139 (prof : Profile) : Sp prof osv osv_at 139 W_139 :=
  Sp.blk_then (blk_139 prof) (Sp.jcc_then (spj_143 prof) (Sp.skip 127) (Sp.skip 145))

def W_121 : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    (f.cond 5 = true → Q 46 g (rfz f) V) ∧
    (f.cond 5 = false → Q 127 g (rfz f) V)
theorem c_121 (prof : Profile) : Sp prof osv osv_at 121 W_121 :=
  Sp.blk_then (blk_121 prof) (Sp.jcc_then (spj_125 prof) (Sp.skip 46) (Sp.skip 127))

def W_103 : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    (f.cond 5 = true → W_139 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → W_121 F Wl Q g (rfz f) V)
theorem c_103 (prof : Profile) : Sp prof osv osv_at 103 W_103 :=
  Sp.blk_then (blk_103 prof) (Sp.jcc_then (spj_119 prof) (c_139 prof) (c_121 prof))

def W_127 : Wpt := fun F Wl Q => wp F Wl o9 (Q 138)
theorem c_127 (prof : Profile) : Sp prof osv osv_at 127 W_127 := Sp.blk_then (blk_127 prof) (Sp.skip 138)

def W_145 : Wpt := fun F Wl Q => wp F Wl o10 (Q 169)
theorem c_145 (prof : Profile) : Sp prof osv osv_at 145 W_145 := Sp.blk_then (blk_145 prof) (Sp.skip 169)

/-- The cut points. -/
def cuts : List Nat := [0, 25, 46, 80, 103, 127, 145]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 25 then W_25 else
  if ℓ = 46 then W_46 else
  if ℓ = 80 then W_80 else
  if ℓ = 103 then W_103 else
  if ℓ = 127 then W_127 else
  if ℓ = 145 then W_145 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof osv osv_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_25 prof) <|
  Sp.table (c_46 prof) <|
  Sp.table (c_80 prof) <|
  Sp.table (c_103 prof) <|
  Sp.table (c_127 prof) <|
  Sp.table (c_145 prof) <|
  Sp.never ℓ

end FV7z.Osv
