/-- The cut points. -/
def cuts : List Nat := [0, 22, 29, 34, 46, 88, 96]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 22 then W_22 else
  if ℓ = 29 then W_29 else
  if ℓ = 34 then W_34 else
  if ℓ = 46 then W_46 else
  if ℓ = 88 then W_88 else
  if ℓ = 96 then W_96 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof isp isp_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_22 prof) <|
  Sp.table (c_29 prof) <|
  Sp.table (c_34 prof) <|
  Sp.table (c_46 prof) <|
  Sp.table (c_88 prof) <|
  Sp.table (c_96 prof) <|
  Sp.never ℓ

