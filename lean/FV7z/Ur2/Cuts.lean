import FV7z.Ur2.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UString::ReAlloc2` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (14, 35, 57, 79; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ur2
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 14)
theorem c_0 (prof : Profile) : Sp prof ur2 ur2_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 14)

def W_20 : Wpt := fun F Wl Q => wp F Wl o1 (Q 35)
theorem c_20 (prof : Profile) : Sp prof ur2 ur2_at 20 W_20 := Sp.blk_then (blk_20 prof) (Sp.skip 35)

def W_40 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 62 g (rfz f) V) ∧
    (f.cond 4 = false → Q 57 g (rfz f) V)
theorem c_40 (prof : Profile) : Sp prof ur2 ur2_at 40 W_40 :=
  Sp.blk_then (blk_40 prof) (Sp.jcc_then (spj_55 prof) (Sp.skip 62) (Sp.skip 57))

def W_62 : Wpt := fun F Wl Q => wp F Wl o3 (Q 79)
theorem c_62 (prof : Profile) : Sp prof ur2 ur2_at 62 W_62 := Sp.blk_then (blk_62 prof) (Sp.skip 79)

/-- The cut points. -/
def cuts : List Nat := [0, 20, 40, 62]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 20 then W_20 else
  if ℓ = 40 then W_40 else
  if ℓ = 62 then W_62 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ur2 ur2_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_20 prof) <|
  Sp.table (c_40 prof) <|
  Sp.table (c_62 prof) <|
  Sp.never ℓ

end FV7z.Ur2
