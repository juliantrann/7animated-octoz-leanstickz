import FV7z.Pop.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CArchiveExtractCallback::PrepareOperation` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (22, 102; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Pop
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_112 : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    Q 50 g (rfz f) V
theorem c_112 (prof : Profile) : Sp prof pop pop_at 112 W_112 :=
  Sp.blk_then (blk_112 prof) (Sp.jmp_then (spj_117 prof) (Sp.skip 50))

def W_46 : Wpt := fun F Wl Q => wp F Wl o4 (Q 50)
theorem c_46 (prof : Profile) : Sp prof pop pop_at 46 W_46 := Sp.blk_then (blk_46 prof) (Sp.skip 50)

def W_40 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 5 = true → W_112 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → W_46 F Wl Q g (rfz f) V)
theorem c_40 (prof : Profile) : Sp prof pop pop_at 40 W_40 :=
  Sp.blk_then (blk_40 prof) (Sp.jcc_then (spj_44 prof) (c_112 prof) (c_46 prof))

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 50 g (rfz f) V) ∧
    (f.cond 5 = false → W_40 F Wl Q g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof pop pop_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_38 prof) (Sp.skip 50) (c_40 prof))

def W_19 : Wpt := fun F Wl Q => wp F Wl o1 (Q 22)
theorem c_19 (prof : Profile) : Sp prof pop pop_at 19 W_19 := Sp.blk_then (blk_19 prof) (Sp.skip 22)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → W_32 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_19 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof pop pop_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_17 prof) (c_32 prof) (c_19 prof))

def W_70 : Wpt := fun F Wl Q => wp F Wl o6 (Q 77)
theorem c_70 (prof : Profile) : Sp prof pop pop_at 70 W_70 := Sp.blk_then (blk_70 prof) (Sp.skip 77)

def W_50 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 4 = true → Q 77 g (rfz f) V) ∧
    (f.cond 4 = false → W_70 F Wl Q g (rfz f) V)
theorem c_50 (prof : Profile) : Sp prof pop pop_at 50 W_50 :=
  Sp.blk_then (blk_50 prof) (Sp.jcc_then (spj_68 prof) (Sp.skip 77) (c_70 prof))

def W_77 : Wpt := fun F Wl Q => wp F Wl o7 (Q 102)
theorem c_77 (prof : Profile) : Sp prof pop pop_at 77 W_77 := Sp.blk_then (blk_77 prof) (Sp.skip 102)

/-- The cut points. -/
def cuts : List Nat := [0, 50, 77]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 50 then W_50 else
  if ℓ = 77 then W_77 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof pop pop_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_50 prof) <|
  Sp.table (c_77 prof) <|
  Sp.never ℓ

end FV7z.Pop
