/-- The cut points. -/
def cuts : List Nat := [0, 35, 64, 97, 167, 171, 183, 224, 236, 250]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 35 then W_35 else
  if ℓ = 64 then W_64 else
  if ℓ = 97 then W_97 else
  if ℓ = 167 then W_167 else
  if ℓ = 171 then W_171 else
  if ℓ = 183 then W_183 else
  if ℓ = 224 then W_224 else
  if ℓ = 236 then W_236 else
  if ℓ = 250 then W_250 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof lri lri_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_35 prof) <|
  Sp.table (c_64 prof) <|
  Sp.table (c_97 prof) <|
  Sp.table (c_167 prof) <|
  Sp.table (c_171 prof) <|
  Sp.table (c_183 prof) <|
  Sp.table (c_224 prof) <|
  Sp.table (c_236 prof) <|
  Sp.table (c_250 prof) <|
  Sp.never ℓ

