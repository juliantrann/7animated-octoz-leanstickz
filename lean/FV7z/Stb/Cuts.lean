import FV7z.Stb.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `_IO_setb` (PLAN.md §M, M1)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (41, 57, 62, 74, 80; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Stb
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_35 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 80 g (rfz f) V) ∧
    (f.cond 4 = false → Q 39 g (rfz f) V)
theorem c_35 (prof : Profile) : Sp prof stb stb_at 35 W_35 :=
  Sp.blk_then (blk_35 prof) (Sp.jcc_then (spj_37 prof) (Sp.skip 80) (Sp.skip 39))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 39 g (rfz f) V) ∧
    (f.cond 4 = false → W_35 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof stb stb_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_33 prof) (Sp.skip 39) (c_35 prof))

def W_39 : Wpt := fun F Wl Q => wp F Wl o2 (Q 41)
theorem c_39 (prof : Profile) : Sp prof stb stb_at 39 W_39 := Sp.blk_then (blk_39 prof) (Sp.skip 41)

def W_46 : Wpt := fun F Wl Q => wp F Wl o3 (Q 57)
theorem c_46 (prof : Profile) : Sp prof stb stb_at 46 W_46 := Sp.blk_then (blk_46 prof) (Sp.skip 57)

def W_66 : Wpt := fun F Wl Q => wp F Wl o4 (Q 74)
theorem c_66 (prof : Profile) : Sp prof stb stb_at 66 W_66 := Sp.blk_then (blk_66 prof) (Sp.skip 74)

def W_85 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    Q 39 g (rfz f) V
theorem c_85 (prof : Profile) : Sp prof stb stb_at 85 W_85 :=
  Sp.blk_then (blk_85 prof) (Sp.jmp_then (spj_87 prof) (Sp.skip 39))

/-- The cut points. -/
def cuts : List Nat := [0, 39, 46, 66, 85]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 39 then W_39 else
  if ℓ = 46 then W_46 else
  if ℓ = 66 then W_66 else
  if ℓ = 85 then W_85 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof stb stb_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_39 prof) <|
  Sp.table (c_46 prof) <|
  Sp.table (c_66 prof) <|
  Sp.table (c_85 prof) <|
  Sp.never ℓ

end FV7z.Stb
