import FV7z.Dpr.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `_dl_protect_relro` (PLAN.md G3, startup)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (50, 67, 76, 99; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Dpr
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_56 : Wpt := fun F Wl Q => wp F Wl o2 (Q 67)
theorem c_56 (prof : Profile) : Sp prof dpr dpr_at 56 W_56 := Sp.blk_then (blk_56 prof) (Sp.skip 67)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → W_56 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → Q 49 g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof dpr dpr_at 0 W_0 :=
  Sp.blkA_then (blk_0 prof) (Sp.jcc_then (spj_47 prof) (c_56 prof) (Sp.skip 49))

def W_49 : Wpt := fun F Wl Q => wp F Wl o1 (Q 50)
theorem c_49 (prof : Profile) : Sp prof dpr dpr_at 49 W_49 := Sp.blk_then (blk_49 prof) (Sp.skip 50)

def W_72 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 9 = true → Q 49 g (rfz f) V) ∧
    (f.cond 9 = false → Q 76 g (rfz f) V)
theorem c_72 (prof : Profile) : Sp prof dpr dpr_at 72 W_72 :=
  Sp.blk_then (blk_72 prof) (Sp.jcc_then (spj_74 prof) (Sp.skip 49) (Sp.skip 76))

/-- The cut points. -/
def cuts : List Nat := [0, 49, 72]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 49 then W_49 else
  if ℓ = 72 then W_72 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof dpr dpr_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_49 prof) <|
  Sp.table (c_72 prof) <|
  Sp.never ℓ

end FV7z.Dpr
