/-- The cut points. -/
def cuts : List Nat := [0, 45, 48, 53, 58, 62, 87, 95, 112, 144]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 45 then W_45 else
  if ℓ = 48 then W_48 else
  if ℓ = 53 then W_53 else
  if ℓ = 58 then W_58 else
  if ℓ = 62 then W_62 else
  if ℓ = 87 then W_87 else
  if ℓ = 95 then W_95 else
  if ℓ = 112 then W_112 else
  if ℓ = 144 then W_144 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof sen sen_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_45 prof) <|
  Sp.table (c_48 prof) <|
  Sp.table (c_53 prof) <|
  Sp.table (c_58 prof) <|
  Sp.table (c_62 prof) <|
  Sp.table (c_87 prof) <|
  Sp.table (c_95 prof) <|
  Sp.table (c_112 prof) <|
  Sp.table (c_144 prof) <|
  Sp.never ℓ

