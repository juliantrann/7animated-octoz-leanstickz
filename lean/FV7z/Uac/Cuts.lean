import FV7z.Uac.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UString::operator= (const char *)` (PLAN.md §M, M1)

The 7 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (130, 141, 157; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Uac
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_176 : Wpt := fun F Wl Q => wp F Wl o12 fun g f V =>
    Q 101 g (rfz f) V
theorem c_176 (prof : Profile) : Sp prof uac uac_at 176 W_176 :=
  Sp.blk_then (blk_176 prof) (Sp.jmp_then (spj_182 prof) (Sp.skip 101))

def W_35 : Wpt := fun F Wl Q => wp F Wl o1 (Q 40)
theorem c_35 (prof : Profile) : Sp prof uac uac_at 35 W_35 := Sp.blk_then (blk_35 prof) (Sp.skip 40)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → W_176 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_35 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof uac uac_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_29 prof) (c_176 prof) (c_35 prof))

def W_136 : Wpt := fun F Wl Q => wp F Wl o9 (Q 141)
theorem c_136 (prof : Profile) : Sp prof uac uac_at 136 W_136 := Sp.blk_then (blk_136 prof) (Sp.skip 141)

def W_70 : Wpt := fun F Wl Q => wp F Wl o4 (Q 73)
theorem c_70 (prof : Profile) : Sp prof uac uac_at 70 W_70 := Sp.blk_then (blk_70 prof) (Sp.skip 73)

def W_56 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 2 = true → W_136 F Wl Q g (rfz f) V) ∧
    (f.cond 2 = false → W_70 F Wl Q g (rfz f) V)
theorem c_56 (prof : Profile) : Sp prof uac uac_at 56 W_56 :=
  Sp.blk_then (blk_56 prof) (Sp.jcc_then (spj_68 prof) (c_136 prof) (c_70 prof))

def W_40 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 40 g (rfz f) V) ∧
    (f.cond 5 = false → W_56 F Wl Q g (rfz f) V)
theorem c_40 (prof : Profile) : Sp prof uac uac_at 40 W_40 :=
  Sp.blk_then (blk_40 prof) (Sp.jcc_then (spj_54 prof) (Sp.skip 40) (c_56 prof))

def W_79 : Wpt := fun F Wl Q => wp F Wl o6 (Q 80)
theorem c_79 (prof : Profile) : Sp prof uac uac_at 79 W_79 := Sp.blk_then (blk_79 prof) (Sp.skip 80)

def W_73 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 4 = true → Q 101 g (rfz f) V) ∧
    (f.cond 4 = false → W_79 F Wl Q g (rfz f) V)
theorem c_73 (prof : Profile) : Sp prof uac uac_at 73 W_73 :=
  Sp.blk_then (blk_73 prof) (Sp.jcc_then (spj_77 prof) (Sp.skip 101) (c_79 prof))

def W_80 : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    (f.cond 5 = true → Q 80 g (rfz f) V) ∧
    (f.cond 5 = false → Q 101 g (rfz f) V)
theorem c_80 (prof : Profile) : Sp prof uac uac_at 80 W_80 :=
  Sp.blk_then (blk_80 prof) (Sp.jcc_then (spj_99 prof) (Sp.skip 80) (Sp.skip 101))

def W_101 : Wpt := fun F Wl Q => wp F Wl o8 (Q 130)
theorem c_101 (prof : Profile) : Sp prof uac uac_at 101 W_101 := Sp.blk_then (blk_101 prof) (Sp.skip 130)

def W_146 : Wpt := fun F Wl Q => wp F Wl o10 fun g f V =>
    (f.cond 4 = true → Q 162 g (rfz f) V) ∧
    (f.cond 4 = false → Q 157 g (rfz f) V)
theorem c_146 (prof : Profile) : Sp prof uac uac_at 146 W_146 :=
  Sp.blk_then (blk_146 prof) (Sp.jcc_then (spj_155 prof) (Sp.skip 162) (Sp.skip 157))

def W_162 : Wpt := fun F Wl Q => wp F Wl o11 fun g f V =>
    Q 73 g (rfz f) V
theorem c_162 (prof : Profile) : Sp prof uac uac_at 162 W_162 :=
  Sp.blk_then (blk_162 prof) (Sp.jmp_then (spj_169 prof) (Sp.skip 73))

/-- The cut points. -/
def cuts : List Nat := [0, 40, 73, 80, 101, 146, 162]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 40 then W_40 else
  if ℓ = 73 then W_73 else
  if ℓ = 80 then W_80 else
  if ℓ = 101 then W_101 else
  if ℓ = 146 then W_146 else
  if ℓ = 162 then W_162 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof uac uac_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_40 prof) <|
  Sp.table (c_73 prof) <|
  Sp.table (c_80 prof) <|
  Sp.table (c_101 prof) <|
  Sp.table (c_146 prof) <|
  Sp.table (c_162 prof) <|
  Sp.never ℓ

end FV7z.Uac
