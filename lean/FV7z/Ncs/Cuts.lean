import FV7z.Ncs.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CCensorNode::NeedCheckSubDirs` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (63, 73; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ncs
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_74 : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    Q 60 g (rfz f) V
theorem c_74 (prof : Profile) : Sp prof ncs ncs_at 74 W_74 :=
  Sp.blk_then (blk_74 prof) (Sp.jmp_then (spj_77 prof) (Sp.skip 60))

def W_11 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    Q 47 g (rfz f) V
theorem c_11 (prof : Profile) : Sp prof ncs ncs_at 11 W_11 :=
  Sp.blk_then (blk_11 prof) (Sp.jmp_then (spj_23 prof) (Sp.skip 47))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → W_74 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_11 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof ncs ncs_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_9 prof) (c_74 prof) (c_11 prof))

def W_64 : Wpt := fun F Wl Q => wp F Wl o6 (Q 73)
theorem c_64 (prof : Profile) : Sp prof ncs ncs_at 64 W_64 := Sp.blk_then (blk_64 prof) (Sp.skip 73)

def W_38 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 60 g (rfz f) V) ∧
    (f.cond 4 = false → Q 47 g (rfz f) V)
theorem c_38 (prof : Profile) : Sp prof ncs ncs_at 38 W_38 :=
  Sp.blk_then (blk_38 prof) (Sp.jcc_then (spj_45 prof) (Sp.skip 60) (Sp.skip 47))

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 7 = true → W_64 F Wl Q g (rfz f) V) ∧
    (f.cond 7 = false → W_38 F Wl Q g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof ncs ncs_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_36 prof) (c_64 prof) (c_38 prof))

def W_47 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → W_32 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 60 g (rfz f) V)
theorem c_47 (prof : Profile) : Sp prof ncs ncs_at 47 W_47 :=
  Sp.blk_then (blk_47 prof) (Sp.jcc_then (spj_58 prof) (c_32 prof) (Sp.skip 60))

def W_60 : Wpt := fun F Wl Q => wp F Wl o5 (Q 63)
theorem c_60 (prof : Profile) : Sp prof ncs ncs_at 60 W_60 := Sp.blk_then (blk_60 prof) (Sp.skip 63)

/-- The cut points. -/
def cuts : List Nat := [0, 47, 60]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 47 then W_47 else
  if ℓ = 60 then W_60 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ncs ncs_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_47 prof) <|
  Sp.table (c_60 prof) <|
  Sp.never ℓ

end FV7z.Ncs
