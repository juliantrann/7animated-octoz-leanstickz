import FV7z.Pml.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `pthread_mutex_lock` (PLAN.md G3, pthread)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (47, 79, 91, 96, 144, 152, 208, 222, 345, 364, 389, 415; the
`ret`). `Wt` is the table of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by
`tools/blk_gen.py`.
-/
namespace FV7z.Pml
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_40 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 47)
theorem c_40 (prof : Profile) (fb : Addr) : SpF prof pml pml_at fb 40 (W_40 fb) :=
  SpF.blk_then (blk_40 prof) (SpF.skip 47)

def W_30 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 96 g (rfz f) V) ∧
    (f.cond 5 = false → W_40 fb F Wl Q g (rfz f) V)
theorem c_30 (prof : Profile) (fb : Addr) : SpF prof pml pml_at fb 30 (W_30 fb) :=
  SpF.blkA_then (blk_30 prof) (SpF.jcc_then (spj_38 prof fb) (SpF.skip 96) (c_40 prof fb))

def W_21 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 152 g (rfz f) V) ∧
    (f.cond 5 = false → W_30 fb F Wl Q g (rfz f) V)
theorem c_21 (prof : Profile) (fb : Addr) : SpF prof pml pml_at fb 21 (W_21 fb) :=
  SpF.blk_then (blk_21 prof) (SpF.jcc_then (spj_28 prof fb) (SpF.skip 152) (c_30 prof fb))

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → Q 144 g (rfz f) V) ∧
    (f.cond 5 = false → W_21 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof pml pml_at fb 0 (W_0 fb) :=
  SpF.blk_then (blk_0 prof) (SpF.jcc_then (spj_19 prof fb) (SpF.skip 144) (c_21 prof fb))

def W_68 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o5 fb) (Q 79)
theorem c_68 (prof : Profile) (fb : Addr) : SpF prof pml pml_at fb 68 (W_68 fb) :=
  SpF.blkF_then (blk_68 prof fb) (SpF.skip 79)

def W_57 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 5 = true → Q 389 g (rfz f) V) ∧
    (f.cond 5 = false → W_68 fb F Wl Q g (rfz f) V)
theorem c_57 (prof : Profile) (fb : Addr) : SpF prof pml pml_at fb 57 (W_57 fb) :=
  SpF.blk_then (blk_57 prof) (SpF.jcc_then (spj_62 prof fb) (SpF.skip 389) (c_68 prof fb))

def W_51 (fb : Addr) : Wpt := fun F Wl Q g f V =>
    (f.cond 5 = true → Q 208 g (rfz f) V) ∧
    (f.cond 5 = false → W_57 fb F Wl Q g (rfz f) V)
theorem c_51 (prof : Profile) (fb : Addr) : SpF prof pml pml_at fb 51 (W_51 fb) :=
  SpF.jcc_then (spj_51 prof fb) (SpF.skip 208) (c_57 prof fb)

def W_86 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o7 (Q 91)
theorem c_86 (prof : Profile) (fb : Addr) : SpF prof pml pml_at fb 86 (W_86 fb) :=
  SpF.blk_then (blk_86 prof) (SpF.skip 91)

def W_83 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o6 (W_86 fb F Wl Q)
theorem c_83 (prof : Profile) (fb : Addr) : SpF prof pml pml_at fb 83 (W_83 fb) :=
  SpF.blk_then (blk_83 prof) (c_86 prof fb)

/-- The cut points. -/
def cuts : List Nat := [0, 51, 83]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 51 then W_51 fb else
  if ℓ = 83 then W_83 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof pml pml_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_51 prof fb) <|
  SpF.table (c_83 prof fb) <|
  SpF.never ℓ

end FV7z.Pml
