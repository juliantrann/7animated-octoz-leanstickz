/-- The cut points. -/
def cuts : List Nat := [0, 312, 900, 1644, 1690]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 312 then W_312 else
  if ℓ = 900 then W_900 else
  if ℓ = 1644 then W_1644 else
  if ℓ = 1690 then W_1690 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof smm smm_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_312 prof) <|
  Sp.table (c_900 prof) <|
  Sp.table (c_1644 prof) <|
  Sp.table (c_1690 prof) <|
  Sp.never ℓ

