import FV7z.Npl.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CStdOutStream::NormalizePrint_UString` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (42, 47, 61; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Npl
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_48 : Wpt := fun F Wl Q => wp F Wl o3 (Q 61)
theorem c_48 (prof : Profile) : Sp prof npl npl_at 48 W_48 := Sp.blk_then (blk_48 prof) (Sp.skip 61)

def W_23 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → W_48 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 29 g (rfz f) V)
theorem c_23 (prof : Profile) : Sp prof npl npl_at 23 W_23 :=
  Sp.blk_then (blk_23 prof) (Sp.jcc_then (spj_27 prof) (c_48 prof) (Sp.skip 29))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 29 g (rfz f) V) ∧
    (f.cond 4 = false → W_23 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof npl npl_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_21 prof) (Sp.skip 29) (c_23 prof))

def W_29 : Wpt := fun F Wl Q => wp F Wl o2 (Q 42)
theorem c_29 (prof : Profile) : Sp prof npl npl_at 29 W_29 := Sp.blk_then (blk_29 prof) (Sp.skip 42)

def W_66 : Wpt := fun F Wl Q g f V =>
    Q 29 g (rfz f) V
theorem c_66 (prof : Profile) : Sp prof npl npl_at 66 W_66 :=
  Sp.jmp_then (spj_66 prof) (Sp.skip 29)

/-- The cut points. -/
def cuts : List Nat := [0, 29, 66]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 29 then W_29 else
  if ℓ = 66 then W_66 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof npl npl_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_29 prof) <|
  Sp.table (c_66 prof) <|
  Sp.never ℓ

end FV7z.Npl
