  if ℓ = 286 then W_286 fb else
  if ℓ = 312 then W_312 fb else
  if ℓ = 343 then W_343 fb else
  if ℓ = 355 then W_355 fb else
  if ℓ = 369 then W_369 fb else
  if ℓ = 381 then W_381 fb else
  if ℓ = 393 then W_393 fb else
  if ℓ = 414 then W_414 fb else
  if ℓ = 490 then W_490 fb else
  if ℓ = 532 then W_532 fb else
  if ℓ = 540 then W_540 fb else
  if ℓ = 585 then W_585 fb else
  if ℓ = 600 then W_600 fb else
  if ℓ = 608 then W_608 fb else
  if ℓ = 624 then W_624 fb else
  if ℓ = 658 then W_658 fb else
  fun _ _ _ _ _ _ => False

