import FV7z.Ain.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `AString::Insert` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (33, 54, 73, 78, 90; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ain
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_40 : Wpt := fun F Wl Q => wp F Wl o2 (Q 54)
theorem c_40 (prof : Profile) : Sp prof ain ain_at 40 W_40 := Sp.blk_then (blk_40 prof) (Sp.skip 54)

def W_25 : Wpt := fun F Wl Q => wp F Wl o1 (Q 33)
theorem c_25 (prof : Profile) : Sp prof ain ain_at 25 W_25 := Sp.blk_then (blk_25 prof) (Sp.skip 33)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → W_40 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → W_25 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof ain ain_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_23 prof) (c_40 prof) (c_25 prof))

def W_59 : Wpt := fun F Wl Q => wp F Wl o3 (Q 73)
theorem c_59 (prof : Profile) : Sp prof ain ain_at 59 W_59 := Sp.blk_then (blk_59 prof) (Sp.skip 73)

def W_82 : Wpt := fun F Wl Q => wp F Wl o1 (Q 90)
theorem c_82 (prof : Profile) : Sp prof ain ain_at 82 W_82 := Sp.blk_then (blk_82 prof) (Sp.skip 90)

/-- The cut points. -/
def cuts : List Nat := [0, 59, 82]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 59 then W_59 else
  if ℓ = 82 then W_82 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ain ain_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_59 prof) <|
  Sp.table (c_82 prof) <|
  Sp.never ℓ

end FV7z.Ain
