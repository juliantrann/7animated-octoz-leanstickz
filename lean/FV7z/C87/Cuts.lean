/-- The cut points. -/
def cuts : List Nat := [2160, 2208, 2233, 2250, 2272, 2296, 2364]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 2160 then W_2160 else
  if ℓ = 2208 then W_2208 else
  if ℓ = 2233 then W_2233 else
  if ℓ = 2250 then W_2250 else
  if ℓ = 2272 then W_2272 else
  if ℓ = 2296 then W_2296 else
  if ℓ = 2364 then W_2364 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof sti sti_at ℓ (Wt ℓ) :=
  Sp.table (c_2160 prof) <|
  Sp.table (c_2208 prof) <|
  Sp.table (c_2233 prof) <|
  Sp.table (c_2250 prof) <|
  Sp.table (c_2272 prof) <|
  Sp.table (c_2296 prof) <|
  Sp.table (c_2364 prof) <|
  Sp.never ℓ

