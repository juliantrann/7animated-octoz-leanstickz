import FV7z.Mbs.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `MultiByteToUnicodeString (const AString &, UINT)` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (18, 32, 45; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Mbs
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o0 (Q 18)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof mbs mbs_at fb 0 (W_0 fb) :=
  SpF.blk_then (blk_0 prof) (SpF.skip 18)

def W_23 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 32)
theorem c_23 (prof : Profile) (fb : Addr) : SpF prof mbs mbs_at fb 23 (W_23 fb) :=
  SpF.blk_then (blk_23 prof) (SpF.skip 32)

def W_37 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 45)
theorem c_37 (prof : Profile) (fb : Addr) : SpF prof mbs mbs_at fb 37 (W_37 fb) :=
  SpF.blk_then (blk_37 prof) (SpF.skip 45)

/-- The cut points. -/
def cuts : List Nat := [0, 23, 37]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 23 then W_23 fb else
  if ℓ = 37 then W_37 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof mbs mbs_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_23 prof fb) <|
  SpF.table (c_37 prof fb) <|
  SpF.never ℓ

end FV7z.Mbs
