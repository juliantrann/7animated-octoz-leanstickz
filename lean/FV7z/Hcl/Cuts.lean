import FV7z.Hcl.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NArchive::NLzma::CHandler::Close` (PLAN.md §M, M1)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (40, 63, 77; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Hcl
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_37 : Wpt := fun F Wl Q => wp F Wl o1 (Q 40)
theorem c_37 (prof : Profile) : Sp prof hcl hcl_at 37 W_37 := Sp.blk_then (blk_37 prof) (Sp.skip 40)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 51 g (rfz f) V) ∧
    (f.cond 4 = false → W_37 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof hcl hcl_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_35 prof) (Sp.skip 51) (c_37 prof))

def W_43 : Wpt := fun F Wl Q => wp F Wl o2 (Q 51)
theorem c_43 (prof : Profile) : Sp prof hcl hcl_at 43 W_43 := Sp.blk_then (blk_43 prof) (Sp.skip 51)

def W_60 : Wpt := fun F Wl Q => wp F Wl o1 (Q 63)
theorem c_60 (prof : Profile) : Sp prof hcl hcl_at 60 W_60 := Sp.blk_then (blk_60 prof) (Sp.skip 63)

def W_51 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 74 g (rfz f) V) ∧
    (f.cond 4 = false → W_60 F Wl Q g (rfz f) V)
theorem c_51 (prof : Profile) : Sp prof hcl hcl_at 51 W_51 :=
  Sp.blk_then (blk_51 prof) (Sp.jcc_then (spj_58 prof) (Sp.skip 74) (c_60 prof))

def W_66 : Wpt := fun F Wl Q => wp F Wl o4 (Q 74)
theorem c_66 (prof : Profile) : Sp prof hcl hcl_at 66 W_66 := Sp.blk_then (blk_66 prof) (Sp.skip 74)

def W_74 : Wpt := fun F Wl Q => wp F Wl o5 (Q 77)
theorem c_74 (prof : Profile) : Sp prof hcl hcl_at 74 W_74 := Sp.blk_then (blk_74 prof) (Sp.skip 77)

/-- The cut points. -/
def cuts : List Nat := [0, 43, 51, 66, 74]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 43 then W_43 else
  if ℓ = 51 then W_51 else
  if ℓ = 66 then W_66 else
  if ℓ = 74 then W_74 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof hcl hcl_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_43 prof) <|
  Sp.table (c_51 prof) <|
  Sp.table (c_66 prof) <|
  Sp.table (c_74 prof) <|
  Sp.never ℓ

end FV7z.Hcl
