import FV7z.Onc.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__open64_nocancel` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (74, 104, 105, 112, 146, 171; the `ret`). `Wt` is the table of
the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Onc
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_58 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 74)
theorem c_58 (prof : Profile) (fb : Addr) : SpF prof onc onc_at fb 58 (W_58 fb) :=
  SpF.blk_then (blk_58 prof) (SpF.skip 74)

def W_44 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 112 g (rfz f) V) ∧
    (f.cond 4 = false → W_58 fb F Wl Q g (rfz f) V)
theorem c_44 (prof : Profile) (fb : Addr) : SpF prof onc onc_at fb 44 (W_44 fb) :=
  SpF.blk_then (blk_44 prof) (SpF.jcc_then (spj_56 prof fb) (SpF.skip 112) (c_58 prof fb))

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) fun g f V =>
    (f.cond 5 = true → Q 112 g (rfz f) V) ∧
    (f.cond 5 = false → W_44 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof onc onc_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.jcc_then (spj_42 prof fb) (SpF.skip 112) (c_44 prof fb))

def W_152 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o6 fb) fun g f V =>
    Q 84 g (rfz f) V
theorem c_152 (prof : Profile) (fb : Addr) : SpF prof onc onc_at fb 152 (W_152 fb) :=
  SpF.blkF_then (blk_152 prof fb) (SpF.jmp_then (spj_169 prof fb) (SpF.skip 84))

def W_76 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 7 = true → W_152 fb F Wl Q g (rfz f) V) ∧
    (f.cond 7 = false → Q 84 g (rfz f) V)
theorem c_76 (prof : Profile) (fb : Addr) : SpF prof onc onc_at fb 76 (W_76 fb) :=
  SpF.blk_then (blk_76 prof) (SpF.jcc_then (spj_82 prof fb) (c_152 prof fb) (SpF.skip 84))

def W_100 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 (Q 104)
theorem c_100 (prof : Profile) (fb : Addr) : SpF prof onc onc_at fb 100 (W_100 fb) :=
  SpF.blk_then (blk_100 prof) (SpF.skip 104)

def W_84 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o4 fb) fun g f V =>
    (f.cond 5 = true → Q 171 g (rfz f) V) ∧
    (f.cond 5 = false → W_100 fb F Wl Q g (rfz f) V)
theorem c_84 (prof : Profile) (fb : Addr) : SpF prof onc onc_at fb 84 (W_84 fb) :=
  SpF.blkF_then (blk_84 prof fb) (SpF.jcc_then (spj_98 prof fb) (SpF.skip 171) (c_100 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 76, 84]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 76 then W_76 fb else
  if ℓ = 84 then W_84 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof onc onc_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_76 prof fb) <|
  SpF.table (c_84 prof fb) <|
  SpF.never ℓ

end FV7z.Onc
