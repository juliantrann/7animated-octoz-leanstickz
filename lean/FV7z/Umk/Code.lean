/-!
# The code of `umask` in `7zzs` (PLAN.md §M, M1)

The bytes of glibc 2.31's `umask` (`sysdeps/unix/syscalls.list`; `objdump -d`), as a list, and the fact that they are the file's (`umk_pin`, by the kernel's evaluation of Zellic's
ELF reader). Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Umk
set_option maxRecDepth 100000
open ZellicX86

/-- `umask`, `0x665480` to `0x66548b` of `7zzs`. -/
def umk : List Byte := [
  0xf3, 0x0f, 0x1e, 0xfa, 0xb8, 0x5f, 0x00, 0x00, 0x00, 0x0f, 0x05, 0xc3]

theorem umk_pin : Exe.bytesAt V2606.zzs.blob 0x665480 12 = some umk := by decide +kernel
theorem umk_length : umk.length = 12 := by decide +kernel

/-- Where the code lies in `7zzs`. -/
abbrev umk_at : Addr := 0x665480

end FV7z.Umk
