/-- The cut points. -/
def cuts : List Nat := [0, 36, 48, 51]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 36 then W_36 else
  if ℓ = 48 then W_48 else
  if ℓ = 51 then W_51 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof gae gae_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_36 prof) <|
  Sp.table (c_48 prof) <|
  Sp.table (c_51 prof) <|
  Sp.never ℓ

