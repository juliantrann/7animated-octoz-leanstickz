import FV7z.Smd.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `Set_ModuleDirPrefix_From_ProgArg0` (PLAN.md §M, M1)

The 6 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (34, 42, 78, 92, 118, 119; the `ret`). `Wt` is the table of
the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Smd
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 34)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof smd smd_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 34)

def W_39 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 42)
theorem c_39 (prof : Profile) (fb : Addr) : SpF prof smd smd_at fb 39 (W_39 fb) :=
  SpF.blk_then (blk_39 prof) (SpF.skip 42)

def W_56 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 68)
theorem c_56 (prof : Profile) (fb : Addr) : SpF prof smd smd_at fb 56 (W_56 fb) :=
  SpF.blk_then (blk_56 prof) (SpF.skip 68)

def W_47 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 3 = true → Q 68 g (rfz f) V) ∧
    (f.cond 3 = false → W_56 fb F Wl Q g (rfz f) V)
theorem c_47 (prof : Profile) (fb : Addr) : SpF prof smd smd_at fb 47 (W_47 fb) :=
  SpF.blk_then (blk_47 prof) (SpF.jcc_then (spj_54 prof fb) (SpF.skip 68) (c_56 prof fb))

def W_68 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 (Q 78)
theorem c_68 (prof : Profile) (fb : Addr) : SpF prof smd smd_at fb 68 (W_68 fb) :=
  SpF.blkA_then (blk_68 prof) (SpF.skip 78)

def W_83 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 4 = true → Q 97 g (rfz f) V) ∧
    (f.cond 4 = false → Q 92 g (rfz f) V)
theorem c_83 (prof : Profile) (fb : Addr) : SpF prof smd smd_at fb 83 (W_83 fb) :=
  SpF.blk_then (blk_83 prof) (SpF.jcc_then (spj_90 prof fb) (SpF.skip 97) (SpF.skip 92))

def W_113 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o7 (Q 118)
theorem c_113 (prof : Profile) (fb : Addr) : SpF prof smd smd_at fb 113 (W_113 fb) :=
  SpF.blk_then (blk_113 prof) (SpF.skip 118)

def W_97 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o6 fb) fun g f V =>
    (f.cond 5 = true → Q 119 g (rfz f) V) ∧
    (f.cond 5 = false → W_113 fb F Wl Q g (rfz f) V)
theorem c_97 (prof : Profile) (fb : Addr) : SpF prof smd smd_at fb 97 (W_97 fb) :=
  SpF.blkF_then (blk_97 prof fb) (SpF.jcc_then (spj_111 prof fb) (SpF.skip 119) (c_113 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 39, 47, 68, 83, 97]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 39 then W_39 fb else
  if ℓ = 47 then W_47 fb else
  if ℓ = 68 then W_68 fb else
  if ℓ = 83 then W_83 fb else
  if ℓ = 97 then W_97 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof smd smd_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_39 prof fb) <|
  SpF.table (c_47 prof fb) <|
  SpF.table (c_68 prof fb) <|
  SpF.table (c_83 prof fb) <|
  SpF.table (c_97 prof fb) <|
  SpF.never ℓ

end FV7z.Smd
