import FV7z.Ldd.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NCompress::NLzma::CDecoder::~CDecoder` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (110, 119, 139, 143; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ldd
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 110)
theorem c_0 (prof : Profile) : Sp prof ldd ldd_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 110)

def W_115 : Wpt := fun F Wl Q => wp F Wl o1 (Q 119)
theorem c_115 (prof : Profile) : Sp prof ldd ldd_at 115 W_115 := Sp.blk_then (blk_115 prof) (Sp.skip 119)

def W_136 : Wpt := fun F Wl Q => wp F Wl o3 (Q 139)
theorem c_136 (prof : Profile) : Sp prof ldd ldd_at 136 W_136 := Sp.blk_then (blk_136 prof) (Sp.skip 139)

def W_124 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 142 g (rfz f) V) ∧
    (f.cond 4 = false → W_136 F Wl Q g (rfz f) V)
theorem c_124 (prof : Profile) : Sp prof ldd ldd_at 124 W_124 :=
  Sp.blk_then (blk_124 prof) (Sp.jcc_then (spj_134 prof) (Sp.skip 142) (c_136 prof))

def W_142 : Wpt := fun F Wl Q => wp F Wl o4 (Q 143)
theorem c_142 (prof : Profile) : Sp prof ldd ldd_at 142 W_142 := Sp.blk_then (blk_142 prof) (Sp.skip 143)

/-- The cut points. -/
def cuts : List Nat := [0, 115, 124, 142]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 115 then W_115 else
  if ℓ = 124 then W_124 else
  if ℓ = 142 then W_142 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ldd ldd_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_115 prof) <|
  Sp.table (c_124 prof) <|
  Sp.table (c_142 prof) <|
  Sp.never ℓ

end FV7z.Ldd
