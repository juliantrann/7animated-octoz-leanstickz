import FV7z.Pui.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `Print_UInt64_and_String` (PLAN.md §M, M1)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (44, 55, 63, 74, 104, 105; the `ret`). `Wt` is the table of
the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Pui
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 44)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof pui pui_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 44)

def W_49 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 55)
theorem c_49 (prof : Profile) (fb : Addr) : SpF prof pui pui_at fb 49 (W_49 fb) :=
  SpF.blk_then (blk_49 prof) (SpF.skip 55)

def W_60 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 63)
theorem c_60 (prof : Profile) (fb : Addr) : SpF prof pui pui_at fb 60 (W_60 fb) :=
  SpF.blk_then (blk_60 prof) (SpF.skip 63)

def W_68 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 74)
theorem c_68 (prof : Profile) (fb : Addr) : SpF prof pui pui_at fb 68 (W_68 fb) :=
  SpF.blk_then (blk_68 prof) (SpF.skip 74)

def W_95 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 (Q 104)
theorem c_95 (prof : Profile) (fb : Addr) : SpF prof pui pui_at fb 95 (W_95 fb) :=
  SpF.blk_then (blk_95 prof) (SpF.skip 104)

def W_79 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o4 fb) fun g f V =>
    (f.cond 5 = true → Q 105 g (rfz f) V) ∧
    (f.cond 5 = false → W_95 fb F Wl Q g (rfz f) V)
theorem c_79 (prof : Profile) (fb : Addr) : SpF prof pui pui_at fb 79 (W_79 fb) :=
  SpF.blkF_then (blk_79 prof fb) (SpF.jcc_then (spj_93 prof fb) (SpF.skip 105) (c_95 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 49, 60, 68, 79]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 49 then W_49 fb else
  if ℓ = 60 then W_60 fb else
  if ℓ = 68 then W_68 fb else
  if ℓ = 79 then W_79 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof pui pui_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_49 prof fb) <|
  SpF.table (c_60 prof fb) <|
  SpF.table (c_68 prof fb) <|
  SpF.table (c_79 prof fb) <|
  SpF.never ℓ

end FV7z.Pui
