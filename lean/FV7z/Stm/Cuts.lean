import FV7z.Stm.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `systrim.isra.0.constprop.0` (PLAN.md §M, M1)

The 9 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (51, 81, 82, 94, 114, 141, 163, 168; the `ret`). `Wt` is the
table of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Stm
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_49 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 51)
theorem c_49 (prof : Profile) (fb : Addr) : SpF prof stm stm_at fb 49 (W_49 fb) :=
  SpF.blk_then (blk_49 prof) (SpF.skip 51)

def W_28 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 75 g (rfz f) V) ∧
    (f.cond 4 = false → W_49 fb F Wl Q g (rfz f) V)
theorem c_28 (prof : Profile) (fb : Addr) : SpF prof stm stm_at fb 28 (W_28 fb) :=
  SpF.blkA_then (blk_28 prof) (SpF.jcc_then (spj_47 prof fb) (SpF.skip 75) (c_49 prof fb))

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 6 = true → Q 75 g (rfz f) V) ∧
    (f.cond 6 = false → W_28 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof stm stm_at fb 0 (W_0 fb) :=
  SpF.blkA_then (blk_0 prof) (SpF.jcc_then (spj_26 prof fb) (SpF.skip 75) (c_28 prof fb))

def W_88 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o6 (Q 94)
theorem c_88 (prof : Profile) (fb : Addr) : SpF prof stm stm_at fb 88 (W_88 fb) :=
  SpF.blk_then (blk_88 prof) (SpF.skip 94)

def W_57 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → W_88 fb F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 75 g (rfz f) V)
theorem c_57 (prof : Profile) (fb : Addr) : SpF prof stm stm_at fb 57 (W_57 fb) :=
  SpF.blkA_then (blk_57 prof) (SpF.jcc_then (spj_73 prof fb) (c_88 prof fb) (SpF.skip 75))

def W_75 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 (Q 77)
theorem c_75 (prof : Profile) (fb : Addr) : SpF prof stm stm_at fb 75 (W_75 fb) :=
  SpF.blk_then (blk_75 prof) (SpF.skip 77)

def W_77 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 (Q 81)
theorem c_77 (prof : Profile) (fb : Addr) : SpF prof stm stm_at fb 77 (W_77 fb) :=
  SpF.blk_then (blk_77 prof) (SpF.skip 81)

def W_100 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    (f.cond 5 = true → Q 168 g (rfz f) V) ∧
    (f.cond 5 = false → Q 112 g (rfz f) V)
theorem c_100 (prof : Profile) (fb : Addr) : SpF prof stm stm_at fb 100 (W_100 fb) :=
  SpF.blkA_then (blk_100 prof) (SpF.jcc_then (spj_110 prof fb) (SpF.skip 168) (SpF.skip 112))

def W_112 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 114)
theorem c_112 (prof : Profile) (fb : Addr) : SpF prof stm stm_at fb 112 (W_112 fb) :=
  SpF.blk_then (blk_112 prof) (SpF.skip 114)

def W_131 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o10 (Q 141)
theorem c_131 (prof : Profile) (fb : Addr) : SpF prof stm stm_at fb 131 (W_131 fb) :=
  SpF.blkA_then (blk_131 prof) (SpF.skip 141)

def W_126 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o9 fun g f V =>
    (f.cond 4 = true → Q 75 g (rfz f) V) ∧
    (f.cond 4 = false → W_131 fb F Wl Q g (rfz f) V)
theorem c_126 (prof : Profile) (fb : Addr) : SpF prof stm stm_at fb 126 (W_126 fb) :=
  SpF.blk_then (blk_126 prof) (SpF.jcc_then (spj_129 prof fb) (SpF.skip 75) (c_131 prof fb))

def W_120 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    (f.cond 4 = true → Q 75 g (rfz f) V) ∧
    (f.cond 4 = false → W_126 fb F Wl Q g (rfz f) V)
theorem c_120 (prof : Profile) (fb : Addr) : SpF prof stm stm_at fb 120 (W_120 fb) :=
  SpF.blk_then (blk_120 prof) (SpF.jcc_then (spj_124 prof fb) (SpF.skip 75) (c_126 prof fb))

def W_148 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o11 fun g f V =>
    Q 77 g (rfz f) V
theorem c_148 (prof : Profile) (fb : Addr) : SpF prof stm stm_at fb 148 (W_148 fb) :=
  SpF.blk_then (blk_148 prof) (SpF.jmp_then (spj_161 prof fb) (SpF.skip 77))

def W_170 (fb : Addr) : Wpt := fun F Wl Q g f V =>
    Q 112 g (rfz f) V
theorem c_170 (prof : Profile) (fb : Addr) : SpF prof stm stm_at fb 170 (W_170 fb) :=
  SpF.jmp_then (spj_170 prof fb) (SpF.skip 112)

/-- The cut points. -/
def cuts : List Nat := [0, 57, 75, 77, 100, 112, 120, 148, 170]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 57 then W_57 fb else
  if ℓ = 75 then W_75 fb else
  if ℓ = 77 then W_77 fb else
  if ℓ = 100 then W_100 fb else
  if ℓ = 112 then W_112 fb else
  if ℓ = 120 then W_120 fb else
  if ℓ = 148 then W_148 fb else
  if ℓ = 170 then W_170 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof stm stm_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_57 prof fb) <|
  SpF.table (c_75 prof fb) <|
  SpF.table (c_77 prof fb) <|
  SpF.table (c_100 prof fb) <|
  SpF.table (c_112 prof fb) <|
  SpF.table (c_120 prof fb) <|
  SpF.table (c_148 prof fb) <|
  SpF.table (c_170 prof fb) <|
  SpF.never ℓ

end FV7z.Stm
