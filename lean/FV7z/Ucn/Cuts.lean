import FV7z.Ucn.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UString::UString(unsigned, const wchar_t*)` (PLAN.md §M, M1)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (65, 79, 105; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ucn
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_112 : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    Q 62 g (rfz f) V
theorem c_112 (prof : Profile) : Sp prof ucn ucn_at 112 W_112 :=
  Sp.blk_then (blk_112 prof) (Sp.jmp_then (spj_120 prof) (Sp.skip 62))

def W_26 : Wpt := fun F Wl Q => wp F Wl o1 (Q 32)
theorem c_26 (prof : Profile) : Sp prof ucn ucn_at 26 W_26 := Sp.blk_then (blk_26 prof) (Sp.skip 32)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → W_112 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_26 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof ucn ucn_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_24 prof) (c_112 prof) (c_26 prof))

def W_46 : Wpt := fun F Wl Q => wp F Wl o3 (Q 62)
theorem c_46 (prof : Profile) : Sp prof ucn ucn_at 46 W_46 := Sp.blk_then (blk_46 prof) (Sp.skip 62)

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 32 g (rfz f) V) ∧
    (f.cond 5 = false → W_46 F Wl Q g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof ucn ucn_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_44 prof) (Sp.skip 32) (c_46 prof))

def W_62 : Wpt := fun F Wl Q => wp F Wl o4 (Q 65)
theorem c_62 (prof : Profile) : Sp prof ucn ucn_at 62 W_62 := Sp.blk_then (blk_62 prof) (Sp.skip 65)

def W_70 : Wpt := fun F Wl Q => wp F Wl o5 (Q 79)
theorem c_70 (prof : Profile) : Sp prof ucn ucn_at 70 W_70 := Sp.blk_then (blk_70 prof) (Sp.skip 79)

def W_84 : Wpt := fun F Wl Q => wp F Wl o6 (Q 105)
theorem c_84 (prof : Profile) : Sp prof ucn ucn_at 84 W_84 := Sp.blk_then (blk_84 prof) (Sp.skip 105)

/-- The cut points. -/
def cuts : List Nat := [0, 32, 62, 70, 84]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 32 then W_32 else
  if ℓ = 62 then W_62 else
  if ℓ = 70 then W_70 else
  if ℓ = 84 then W_84 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ucn ucn_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_32 prof) <|
  Sp.table (c_62 prof) <|
  Sp.table (c_70 prof) <|
  Sp.table (c_84 prof) <|
  Sp.never ℓ

end FV7z.Ucn
