import FV7z.Tci.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `tcache_init` (PLAN.md G3, `malloc`)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (42, 54, 87, 146, 150, 160, 180, 196, 224, 232, 248, 272, 293,
304, 339; the `ret`). `Wt` is the table of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by
`tools/blk_gen.py`.
-/
namespace FV7z.Tci
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_37 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 42)
theorem c_37 (prof : Profile) (fb : Addr) : SpF prof tci tci_at fb 37 (W_37 fb) :=
  SpF.blk_then (blk_37 prof) (SpF.skip 42)

def W_21 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o1 fb) fun g f V =>
    (f.cond 5 = true → Q 272 g (rfz f) V) ∧
    (f.cond 5 = false → W_37 fb F Wl Q g (rfz f) V)
theorem c_21 (prof : Profile) (fb : Addr) : SpF prof tci tci_at fb 21 (W_21 fb) :=
  SpF.blkF_then (blk_21 prof fb) (SpF.jcc_then (spj_31 prof fb) (SpF.skip 272) (c_37 prof fb))

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) fun g f V =>
    (f.cond 4 = true → Q 160 g (rfz f) V) ∧
    (f.cond 4 = false → W_21 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof tci tci_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.jcc_then (spj_15 prof fb) (SpF.skip 160) (c_21 prof fb))

def W_46 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 54)
theorem c_46 (prof : Profile) (fb : Addr) : SpF prof tci tci_at fb 46 (W_46 fb) :=
  SpF.blk_then (blk_46 prof) (SpF.skip 54)

def W_71 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o5 fb) fun g f V =>
    (f.cond 5 = true → Q 304 g (rfz f) V) ∧
    (f.cond 5 = false → Q 87 g (rfz f) V)
theorem c_71 (prof : Profile) (fb : Addr) : SpF prof tci tci_at fb 71 (W_71 fb) :=
  SpF.blkF_then (blk_71 prof fb) (SpF.jcc_then (spj_81 prof fb) (SpF.skip 304) (SpF.skip 87))

def W_59 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → Q 224 g (rfz f) V) ∧
    (f.cond 4 = false → W_71 fb F Wl Q g (rfz f) V)
theorem c_59 (prof : Profile) (fb : Addr) : SpF prof tci tci_at fb 59 (W_59 fb) :=
  SpF.blk_then (blk_59 prof) (SpF.jcc_then (spj_65 prof fb) (SpF.skip 224) (c_71 prof fb))

def W_96 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o7 fb) (Q 146)
theorem c_96 (prof : Profile) (fb : Addr) : SpF prof tci tci_at fb 96 (W_96 fb) :=
  SpF.blkF_then (blk_96 prof fb) (SpF.skip 146)

def W_91 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    (f.cond 4 = true → Q 149 g (rfz f) V) ∧
    (f.cond 4 = false → W_96 fb F Wl Q g (rfz f) V)
theorem c_91 (prof : Profile) (fb : Addr) : SpF prof tci tci_at fb 91 (W_91 fb) :=
  SpF.blk_then (blk_91 prof) (SpF.jcc_then (spj_94 prof fb) (SpF.skip 149) (c_96 prof fb))

def W_149 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o8 (Q 150)
theorem c_149 (prof : Profile) (fb : Addr) : SpF prof tci tci_at fb 149 (W_149 fb) :=
  SpF.blk_then (blk_149 prof) (SpF.skip 150)

/-- The cut points. -/
def cuts : List Nat := [0, 46, 59, 91, 149]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 46 then W_46 fb else
  if ℓ = 59 then W_59 fb else
  if ℓ = 91 then W_91 fb else
  if ℓ = 149 then W_149 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof tci tci_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_46 prof fb) <|
  SpF.table (c_59 prof fb) <|
  SpF.table (c_91 prof fb) <|
  SpF.table (c_149 prof fb) <|
  SpF.never ℓ

end FV7z.Tci
