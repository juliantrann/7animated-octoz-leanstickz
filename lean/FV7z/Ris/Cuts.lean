import FV7z.Ris.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CDecoder::ReleaseInStream` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (23, 40; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ris
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_20 : Wpt := fun F Wl Q => wp F Wl o1 (Q 23)
theorem c_20 (prof : Profile) : Sp prof ris ris_at 20 W_20 := Sp.blk_then (blk_20 prof) (Sp.skip 23)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 37 g (rfz f) V) ∧
    (f.cond 4 = false → W_20 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof ris ris_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_18 prof) (Sp.skip 37) (c_20 prof))

def W_26 : Wpt := fun F Wl Q => wp F Wl o2 (Q 37)
theorem c_26 (prof : Profile) : Sp prof ris ris_at 26 W_26 := Sp.blk_then (blk_26 prof) (Sp.skip 37)

def W_37 : Wpt := fun F Wl Q => wp F Wl o3 (Q 40)
theorem c_37 (prof : Profile) : Sp prof ris ris_at 37 W_37 := Sp.blk_then (blk_37 prof) (Sp.skip 40)

/-- The cut points. -/
def cuts : List Nat := [0, 26, 37]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 26 then W_26 else
  if ℓ = 37 then W_37 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ris ris_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_26 prof) <|
  Sp.table (c_37 prof) <|
  Sp.never ℓ

end FV7z.Ris
