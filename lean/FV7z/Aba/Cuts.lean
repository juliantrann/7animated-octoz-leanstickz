import FV7z.Aba.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `AllocBstrFromAscii` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (18, 30, 70, 88, 98; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Aba
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_96 : Wpt := fun F Wl Q => wp F Wl o8 (Q 98)
theorem c_96 (prof : Profile) : Sp prof aba aba_at 96 W_96 := Sp.blk_then (blk_96 prof) (Sp.skip 98)

def W_9 : Wpt := fun F Wl Q => wp F Wl o1 (Q 18)
theorem c_9 (prof : Profile) : Sp prof aba aba_at 9 W_9 := Sp.blk_then (blk_9 prof) (Sp.skip 18)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → W_96 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_9 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof aba aba_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_7 prof) (c_96 prof) (c_9 prof))

def W_23 : Wpt := fun F Wl Q => wp F Wl o2 (Q 30)
theorem c_23 (prof : Profile) : Sp prof aba aba_at 23 W_23 := Sp.blk_then (blk_23 prof) (Sp.skip 30)

def W_80 : Wpt := fun F Wl Q => wp F Wl o7 (Q 88)
theorem c_80 (prof : Profile) : Sp prof aba aba_at 80 W_80 := Sp.blk_then (blk_80 prof) (Sp.skip 88)

def W_40 : Wpt := fun F Wl Q => wp F Wl o4 (Q 48)
theorem c_40 (prof : Profile) : Sp prof aba aba_at 40 W_40 := Sp.blk_then (blk_40 prof) (Sp.skip 48)

def W_35 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → W_80 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_40 F Wl Q g (rfz f) V)
theorem c_35 (prof : Profile) : Sp prof aba aba_at 35 W_35 :=
  Sp.blk_then (blk_35 prof) (Sp.jcc_then (spj_38 prof) (c_80 prof) (c_40 prof))

def W_64 : Wpt := fun F Wl Q => wp F Wl o6 (Q 70)
theorem c_64 (prof : Profile) : Sp prof aba aba_at 64 W_64 := Sp.blk_then (blk_64 prof) (Sp.skip 70)

def W_48 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 3 = true → Q 48 g (rfz f) V) ∧
    (f.cond 3 = false → W_64 F Wl Q g (rfz f) V)
theorem c_48 (prof : Profile) : Sp prof aba aba_at 48 W_48 :=
  Sp.blk_then (blk_48 prof) (Sp.jcc_then (spj_62 prof) (Sp.skip 48) (c_64 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 23, 35, 48]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 23 then W_23 else
  if ℓ = 35 then W_35 else
  if ℓ = 48 then W_48 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof aba aba_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_23 prof) <|
  Sp.table (c_35 prof) <|
  Sp.table (c_48 prof) <|
  Sp.never ℓ

end FV7z.Aba
