/-- The cut points. -/
def cuts : List Nat := [0, 106, 121, 195, 215, 284, 312, 368, 391, 400, 432, 443, 456, 472, 493]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 106 then W_106 fb else
  if ℓ = 121 then W_121 fb else
  if ℓ = 195 then W_195 fb else
  if ℓ = 215 then W_215 fb else
  if ℓ = 284 then W_284 fb else
  if ℓ = 312 then W_312 fb else
  if ℓ = 368 then W_368 fb else
  if ℓ = 391 then W_391 fb else
  if ℓ = 400 then W_400 fb else
  if ℓ = 432 then W_432 fb else
  if ℓ = 443 then W_443 fb else
  if ℓ = 456 then W_456 fb else
  if ℓ = 472 then W_472 fb else
  if ℓ = 493 then W_493 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof mbu mbu_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_106 prof fb) <|
  SpF.table (c_121 prof fb) <|
  SpF.table (c_195 prof fb) <|
  SpF.table (c_215 prof fb) <|
  SpF.table (c_284 prof fb) <|
  SpF.table (c_312 prof fb) <|
  SpF.table (c_368 prof fb) <|
  SpF.table (c_391 prof fb) <|
  SpF.table (c_400 prof fb) <|
  SpF.table (c_432 prof fb) <|
  SpF.table (c_443 prof fb) <|
  SpF.table (c_456 prof fb) <|
  SpF.table (c_472 prof fb) <|
  SpF.table (c_493 prof fb) <|
  SpF.never ℓ

