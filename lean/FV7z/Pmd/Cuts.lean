import FV7z.Pmd.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__pthread_mutex_destroy` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (33; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Pmd
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_12 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 33 g (rfz f) V) ∧
    (f.cond 5 = false → Q 24 g (rfz f) V)
theorem c_12 (prof : Profile) : Sp prof pmd pmd_at 12 W_12 :=
  Sp.blk_then (blk_12 prof) (Sp.jcc_then (spj_22 prof) (Sp.skip 33) (Sp.skip 24))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → Q 24 g (rfz f) V) ∧
    (f.cond 5 = false → W_12 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof pmd pmd_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_10 prof) (Sp.skip 24) (c_12 prof))

def W_24 : Wpt := fun F Wl Q => wp F Wl o2 (Q 33)
theorem c_24 (prof : Profile) : Sp prof pmd pmd_at 24 W_24 := Sp.blk_then (blk_24 prof) (Sp.skip 33)

/-- The cut points. -/
def cuts : List Nat := [0, 24]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 24 then W_24 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof pmd pmd_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_24 prof) <|
  Sp.never ℓ

end FV7z.Pmd
