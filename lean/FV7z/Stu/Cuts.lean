/-- The cut points. -/
def cuts : List Nat := [0, 22, 40, 83, 101]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 22 then W_22 else
  if ℓ = 40 then W_40 else
  if ℓ = 83 then W_83 else
  if ℓ = 101 then W_101 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof stu stu_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_22 prof) <|
  Sp.table (c_40 prof) <|
  Sp.table (c_83 prof) <|
  Sp.table (c_101 prof) <|
  Sp.never ℓ

