import FV7z.Npp.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CStdOutStream::NormalizePrint_UString_Path (const UString &)` (PLAN.md §M, M1)

The 6 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (48, 56, 73, 88, 102, 134, 135; the `ret`). `Wt` is the table
of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Npp
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 48)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof npp npp_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 48)

def W_53 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 56)
theorem c_53 (prof : Profile) (fb : Addr) : SpF prof npp npp_at fb 53 (W_53 fb) :=
  SpF.blk_then (blk_53 prof) (SpF.skip 56)

def W_61 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 73)
theorem c_61 (prof : Profile) (fb : Addr) : SpF prof npp npp_at fb 61 (W_61 fb) :=
  SpF.blk_then (blk_61 prof) (SpF.skip 73)

def W_78 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 93 g (rfz f) V) ∧
    (f.cond 4 = false → Q 88 g (rfz f) V)
theorem c_78 (prof : Profile) (fb : Addr) : SpF prof npp npp_at fb 78 (W_78 fb) :=
  SpF.blk_then (blk_78 prof) (SpF.jcc_then (spj_86 prof fb) (SpF.skip 93) (SpF.skip 88))

def W_93 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → Q 107 g (rfz f) V) ∧
    (f.cond 4 = false → Q 102 g (rfz f) V)
theorem c_93 (prof : Profile) (fb : Addr) : SpF prof npp npp_at fb 93 (W_93 fb) :=
  SpF.blk_then (blk_93 prof) (SpF.jcc_then (spj_100 prof fb) (SpF.skip 107) (SpF.skip 102))

def W_123 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o6 (Q 134)
theorem c_123 (prof : Profile) (fb : Addr) : SpF prof npp npp_at fb 123 (W_123 fb) :=
  SpF.blk_then (blk_123 prof) (SpF.skip 134)

def W_107 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o5 fb) fun g f V =>
    (f.cond 5 = true → Q 135 g (rfz f) V) ∧
    (f.cond 5 = false → W_123 fb F Wl Q g (rfz f) V)
theorem c_107 (prof : Profile) (fb : Addr) : SpF prof npp npp_at fb 107 (W_107 fb) :=
  SpF.blkF_then (blk_107 prof fb) (SpF.jcc_then (spj_121 prof fb) (SpF.skip 135) (c_123 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 53, 61, 78, 93, 107]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 53 then W_53 fb else
  if ℓ = 61 then W_61 fb else
  if ℓ = 78 then W_78 fb else
  if ℓ = 93 then W_93 fb else
  if ℓ = 107 then W_107 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof npp npp_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_53 prof fb) <|
  SpF.table (c_61 prof fb) <|
  SpF.table (c_78 prof fb) <|
  SpF.table (c_93 prof fb) <|
  SpF.table (c_107 prof fb) <|
  SpF.never ℓ

end FV7z.Npp
