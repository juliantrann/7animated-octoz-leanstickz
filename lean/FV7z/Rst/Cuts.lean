import FV7z.Rst.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `ReadStream` (PLAN.md §M, M1)

The 6 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (111, 118, 161, 172; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Rst
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_49 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    Q 89 g (rfz f) V
theorem c_49 (prof : Profile) (fb : Addr) : SpF prof rst rst_at fb 49 (W_49 fb) :=
  SpF.blk_then (blk_49 prof) (SpF.jmp_then (spj_68 prof fb) (SpF.skip 89))

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) fun g f V =>
    (f.cond 4 = true → Q 168 g (rfz f) V) ∧
    (f.cond 4 = false → W_49 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof rst rst_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.jcc_then (spj_47 prof fb) (SpF.skip 168) (c_49 prof fb))

def W_89 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 (Q 111)
theorem c_89 (prof : Profile) (fb : Addr) : SpF prof rst rst_at fb 89 (W_89 fb) :=
  SpF.blk_then (blk_89 prof) (SpF.skip 111)

def W_114 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 (Q 118)
theorem c_114 (prof : Profile) (fb : Addr) : SpF prof rst rst_at fb 114 (W_114 fb) :=
  SpF.blk_then (blk_114 prof) (SpF.skip 118)

def W_84 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 168 g (rfz f) V) ∧
    (f.cond 4 = false → Q 89 g (rfz f) V)
theorem c_84 (prof : Profile) (fb : Addr) : SpF prof rst rst_at fb 84 (W_84 fb) :=
  SpF.blk_then (blk_84 prof) (SpF.jcc_then (spj_87 prof fb) (SpF.skip 168) (SpF.skip 89))

def W_80 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 131 g (rfz f) V) ∧
    (f.cond 4 = false → W_84 fb F Wl Q g (rfz f) V)
theorem c_80 (prof : Profile) (fb : Addr) : SpF prof rst rst_at fb 80 (W_80 fb) :=
  SpF.blk_then (blk_80 prof) (SpF.jcc_then (spj_82 prof fb) (SpF.skip 131) (c_84 prof fb))

def W_121 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    (f.cond 4 = true → W_80 fb F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 131 g (rfz f) V)
theorem c_121 (prof : Profile) (fb : Addr) : SpF prof rst rst_at fb 121 (W_121 fb) :=
  SpF.blk_then (blk_121 prof) (SpF.jcc_then (spj_129 prof fb) (c_80 prof fb) (SpF.skip 131))

def W_147 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o8 (Q 161)
theorem c_147 (prof : Profile) (fb : Addr) : SpF prof rst rst_at fb 147 (W_147 fb) :=
  SpF.blk_then (blk_147 prof) (SpF.skip 161)

def W_131 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o7 fb) fun g f V =>
    (f.cond 5 = true → Q 172 g (rfz f) V) ∧
    (f.cond 5 = false → W_147 fb F Wl Q g (rfz f) V)
theorem c_131 (prof : Profile) (fb : Addr) : SpF prof rst rst_at fb 131 (W_131 fb) :=
  SpF.blkF_then (blk_131 prof fb) (SpF.jcc_then (spj_145 prof fb) (SpF.skip 172) (c_147 prof fb))

def W_168 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o9 fun g f V =>
    Q 131 g (rfz f) V
theorem c_168 (prof : Profile) (fb : Addr) : SpF prof rst rst_at fb 168 (W_168 fb) :=
  SpF.blk_then (blk_168 prof) (SpF.jmp_then (spj_170 prof fb) (SpF.skip 131))

/-- The cut points. -/
def cuts : List Nat := [0, 89, 114, 121, 131, 168]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 89 then W_89 fb else
  if ℓ = 114 then W_114 fb else
  if ℓ = 121 then W_121 fb else
  if ℓ = 131 then W_131 fb else
  if ℓ = 168 then W_168 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof rst rst_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_89 prof fb) <|
  SpF.table (c_114 prof fb) <|
  SpF.table (c_121 prof fb) <|
  SpF.table (c_131 prof fb) <|
  SpF.table (c_168 prof fb) <|
  SpF.never ℓ

end FV7z.Rst
