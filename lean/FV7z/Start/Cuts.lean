/-- The cut points. -/
def cuts : List Nat := [0, 65, 76, 120, 136, 199]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 65 then W_65 else
  if ℓ = 76 then W_76 else
  if ℓ = 120 then W_120 else
