import FV7z.Start.Cpu
/-!
# What the image gives (PLAN.md G3, startup)

`Img V`: the bytes `V` at the addresses of the file's segments are the file's, as Zellic's ELF reader reads them
(`Exe.bytesAt`) and as `execve` maps them. From it, the facts about the image that the start of `__libc_start_main`
uses (`Ctx.Im`, by `Ctx.im`): `_dl_aux_init`'s jump table (`0x6f3660`), the string `GLIBC_TUNABLES` (`0x6f32b3`), and
the list of tunables (`0x791660`, 26 entries of 56 bytes) with its 9 aliases, strings of `.rodata`; and those
`init_cpu_features` and `apply_irel` use: the jump table at `0x6ee6d0` (`Img.jtab`) and the table of relocations
(`Img.rela`). So `Ctx.Ok` is what the launch gives (`Ctx.Lch`: the stack the kernel builds) and `Img` (`Ctx.ok`).
`Bss V`: the bytes after the file's in the last segment are 0; so `CInv` holds at the entry (`Bss.cinv`).

The bytes `tl` and `ts` are the file's (`tl_pin`, `ts_pin`, by the kernel's evaluation of the reader); the aliases'
addresses, strings and lengths (`aqI`, `azI`, `alenI`) are computed from them.
-/
namespace FV7z.Start
open ZellicX86 FV7z
open FV7z.Tun (gz)
set_option maxRecDepth 100000

/-- The file's bytes are at their addresses (the segments lie from `0x400000` to `0x7a86c0`). -/
def Img (V : Addr → Byte) : Prop :=
  ∀ a n bs, Exe.bytesAt V2606.zzs.blob a n = some bs → 0x400000 ≤ a → a + n ≤ 0x7a9000 →
    ∀ i, i < n → V (BitVec.ofNat 64 (a + i)) = bs.getD i 0

/-- A read of the file's bytes. -/
theorem Img.map {V : Addr → Byte} (h : Img V) {a n : Nat} {bs : List Byte}
    (hp : Exe.bytesAt V2606.zzs.blob a n = some bs) (hl : bs.length = n) (hlo : 0x400000 ≤ a)
    (hhi : a + n ≤ 0x7a9000) {off m : Nat} (hm : off + m ≤ n) :
    List.map V (byteAddrs (BitVec.ofNat 64 (a + off)) m) = (bs.drop off).take m := by
  apply List.ext_getElem
  · simp only [List.length_map, byteAddrs, List.length_range, List.length_take, List.length_drop]; omega
  · intro i h1 h2
    simp only [List.length_map, byteAddrs, List.length_range] at h1
    simp only [List.getElem_map, byteAddrs, List.getElem_range, List.getElem_take, List.getElem_drop]
    have e : Addr.add (BitVec.ofNat 64 (a + off)) i = BitVec.ofNat 64 (a + (off + i)) := by
      simp only [Addr.add]; bv_omega
    rw [e, h a n bs hp hlo hhi (off + i) (by omega)]
    simp only [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (show off + i < bs.length by omega),
      Option.getD_some]

