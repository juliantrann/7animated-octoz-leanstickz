theorem tl_pin : Exe.bytesAt V2606.zzs.blob 0x791660 1456 = some tl := by decide +kernel
theorem ts_pin : Exe.bytesAt V2606.zzs.blob 0x6f32b3 621 = some ts := by decide +kernel
theorem tl_length : tl.length = 1456 := by decide +kernel
theorem ts_length : ts.length = 621 := by decide +kernel

/-- Tunable `t`'s alias: its address (0 without one), its offset in `ts`, its bytes and its length. -/
def aqI (t : Nat) : Addr := ofBytesLE 64 ((tl.drop (48 + 56 * t)).take 8)
def aoff (t : Nat) : Nat := (aqI t).toNat - 0x6f32b3
def azI (t k : Nat) : Byte := ts.getD (aoff t + k) 0
def alenI (t : Nat) : Nat := ((ts.drop (aoff t)).takeWhile (· != 0)).length

theorem al_bd : ∀ t < 26, aqI t ≠ 0 → 0x6f32b3 ≤ (aqI t).toNat ∧ (aqI t).toNat + alenI t + 1 ≤ 0x6f32b3 + 621 := by
  decide +kernel
theorem al_z : ∀ t < 26, aqI t ≠ 0 → azI t (alenI t) = 0 := by decide +kernel
theorem al_nz : ∀ t < 26, aqI t ≠ 0 → ∀ k < alenI t, azI t k ≠ 0 := by decide +kernel
theorem ts_gz : ∀ k < 15, ts.getD k 0 = gz k := by decide +kernel
/-- The 9 aliases. -/
theorem al_list : (List.range 26).filter (fun t => aqI t != 0) = [1, 2, 8, 11, 12, 18, 19, 22, 25] := by
  decide +kernel

variable {K : Ctx} {V : Addr → Byte}

/-- `_dl_aux_init`'s jump table. -/
theorem Img.jt (h : Img V) (k : Nat) (hk : k < 31) : rdd(V, Addr.add 0x6f3660#64 (4 * k)) = Auxv.jt k := by
  have e : Addr.add 0x6f3660#64 (4 * k) = BitVec.ofNat 64 (0x6f3660 + 4 * k) := by simp only [Addr.add]; bv_omega
  rw [e, h.map Auxv.aux_jt_pin (by decide) (by decide) (by decide) (by omega)]
  rfl

/-- `GLIBC_TUNABLES`. -/
theorem Img.gz (h : Img V) (k : Nat) (hk : k < 15) : V (Addr.add 0x6f32b3#64 k) = gz k := by
  have e : Addr.add 0x6f32b3#64 k = BitVec.ofNat 64 (0x6f32b3 + k) := by simp only [Addr.add]; bv_omega
  rw [e, h _ _ _ ts_pin (by decide) (by decide) k (by omega)]
  exact ts_gz k hk

/-- `init_cpu_features`' jump table. -/
theorem Img.jtab (h : Img V) (i : Nat) (hi : i < 280) : V ((0x6ee6d0 : Addr).add i) = CpuFeat.jtab.getD i 0 := by
  have e : (0x6ee6d0 : Addr).add i = BitVec.ofNat 64 (0x6ee6d0 + i) := by simp only [Addr.add]; bv_omega
  rw [e, h _ _ _ CpuFeat.jtab_pin (by decide) (by decide) i hi]

/-- The table of relocations. -/
theorem Img.rela (h : Img V) (j : Nat) (hj : j < 744) : V ((0x400248 : Addr).add j) = CpuFeat.rela.getD j 0 := by
  have e : (0x400248 : Addr).add j = BitVec.ofNat 64 (0x400248 + j) := by simp only [Addr.add]; bv_omega
  rw [e, h _ _ _ CpuFeat.rela_pin (by decide) (by decide) j hj]

/-- What the image gives, of the file's bytes. -/
theorem Ctx.im (hI : Img K.V0) (himg : K.bp.toNat + 376 ≤ 0x400000 ∨ 0x7a9000 ≤ K.bp.toNat) (hq : K.aq = aqI)
    (hz : K.az = azI) (hl : K.alen = alenI) : K.Im where
  hjt := hI.jt
  hG := hI.gz
  hal t ht := by
    have e : 0x791690 + 56 * t = 0x791660 + (48 + 56 * t) := by omega
    rw [hq, e, hI.map tl_pin tl_length (by decide) (by decide) (by omega)]
    rfl
  afit t ht h := by
    rw [hq] at h ⊢
    rw [hl]
    have := al_bd t ht h
    omega
  cAl t ht h := by
    rw [hq] at h ⊢
    rw [hl]
    have := al_bd t ht h
    simp only [Clean]
    omega
  hastr t ht h k hk := by
    rw [hq] at h ⊢
    rw [hl] at hk
    rw [hz]
    have b := al_bd t ht h
    have e : (aqI t).add k = BitVec.ofNat 64 (0x6f32b3 + (aoff t + k)) ∧ aoff t + k < 621 := by
      have ho : aoff t = (aqI t).toNat - 0x6f32b3 := rfl
      generalize aqI t = q at b ho ⊢
      generalize aoff t = o at ho ⊢
      generalize alenI t = l at b hk
      refine ⟨?_, by omega⟩
      simp only [Addr.add]
      apply BitVec.eq_of_toNat_eq
      simp only [BitVec.toNat_add, BitVec.toNat_ofNat]
      omega
    rw [e.1, hI _ _ _ ts_pin (by decide) (by decide) (aoff t + k) e.2]
    rfl
  haz t ht h := by
    rw [hq] at h
    rw [hz, hl]
    exact al_z t ht h
  hanz t ht h k hk := by
    rw [hq] at h
    rw [hl] at hk
    rw [hz]
    exact al_nz t ht h k hk

/-- The bytes of the last segment after the file's (`.bss` and `.tbss`' place: `p_filesz` to `p_memsz` of the segment
at `0x777770`) are 0, as `execve` maps them. -/
def Bss (V : Addr → Byte) : Prop := ∀ a : Addr, 0x7945d0 ≤ a.toNat → a.toNat < 0x7a86c0 → V a = 0

/-- `_dl_x86_cpu_features` is in `.bss`: no feature is recorded yet, so `CInv` holds on every processor. -/
theorem Bss.cinv {prof : Profile} (h : Bss V) : CpuFeat.CInv prof V := by
  have z : ∀ a i : Nat, a + i / 8 < 0x68 → CpuFeat.bitV V a i = false := by
    intro a i hh
    have e : (Glibc.cpuRgn.base.add (a + i / 8)).toNat = 0x7a4ae0 + (a + i / 8) :=
      CpuFeat.tn (by rw [show Glibc.cpuRgn.base.toNat = 0x7a4ae0 from rfl]; omega)
    simp only [CpuFeat.bitV]
    rw [h _ (by omega) (by omega)]
    exact BitVec.getLsbD_zero
  have c : ∀ {a i : Nat} {P : Prop}, a + i / 8 < 0x68 → CpuFeat.bitV V a i = true → P := by
    intro a i P hh hb
    rw [z a i hh] at hb
    cases hb
  exact ⟨fun i hi => c (by omega), fun i hi => c (by omega), fun i hi => c (by omega), fun i hi => c (by omega),
    ⟨c (by decide), c (by decide), c (by decide), c (by decide), c (by decide), c (by decide), c (by decide),
      c (by decide), c (by decide)⟩⟩

/-- What the launch gives, and the image: `Ctx.Ok`. -/
theorem Ctx.ok (hL : K.Lch) (hI : Img K.V0) (hq : K.aq = aqI) (hz : K.az = azI) (hl : K.alen = alenI) : K.Ok :=
  ⟨hL, Ctx.im hI hL.himg hq hz hl⟩

end FV7z.Start
