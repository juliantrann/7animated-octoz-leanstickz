/-- The cut points. -/
def cuts : List Nat := [0, 32, 83, 141, 152, 184, 200, 296, 328]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 32 then W_32 else
  if ℓ = 83 then W_83 else
  if ℓ = 141 then W_141 else
  if ℓ = 152 then W_152 else
  if ℓ = 184 then W_184 else
  if ℓ = 200 then W_200 else
  if ℓ = 296 then W_296 else
  if ℓ = 328 then W_328 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof u8w u8w_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_32 prof) <|
  Sp.table (c_83 prof) <|
  Sp.table (c_141 prof) <|
  Sp.table (c_152 prof) <|
  Sp.table (c_184 prof) <|
  Sp.table (c_200 prof) <|
  Sp.table (c_296 prof) <|
  Sp.table (c_328 prof) <|
  Sp.never ℓ

