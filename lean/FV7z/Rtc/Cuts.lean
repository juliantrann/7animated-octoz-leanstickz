import FV7z.Rtc.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `register_tm_clones` (PLAN.md G3, startup)

The 1 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (46, 48; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Rtc
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_41 : Wpt := fun F Wl Q => wp F Wl o2 (Q 46)
theorem c_41 (prof : Profile) : Sp prof rtc rtc_at 41 W_41 := Sp.blk_then (blk_41 prof) (Sp.skip 46)

def W_31 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 48 g (rfz f) V) ∧
    (f.cond 4 = false → W_41 F Wl Q g (rfz f) V)
theorem c_31 (prof : Profile) : Sp prof rtc rtc_at 31 W_31 :=
  Sp.blk_then (blk_31 prof) (Sp.jcc_then (spj_39 prof) (Sp.skip 48) (c_41 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 48 g (rfz f) V) ∧
    (f.cond 4 = false → W_31 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof rtc rtc_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_29 prof) (Sp.skip 48) (c_31 prof))

/-- The cut points. -/
def cuts : List Nat := [0]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof rtc rtc_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.never ℓ

end FV7z.Rtc
