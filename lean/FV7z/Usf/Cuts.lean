import FV7z.Usf.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UString::SetFrom` (PLAN.md §M, M1)

The 7 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (44, 72, 86, 103, 120; the `ret`). `Wt` is the table of the
cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Usf
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_80 : Wpt := fun F Wl Q => wp F Wl o6 (Q 86)
theorem c_80 (prof : Profile) : Sp prof usf usf_at 80 W_80 := Sp.blk_then (blk_80 prof) (Sp.skip 86)

def W_25 : Wpt := fun F Wl Q => wp F Wl o1 (Q 31)
theorem c_25 (prof : Profile) : Sp prof usf usf_at 25 W_25 := Sp.blk_then (blk_25 prof) (Sp.skip 31)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 2 = true → W_80 F Wl Q g (rfz f) V) ∧
    (f.cond 2 = false → W_25 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof usf usf_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_23 prof) (c_80 prof) (c_25 prof))

def W_35 : Wpt := fun F Wl Q => wp F Wl o3 (Q 44)
theorem c_35 (prof : Profile) : Sp prof usf usf_at 35 W_35 := Sp.blk_then (blk_35 prof) (Sp.skip 44)

def W_31 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 53 g (rfz f) V) ∧
    (f.cond 4 = false → W_35 F Wl Q g (rfz f) V)
theorem c_31 (prof : Profile) : Sp prof usf usf_at 31 W_31 :=
  Sp.blk_then (blk_31 prof) (Sp.jcc_then (spj_33 prof) (Sp.skip 53) (c_35 prof))

def W_49 : Wpt := fun F Wl Q => wp F Wl o4 (Q 53)
theorem c_49 (prof : Profile) : Sp prof usf usf_at 49 W_49 := Sp.blk_then (blk_49 prof) (Sp.skip 53)

def W_53 : Wpt := fun F Wl Q => wp F Wl o5 (Q 72)
theorem c_53 (prof : Profile) : Sp prof usf usf_at 53 W_53 := Sp.blk_then (blk_53 prof) (Sp.skip 72)

def W_92 : Wpt := fun F Wl Q => wp F Wl o7 (Q 103)
theorem c_92 (prof : Profile) : Sp prof usf usf_at 92 W_92 := Sp.blk_then (blk_92 prof) (Sp.skip 103)

def W_108 : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    (f.cond 4 = true → Q 125 g (rfz f) V) ∧
    (f.cond 4 = false → Q 120 g (rfz f) V)
theorem c_108 (prof : Profile) : Sp prof usf usf_at 108 W_108 :=
  Sp.blk_then (blk_108 prof) (Sp.jcc_then (spj_118 prof) (Sp.skip 125) (Sp.skip 120))

def W_125 : Wpt := fun F Wl Q => wp F Wl o9 fun g f V =>
    Q 31 g (rfz f) V
theorem c_125 (prof : Profile) : Sp prof usf usf_at 125 W_125 :=
  Sp.blk_then (blk_125 prof) (Sp.jmp_then (spj_132 prof) (Sp.skip 31))

/-- The cut points. -/
def cuts : List Nat := [0, 31, 49, 53, 92, 108, 125]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 31 then W_31 else
  if ℓ = 49 then W_49 else
  if ℓ = 53 then W_53 else
  if ℓ = 92 then W_92 else
  if ℓ = 108 then W_108 else
  if ℓ = 125 then W_125 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof usf usf_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_31 prof) <|
  Sp.table (c_49 prof) <|
  Sp.table (c_53 prof) <|
  Sp.table (c_92 prof) <|
  Sp.table (c_108 prof) <|
  Sp.table (c_125 prof) <|
  Sp.never ℓ

end FV7z.Usf
