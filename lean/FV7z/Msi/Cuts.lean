import FV7z.Msi.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CMultiStreams::Init` (PLAN.md §M, M1)

The 6 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (70, 87, 98, 124; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Msi
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_33 : Wpt := fun F Wl Q => wp F Wl o1 (Q 48)
theorem c_33 (prof : Profile) : Sp prof msi msi_at 33 W_33 := Sp.blk_then (blk_33 prof) (Sp.skip 48)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 113 g (rfz f) V) ∧
    (f.cond 4 = false → W_33 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof msi msi_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_31 prof) (Sp.skip 113) (c_33 prof))

def W_60 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 75 g (rfz f) V) ∧
    (f.cond 4 = false → Q 70 g (rfz f) V)
theorem c_60 (prof : Profile) : Sp prof msi msi_at 60 W_60 :=
  Sp.blk_then (blk_60 prof) (Sp.jcc_then (spj_68 prof) (Sp.skip 75) (Sp.skip 70))

def W_48 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 103 g (rfz f) V) ∧
    (f.cond 4 = false → W_60 F Wl Q g (rfz f) V)
theorem c_48 (prof : Profile) : Sp prof msi msi_at 48 W_48 :=
  Sp.blk_then (blk_48 prof) (Sp.jcc_then (spj_58 prof) (Sp.skip 103) (c_60 prof))

def W_84 : Wpt := fun F Wl Q => wp F Wl o5 (Q 87)
theorem c_84 (prof : Profile) : Sp prof msi msi_at 84 W_84 := Sp.blk_then (blk_84 prof) (Sp.skip 87)

def W_75 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → Q 90 g (rfz f) V) ∧
    (f.cond 4 = false → W_84 F Wl Q g (rfz f) V)
theorem c_75 (prof : Profile) : Sp prof msi msi_at 75 W_75 :=
  Sp.blk_then (blk_75 prof) (Sp.jcc_then (spj_82 prof) (Sp.skip 90) (c_84 prof))

def W_90 : Wpt := fun F Wl Q => wp F Wl o6 (Q 98)
theorem c_90 (prof : Profile) : Sp prof msi msi_at 90 W_90 := Sp.blk_then (blk_90 prof) (Sp.skip 98)

def W_103 : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    (f.cond 5 = true → Q 48 g (rfz f) V) ∧
    (f.cond 5 = false → Q 113 g (rfz f) V)
theorem c_103 (prof : Profile) : Sp prof msi msi_at 103 W_103 :=
  Sp.blk_then (blk_103 prof) (Sp.jcc_then (spj_111 prof) (Sp.skip 48) (Sp.skip 113))

def W_113 : Wpt := fun F Wl Q => wp F Wl o8 (Q 124)
theorem c_113 (prof : Profile) : Sp prof msi msi_at 113 W_113 := Sp.blk_then (blk_113 prof) (Sp.skip 124)

/-- The cut points. -/
def cuts : List Nat := [0, 48, 75, 90, 103, 113]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 48 then W_48 else
  if ℓ = 75 then W_75 else
  if ℓ = 90 then W_90 else
  if ℓ = 103 then W_103 else
  if ℓ = 113 then W_113 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof msi msi_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_48 prof) <|
  Sp.table (c_75 prof) <|
  Sp.table (c_90 prof) <|
  Sp.table (c_103 prof) <|
  Sp.table (c_113 prof) <|
  Sp.never ℓ

end FV7z.Msi
