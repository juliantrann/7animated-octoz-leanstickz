import FV7z.Arl.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `AString::ReAlloc` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (26, 50, 58, 79; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Arl
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 26)
theorem c_0 (prof : Profile) : Sp prof arl arl_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 26)

def W_31 : Wpt := fun F Wl Q => wp F Wl o1 (Q 50)
theorem c_31 (prof : Profile) : Sp prof arl arl_at 31 W_31 := Sp.blk_then (blk_31 prof) (Sp.skip 50)

def W_55 : Wpt := fun F Wl Q => wp F Wl o2 (Q 58)
theorem c_55 (prof : Profile) : Sp prof arl arl_at 55 W_55 := Sp.blk_then (blk_55 prof) (Sp.skip 58)

def W_63 : Wpt := fun F Wl Q => wp F Wl o3 (Q 79)
theorem c_63 (prof : Profile) : Sp prof arl arl_at 63 W_63 := Sp.blk_then (blk_63 prof) (Sp.skip 79)

/-- The cut points. -/
def cuts : List Nat := [0, 31, 55, 63]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 31 then W_31 else
  if ℓ = 55 then W_55 else
  if ℓ = 63 then W_63 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof arl arl_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_31 prof) <|
  Sp.table (c_55 prof) <|
  Sp.table (c_63 prof) <|
  Sp.never ℓ

end FV7z.Arl
