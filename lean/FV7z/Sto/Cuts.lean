import FV7z.Sto.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `COpenCallbackImp::SetTotal` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (23, 48, 55, 66; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Sto
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_64 : Wpt := fun F Wl Q => wp F Wl o5 (Q 66)
theorem c_64 (prof : Profile) : Sp prof sto sto_at 64 W_64 := Sp.blk_then (blk_64 prof) (Sp.skip 66)

def W_41 : Wpt := fun F Wl Q => wp F Wl o3 (Q 48)
theorem c_41 (prof : Profile) : Sp prof sto sto_at 41 W_41 := Sp.blk_then (blk_41 prof) (Sp.skip 48)

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → W_64 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_41 F Wl Q g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof sto sto_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_39 prof) (c_64 prof) (c_41 prof))

def W_13 : Wpt := fun F Wl Q => wp F Wl o1 (Q 23)
theorem c_13 (prof : Profile) : Sp prof sto sto_at 13 W_13 := Sp.blk_then (blk_13 prof) (Sp.skip 23)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → W_32 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_13 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof sto sto_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_11 prof) (c_32 prof) (c_13 prof))

def W_51 : Wpt := fun F Wl Q => wp F Wl o4 (Q 55)
theorem c_51 (prof : Profile) : Sp prof sto sto_at 51 W_51 := Sp.blk_then (blk_51 prof) (Sp.skip 55)

/-- The cut points. -/
def cuts : List Nat := [0, 51]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 51 then W_51 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof sto sto_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_51 prof) <|
  Sp.never ℓ

end FV7z.Sto
