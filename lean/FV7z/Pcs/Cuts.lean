import FV7z.Pcs.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `ParseComplexSize` (PLAN.md §M, M1)

The 10 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (42, 166, 167, 268; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Pcs
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 42)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof pcs pcs_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 42)

def W_94 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    ∃ tgt, tgt < pcs.length ∧ g.get (regOf 0) = Addr.add pcs_at tgt ∧ Q tgt g (rfz f) V
theorem c_94 (prof : Profile) (fb : Addr) : SpF prof pcs pcs_at fb 94 (W_94 fb) :=
  SpF.blkA_then (blk_94 prof) (spj_108 prof fb)

def W_74 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 7 = true → Q 176 g (rfz f) V) ∧
    (f.cond 7 = false → W_94 fb F Wl Q g (rfz f) V)
theorem c_74 (prof : Profile) (fb : Addr) : SpF prof pcs pcs_at fb 74 (W_74 fb) :=
  SpF.blk_then (blk_74 prof) (SpF.jcc_then (spj_92 prof fb) (SpF.skip 176) (c_94 prof fb))

def W_65 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 5 = true → Q 144 g (rfz f) V) ∧
    (f.cond 5 = false → W_74 fb F Wl Q g (rfz f) V)
theorem c_65 (prof : Profile) (fb : Addr) : SpF prof pcs pcs_at fb 65 (W_65 fb) :=
  SpF.blk_then (blk_65 prof) (SpF.jcc_then (spj_72 prof fb) (SpF.skip 144) (c_74 prof fb))

def W_56 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 184 g (rfz f) V) ∧
    (f.cond 4 = false → W_65 fb F Wl Q g (rfz f) V)
theorem c_56 (prof : Profile) (fb : Addr) : SpF prof pcs pcs_at fb 56 (W_56 fb) :=
  SpF.blk_then (blk_56 prof) (SpF.jcc_then (spj_63 prof fb) (SpF.skip 184) (c_65 prof fb))

def W_47 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 176 g (rfz f) V) ∧
    (f.cond 4 = false → W_56 fb F Wl Q g (rfz f) V)
theorem c_47 (prof : Profile) (fb : Addr) : SpF prof pcs pcs_at fb 47 (W_47 fb) :=
  SpF.blk_then (blk_47 prof) (SpF.jcc_then (spj_54 prof fb) (SpF.skip 176) (c_56 prof fb))

def W_112 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o6 (Q 122)
theorem c_112 (prof : Profile) (fb : Addr) : SpF prof pcs pcs_at fb 112 (W_112 fb) :=
  SpF.blk_then (blk_112 prof) (SpF.skip 122)

def W_129 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o8 (Q 144)
theorem c_129 (prof : Profile) (fb : Addr) : SpF prof pcs pcs_at fb 129 (W_129 fb) :=
  SpF.blk_then (blk_129 prof) (SpF.skip 144)

def W_122 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    (f.cond 3 = true → Q 144 g (rfz f) V) ∧
    (f.cond 3 = false → W_129 fb F Wl Q g (rfz f) V)
theorem c_122 (prof : Profile) (fb : Addr) : SpF prof pcs pcs_at fb 122 (W_122 fb) :=
