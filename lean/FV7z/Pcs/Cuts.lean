theorem c_224 (prof : Profile) (fb : Addr) : SpF prof pcs pcs_at fb 224 (W_224 fb) :=
  SpF.blk_then (blk_224 prof) (SpF.jmp_then (spj_239 prof fb) (SpF.skip 122))

def W_248 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o15 fun g f V =>
    Q 122 g (rfz f) V
theorem c_248 (prof : Profile) (fb : Addr) : SpF prof pcs pcs_at fb 248 (W_248 fb) :=
  SpF.blk_then (blk_248 prof) (SpF.jmp_then (spj_263 prof fb) (SpF.skip 122))

/-- The cut points. -/
def cuts : List Nat := [0, 47, 112, 122, 144, 176, 184, 200, 224, 248]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 47 then W_47 fb else
  if ℓ = 112 then W_112 fb else
  if ℓ = 122 then W_122 fb else
  if ℓ = 144 then W_144 fb else
  if ℓ = 176 then W_176 fb else
  if ℓ = 184 then W_184 fb else
  if ℓ = 200 then W_200 fb else
  if ℓ = 224 then W_224 fb else
  if ℓ = 248 then W_248 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof pcs pcs_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_47 prof fb) <|
  SpF.table (c_112 prof fb) <|
  SpF.table (c_122 prof fb) <|
  SpF.table (c_144 prof fb) <|
  SpF.table (c_176 prof fb) <|
  SpF.table (c_184 prof fb) <|
  SpF.table (c_200 prof fb) <|
  SpF.table (c_224 prof fb) <|
  SpF.table (c_248 prof fb) <|
  SpF.never ℓ

end FV7z.Pcs
