import FV7z.Ims.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__init_misc` (PLAN.md G3, startup)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (34, 73, 80; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ims
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_26 : Wpt := fun F Wl Q => wp F Wl o2 (Q 34)
theorem c_26 (prof : Profile) : Sp prof ims ims_at 26 W_26 := Sp.blk_then (blk_26 prof) (Sp.skip 34)

def W_9 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 67 g (rfz f) V) ∧
    (f.cond 4 = false → W_26 F Wl Q g (rfz f) V)
theorem c_9 (prof : Profile) : Sp prof ims ims_at 9 W_9 :=
  Sp.blk_then (blk_9 prof) (Sp.jcc_then (spj_24 prof) (Sp.skip 67) (c_26 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 80 g (rfz f) V) ∧
    (f.cond 4 = false → W_9 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof ims ims_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_7 prof) (Sp.skip 80) (c_9 prof))

def W_39 : Wpt := fun F Wl Q => wp F Wl o3 (Q 67)
theorem c_39 (prof : Profile) : Sp prof ims ims_at 39 W_39 := Sp.blkA_then (blk_39 prof) (Sp.skip 67)

def W_67 : Wpt := fun F Wl Q => wp F Wl o4 (Q 73)
theorem c_67 (prof : Profile) : Sp prof ims ims_at 67 W_67 := Sp.blk_then (blk_67 prof) (Sp.skip 73)

/-- The cut points. -/
def cuts : List Nat := [0, 39, 67]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 39 then W_39 else
  if ℓ = 67 then W_67 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ims ims_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_39 prof) <|
  Sp.table (c_67 prof) <|
  Sp.never ℓ

end FV7z.Ims
