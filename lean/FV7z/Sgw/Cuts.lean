import FV7z.Sgw.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__sigaction` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (20, 51; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Sgw
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_12 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 6 = true → Q 32 g (rfz f) V) ∧
    (f.cond 6 = false → Q 20 g (rfz f) V)
theorem c_12 (prof : Profile) (fb : Addr) : SpF prof sgw sgw_at fb 12 (W_12 fb) :=
  SpF.blk_then (blk_12 prof) (SpF.jcc_then (spj_18 prof fb) (SpF.skip 32) (SpF.skip 20))

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 7 = true → Q 32 g (rfz f) V) ∧
    (f.cond 7 = false → W_12 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof sgw sgw_at fb 0 (W_0 fb) :=
  SpF.blk_then (blk_0 prof) (SpF.jcc_then (spj_10 prof fb) (SpF.skip 32) (c_12 prof fb))

def W_32 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o2 fb) (Q 51)
theorem c_32 (prof : Profile) (fb : Addr) : SpF prof sgw sgw_at fb 32 (W_32 fb) :=
  SpF.blkF_then (blk_32 prof fb) (SpF.skip 51)

/-- The cut points. -/
def cuts : List Nat := [0, 32]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 32 then W_32 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof sgw sgw_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_32 prof fb) <|
  SpF.never ℓ

end FV7z.Sgw
