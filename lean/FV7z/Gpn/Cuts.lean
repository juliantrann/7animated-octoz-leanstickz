import FV7z.Gpn.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `GetPropName` (PLAN.md §M, M1)

The 1 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (20, 48, 67; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Gpn
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_56 : Wpt := fun F Wl Q => wp F Wl o4 (Q 67)
theorem c_56 (prof : Profile) : Sp prof gpn gpn_at 56 W_56 := Sp.blkA_then (blk_56 prof) (Sp.skip 67)

def W_32 : Wpt := fun F Wl Q => wp F Wl o3 (Q 48)
theorem c_32 (prof : Profile) : Sp prof gpn gpn_at 32 W_32 := Sp.blk_then (blk_32 prof) (Sp.skip 48)

def W_17 : Wpt := fun F Wl Q => wp F Wl o2 (Q 20)
theorem c_17 (prof : Profile) : Sp prof gpn gpn_at 17 W_17 := Sp.blk_then (blk_17 prof) (Sp.skip 20)

def W_12 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → W_32 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_17 F Wl Q g (rfz f) V)
theorem c_12 (prof : Profile) : Sp prof gpn gpn_at 12 W_12 :=
  Sp.blk_then (blk_12 prof) (Sp.jcc_then (spj_15 prof) (c_32 prof) (c_17 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 6 = true → W_56 F Wl Q g (rfz f) V) ∧
    (f.cond 6 = false → W_12 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof gpn gpn_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_10 prof) (c_56 prof) (c_12 prof))

/-- The cut points. -/
def cuts : List Nat := [0]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof gpn gpn_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.never ℓ

end FV7z.Gpn
