import FV7z.Npc.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `_nl_postload_ctype` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (84, 121; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Npc
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o0 (Q 25)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof npc npc_at fb 0 (W_0 fb) :=
  SpF.blkA_then (blk_0 prof) (SpF.skip 25)

def W_25 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 44)
theorem c_25 (prof : Profile) (fb : Addr) : SpF prof npc npc_at fb 25 (W_25 fb) :=
  SpF.blk_then (blk_25 prof) (SpF.skip 44)

def W_44 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 78)
theorem c_44 (prof : Profile) (fb : Addr) : SpF prof npc npc_at fb 44 (W_44 fb) :=
  SpF.blkA_then (blk_44 prof) (SpF.skip 78)

def W_88 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o4 fb) (Q 121)
theorem c_88 (prof : Profile) (fb : Addr) : SpF prof npc npc_at fb 88 (W_88 fb) :=
  SpF.blkF_then (blk_88 prof fb) (SpF.skip 121)

def W_78 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o3 fb) fun g f V =>
    (f.cond 4 = true → W_88 fb F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 84 g (rfz f) V)
theorem c_78 (prof : Profile) (fb : Addr) : SpF prof npc npc_at fb 78 (W_78 fb) :=
  SpF.blkF_then (blk_78 prof fb) (SpF.jcc_then (spj_82 prof fb) (c_88 prof fb) (SpF.skip 84))

/-- The cut points. -/
def cuts : List Nat := [0, 25, 44, 78]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 25 then W_25 fb else
  if ℓ = 44 then W_44 fb else
  if ℓ = 78 then W_78 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof npc npc_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_25 prof fb) <|
  SpF.table (c_44 prof fb) <|
  SpF.table (c_78 prof fb) <|
  SpF.never ℓ

end FV7z.Npc
