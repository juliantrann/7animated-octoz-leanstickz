/-- The cut points. -/
def cuts : List Nat := [0, 65, 127, 196, 228, 240, 248, 264, 279, 288, 299, 307, 318, 336, 350, 358, 369, 380, 391, 402, 420, 435]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 65 then W_65 fb else
  if ℓ = 127 then W_127 fb else
  if ℓ = 196 then W_196 fb else
  if ℓ = 228 then W_228 fb else
  if ℓ = 240 then W_240 fb else
  if ℓ = 248 then W_248 fb else
  if ℓ = 264 then W_264 fb else
  if ℓ = 279 then W_279 fb else
  if ℓ = 288 then W_288 fb else
  if ℓ = 299 then W_299 fb else
  if ℓ = 307 then W_307 fb else
  if ℓ = 318 then W_318 fb else
  if ℓ = 336 then W_336 fb else
  if ℓ = 350 then W_350 fb else
  if ℓ = 358 then W_358 fb else
  if ℓ = 369 then W_369 fb else
  if ℓ = 380 then W_380 fb else
  if ℓ = 391 then W_391 fb else
  if ℓ = 402 then W_402 fb else
  if ℓ = 420 then W_420 fb else
  if ℓ = 435 then W_435 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof ild ild_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_65 prof fb) <|
  SpF.table (c_127 prof fb) <|
  SpF.table (c_196 prof fb) <|
  SpF.table (c_228 prof fb) <|
  SpF.table (c_240 prof fb) <|
  SpF.table (c_248 prof fb) <|
  SpF.table (c_264 prof fb) <|
  SpF.table (c_279 prof fb) <|
  SpF.table (c_288 prof fb) <|
  SpF.table (c_299 prof fb) <|
  SpF.table (c_307 prof fb) <|
  SpF.table (c_318 prof fb) <|
  SpF.table (c_336 prof fb) <|
  SpF.table (c_350 prof fb) <|
  SpF.table (c_358 prof fb) <|
  SpF.table (c_369 prof fb) <|
  SpF.table (c_380 prof fb) <|
  SpF.table (c_391 prof fb) <|
  SpF.table (c_402 prof fb) <|
  SpF.table (c_420 prof fb) <|
  SpF.table (c_435 prof fb) <|
  SpF.never ℓ

