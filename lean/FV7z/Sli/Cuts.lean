/-!
# The cut points of `CDirItems::SetLinkInfo` (PLAN.md §M, M1)

The 11 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (94, 117, 132, 144, 164, 184, 202, 237, 244; the `ret`). `Wt`
is the table of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Sli
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_176 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    Q 62 g (rfz f) V
theorem c_176 (prof : Profile) (fb : Addr) : SpF prof sli sli_at fb 176 (W_176 fb) :=
  SpF.blk_then (blk_176 prof) (SpF.jmp_then (spj_178 prof fb) (SpF.skip 62))

def W_96 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 (Q 117)
