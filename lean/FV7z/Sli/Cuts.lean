def W_42 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → W_96 fb F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 62 g (rfz f) V)
theorem c_42 (prof : Profile) (fb : Addr) : SpF prof sli sli_at fb 42 (W_42 fb) :=
  SpF.blk_then (blk_42 prof) (SpF.jcc_then (spj_60 prof fb) (c_96 prof fb) (SpF.skip 62))

