/-- The cut points. -/
def cuts : List Nat := [0, 62, 122, 137, 148, 150, 169, 189, 207, 216, 242]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 62 then W_62 fb else
  if ℓ = 122 then W_122 fb else
  if ℓ = 137 then W_137 fb else
  if ℓ = 148 then W_148 fb else
  if ℓ = 150 then W_150 fb else
  if ℓ = 169 then W_169 fb else
  if ℓ = 189 then W_189 fb else
  if ℓ = 207 then W_207 fb else
  if ℓ = 216 then W_216 fb else
  if ℓ = 242 then W_242 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof sli sli_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_62 prof fb) <|
  SpF.table (c_122 prof fb) <|
  SpF.table (c_137 prof fb) <|
  SpF.table (c_148 prof fb) <|
  SpF.table (c_150 prof fb) <|
  SpF.table (c_169 prof fb) <|
  SpF.table (c_189 prof fb) <|
  SpF.table (c_207 prof fb) <|
  SpF.table (c_216 prof fb) <|
  SpF.table (c_242 prof fb) <|
  SpF.never ℓ

