import FV7z.C82.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `csuTg 82` (PLAN.md G3, constructors)

The 7 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (2081; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.C82
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf
open FV7z.Ctor (sti sti_at sti_length)

def W_1888 : Wpt := fun F Wl Q => wp F Wl o0 (Q 1936)
theorem c_1888 (prof : Profile) : Sp prof sti sti_at 1888 W_1888 := Sp.blkA_then (blk_1888 prof) (Sp.skip 1936)

def W_1945 : Wpt := fun F Wl Q => wp F Wl o2 (Q 1968)
theorem c_1945 (prof : Profile) : Sp prof sti sti_at 1945 W_1945 := Sp.blk_then (blk_1945 prof) (Sp.skip 1968)

def W_1936 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 1979 g (rfz f) V) ∧
    (f.cond 4 = false → W_1945 F Wl Q g (rfz f) V)
theorem c_1936 (prof : Profile) : Sp prof sti sti_at 1936 W_1936 :=
  Sp.blk_then (blk_1936 prof) (Sp.jcc_then (spj_1943 prof) (Sp.skip 1979) (c_1945 prof))

def W_1968 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 5 = true → Q 1968 g (rfz f) V) ∧
    (f.cond 5 = false → Q 1979 g (rfz f) V)
theorem c_1968 (prof : Profile) : Sp prof sti sti_at 1968 W_1968 :=
  Sp.blk_then (blk_1968 prof) (Sp.jcc_then (spj_1977 prof) (Sp.skip 1968) (Sp.skip 1979))

def W_2000 : Wpt := fun F Wl Q => wp F Wl o6 (Q 2032)
theorem c_2000 (prof : Profile) : Sp prof sti sti_at 2000 W_2000 := Sp.blkA_then (blk_2000 prof) (Sp.skip 2032)

def W_1989 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    Q 1936 g (rfz f) V
theorem c_1989 (prof : Profile) : Sp prof sti sti_at 1989 W_1989 :=
  Sp.blk_then (blk_1989 prof) (Sp.jmp_then (spj_1998 prof) (Sp.skip 1936))

def W_1979 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → W_2000 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_1989 F Wl Q g (rfz f) V)
theorem c_1979 (prof : Profile) : Sp prof sti sti_at 1979 W_1979 :=
  Sp.blk_then (blk_1979 prof) (Sp.jcc_then (spj_1987 prof) (c_2000 prof) (c_1989 prof))

def W_2046 : Wpt := fun F Wl Q => wp F Wl o8 (Q 2048)
theorem c_2046 (prof : Profile) : Sp prof sti sti_at 2046 W_2046 := Sp.blk_then (blk_2046 prof) (Sp.skip 2048)

def W_2032 : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    (f.cond 4 = true → Q 2062 g (rfz f) V) ∧
    (f.cond 4 = false → W_2046 F Wl Q g (rfz f) V)
theorem c_2032 (prof : Profile) : Sp prof sti sti_at 2032 W_2032 :=
  Sp.blk_then (blk_2032 prof) (Sp.jcc_then (spj_2044 prof) (Sp.skip 2062) (c_2046 prof))

def W_2048 : Wpt := fun F Wl Q => wp F Wl o9 fun g f V =>
    (f.cond 5 = true → Q 2048 g (rfz f) V) ∧
    (f.cond 5 = false → Q 2062 g (rfz f) V)
theorem c_2048 (prof : Profile) : Sp prof sti sti_at 2048 W_2048 :=
  Sp.blk_then (blk_2048 prof) (Sp.jcc_then (spj_2060 prof) (Sp.skip 2048) (Sp.skip 2062))

def W_2080 : Wpt := fun F Wl Q => wp F Wl o12 (Q 2081)
theorem c_2080 (prof : Profile) : Sp prof sti sti_at 2080 W_2080 := Sp.blk_then (blk_2080 prof) (Sp.skip 2081)

def W_2072 : Wpt := fun F Wl Q => wp F Wl o11 fun g f V =>
    Q 2032 g (rfz f) V
theorem c_2072 (prof : Profile) : Sp prof sti sti_at 2072 W_2072 :=
  Sp.blk_then (blk_2072 prof) (Sp.jmp_then (spj_2076 prof) (Sp.skip 2032))

def W_2062 : Wpt := fun F Wl Q => wp F Wl o10 fun g f V =>
    (f.cond 4 = true → W_2080 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_2072 F Wl Q g (rfz f) V)
theorem c_2062 (prof : Profile) : Sp prof sti sti_at 2062 W_2062 :=
  Sp.blk_then (blk_2062 prof) (Sp.jcc_then (spj_2070 prof) (c_2080 prof) (c_2072 prof))

/-- The cut points. -/
def cuts : List Nat := [1888, 1936, 1968, 1979, 2032, 2048, 2062]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 1888 then W_1888 else
  if ℓ = 1936 then W_1936 else
  if ℓ = 1968 then W_1968 else
  if ℓ = 1979 then W_1979 else
  if ℓ = 2032 then W_2032 else
  if ℓ = 2048 then W_2048 else
  if ℓ = 2062 then W_2062 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof sti sti_at ℓ (Wt ℓ) :=
  Sp.table (c_1888 prof) <|
  Sp.table (c_1936 prof) <|
  Sp.table (c_1968 prof) <|
  Sp.table (c_1979 prof) <|
  Sp.table (c_2032 prof) <|
  Sp.table (c_2048 prof) <|
  Sp.table (c_2062 prof) <|
  Sp.never ℓ

end FV7z.C82
