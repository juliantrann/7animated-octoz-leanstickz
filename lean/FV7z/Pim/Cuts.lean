def cuts : List Nat := [0, 19, 32, 72, 149, 193, 251, 276, 314, 345, 352, 369, 403, 437, 453, 492, 553, 593, 647, 669]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 19 then W_19 fb else
  if ℓ = 32 then W_32 fb else
  if ℓ = 72 then W_72 fb else
  if ℓ = 149 then W_149 fb else
