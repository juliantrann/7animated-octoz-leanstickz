  if ℓ = 403 then W_403 fb else
  if ℓ = 437 then W_437 fb else
  if ℓ = 453 then W_453 fb else
  if ℓ = 492 then W_492 fb else
  if ℓ = 553 then W_553 fb else
  if ℓ = 593 then W_593 fb else
  if ℓ = 647 then W_647 fb else
  if ℓ = 669 then W_669 fb else
  fun _ _ _ _ _ _ => False

