import FV7z.Pvf.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CPropVariant::operator=(const FILETIME &)` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (23, 64; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Pvf
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 38 g (rfz f) V) ∧
    (f.cond 4 = false → Q 23 g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof pvf pvf_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_21 prof) (Sp.skip 38) (Sp.skip 23))

def W_28 : Wpt := fun F Wl Q => wp F Wl o1 (Q 38)
theorem c_28 (prof : Profile) : Sp prof pvf pvf_at 28 W_28 := Sp.blk_then (blk_28 prof) (Sp.skip 38)

def W_38 : Wpt := fun F Wl Q => wp F Wl o2 (Q 64)
theorem c_38 (prof : Profile) : Sp prof pvf pvf_at 38 W_38 := Sp.blk_then (blk_38 prof) (Sp.skip 64)

/-- The cut points. -/
def cuts : List Nat := [0, 28, 38]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 28 then W_28 else
  if ℓ = 38 then W_38 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof pvf pvf_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_28 prof) <|
  Sp.table (c_38 prof) <|
  Sp.never ℓ

end FV7z.Pvf
