import FV7z.Ppd.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CPercentPrinter::~CPercentPrinter` (PLAN.md §M, M1)

The 10 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (10, 27, 44, 61, 78, 92, 106, 120, 134, 149, 161; the `ret`).
`Wt` is the table of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ppd
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 10)
theorem c_0 (prof : Profile) : Sp prof ppd ppd_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 10)

def W_15 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 32 g (rfz f) V) ∧
    (f.cond 4 = false → Q 27 g (rfz f) V)
theorem c_15 (prof : Profile) : Sp prof ppd ppd_at 15 W_15 :=
  Sp.blk_then (blk_15 prof) (Sp.jcc_then (spj_25 prof) (Sp.skip 32) (Sp.skip 27))

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 49 g (rfz f) V) ∧
    (f.cond 4 = false → Q 44 g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof ppd ppd_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_42 prof) (Sp.skip 49) (Sp.skip 44))

def W_49 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 66 g (rfz f) V) ∧
    (f.cond 4 = false → Q 61 g (rfz f) V)
theorem c_49 (prof : Profile) : Sp prof ppd ppd_at 49 W_49 :=
  Sp.blk_then (blk_49 prof) (Sp.jcc_then (spj_59 prof) (Sp.skip 66) (Sp.skip 61))

def W_66 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → Q 83 g (rfz f) V) ∧
    (f.cond 4 = false → Q 78 g (rfz f) V)
theorem c_66 (prof : Profile) : Sp prof ppd ppd_at 66 W_66 :=
  Sp.blk_then (blk_66 prof) (Sp.jcc_then (spj_76 prof) (Sp.skip 83) (Sp.skip 78))

def W_83 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 4 = true → Q 97 g (rfz f) V) ∧
    (f.cond 4 = false → Q 92 g (rfz f) V)
theorem c_83 (prof : Profile) : Sp prof ppd ppd_at 83 W_83 :=
  Sp.blk_then (blk_83 prof) (Sp.jcc_then (spj_90 prof) (Sp.skip 97) (Sp.skip 92))

def W_97 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    (f.cond 4 = true → Q 111 g (rfz f) V) ∧
    (f.cond 4 = false → Q 106 g (rfz f) V)
theorem c_97 (prof : Profile) : Sp prof ppd ppd_at 97 W_97 :=
  Sp.blk_then (blk_97 prof) (Sp.jcc_then (spj_104 prof) (Sp.skip 111) (Sp.skip 106))

def W_111 : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    (f.cond 4 = true → Q 125 g (rfz f) V) ∧
    (f.cond 4 = false → Q 120 g (rfz f) V)
theorem c_111 (prof : Profile) : Sp prof ppd ppd_at 111 W_111 :=
  Sp.blk_then (blk_111 prof) (Sp.jcc_then (spj_118 prof) (Sp.skip 125) (Sp.skip 120))

def W_125 : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    (f.cond 4 = true → Q 139 g (rfz f) V) ∧
    (f.cond 4 = false → Q 134 g (rfz f) V)
theorem c_125 (prof : Profile) : Sp prof ppd ppd_at 125 W_125 :=
  Sp.blk_then (blk_125 prof) (Sp.jcc_then (spj_132 prof) (Sp.skip 139) (Sp.skip 134))

def W_160 : Wpt := fun F Wl Q => wp F Wl o10 (Q 161)
theorem c_160 (prof : Profile) : Sp prof ppd ppd_at 160 W_160 := Sp.blk_then (blk_160 prof) (Sp.skip 161)

def W_148 : Wpt := fun F Wl Q => wp F Wl o10 (Q 149)
theorem c_148 (prof : Profile) : Sp prof ppd ppd_at 148 W_148 := Sp.blk_then (blk_148 prof) (Sp.skip 149)

def W_139 : Wpt := fun F Wl Q => wp F Wl o9 fun g f V =>
    (f.cond 4 = true → W_160 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_148 F Wl Q g (rfz f) V)
theorem c_139 (prof : Profile) : Sp prof ppd ppd_at 139 W_139 :=
  Sp.blk_then (blk_139 prof) (Sp.jcc_then (spj_146 prof) (c_160 prof) (c_148 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 15, 32, 49, 66, 83, 97, 111, 125, 139]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 15 then W_15 else
  if ℓ = 32 then W_32 else
  if ℓ = 49 then W_49 else
  if ℓ = 66 then W_66 else
  if ℓ = 83 then W_83 else
  if ℓ = 97 then W_97 else
  if ℓ = 111 then W_111 else
  if ℓ = 125 then W_125 else
  if ℓ = 139 then W_139 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ppd ppd_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_15 prof) <|
  Sp.table (c_32 prof) <|
  Sp.table (c_49 prof) <|
  Sp.table (c_66 prof) <|
  Sp.table (c_83 prof) <|
  Sp.table (c_97 prof) <|
  Sp.table (c_111 prof) <|
  Sp.table (c_125 prof) <|
  Sp.table (c_139 prof) <|
  Sp.never ℓ

end FV7z.Ppd
