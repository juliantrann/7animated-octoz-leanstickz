import FV7z.Sga.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__libc_sigaction` (PLAN.md G3, startup)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (196, 230, 412, 448, 468; the `ret`). `Wt` is the table of the
cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Sga
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_416 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    Q 185 g (rfz f) V
theorem c_416 (prof : Profile) (fb : Addr) : SpF prof sga sga_at fb 416 (W_416 fb) :=
  SpF.blk_then (blk_416 prof) (SpF.jmp_then (spj_433 prof fb) (SpF.skip 185))

def W_42 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 185)
theorem c_42 (prof : Profile) (fb : Addr) : SpF prof sga sga_at fb 42 (W_42 fb) :=
  SpF.blk_then (blk_42 prof) (SpF.skip 185)

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) fun g f V =>
    (f.cond 4 = true → W_416 fb F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_42 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof sga sga_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.jcc_then (spj_36 prof fb) (c_416 prof fb) (c_42 prof fb))

def W_185 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 196)
theorem c_185 (prof : Profile) (fb : Addr) : SpF prof sga sga_at fb 185 (W_185 fb) :=
  SpF.blk_then (blk_185 prof) (SpF.skip 196)

def W_222 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 8 = true → Q 383 g (rfz f) V) ∧
    (f.cond 8 = false → Q 230 g (rfz f) V)
theorem c_222 (prof : Profile) (fb : Addr) : SpF prof sga sga_at fb 222 (W_222 fb) :=
  SpF.blk_then (blk_222 prof) (SpF.jcc_then (spj_224 prof fb) (SpF.skip 383) (SpF.skip 230))

def W_210 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → Q 383 g (rfz f) V) ∧
    (f.cond 4 = false → W_222 fb F Wl Q g (rfz f) V)
theorem c_210 (prof : Profile) (fb : Addr) : SpF prof sga sga_at fb 210 (W_210 fb) :=
  SpF.blk_then (blk_210 prof) (SpF.jcc_then (spj_216 prof fb) (SpF.skip 383) (c_222 prof fb))

def W_198 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 7 = true → Q 448 g (rfz f) V) ∧
    (f.cond 7 = false → W_210 fb F Wl Q g (rfz f) V)
theorem c_198 (prof : Profile) (fb : Addr) : SpF prof sga sga_at fb 198 (W_198 fb) :=
  SpF.blk_then (blk_198 prof) (SpF.jcc_then (spj_204 prof fb) (SpF.skip 448) (c_210 prof fb))

def W_402 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o7 (Q 412)
theorem c_402 (prof : Profile) (fb : Addr) : SpF prof sga sga_at fb 402 (W_402 fb) :=
  SpF.blk_then (blk_402 prof) (SpF.skip 412)

def W_383 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o6 fb) fun g f V =>
    (f.cond 5 = true → Q 468 g (rfz f) V) ∧
    (f.cond 5 = false → W_402 fb F Wl Q g (rfz f) V)
theorem c_383 (prof : Profile) (fb : Addr) : SpF prof sga sga_at fb 383 (W_383 fb) :=
  SpF.blkF_then (blk_383 prof fb) (SpF.jcc_then (spj_400 prof fb) (SpF.skip 468) (c_402 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 185, 198, 383]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 185 then W_185 fb else
  if ℓ = 198 then W_198 fb else
  if ℓ = 383 then W_383 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof sga sga_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_185 prof fb) <|
  SpF.table (c_198 prof fb) <|
  SpF.table (c_383 prof fb) <|
  SpF.never ℓ

end FV7z.Sga
