/-- The cut points. -/
def cuts : List Nat := [0, 68, 99, 130, 180, 236, 341]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 68 then W_68 fb else
  if ℓ = 99 then W_99 fb else
  if ℓ = 130 then W_130 fb else
  if ℓ = 180 then W_180 fb else
  if ℓ = 236 then W_236 fb else
  if ℓ = 341 then W_341 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof mhi mhi_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_68 prof fb) <|
  SpF.table (c_99 prof fb) <|
  SpF.table (c_130 prof fb) <|
  SpF.table (c_180 prof fb) <|
  SpF.table (c_236 prof fb) <|
  SpF.table (c_341 prof fb) <|
  SpF.never ℓ

