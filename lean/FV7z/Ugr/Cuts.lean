import FV7z.Ugr.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UString::Grow` (PLAN.md §M, M1)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (55, 67, 80, 88; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ugr
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_41 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 6 = true → Q 53 g (rfz f) V) ∧
    (f.cond 6 = false → Q 48 g (rfz f) V)
theorem c_41 (prof : Profile) : Sp prof ugr ugr_at 41 W_41 :=
  Sp.blk_then (blk_41 prof) (Sp.jcc_then (spj_46 prof) (Sp.skip 53) (Sp.skip 48))

def W_16 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 7 = true → Q 48 g (rfz f) V) ∧
    (f.cond 7 = false → W_41 F Wl Q g (rfz f) V)
theorem c_16 (prof : Profile) : Sp prof ugr ugr_at 16 W_16 :=
  Sp.blk_then (blk_16 prof) (Sp.jcc_then (spj_39 prof) (Sp.skip 48) (c_41 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 3 = true → Q 88 g (rfz f) V) ∧
    (f.cond 3 = false → W_16 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof ugr ugr_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_14 prof) (Sp.skip 88) (c_16 prof))

def W_48 : Wpt := fun F Wl Q => wp F Wl o3 (Q 53)
theorem c_48 (prof : Profile) : Sp prof ugr ugr_at 48 W_48 := Sp.blk_then (blk_48 prof) (Sp.skip 53)

def W_53 : Wpt := fun F Wl Q => wp F Wl o4 (Q 55)
theorem c_53 (prof : Profile) : Sp prof ugr ugr_at 53 W_53 := Sp.blk_then (blk_53 prof) (Sp.skip 55)

def W_61 : Wpt := fun F Wl Q => wp F Wl o5 (Q 67)
theorem c_61 (prof : Profile) : Sp prof ugr ugr_at 61 W_61 := Sp.blk_then (blk_61 prof) (Sp.skip 67)

def W_73 : Wpt := fun F Wl Q => wp F Wl o6 (Q 80)
theorem c_73 (prof : Profile) : Sp prof ugr ugr_at 73 W_73 := Sp.blk_then (blk_73 prof) (Sp.skip 80)

/-- The cut points. -/
def cuts : List Nat := [0, 48, 53, 61, 73]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 48 then W_48 else
  if ℓ = 53 then W_53 else
  if ℓ = 61 then W_61 else
  if ℓ = 73 then W_73 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ugr ugr_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_48 prof) <|
  Sp.table (c_53 prof) <|
  Sp.table (c_61 prof) <|
  Sp.table (c_73 prof) <|
  Sp.never ℓ

end FV7z.Ugr
