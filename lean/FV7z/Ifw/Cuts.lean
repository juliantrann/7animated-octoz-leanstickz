/-- The cut points. -/
def cuts : List Nat := [0, 45, 50, 61, 83, 101, 107, 129]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 45 then W_45 else
  if ℓ = 50 then W_50 else
  if ℓ = 61 then W_61 else
  if ℓ = 83 then W_83 else
  if ℓ = 101 then W_101 else
  if ℓ = 107 then W_107 else
  if ℓ = 129 then W_129 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ifw ifw_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_45 prof) <|
  Sp.table (c_50 prof) <|
  Sp.table (c_61 prof) <|
  Sp.table (c_83 prof) <|
  Sp.table (c_101 prof) <|
  Sp.table (c_107 prof) <|
  Sp.table (c_129 prof) <|
  Sp.never ℓ

