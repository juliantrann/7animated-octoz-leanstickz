import FV7z.Ffa.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CCodecs::FindFormatForArchiveType` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (58, 73, 89, 95; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ffa
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_90 : Wpt := fun F Wl Q => wp F Wl o7 (Q 95)
theorem c_90 (prof : Profile) : Sp prof ffa ffa_at 90 W_90 := Sp.blk_then (blk_90 prof) (Sp.skip 95)

def W_11 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    Q 40 g (rfz f) V
theorem c_11 (prof : Profile) : Sp prof ffa ffa_at 11 W_11 :=
  Sp.blk_then (blk_11 prof) (Sp.jmp_then (spj_23 prof) (Sp.skip 40))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → W_90 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_11 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof ffa ffa_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_9 prof) (c_90 prof) (c_11 prof))

def W_40 : Wpt := fun F Wl Q => wp F Wl o3 (Q 58)
theorem c_40 (prof : Profile) : Sp prof ffa ffa_at 40 W_40 := Sp.blk_then (blk_40 prof) (Sp.skip 58)

def W_80 : Wpt := fun F Wl Q => wp F Wl o6 (Q 89)
theorem c_80 (prof : Profile) : Sp prof ffa ffa_at 80 W_80 := Sp.blk_then (blk_80 prof) (Sp.skip 89)

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 6 = true → W_80 F Wl Q g (rfz f) V) ∧
    (f.cond 6 = false → Q 40 g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof ffa ffa_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_38 prof) (c_80 prof) (Sp.skip 40))

def W_67 : Wpt := fun F Wl Q => wp F Wl o5 (Q 73)
theorem c_67 (prof : Profile) : Sp prof ffa ffa_at 67 W_67 := Sp.blk_then (blk_67 prof) (Sp.skip 73)

def W_63 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → W_32 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_67 F Wl Q g (rfz f) V)
theorem c_63 (prof : Profile) : Sp prof ffa ffa_at 63 W_63 :=
  Sp.blk_then (blk_63 prof) (Sp.jcc_then (spj_65 prof) (c_32 prof) (c_67 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 40, 63]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 40 then W_40 else
  if ℓ = 63 then W_63 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ffa ffa_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_40 prof) <|
  Sp.table (c_63 prof) <|
  Sp.never ℓ

end FV7z.Ffa
