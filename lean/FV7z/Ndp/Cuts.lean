import FV7z.Ndp.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NWindows::NFile::NName::NormalizeDirPathPrefix` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (31, 65, 77; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ndp
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_72 : Wpt := fun F Wl Q => wp F Wl o4 (Q 77)
theorem c_72 (prof : Profile) : Sp prof ndp ndp_at 72 W_72 := Sp.blk_then (blk_72 prof) (Sp.skip 77)

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → W_72 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 41 g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof ndp ndp_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_39 prof) (c_72 prof) (Sp.skip 41))

def W_11 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → W_32 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → Q 31 g (rfz f) V)
theorem c_11 (prof : Profile) : Sp prof ndp ndp_at 11 W_11 :=
  Sp.blk_then (blk_11 prof) (Sp.jcc_then (spj_29 prof) (c_32 prof) (Sp.skip 31))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 31 g (rfz f) V) ∧
    (f.cond 4 = false → W_11 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof ndp ndp_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_9 prof) (Sp.skip 31) (c_11 prof))

def W_41 : Wpt := fun F Wl Q => wp F Wl o3 (Q 65)
theorem c_41 (prof : Profile) : Sp prof ndp ndp_at 41 W_41 := Sp.blk_then (blk_41 prof) (Sp.skip 65)

def W_82 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    Q 41 g (rfz f) V
theorem c_82 (prof : Profile) : Sp prof ndp ndp_at 82 W_82 :=
  Sp.blk_then (blk_82 prof) (Sp.jmp_then (spj_100 prof) (Sp.skip 41))

/-- The cut points. -/
def cuts : List Nat := [0, 41, 82]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 41 then W_41 else
  if ℓ = 82 then W_82 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ndp ndp_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_41 prof) <|
  Sp.table (c_82 prof) <|
  Sp.never ℓ

end FV7z.Ndp
