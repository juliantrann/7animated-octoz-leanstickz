import FV7z.Olg.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CStdOutStream::operator<< (Int64)` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (39, 51, 82, 83; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Olg
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 39)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof olg olg_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 39)

def W_44 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 51)
theorem c_44 (prof : Profile) (fb : Addr) : SpF prof olg olg_at fb 44 (W_44 fb) :=
  SpF.blk_then (blk_44 prof) (SpF.skip 51)

def W_72 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 82)
theorem c_72 (prof : Profile) (fb : Addr) : SpF prof olg olg_at fb 72 (W_72 fb) :=
  SpF.blk_then (blk_72 prof) (SpF.skip 82)

def W_56 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o2 fb) fun g f V =>
    (f.cond 5 = true → Q 83 g (rfz f) V) ∧
    (f.cond 5 = false → W_72 fb F Wl Q g (rfz f) V)
theorem c_56 (prof : Profile) (fb : Addr) : SpF prof olg olg_at fb 56 (W_56 fb) :=
  SpF.blkF_then (blk_56 prof fb) (SpF.jcc_then (spj_70 prof fb) (SpF.skip 83) (c_72 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 44, 56]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 44 then W_44 fb else
  if ℓ = 56 then W_56 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof olg olg_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_44 prof fb) <|
  SpF.table (c_56 prof fb) <|
  SpF.never ℓ

end FV7z.Olg
