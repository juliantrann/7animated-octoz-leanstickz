import FV7z.Amp.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `Add_Messsage_Pre_ArcType(UString&, char const*, wchar_t const*)` (PLAN.md §M, M1)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (14, 25, 40, 51, 71; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Amp
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 14)
theorem c_0 (prof : Profile) : Sp prof amp amp_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 14)

def W_19 : Wpt := fun F Wl Q => wp F Wl o1 (Q 25)
theorem c_19 (prof : Profile) : Sp prof amp amp_at 19 W_19 := Sp.blk_then (blk_19 prof) (Sp.skip 25)

def W_30 : Wpt := fun F Wl Q => wp F Wl o2 (Q 40)
theorem c_30 (prof : Profile) : Sp prof amp amp_at 30 W_30 := Sp.blkA_then (blk_30 prof) (Sp.skip 40)

def W_45 : Wpt := fun F Wl Q => wp F Wl o3 (Q 51)
theorem c_45 (prof : Profile) : Sp prof amp amp_at 45 W_45 := Sp.blk_then (blk_45 prof) (Sp.skip 51)

def W_56 : Wpt := fun F Wl Q => wp F Wl o4 (Q 71)
theorem c_56 (prof : Profile) : Sp prof amp amp_at 56 W_56 := Sp.blkA_then (blk_56 prof) (Sp.skip 71)

/-- The cut points. -/
def cuts : List Nat := [0, 19, 30, 45, 56]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 19 then W_19 else
  if ℓ = 30 then W_30 else
  if ℓ = 45 then W_45 else
  if ℓ = 56 then W_56 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof amp amp_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_19 prof) <|
  Sp.table (c_30 prof) <|
  Sp.table (c_45 prof) <|
  Sp.table (c_56 prof) <|
  Sp.never ℓ

end FV7z.Amp
