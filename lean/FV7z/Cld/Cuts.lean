import FV7z.Cld.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__closedir` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (12, 20, 44; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Cld
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_25 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o3 fb) (Q 44)
theorem c_25 (prof : Profile) (fb : Addr) : SpF prof cld cld_at fb 25 (W_25 fb) :=
  SpF.blkF_then (blk_25 prof fb) (SpF.skip 44)

def W_9 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 12)
theorem c_9 (prof : Profile) (fb : Addr) : SpF prof cld cld_at fb 9 (W_9 fb) :=
  SpF.blk_then (blk_9 prof) (SpF.skip 12)

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → W_25 fb F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_9 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof cld cld_at fb 0 (W_0 fb) :=
  SpF.blk_then (blk_0 prof) (SpF.jcc_then (spj_7 prof fb) (c_25 prof fb) (c_9 prof fb))

def W_17 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 20)
theorem c_17 (prof : Profile) (fb : Addr) : SpF prof cld cld_at fb 17 (W_17 fb) :=
  SpF.blk_then (blk_17 prof) (SpF.skip 20)

/-- The cut points. -/
def cuts : List Nat := [0, 17]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 17 then W_17 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof cld cld_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_17 prof fb) <|
  SpF.never ℓ

end FV7z.Cld
