def W_240 : Wpt := fun F Wl Q => wp F Wl o20 (Q 245)
theorem c_240 (prof : Profile) : Sp prof nlc nlc_at 240 W_240 := Sp.blk_then (blk_240 prof) (Sp.skip 245)

