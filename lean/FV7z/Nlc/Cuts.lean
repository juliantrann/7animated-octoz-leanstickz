def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → W_240 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_17 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof nlc nlc_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_11 prof) (c_240 prof) (c_17 prof))

