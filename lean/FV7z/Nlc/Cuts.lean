/-- The cut points. -/
def cuts : List Nat := [0, 48, 74, 96, 104, 131, 140, 180, 201, 224, 250]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 48 then W_48 else
  if ℓ = 74 then W_74 else
  if ℓ = 96 then W_96 else
  if ℓ = 104 then W_104 else
  if ℓ = 131 then W_131 else
  if ℓ = 140 then W_140 else
  if ℓ = 180 then W_180 else
  if ℓ = 201 then W_201 else
  if ℓ = 224 then W_224 else
  if ℓ = 250 then W_250 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof nlc nlc_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_48 prof) <|
  Sp.table (c_74 prof) <|
  Sp.table (c_96 prof) <|
  Sp.table (c_104 prof) <|
  Sp.table (c_131 prof) <|
  Sp.table (c_140 prof) <|
  Sp.table (c_180 prof) <|
  Sp.table (c_201 prof) <|
  Sp.table (c_224 prof) <|
  Sp.table (c_250 prof) <|
  Sp.never ℓ

