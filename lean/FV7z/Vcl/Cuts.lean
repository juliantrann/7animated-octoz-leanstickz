import FV7z.Vcl.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `VariantClear` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (22, 36, 49; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Vcl
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 (Q 36)
theorem c_32 (prof : Profile) : Sp prof vcl vcl_at 32 W_32 := Sp.blk_then (blk_32 prof) (Sp.skip 36)

def W_14 : Wpt := fun F Wl Q => wp F Wl o1 (Q 22)
theorem c_14 (prof : Profile) : Sp prof vcl vcl_at 14 W_14 := Sp.blk_then (blk_14 prof) (Sp.skip 22)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → W_32 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_14 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof vcl vcl_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_12 prof) (c_32 prof) (c_14 prof))

def W_41 : Wpt := fun F Wl Q => wp F Wl o1 (Q 49)
theorem c_41 (prof : Profile) : Sp prof vcl vcl_at 41 W_41 := Sp.blk_then (blk_41 prof) (Sp.skip 49)

/-- The cut points. -/
def cuts : List Nat := [0, 41]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 41 then W_41 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof vcl vcl_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_41 prof) <|
  Sp.never ℓ

end FV7z.Vcl
