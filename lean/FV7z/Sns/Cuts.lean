import FV7z.Sns.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CDirPathSortPair::SetNumSlashes` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (48; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Sns
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_17 : Wpt := fun F Wl Q => wp F Wl o1 (Q 24)
theorem c_17 (prof : Profile) : Sp prof sns sns_at 17 W_17 := Sp.blk_then (blk_17 prof) (Sp.skip 24)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 46 g (rfz f) V) ∧
    (f.cond 4 = false → W_17 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof sns sns_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_15 prof) (Sp.skip 46) (c_17 prof))

def W_24 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 24 g (rfz f) V) ∧
    (f.cond 5 = false → Q 46 g (rfz f) V)
theorem c_24 (prof : Profile) : Sp prof sns sns_at 24 W_24 :=
  Sp.blk_then (blk_24 prof) (Sp.jcc_then (spj_44 prof) (Sp.skip 24) (Sp.skip 46))

def W_46 : Wpt := fun F Wl Q => wp F Wl o3 (Q 48)
theorem c_46 (prof : Profile) : Sp prof sns sns_at 46 W_46 := Sp.blk_then (blk_46 prof) (Sp.skip 48)

/-- The cut points. -/
def cuts : List Nat := [0, 24, 46]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 24 then W_24 else
  if ℓ = 46 then W_46 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof sns sns_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_24 prof) <|
  Sp.table (c_46 prof) <|
  Sp.never ℓ

end FV7z.Sns
