import FV7z.Aac.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `AString::operator= (const char *)` (PLAN.md §M, M1)

The 7 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (94, 100, 117; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Aac
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_27 : Wpt := fun F Wl Q => wp F Wl o1 (Q 32)
theorem c_27 (prof : Profile) : Sp prof aac aac_at 27 W_27 := Sp.blk_then (blk_27 prof) (Sp.skip 32)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 51 g (rfz f) V) ∧
    (f.cond 4 = false → W_27 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof aac aac_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_25 prof) (Sp.skip 51) (c_27 prof))

def W_96 : Wpt := fun F Wl Q => wp F Wl o8 (Q 100)
theorem c_96 (prof : Profile) : Sp prof aac aac_at 96 W_96 := Sp.blk_then (blk_96 prof) (Sp.skip 100)

def W_45 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 2 = true → W_96 F Wl Q g (rfz f) V) ∧
    (f.cond 2 = false → Q 51 g (rfz f) V)
theorem c_45 (prof : Profile) : Sp prof aac aac_at 45 W_45 :=
  Sp.blk_then (blk_45 prof) (Sp.jcc_then (spj_49 prof) (c_96 prof) (Sp.skip 51))

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 32 g (rfz f) V) ∧
    (f.cond 5 = false → W_45 F Wl Q g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof aac aac_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_43 prof) (Sp.skip 32) (c_45 prof))

def W_51 : Wpt := fun F Wl Q => wp F Wl o4 (Q 55)
theorem c_51 (prof : Profile) : Sp prof aac aac_at 51 W_51 := Sp.blk_then (blk_51 prof) (Sp.skip 55)

def W_55 : Wpt := fun F Wl Q => wp F Wl o5 (Q 64)
theorem c_55 (prof : Profile) : Sp prof aac aac_at 55 W_55 := Sp.blk_then (blk_55 prof) (Sp.skip 64)

def W_81 : Wpt := fun F Wl Q => wp F Wl o7 (Q 94)
theorem c_81 (prof : Profile) : Sp prof aac aac_at 81 W_81 := Sp.blk_then (blk_81 prof) (Sp.skip 94)

def W_64 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    (f.cond 5 = true → Q 64 g (rfz f) V) ∧
    (f.cond 5 = false → W_81 F Wl Q g (rfz f) V)
theorem c_64 (prof : Profile) : Sp prof aac aac_at 64 W_64 :=
  Sp.blk_then (blk_64 prof) (Sp.jcc_then (spj_79 prof) (Sp.skip 64) (c_81 prof))

def W_105 : Wpt := fun F Wl Q => wp F Wl o9 fun g f V =>
    (f.cond 4 = true → Q 122 g (rfz f) V) ∧
    (f.cond 4 = false → Q 117 g (rfz f) V)
theorem c_105 (prof : Profile) : Sp prof aac aac_at 105 W_105 :=
  Sp.blk_then (blk_105 prof) (Sp.jcc_then (spj_115 prof) (Sp.skip 122) (Sp.skip 117))

def W_122 : Wpt := fun F Wl Q => wp F Wl o10 fun g f V =>
    Q 55 g (rfz f) V
theorem c_122 (prof : Profile) : Sp prof aac aac_at 122 W_122 :=
  Sp.blk_then (blk_122 prof) (Sp.jmp_then (spj_130 prof) (Sp.skip 55))

/-- The cut points. -/
def cuts : List Nat := [0, 32, 51, 55, 64, 105, 122]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 32 then W_32 else
  if ℓ = 51 then W_51 else
  if ℓ = 55 then W_55 else
  if ℓ = 64 then W_64 else
  if ℓ = 105 then W_105 else
  if ℓ = 122 then W_122 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof aac aac_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_32 prof) <|
  Sp.table (c_51 prof) <|
  Sp.table (c_55 prof) <|
  Sp.table (c_64 prof) <|
  Sp.table (c_105 prof) <|
  Sp.table (c_122 prof) <|
  Sp.never ℓ

end FV7z.Aac
