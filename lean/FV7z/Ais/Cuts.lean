/-- The cut points. -/
def cuts : List Nat := [0, 55, 91, 117, 123, 133, 161, 220, 256, 274, 288, 343, 351]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 55 then W_55 else
  if ℓ = 91 then W_91 else
  if ℓ = 117 then W_117 else
  if ℓ = 123 then W_123 else
  if ℓ = 133 then W_133 else
  if ℓ = 161 then W_161 else
  if ℓ = 220 then W_220 else
  if ℓ = 256 then W_256 else
  if ℓ = 274 then W_274 else
  if ℓ = 288 then W_288 else
  if ℓ = 343 then W_343 else
  if ℓ = 351 then W_351 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ais ais_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_55 prof) <|
  Sp.table (c_91 prof) <|
  Sp.table (c_117 prof) <|
  Sp.table (c_123 prof) <|
  Sp.table (c_133 prof) <|
  Sp.table (c_161 prof) <|
  Sp.table (c_220 prof) <|
  Sp.table (c_256 prof) <|
  Sp.table (c_274 prof) <|
  Sp.table (c_288 prof) <|
  Sp.table (c_343 prof) <|
  Sp.table (c_351 prof) <|
  Sp.never ℓ

