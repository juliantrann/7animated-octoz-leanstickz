def W_44 : Wpt := fun F Wl Q => wp F Wl o1 (Q 49)
theorem c_44 (prof : Profile) : Sp prof ais ais_at 44 W_44 := Sp.blk_then (blk_44 prof) (Sp.skip 49)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → Q 123 g (rfz f) V) ∧
    (f.cond 5 = false → W_44 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof ais ais_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_42 prof) (Sp.skip 123) (c_44 prof))

