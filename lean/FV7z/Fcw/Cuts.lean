import FV7z.Fcw.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `FindCharPosInString(const wchar_t *, wchar_t)` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (36, 47, 50; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Fcw
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_48 : Wpt := fun F Wl Q => wp F Wl o5 (Q 50)
theorem c_48 (prof : Profile) : Sp prof fcw fcw_at 48 W_48 := Sp.blk_then (blk_48 prof) (Sp.skip 50)

def W_13 : Wpt := fun F Wl Q g f V =>
    W_48 F Wl Q g (rfz f) V
theorem c_13 (prof : Profile) : Sp prof fcw fcw_at 13 W_13 :=
  Sp.jmp_then (spj_13 prof) (c_48 prof)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → Q 27 g (rfz f) V) ∧
    (f.cond 5 = false → W_13 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof fcw fcw_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_11 prof) (Sp.skip 27) (c_13 prof))

def W_40 : Wpt := fun F Wl Q => wp F Wl o4 (Q 47)
theorem c_40 (prof : Profile) : Sp prof fcw fcw_at 40 W_40 := Sp.blk_then (blk_40 prof) (Sp.skip 47)

def W_16 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → W_40 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 27 g (rfz f) V)
theorem c_16 (prof : Profile) : Sp prof fcw fcw_at 16 W_16 :=
  Sp.blk_then (blk_16 prof) (Sp.jcc_then (spj_25 prof) (c_40 prof) (Sp.skip 27))

def W_31 : Wpt := fun F Wl Q => wp F Wl o3 (Q 36)
theorem c_31 (prof : Profile) : Sp prof fcw fcw_at 31 W_31 := Sp.blk_then (blk_31 prof) (Sp.skip 36)

def W_27 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → W_16 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → W_31 F Wl Q g (rfz f) V)
theorem c_27 (prof : Profile) : Sp prof fcw fcw_at 27 W_27 :=
  Sp.blk_then (blk_27 prof) (Sp.jcc_then (spj_29 prof) (c_16 prof) (c_31 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 27]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 27 then W_27 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof fcw fcw_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_27 prof) <|
  Sp.never ℓ

end FV7z.Fcw
