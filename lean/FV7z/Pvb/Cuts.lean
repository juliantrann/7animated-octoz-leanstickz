import FV7z.Pvb.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CPropVariant::operator=(Byte)` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (22, 60; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Pvb
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 37 g (rfz f) V) ∧
    (f.cond 4 = false → Q 22 g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof pvb pvb_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_20 prof) (Sp.skip 37) (Sp.skip 22))

def W_27 : Wpt := fun F Wl Q => wp F Wl o1 (Q 37)
theorem c_27 (prof : Profile) : Sp prof pvb pvb_at 27 W_27 := Sp.blk_then (blk_27 prof) (Sp.skip 37)

def W_37 : Wpt := fun F Wl Q => wp F Wl o2 (Q 60)
theorem c_37 (prof : Profile) : Sp prof pvb pvb_at 37 W_37 := Sp.blk_then (blk_37 prof) (Sp.skip 60)

/-- The cut points. -/
def cuts : List Nat := [0, 27, 37]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 27 then W_27 else
  if ℓ = 37 then W_37 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof pvb pvb_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_27 prof) <|
  Sp.table (c_37 prof) <|
  Sp.never ℓ

end FV7z.Pvb
