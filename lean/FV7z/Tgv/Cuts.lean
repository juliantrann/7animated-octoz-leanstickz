import FV7z.Tgv.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__tunable_get_val` (PLAN.md G3, startup)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (85, 96; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Tgv
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_47 : Wpt := fun F Wl Q => wp F Wl o2 (Q 49)
theorem c_47 (prof : Profile) : Sp prof tgv tgv_at 47 W_47 := Sp.blk_then (blk_47 prof) (Sp.skip 49)

def W_42 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 104 g (rfz f) V) ∧
    (f.cond 5 = false → W_47 F Wl Q g (rfz f) V)
theorem c_42 (prof : Profile) : Sp prof tgv tgv_at 42 W_42 :=
  Sp.blk_then (blk_42 prof) (Sp.jcc_then (spj_45 prof) (Sp.skip 104) (c_47 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 7 = true → Q 104 g (rfz f) V) ∧
    (f.cond 7 = false → W_42 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof tgv tgv_at 0 W_0 :=
  Sp.blkA_then (blk_0 prof) (Sp.jcc_then (spj_40 prof) (Sp.skip 104) (c_42 prof))

def W_80 : Wpt := fun F Wl Q => wp F Wl o5 (Q 85)
theorem c_80 (prof : Profile) : Sp prof tgv tgv_at 80 W_80 := Sp.blk_then (blk_80 prof) (Sp.skip 85)

def W_75 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → Q 96 g (rfz f) V) ∧
    (f.cond 4 = false → W_80 F Wl Q g (rfz f) V)
theorem c_75 (prof : Profile) : Sp prof tgv tgv_at 75 W_75 :=
  Sp.blk_then (blk_75 prof) (Sp.jcc_then (spj_78 prof) (Sp.skip 96) (c_80 prof))

def W_49 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 96 g (rfz f) V) ∧
    (f.cond 4 = false → W_75 F Wl Q g (rfz f) V)
theorem c_49 (prof : Profile) : Sp prof tgv tgv_at 49 W_49 :=
  Sp.blk_then (blk_49 prof) (Sp.jcc_then (spj_73 prof) (Sp.skip 96) (c_75 prof))

def W_104 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    Q 49 g (rfz f) V
theorem c_104 (prof : Profile) : Sp prof tgv tgv_at 104 W_104 :=
  Sp.blk_then (blk_104 prof) (Sp.jmp_then (spj_107 prof) (Sp.skip 49))

/-- The cut points. -/
def cuts : List Nat := [0, 49, 104]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 49 then W_49 else
  if ℓ = 104 then W_104 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof tgv tgv_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_49 prof) <|
  Sp.table (c_104 prof) <|
  Sp.never ℓ

end FV7z.Tgv
