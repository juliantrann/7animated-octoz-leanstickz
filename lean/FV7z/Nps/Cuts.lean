import FV7z.Nps.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CStdOutStream::NormalizePrint_UString (const UString &)` (PLAN.md §M, M1)

The 7 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (38, 49, 62, 76, 91, 105, 135, 136; the `ret`). `Wt` is the
table of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Nps
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 38)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof nps nps_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 38)

def W_43 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 49)
theorem c_43 (prof : Profile) (fb : Addr) : SpF prof nps nps_at fb 43 (W_43 fb) :=
  SpF.blk_then (blk_43 prof) (SpF.skip 49)

def W_54 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 62)
theorem c_54 (prof : Profile) (fb : Addr) : SpF prof nps nps_at fb 54 (W_54 fb) :=
  SpF.blk_then (blk_54 prof) (SpF.skip 62)

def W_67 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 76)
theorem c_67 (prof : Profile) (fb : Addr) : SpF prof nps nps_at fb 67 (W_67 fb) :=
  SpF.blk_then (blk_67 prof) (SpF.skip 76)

def W_81 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → Q 96 g (rfz f) V) ∧
    (f.cond 4 = false → Q 91 g (rfz f) V)
theorem c_81 (prof : Profile) (fb : Addr) : SpF prof nps nps_at fb 81 (W_81 fb) :=
  SpF.blk_then (blk_81 prof) (SpF.jcc_then (spj_89 prof fb) (SpF.skip 96) (SpF.skip 91))

def W_96 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 4 = true → Q 110 g (rfz f) V) ∧
    (f.cond 4 = false → Q 105 g (rfz f) V)
theorem c_96 (prof : Profile) (fb : Addr) : SpF prof nps nps_at fb 96 (W_96 fb) :=
  SpF.blk_then (blk_96 prof) (SpF.jcc_then (spj_103 prof fb) (SpF.skip 110) (SpF.skip 105))

def W_126 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o7 (Q 135)
theorem c_126 (prof : Profile) (fb : Addr) : SpF prof nps nps_at fb 126 (W_126 fb) :=
  SpF.blk_then (blk_126 prof) (SpF.skip 135)

def W_110 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o6 fb) fun g f V =>
    (f.cond 5 = true → Q 136 g (rfz f) V) ∧
    (f.cond 5 = false → W_126 fb F Wl Q g (rfz f) V)
theorem c_110 (prof : Profile) (fb : Addr) : SpF prof nps nps_at fb 110 (W_110 fb) :=
  SpF.blkF_then (blk_110 prof fb) (SpF.jcc_then (spj_124 prof fb) (SpF.skip 136) (c_126 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 43, 54, 67, 81, 96, 110]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 43 then W_43 fb else
  if ℓ = 54 then W_54 fb else
  if ℓ = 67 then W_67 fb else
  if ℓ = 81 then W_81 fb else
  if ℓ = 96 then W_96 fb else
  if ℓ = 110 then W_110 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof nps nps_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_43 prof fb) <|
  SpF.table (c_54 prof fb) <|
  SpF.table (c_67 prof fb) <|
  SpF.table (c_81 prof fb) <|
  SpF.table (c_96 prof fb) <|
  SpF.table (c_110 prof fb) <|
  SpF.never ℓ

end FV7z.Nps
