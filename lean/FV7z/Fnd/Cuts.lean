import FV7z.Fnd.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NWindows::NFile::NFind::CFileInfo::Find` (PLAN.md §M, M1)

The 7 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (17, 87, 129; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Fnd
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 17)
theorem c_0 (prof : Profile) : Sp prof fnd fnd_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 17)

def W_41 : Wpt := fun F Wl Q g f V =>
    Q 80 g (rfz f) V
theorem c_41 (prof : Profile) : Sp prof fnd fnd_at 41 W_41 :=
  Sp.jmp_then (spj_41 prof) (Sp.skip 80)

def W_29 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 58 g (rfz f) V) ∧
    (f.cond 5 = false → W_41 F Wl Q g (rfz f) V)
theorem c_29 (prof : Profile) : Sp prof fnd fnd_at 29 W_29 :=
  Sp.blk_then (blk_29 prof) (Sp.jcc_then (spj_39 prof) (Sp.skip 58) (c_41 prof))

def W_22 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 122 g (rfz f) V) ∧
    (f.cond 4 = false → W_29 F Wl Q g (rfz f) V)
theorem c_22 (prof : Profile) : Sp prof fnd fnd_at 22 W_22 :=
  Sp.blk_then (blk_22 prof) (Sp.jcc_then (spj_27 prof) (Sp.skip 122) (c_29 prof))

def W_52 : Wpt := fun F Wl Q => wp F Wl o4 (Q 58)
theorem c_52 (prof : Profile) : Sp prof fnd fnd_at 52 W_52 := Sp.blk_then (blk_52 prof) (Sp.skip 58)

def W_48 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 80 g (rfz f) V) ∧
    (f.cond 4 = false → Q 52 g (rfz f) V)
theorem c_48 (prof : Profile) : Sp prof fnd fnd_at 48 W_48 :=
  Sp.blk_then (blk_48 prof) (Sp.jcc_then (spj_50 prof) (Sp.skip 80) (Sp.skip 52))

def W_70 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    Q 52 g (rfz f) V
theorem c_70 (prof : Profile) : Sp prof fnd fnd_at 70 W_70 :=
  Sp.blk_then (blk_70 prof) (Sp.jmp_then (spj_73 prof) (Sp.skip 52))

def W_66 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 80 g (rfz f) V) ∧
    (f.cond 4 = false → W_70 F Wl Q g (rfz f) V)
theorem c_66 (prof : Profile) : Sp prof fnd fnd_at 66 W_66 :=
  Sp.blk_then (blk_66 prof) (Sp.jcc_then (spj_68 prof) (Sp.skip 80) (c_70 prof))

def W_58 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 5 = true → W_48 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → W_66 F Wl Q g (rfz f) V)
theorem c_58 (prof : Profile) : Sp prof fnd fnd_at 58 W_58 :=
  Sp.blk_then (blk_58 prof) (Sp.jcc_then (spj_64 prof) (c_48 prof) (c_66 prof))

def W_80 : Wpt := fun F Wl Q => wp F Wl o7 (Q 87)
theorem c_80 (prof : Profile) : Sp prof fnd fnd_at 80 W_80 := Sp.blk_then (blk_80 prof) (Sp.skip 87)

def W_112 : Wpt := fun F Wl Q => wp F Wl o10 (Q 122)
theorem c_112 (prof : Profile) : Sp prof fnd fnd_at 112 W_112 := Sp.blk_then (blk_112 prof) (Sp.skip 122)

def W_99 : Wpt := fun F Wl Q => wp F Wl o9 fun g f V =>
    (f.cond 5 = true → Q 122 g (rfz f) V) ∧
    (f.cond 5 = false → W_112 F Wl Q g (rfz f) V)
theorem c_99 (prof : Profile) : Sp prof fnd fnd_at 99 W_99 :=
  Sp.blk_then (blk_99 prof) (Sp.jcc_then (spj_110 prof) (Sp.skip 122) (c_112 prof))

def W_92 : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    (f.cond 4 = true → Q 122 g (rfz f) V) ∧
    (f.cond 4 = false → W_99 F Wl Q g (rfz f) V)
theorem c_92 (prof : Profile) : Sp prof fnd fnd_at 92 W_92 :=
  Sp.blk_then (blk_92 prof) (Sp.jcc_then (spj_97 prof) (Sp.skip 122) (c_99 prof))

def W_122 : Wpt := fun F Wl Q => wp F Wl o11 (Q 129)
theorem c_122 (prof : Profile) : Sp prof fnd fnd_at 122 W_122 := Sp.blk_then (blk_122 prof) (Sp.skip 129)

/-- The cut points. -/
def cuts : List Nat := [0, 22, 52, 58, 80, 92, 122]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 22 then W_22 else
  if ℓ = 52 then W_52 else
  if ℓ = 58 then W_58 else
  if ℓ = 80 then W_80 else
  if ℓ = 92 then W_92 else
  if ℓ = 122 then W_122 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof fnd fnd_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_22 prof) <|
  Sp.table (c_52 prof) <|
  Sp.table (c_58 prof) <|
  Sp.table (c_80 prof) <|
  Sp.table (c_92 prof) <|
  Sp.table (c_122 prof) <|
  Sp.never ℓ

end FV7z.Fnd
