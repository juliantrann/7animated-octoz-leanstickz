import FV7z.Lpd.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `LzmaProps_Decode` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (86, 101; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Lpd
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_36 : Wpt := fun F Wl Q => wp F Wl o2 (Q 86)
theorem c_36 (prof : Profile) : Sp prof lpd lpd_at 36 W_36 := Sp.blk_then (blk_36 prof) (Sp.skip 86)

def W_9 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 7 = true → Q 96 g (rfz f) V) ∧
    (f.cond 7 = false → W_36 F Wl Q g (rfz f) V)
theorem c_9 (prof : Profile) : Sp prof lpd lpd_at 9 W_9 :=
  Sp.blk_then (blk_9 prof) (Sp.jcc_then (spj_34 prof) (Sp.skip 96) (c_36 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 6 = true → Q 96 g (rfz f) V) ∧
    (f.cond 6 = false → W_9 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof lpd lpd_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_7 prof) (Sp.skip 96) (c_9 prof))

def W_96 : Wpt := fun F Wl Q => wp F Wl o3 (Q 101)
theorem c_96 (prof : Profile) : Sp prof lpd lpd_at 96 W_96 := Sp.blk_then (blk_96 prof) (Sp.skip 101)

/-- The cut points. -/
def cuts : List Nat := [0, 96]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 96 then W_96 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof lpd lpd_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_96 prof) <|
  Sp.never ℓ

end FV7z.Lpd
