import FV7z.Lza.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `LzmaDec_Allocate` (PLAN.md §M, M1)

The 10 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (39, 84, 103, 207, 225, 284, 294; the `ret`). `Wt` is the
table of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Lza
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 39)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof lza lza_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 39)

def W_88 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 (Q 103)
theorem c_88 (prof : Profile) (fb : Addr) : SpF prof lza lza_at fb 88 (W_88 fb) :=
  SpF.blk_then (blk_88 prof) (SpF.skip 103)

def W_44 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → W_88 fb F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 51 g (rfz f) V)
theorem c_44 (prof : Profile) (fb : Addr) : SpF prof lza lza_at fb 44 (W_44 fb) :=
  SpF.blk_then (blk_44 prof) (SpF.jcc_then (spj_49 prof fb) (c_88 prof fb) (SpF.skip 51))

def W_71 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 84)
theorem c_71 (prof : Profile) (fb : Addr) : SpF prof lza lza_at fb 71 (W_71 fb) :=
  SpF.blk_then (blk_71 prof) (SpF.skip 84)

def W_51 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o2 fb) fun g f V =>
    (f.cond 5 = true → Q 294 g (rfz f) V) ∧
    (f.cond 5 = false → W_71 fb F Wl Q g (rfz f) V)
theorem c_51 (prof : Profile) (fb : Addr) : SpF prof lza lza_at fb 51 (W_51 fb) :=
  SpF.blkF_then (blk_51 prof fb) (SpF.jcc_then (spj_65 prof fb) (SpF.skip 294) (c_71 prof fb))

def W_256 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o13 fun g f V =>
    Q 173 g (rfz f) V
theorem c_256 (prof : Profile) (fb : Addr) : SpF prof lza lza_at fb 256 (W_256 fb) :=
