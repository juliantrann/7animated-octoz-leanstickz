def W_289 (fb : Addr) : Wpt := fun F Wl Q g f V =>
    Q 51 g (rfz f) V
theorem c_289 (prof : Profile) (fb : Addr) : SpF prof lza lza_at fb 289 (W_289 fb) :=
  SpF.jmp_then (spj_289 prof fb) (SpF.skip 51)

/-- The cut points. -/
def cuts : List Nat := [0, 44, 51, 108, 173, 204, 211, 229, 238, 289]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 44 then W_44 fb else
  if ℓ = 51 then W_51 fb else
  if ℓ = 108 then W_108 fb else
  if ℓ = 173 then W_173 fb else
  if ℓ = 204 then W_204 fb else
  if ℓ = 211 then W_211 fb else
  if ℓ = 229 then W_229 fb else
  if ℓ = 238 then W_238 fb else
  if ℓ = 289 then W_289 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof lza lza_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_44 prof fb) <|
  SpF.table (c_51 prof fb) <|
  SpF.table (c_108 prof fb) <|
  SpF.table (c_173 prof fb) <|
  SpF.table (c_204 prof fb) <|
  SpF.table (c_211 prof fb) <|
  SpF.table (c_229 prof fb) <|
  SpF.table (c_238 prof fb) <|
  SpF.table (c_289 prof fb) <|
  SpF.never ℓ

end FV7z.Lza
