def W_130 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o6 (Q 173)
theorem c_130 (prof : Profile) (fb : Addr) : SpF prof lza lza_at fb 130 (W_130 fb) :=
  SpF.blk_then (blk_130 prof) (SpF.skip 173)

def W_115 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
