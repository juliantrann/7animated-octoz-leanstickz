import FV7z.Fsv.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `fs2us (const char *), the twin at 0x44e600` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (31, 61, 62; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Fsv
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 31)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof fsv fsv_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 31)

def W_52 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 61)
theorem c_52 (prof : Profile) (fb : Addr) : SpF prof fsv fsv_at fb 52 (W_52 fb) :=
  SpF.blk_then (blk_52 prof) (SpF.skip 61)

def W_36 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o1 fb) fun g f V =>
    (f.cond 5 = true → Q 62 g (rfz f) V) ∧
    (f.cond 5 = false → W_52 fb F Wl Q g (rfz f) V)
theorem c_36 (prof : Profile) (fb : Addr) : SpF prof fsv fsv_at fb 36 (W_36 fb) :=
  SpF.blkF_then (blk_36 prof fb) (SpF.jcc_then (spj_50 prof fb) (SpF.skip 62) (c_52 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 36]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 36 then W_36 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof fsv fsv_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_36 prof fb) <|
  SpF.never ℓ

end FV7z.Fsv
