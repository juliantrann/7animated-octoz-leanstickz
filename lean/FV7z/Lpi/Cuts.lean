import FV7z.Lpi.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__libc_pthread_init` (PLAN.md G3, startup)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (24, 40; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Lpi
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 24)
theorem c_0 (prof : Profile) : Sp prof lpi lpi_at 0 W_0 := Sp.blkA_then (blk_0 prof) (Sp.skip 24)

def W_29 : Wpt := fun F Wl Q => wp F Wl o1 (Q 40)
theorem c_29 (prof : Profile) : Sp prof lpi lpi_at 29 W_29 := Sp.blkA_then (blk_29 prof) (Sp.skip 40)

/-- The cut points. -/
def cuts : List Nat := [0, 29]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 29 then W_29 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof lpi lpi_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_29 prof) <|
  Sp.never ℓ

end FV7z.Lpi
