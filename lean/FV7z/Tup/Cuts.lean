import FV7z.Tup.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `towupper` (PLAN.md §M, M1)

The 1 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (76, 92; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Tup
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_80 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 92)
theorem c_80 (prof : Profile) (fb : Addr) : SpF prof tup tup_at fb 80 (W_80 fb) :=
  SpF.blk_then (blk_80 prof) (SpF.skip 92)

def W_55 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → W_80 fb F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → Q 76 g (rfz f) V)
theorem c_55 (prof : Profile) (fb : Addr) : SpF prof tup tup_at fb 55 (W_55 fb) :=
  SpF.blk_then (blk_55 prof) (SpF.jcc_then (spj_74 prof fb) (c_80 prof fb) (SpF.skip 76))

def W_45 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 76 g (rfz f) V) ∧
    (f.cond 4 = false → W_55 fb F Wl Q g (rfz f) V)
theorem c_45 (prof : Profile) (fb : Addr) : SpF prof tup tup_at fb 45 (W_45 fb) :=
  SpF.blk_then (blk_45 prof) (SpF.jcc_then (spj_53 prof fb) (SpF.skip 76) (c_55 prof fb))

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) fun g f V =>
    (f.cond 3 = true → Q 76 g (rfz f) V) ∧
    (f.cond 3 = false → W_45 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof tup tup_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.jcc_then (spj_43 prof fb) (SpF.skip 76) (c_45 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof tup tup_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.never ℓ

end FV7z.Tup
