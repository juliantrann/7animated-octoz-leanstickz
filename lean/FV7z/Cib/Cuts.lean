import FV7z.Cib.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NCompress::NLzma::CDecoder::CreateInputBuffer` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (27, 42, 65, 72; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Cib
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_17 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 64 g (rfz f) V) ∧
    (f.cond 4 = false → Q 27 g (rfz f) V)
theorem c_17 (prof : Profile) : Sp prof cib cib_at 17 W_17 :=
  Sp.blk_then (blk_17 prof) (Sp.jcc_then (spj_25 prof) (Sp.skip 64) (Sp.skip 27))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 27 g (rfz f) V) ∧
    (f.cond 4 = false → W_17 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof cib cib_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_15 prof) (Sp.skip 27) (c_17 prof))

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 (Q 42)
theorem c_32 (prof : Profile) : Sp prof cib cib_at 32 W_32 := Sp.blk_then (blk_32 prof) (Sp.skip 42)

def W_66 : Wpt := fun F Wl Q => wp F Wl o6 (Q 72)
theorem c_66 (prof : Profile) : Sp prof cib cib_at 66 W_66 := Sp.blk_then (blk_66 prof) (Sp.skip 72)

def W_56 : Wpt := fun F Wl Q => wp F Wl o4 (Q 64)
theorem c_56 (prof : Profile) : Sp prof cib cib_at 56 W_56 := Sp.blk_then (blk_56 prof) (Sp.skip 64)

def W_47 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → W_66 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_56 F Wl Q g (rfz f) V)
theorem c_47 (prof : Profile) : Sp prof cib cib_at 47 W_47 :=
  Sp.blk_then (blk_47 prof) (Sp.jcc_then (spj_54 prof) (c_66 prof) (c_56 prof))

def W_64 : Wpt := fun F Wl Q => wp F Wl o5 (Q 65)
theorem c_64 (prof : Profile) : Sp prof cib cib_at 64 W_64 := Sp.blk_then (blk_64 prof) (Sp.skip 65)

/-- The cut points. -/
def cuts : List Nat := [0, 32, 47, 64]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 32 then W_32 else
  if ℓ = 47 then W_47 else
  if ℓ = 64 then W_64 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof cib cib_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_32 prof) <|
  Sp.table (c_47 prof) <|
  Sp.table (c_64 prof) <|
  Sp.never ℓ

end FV7z.Cib
