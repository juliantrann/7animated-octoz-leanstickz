import FV7z.Sas.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `SysAllocStringLen` (PLAN.md §M, M1)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (34, 65, 88, 106; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Sas
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_18 : Wpt := fun F Wl Q => wp F Wl o1 (Q 34)
theorem c_18 (prof : Profile) : Sp prof sas sas_at 18 W_18 := Sp.blk_then (blk_18 prof) (Sp.skip 34)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 7 = true → Q 96 g (rfz f) V) ∧
    (f.cond 7 = false → W_18 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof sas sas_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_16 prof) (Sp.skip 96) (c_18 prof))

def W_56 : Wpt := fun F Wl Q => wp F Wl o4 (Q 65)
theorem c_56 (prof : Profile) : Sp prof sas sas_at 56 W_56 := Sp.blk_then (blk_56 prof) (Sp.skip 65)

def W_44 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 73 g (rfz f) V) ∧
    (f.cond 4 = false → W_56 F Wl Q g (rfz f) V)
theorem c_44 (prof : Profile) : Sp prof sas sas_at 44 W_44 :=
  Sp.blk_then (blk_44 prof) (Sp.jcc_then (spj_54 prof) (Sp.skip 73) (c_56 prof))

def W_39 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 96 g (rfz f) V) ∧
    (f.cond 4 = false → W_44 F Wl Q g (rfz f) V)
theorem c_39 (prof : Profile) : Sp prof sas sas_at 39 W_39 :=
  Sp.blk_then (blk_39 prof) (Sp.jcc_then (spj_42 prof) (Sp.skip 96) (c_44 prof))

def W_70 : Wpt := fun F Wl Q => wp F Wl o5 (Q 73)
theorem c_70 (prof : Profile) : Sp prof sas sas_at 70 W_70 := Sp.blk_then (blk_70 prof) (Sp.skip 73)

def W_73 : Wpt := fun F Wl Q => wp F Wl o6 (Q 88)
theorem c_73 (prof : Profile) : Sp prof sas sas_at 73 W_73 := Sp.blk_then (blk_73 prof) (Sp.skip 88)

def W_96 : Wpt := fun F Wl Q => wp F Wl o7 (Q 106)
theorem c_96 (prof : Profile) : Sp prof sas sas_at 96 W_96 := Sp.blk_then (blk_96 prof) (Sp.skip 106)

/-- The cut points. -/
def cuts : List Nat := [0, 39, 70, 73, 96]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 39 then W_39 else
  if ℓ = 70 then W_70 else
  if ℓ = 73 then W_73 else
  if ℓ = 96 then W_96 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof sas sas_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_39 prof) <|
  Sp.table (c_70 prof) <|
  Sp.table (c_73 prof) <|
  Sp.table (c_96 prof) <|
  Sp.never ℓ

end FV7z.Sas
