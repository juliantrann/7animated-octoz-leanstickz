import FV7z.Isk.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CInFileStream::Seek` (PLAN.md §M, M1)

The 6 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (23, 52, 56, 90; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Isk
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_104 : Wpt := fun F Wl Q => wp F Wl o10 fun g f V =>
    Q 45 g (rfz f) V
theorem c_104 (prof : Profile) : Sp prof isk isk_at 104 W_104 :=
  Sp.blk_then (blk_104 prof) (Sp.jmp_then (spj_110 prof) (Sp.skip 45))

def W_13 : Wpt := fun F Wl Q => wp F Wl o1 (Q 23)
theorem c_13 (prof : Profile) : Sp prof isk isk_at 13 W_13 := Sp.blk_then (blk_13 prof) (Sp.skip 23)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 7 = true → W_104 F Wl Q g (rfz f) V) ∧
    (f.cond 7 = false → W_13 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof isk isk_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_11 prof) (c_104 prof) (c_13 prof))

def W_42 : Wpt := fun F Wl Q => wp F Wl o4 (Q 45)
theorem c_42 (prof : Profile) : Sp prof isk isk_at 42 W_42 := Sp.blk_then (blk_42 prof) (Sp.skip 45)

def W_34 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 45 g (rfz f) V) ∧
    (f.cond 4 = false → W_42 F Wl Q g (rfz f) V)
theorem c_34 (prof : Profile) : Sp prof isk isk_at 34 W_34 :=
  Sp.blk_then (blk_34 prof) (Sp.jcc_then (spj_40 prof) (Sp.skip 45) (c_42 prof))

def W_28 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 56 g (rfz f) V) ∧
    (f.cond 4 = false → W_34 F Wl Q g (rfz f) V)
theorem c_28 (prof : Profile) : Sp prof isk isk_at 28 W_28 :=
  Sp.blk_then (blk_28 prof) (Sp.jcc_then (spj_32 prof) (Sp.skip 56) (c_34 prof))

def W_45 : Wpt := fun F Wl Q => wp F Wl o5 (Q 52)
theorem c_45 (prof : Profile) : Sp prof isk isk_at 45 W_45 := Sp.blk_then (blk_45 prof) (Sp.skip 52)

def W_112 : Wpt := fun F Wl Q => wp F Wl o11 fun g f V =>
    Q 82 g (rfz f) V
theorem c_112 (prof : Profile) : Sp prof isk isk_at 112 W_112 :=
  Sp.blk_then (blk_112 prof) (Sp.jmp_then (spj_118 prof) (Sp.skip 82))

def W_65 : Wpt := fun F Wl Q => wp F Wl o7 (Q 82)
theorem c_65 (prof : Profile) : Sp prof isk isk_at 65 W_65 := Sp.blk_then (blk_65 prof) (Sp.skip 82)

def W_61 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    (f.cond 4 = true → W_112 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_65 F Wl Q g (rfz f) V)
theorem c_61 (prof : Profile) : Sp prof isk isk_at 61 W_61 :=
  Sp.blk_then (blk_61 prof) (Sp.jcc_then (spj_63 prof) (c_112 prof) (c_65 prof))

def W_87 : Wpt := fun F Wl Q => wp F Wl o9 (Q 90)
theorem c_87 (prof : Profile) : Sp prof isk isk_at 87 W_87 := Sp.blk_then (blk_87 prof) (Sp.skip 90)

def W_82 : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    (f.cond 4 = true → Q 45 g (rfz f) V) ∧
    (f.cond 4 = false → W_87 F Wl Q g (rfz f) V)
theorem c_82 (prof : Profile) : Sp prof isk isk_at 82 W_82 :=
  Sp.blk_then (blk_82 prof) (Sp.jcc_then (spj_85 prof) (Sp.skip 45) (c_87 prof))

def W_95 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    Q 45 g (rfz f) V
theorem c_95 (prof : Profile) : Sp prof isk isk_at 95 W_95 :=
  Sp.blk_then (blk_95 prof) (Sp.jmp_then (spj_98 prof) (Sp.skip 45))

/-- The cut points. -/
def cuts : List Nat := [0, 28, 45, 61, 82, 95]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 28 then W_28 else
  if ℓ = 45 then W_45 else
  if ℓ = 61 then W_61 else
  if ℓ = 82 then W_82 else
  if ℓ = 95 then W_95 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof isk isk_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_28 prof) <|
  Sp.table (c_45 prof) <|
  Sp.table (c_61 prof) <|
  Sp.table (c_82 prof) <|
  Sp.table (c_95 prof) <|
  Sp.never ℓ

end FV7z.Isk
