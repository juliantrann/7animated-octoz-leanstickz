import FV7z.Aas.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `AString::operator= (const AString &)` (PLAN.md §M, M1)

The 6 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (84, 95, 112; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Aas
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_88 : Wpt := fun F Wl Q => wp F Wl o6 (Q 95)
theorem c_88 (prof : Profile) : Sp prof aas aas_at 88 W_88 := Sp.blk_then (blk_88 prof) (Sp.skip 95)

def W_35 : Wpt := fun F Wl Q => wp F Wl o2 (Q 38)
theorem c_35 (prof : Profile) : Sp prof aas aas_at 35 W_35 := Sp.blk_then (blk_35 prof) (Sp.skip 38)

def W_22 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 2 = true → W_88 F Wl Q g (rfz f) V) ∧
    (f.cond 2 = false → W_35 F Wl Q g (rfz f) V)
theorem c_22 (prof : Profile) : Sp prof aas aas_at 22 W_22 :=
  Sp.blk_then (blk_22 prof) (Sp.jcc_then (spj_33 prof) (c_88 prof) (c_35 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 71 g (rfz f) V) ∧
    (f.cond 4 = false → W_22 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof aas aas_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_20 prof) (Sp.skip 71) (c_22 prof))

def W_38 : Wpt := fun F Wl Q => wp F Wl o3 (Q 56)
theorem c_38 (prof : Profile) : Sp prof aas aas_at 38 W_38 := Sp.blk_then (blk_38 prof) (Sp.skip 56)

def W_56 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 5 = true → Q 56 g (rfz f) V) ∧
    (f.cond 5 = false → Q 71 g (rfz f) V)
theorem c_56 (prof : Profile) : Sp prof aas aas_at 56 W_56 :=
  Sp.blk_then (blk_56 prof) (Sp.jcc_then (spj_69 prof) (Sp.skip 56) (Sp.skip 71))

def W_71 : Wpt := fun F Wl Q => wp F Wl o5 (Q 84)
theorem c_71 (prof : Profile) : Sp prof aas aas_at 71 W_71 := Sp.blk_then (blk_71 prof) (Sp.skip 84)

def W_100 : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    (f.cond 4 = true → Q 117 g (rfz f) V) ∧
    (f.cond 4 = false → Q 112 g (rfz f) V)
theorem c_100 (prof : Profile) : Sp prof aas aas_at 100 W_100 :=
  Sp.blk_then (blk_100 prof) (Sp.jcc_then (spj_110 prof) (Sp.skip 117) (Sp.skip 112))

def W_117 : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    Q 38 g (rfz f) V
theorem c_117 (prof : Profile) : Sp prof aas aas_at 117 W_117 :=
  Sp.blk_then (blk_117 prof) (Sp.jmp_then (spj_126 prof) (Sp.skip 38))

/-- The cut points. -/
def cuts : List Nat := [0, 38, 56, 71, 100, 117]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 38 then W_38 else
  if ℓ = 56 then W_56 else
  if ℓ = 71 then W_71 else
  if ℓ = 100 then W_100 else
  if ℓ = 117 then W_117 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof aas aas_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_38 prof) <|
  Sp.table (c_56 prof) <|
  Sp.table (c_71 prof) <|
  Sp.table (c_100 prof) <|
  Sp.table (c_117 prof) <|
  Sp.never ℓ

end FV7z.Aas
