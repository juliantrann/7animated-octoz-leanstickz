import FV7z.Dtu.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `do_tunable_update_val` (PLAN.md G3, startup)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (38, 52, 76; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Dtu
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_48 : Wpt := fun F Wl Q => wp F Wl o5 (Q 52)
theorem c_48 (prof : Profile) : Sp prof dtu dtu_at 48 W_48 := Sp.blk_then (blk_48 prof) (Sp.skip 52)

def W_68 : Wpt := fun F Wl Q => wp F Wl o4 (Q 76)
theorem c_68 (prof : Profile) : Sp prof dtu dtu_at 68 W_68 := Sp.blk_then (blk_68 prof) (Sp.skip 76)

def W_62 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 15 = true → Q 52 g (rfz f) V) ∧
    (f.cond 15 = false → W_68 F Wl Q g (rfz f) V)
theorem c_62 (prof : Profile) : Sp prof dtu dtu_at 62 W_62 :=
  Sp.blk_then (blk_62 prof) (Sp.jcc_then (spj_66 prof) (Sp.skip 52) (c_68 prof))

def W_56 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 12 = true → Q 52 g (rfz f) V) ∧
    (f.cond 12 = false → W_62 F Wl Q g (rfz f) V)
theorem c_56 (prof : Profile) : Sp prof dtu dtu_at 56 W_56 :=
  Sp.blk_then (blk_56 prof) (Sp.jcc_then (spj_60 prof) (Sp.skip 52) (c_62 prof))

def W_16 : Wpt := fun F Wl Q g f V =>
    (f.cond 6 = true → W_56 F Wl Q g (rfz f) V) ∧
    (f.cond 6 = false → Q 18 g (rfz f) V)
theorem c_16 (prof : Profile) : Sp prof dtu dtu_at 16 W_16 :=
  Sp.jcc_then (spj_16 prof) (c_56 prof) (Sp.skip 18)

def W_8 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 18 g (rfz f) V) ∧
    (f.cond 4 = false → W_16 F Wl Q g (rfz f) V)
theorem c_8 (prof : Profile) : Sp prof dtu dtu_at 8 W_8 :=
  Sp.blk_then (blk_8 prof) (Sp.jcc_then (spj_14 prof) (Sp.skip 18) (c_16 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → W_48 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_8 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof dtu dtu_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_6 prof) (c_48 prof) (c_8 prof))

def W_30 : Wpt := fun F Wl Q => wp F Wl o4 (Q 38)
theorem c_30 (prof : Profile) : Sp prof dtu dtu_at 30 W_30 := Sp.blk_then (blk_30 prof) (Sp.skip 38)

def W_24 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 7 = true → Q 52 g (rfz f) V) ∧
    (f.cond 7 = false → W_30 F Wl Q g (rfz f) V)
theorem c_24 (prof : Profile) : Sp prof dtu dtu_at 24 W_24 :=
  Sp.blk_then (blk_24 prof) (Sp.jcc_then (spj_28 prof) (Sp.skip 52) (c_30 prof))

def W_18 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 2 = true → Q 52 g (rfz f) V) ∧
    (f.cond 2 = false → W_24 F Wl Q g (rfz f) V)
theorem c_18 (prof : Profile) : Sp prof dtu dtu_at 18 W_18 :=
  Sp.blk_then (blk_18 prof) (Sp.jcc_then (spj_22 prof) (Sp.skip 52) (c_24 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 18]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 18 then W_18 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof dtu dtu_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_18 prof) <|
  Sp.never ℓ

end FV7z.Dtu
