/-- The cut points. -/
def cuts : List Nat := [0, 39, 74, 80, 114, 127, 137, 165, 181]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 39 then W_39 else
  if ℓ = 74 then W_74 else
  if ℓ = 80 then W_80 else
  if ℓ = 114 then W_114 else
  if ℓ = 127 then W_127 else
  if ℓ = 137 then W_137 else
  if ℓ = 165 then W_165 else
  if ℓ = 181 then W_181 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof dab dab_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_39 prof) <|
  Sp.table (c_74 prof) <|
  Sp.table (c_80 prof) <|
  Sp.table (c_114 prof) <|
  Sp.table (c_127 prof) <|
  Sp.table (c_137 prof) <|
  Sp.table (c_165 prof) <|
  Sp.table (c_181 prof) <|
  Sp.never ℓ

