/-- The cut points. -/
def cuts : List Nat := [0, 24, 45, 55, 88, 109, 128, 192, 240]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 24 then W_24 else
  if ℓ = 45 then W_45 else
  if ℓ = 55 then W_55 else
  if ℓ = 88 then W_88 else
  if ℓ = 109 then W_109 else
  if ℓ = 128 then W_128 else
  if ℓ = 192 then W_192 else
  if ℓ = 240 then W_240 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ecq ecq_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_24 prof) <|
  Sp.table (c_45 prof) <|
  Sp.table (c_55 prof) <|
  Sp.table (c_88 prof) <|
  Sp.table (c_109 prof) <|
  Sp.table (c_128 prof) <|
  Sp.table (c_192 prof) <|
  Sp.table (c_240 prof) <|
  Sp.never ℓ

