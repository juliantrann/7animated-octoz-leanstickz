import FV7z.Dbg.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `_dl_debug_initialize` (PLAN.md G3, startup)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (92, 96; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Dbg
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_16 : Wpt := fun F Wl Q => wp F Wl o1 (Q 36)
theorem c_16 (prof : Profile) : Sp prof dbg dbg_at 16 W_16 := Sp.blkA_then (blk_16 prof) (Sp.skip 36)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 36 g (rfz f) V) ∧
    (f.cond 4 = false → W_16 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof dbg dbg_at 0 W_0 :=
  Sp.blkA_then (blk_0 prof) (Sp.jcc_then (spj_14 prof) (Sp.skip 36) (c_16 prof))

def W_115 : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    Q 54 g (rfz f) V
theorem c_115 (prof : Profile) : Sp prof dbg dbg_at 115 W_115 :=
  Sp.blkA_then (blk_115 prof) (Sp.jmp_then (spj_122 prof) (Sp.skip 54))

def W_104 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    (f.cond 5 = true → Q 54 g (rfz f) V) ∧
    (f.cond 5 = false → W_115 F Wl Q g (rfz f) V)
theorem c_104 (prof : Profile) : Sp prof dbg dbg_at 104 W_104 :=
  Sp.blk_then (blk_104 prof) (Sp.jcc_then (spj_113 prof) (Sp.skip 54) (c_115 prof))

def W_48 : Wpt := fun F Wl Q => wp F Wl o4 (Q 54)
theorem c_48 (prof : Profile) : Sp prof dbg dbg_at 48 W_48 := Sp.blk_then (blk_48 prof) (Sp.skip 54)

def W_43 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 96 g (rfz f) V) ∧
    (f.cond 4 = false → W_48 F Wl Q g (rfz f) V)
theorem c_43 (prof : Profile) : Sp prof dbg dbg_at 43 W_43 :=
  Sp.blk_then (blk_43 prof) (Sp.jcc_then (spj_46 prof) (Sp.skip 96) (c_48 prof))

def W_36 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → W_104 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_43 F Wl Q g (rfz f) V)
theorem c_36 (prof : Profile) : Sp prof dbg dbg_at 36 W_36 :=
  Sp.blk_then (blk_36 prof) (Sp.jcc_then (spj_41 prof) (c_104 prof) (c_43 prof))

def W_54 : Wpt := fun F Wl Q => wp F Wl o5 (Q 92)
theorem c_54 (prof : Profile) : Sp prof dbg dbg_at 54 W_54 := Sp.blkA_then (blk_54 prof) (Sp.skip 92)

/-- The cut points. -/
def cuts : List Nat := [0, 36, 54]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 36 then W_36 else
  if ℓ = 54 then W_54 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof dbg dbg_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_36 prof) <|
  Sp.table (c_54 prof) <|
  Sp.never ℓ

end FV7z.Dbg
