import FV7z.Anc.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `AddNameToCensor` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (55, 87, 116, 117; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Anc
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_52 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 55)
theorem c_52 (prof : Profile) (fb : Addr) : SpF prof anc anc_at fb 52 (W_52 fb) :=
  SpF.blk_then (blk_52 prof) (SpF.skip 55)

def W_45 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 60 g (rfz f) V) ∧
    (f.cond 5 = false → W_52 fb F Wl Q g (rfz f) V)
theorem c_45 (prof : Profile) (fb : Addr) : SpF prof anc anc_at fb 45 (W_45 fb) :=
  SpF.blk_then (blk_45 prof) (SpF.jcc_then (spj_50 prof fb) (SpF.skip 60) (c_52 prof fb))

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) fun g f V =>
    (f.cond 4 = true → Q 60 g (rfz f) V) ∧
    (f.cond 4 = false → W_45 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof anc anc_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.jcc_then (spj_43 prof fb) (SpF.skip 60) (c_45 prof fb))

def W_60 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 87)
theorem c_60 (prof : Profile) (fb : Addr) : SpF prof anc anc_at fb 60 (W_60 fb) :=
  SpF.blk_then (blk_60 prof) (SpF.skip 87)

def W_108 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 (Q 116)
theorem c_108 (prof : Profile) (fb : Addr) : SpF prof anc anc_at fb 108 (W_108 fb) :=
  SpF.blk_then (blk_108 prof) (SpF.skip 116)

def W_92 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o4 fb) fun g f V =>
    (f.cond 5 = true → Q 117 g (rfz f) V) ∧
    (f.cond 5 = false → W_108 fb F Wl Q g (rfz f) V)
theorem c_92 (prof : Profile) (fb : Addr) : SpF prof anc anc_at fb 92 (W_92 fb) :=
  SpF.blkF_then (blk_92 prof fb) (SpF.jcc_then (spj_106 prof fb) (SpF.skip 117) (c_108 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 60, 92]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 60 then W_60 fb else
  if ℓ = 92 then W_92 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof anc anc_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_60 prof fb) <|
  SpF.table (c_92 prof fb) <|
  SpF.never ℓ

end FV7z.Anc
