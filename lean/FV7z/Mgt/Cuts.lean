import FV7z.Mgt.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NWindows::NFile::NDir::MyGetTempPath` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (15, 29, 57, 68; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Mgt
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 15)
theorem c_0 (prof : Profile) : Sp prof mgt mgt_at 0 W_0 := Sp.blkA_then (blk_0 prof) (Sp.skip 15)

def W_20 : Wpt := fun F Wl Q => wp F Wl o1 (Q 29)
theorem c_20 (prof : Profile) : Sp prof mgt mgt_at 20 W_20 := Sp.blk_then (blk_20 prof) (Sp.skip 29)

def W_34 : Wpt := fun F Wl Q => wp F Wl o2 (Q 57)
theorem c_34 (prof : Profile) : Sp prof mgt mgt_at 34 W_34 := Sp.blkA_then (blk_34 prof) (Sp.skip 57)

def W_62 : Wpt := fun F Wl Q => wp F Wl o3 (Q 68)
theorem c_62 (prof : Profile) : Sp prof mgt mgt_at 62 W_62 := Sp.blk_then (blk_62 prof) (Sp.skip 68)

/-- The cut points. -/
def cuts : List Nat := [0, 20, 34, 62]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 20 then W_20 else
  if ℓ = 34 then W_34 else
  if ℓ = 62 then W_62 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof mgt mgt_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_20 prof) <|
  Sp.table (c_34 prof) <|
  Sp.table (c_62 prof) <|
  Sp.never ℓ

end FV7z.Mgt
