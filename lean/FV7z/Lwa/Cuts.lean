import FV7z.Lwa.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `MyStringLower_Ascii(char *)` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (42; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Lwa
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    Q 35 g (rfz f) V
theorem c_0 (prof : Profile) : Sp prof lwa lwa_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jmp_then (spj_4 prof) (Sp.skip 35))

def W_16 : Wpt := fun F Wl Q => wp F Wl o1 (Q 35)
theorem c_16 (prof : Profile) : Sp prof lwa lwa_at 16 W_16 := Sp.blk_then (blk_16 prof) (Sp.skip 35)

def W_35 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → W_16 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → Q 42 g (rfz f) V)
theorem c_35 (prof : Profile) : Sp prof lwa lwa_at 35 W_35 :=
  Sp.blk_then (blk_35 prof) (Sp.jcc_then (spj_40 prof) (c_16 prof) (Sp.skip 42))

/-- The cut points. -/
def cuts : List Nat := [0, 35]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 35 then W_35 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof lwa lwa_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_35 prof) <|
  Sp.never ℓ

end FV7z.Lwa
