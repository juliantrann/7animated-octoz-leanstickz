import FV7z.Usl.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UString::SetStartLen` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (33, 53; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Usl
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 33)
theorem c_0 (prof : Profile) : Sp prof usl usl_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 33)

def W_38 : Wpt := fun F Wl Q => wp F Wl o1 (Q 53)
theorem c_38 (prof : Profile) : Sp prof usl usl_at 38 W_38 := Sp.blk_then (blk_38 prof) (Sp.skip 53)

/-- The cut points. -/
def cuts : List Nat := [0, 38]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 38 then W_38 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof usl usl_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_38 prof) <|
  Sp.never ℓ

end FV7z.Usl
