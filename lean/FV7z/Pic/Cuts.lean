import FV7z.Pic.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CPropVariant::InternalClear` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (23, 32, 53; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Pic
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_14 : Wpt := fun F Wl Q => wp F Wl o1 (Q 22)
theorem c_14 (prof : Profile) : Sp prof pic pic_at 14 W_14 := Sp.blk_then (blk_14 prof) (Sp.skip 22)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → Q 32 g (rfz f) V) ∧
    (f.cond 5 = false → W_14 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof pic pic_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_12 prof) (Sp.skip 32) (c_14 prof))

def W_22 : Wpt := fun F Wl Q => wp F Wl o2 (Q 23)
theorem c_22 (prof : Profile) : Sp prof pic pic_at 22 W_22 := Sp.blk_then (blk_22 prof) (Sp.skip 23)

def W_41 : Wpt := fun F Wl Q => wp F Wl o4 (Q 53)
theorem c_41 (prof : Profile) : Sp prof pic pic_at 41 W_41 := Sp.blk_then (blk_41 prof) (Sp.skip 53)

def W_37 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 9 = true → Q 22 g (rfz f) V) ∧
    (f.cond 9 = false → W_41 F Wl Q g (rfz f) V)
theorem c_37 (prof : Profile) : Sp prof pic pic_at 37 W_37 :=
  Sp.blk_then (blk_37 prof) (Sp.jcc_then (spj_39 prof) (Sp.skip 22) (c_41 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 22, 37]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 22 then W_22 else
  if ℓ = 37 then W_37 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof pic pic_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_22 prof) <|
  Sp.table (c_37 prof) <|
  Sp.never ℓ

end FV7z.Pic
