import FV7z.Pus.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CStdOutStream::PrintUString` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (16, 28, 39; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Pus
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 16)
theorem c_0 (prof : Profile) : Sp prof pus pus_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 16)

def W_21 : Wpt := fun F Wl Q => wp F Wl o1 (Q 28)
theorem c_21 (prof : Profile) : Sp prof pus pus_at 21 W_21 := Sp.blk_then (blk_21 prof) (Sp.skip 28)

def W_33 : Wpt := fun F Wl Q => wp F Wl o2 (Q 39)
theorem c_33 (prof : Profile) : Sp prof pus pus_at 33 W_33 := Sp.blk_then (blk_33 prof) (Sp.skip 39)

/-- The cut points. -/
def cuts : List Nat := [0, 21, 33]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 21 then W_21 else
  if ℓ = 33 then W_33 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof pus pus_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_21 prof) <|
  Sp.table (c_33 prof) <|
  Sp.never ℓ

end FV7z.Pus
