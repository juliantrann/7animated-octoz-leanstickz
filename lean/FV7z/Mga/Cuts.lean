/-- The cut points. -/
def cuts : List Nat := [0, 63, 84, 127, 175, 192, 221, 242, 254, 341]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 63 then W_63 fb else
  if ℓ = 84 then W_84 fb else
  if ℓ = 127 then W_127 fb else
  if ℓ = 175 then W_175 fb else
  if ℓ = 192 then W_192 fb else
  if ℓ = 221 then W_221 fb else
  if ℓ = 242 then W_242 fb else
  if ℓ = 254 then W_254 fb else
  if ℓ = 341 then W_341 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof mga mga_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_63 prof fb) <|
  SpF.table (c_84 prof fb) <|
  SpF.table (c_127 prof fb) <|
  SpF.table (c_175 prof fb) <|
  SpF.table (c_192 prof fb) <|
  SpF.table (c_221 prof fb) <|
  SpF.table (c_242 prof fb) <|
  SpF.table (c_254 prof fb) <|
  SpF.table (c_341 prof fb) <|
  SpF.never ℓ

