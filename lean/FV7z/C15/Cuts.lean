import FV7z.C15.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `Crc64GenerateTable` (PLAN.md G3, constructors)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (142; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.C15
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 32)
theorem c_0 (prof : Profile) : Sp prof c15 c15_at 0 W_0 := Sp.blkA_then (blk_0 prof) (Sp.skip 32)

def W_32 : Wpt := fun F Wl Q => wp F Wl o1 (Q 48)
theorem c_32 (prof : Profile) : Sp prof c15 c15_at 32 W_32 := Sp.blk_then (blk_32 prof) (Sp.skip 48)

def W_88 : Wpt := fun F Wl Q => wp F Wl o4 (Q 112)
theorem c_88 (prof : Profile) : Sp prof c15 c15_at 88 W_88 := Sp.blkA_then (blk_88 prof) (Sp.skip 112)

def W_71 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 5 = true → Q 32 g (rfz f) V) ∧
    (f.cond 5 = false → W_88 F Wl Q g (rfz f) V)
theorem c_71 (prof : Profile) : Sp prof c15 c15_at 71 W_71 :=
  Sp.blk_then (blk_71 prof) (Sp.jcc_then (spj_86 prof) (Sp.skip 32) (c_88 prof))

def W_48 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 48 g (rfz f) V) ∧
    (f.cond 5 = false → W_71 F Wl Q g (rfz f) V)
theorem c_48 (prof : Profile) : Sp prof c15 c15_at 48 W_48 :=
  Sp.blk_then (blk_48 prof) (Sp.jcc_then (spj_69 prof) (Sp.skip 48) (c_71 prof))

def W_112 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 5 = true → Q 112 g (rfz f) V) ∧
    (f.cond 5 = false → Q 142 g (rfz f) V)
theorem c_112 (prof : Profile) : Sp prof c15 c15_at 112 W_112 :=
  Sp.blk_then (blk_112 prof) (Sp.jcc_then (spj_140 prof) (Sp.skip 112) (Sp.skip 142))

/-- The cut points. -/
def cuts : List Nat := [0, 32, 48, 112]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 32 then W_32 else
  if ℓ = 48 then W_48 else
  if ℓ = 112 then W_112 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof c15 c15_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_32 prof) <|
  Sp.table (c_48 prof) <|
  Sp.table (c_112 prof) <|
  Sp.never ℓ

end FV7z.C15
