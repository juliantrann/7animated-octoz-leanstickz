import FV7z.Dow.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CDummyOutStream::Write` (PLAN.md §M, M1)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (53, 62, 96, 97; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Dow
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_45 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 53)
theorem c_45 (prof : Profile) (fb : Addr) : SpF prof dow dow_at fb 45 (W_45 fb) :=
  SpF.blk_then (blk_45 prof) (SpF.skip 53)

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) fun g f V =>
    (f.cond 4 = true → Q 60 g (rfz f) V) ∧
    (f.cond 4 = false → W_45 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof dow dow_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.jcc_then (spj_43 prof fb) (SpF.skip 60) (c_45 prof fb))

def W_56 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 60)
theorem c_56 (prof : Profile) (fb : Addr) : SpF prof dow dow_at fb 56 (W_56 fb) :=
  SpF.blk_then (blk_56 prof) (SpF.skip 60)

def W_60 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 62)
theorem c_60 (prof : Profile) (fb : Addr) : SpF prof dow dow_at fb 60 (W_60 fb) :=
  SpF.blk_then (blk_60 prof) (SpF.skip 62)

def W_71 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 (Q 74)
theorem c_71 (prof : Profile) (fb : Addr) : SpF prof dow dow_at fb 71 (W_71 fb) :=
  SpF.blk_then (blk_71 prof) (SpF.skip 74)

def W_66 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → Q 74 g (rfz f) V) ∧
    (f.cond 4 = false → W_71 fb F Wl Q g (rfz f) V)
theorem c_66 (prof : Profile) (fb : Addr) : SpF prof dow dow_at fb 66 (W_66 fb) :=
  SpF.blk_then (blk_66 prof) (SpF.jcc_then (spj_69 prof fb) (SpF.skip 74) (c_71 prof fb))

def W_90 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o7 (Q 96)
theorem c_90 (prof : Profile) (fb : Addr) : SpF prof dow dow_at fb 90 (W_90 fb) :=
  SpF.blk_then (blk_90 prof) (SpF.skip 96)

def W_74 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o6 fb) fun g f V =>
    (f.cond 5 = true → Q 97 g (rfz f) V) ∧
    (f.cond 5 = false → W_90 fb F Wl Q g (rfz f) V)
theorem c_74 (prof : Profile) (fb : Addr) : SpF prof dow dow_at fb 74 (W_74 fb) :=
  SpF.blkF_then (blk_74 prof fb) (SpF.jcc_then (spj_88 prof fb) (SpF.skip 97) (c_90 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 56, 60, 66, 74]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 56 then W_56 fb else
  if ℓ = 60 then W_60 fb else
  if ℓ = 66 then W_66 fb else
  if ℓ = 74 then W_74 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof dow dow_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_56 prof fb) <|
  SpF.table (c_60 prof fb) <|
  SpF.table (c_66 prof fb) <|
  SpF.table (c_74 prof fb) <|
  SpF.never ℓ

end FV7z.Dow
