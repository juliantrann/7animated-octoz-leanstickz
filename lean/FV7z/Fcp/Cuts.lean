import FV7z.Fcp.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `FindCharPosInString(const char *, char)` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (45, 50, 53; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Fcp
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_51 : Wpt := fun F Wl Q => wp F Wl o5 (Q 53)
theorem c_51 (prof : Profile) : Sp prof fcp fcp_at 51 W_51 := Sp.blk_then (blk_51 prof) (Sp.skip 53)

def W_17 : Wpt := fun F Wl Q g f V =>
    W_51 F Wl Q g (rfz f) V
theorem c_17 (prof : Profile) : Sp prof fcp fcp_at 17 W_17 :=
  Sp.jmp_then (spj_17 prof) (c_51 prof)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → Q 36 g (rfz f) V) ∧
    (f.cond 5 = false → W_17 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof fcp fcp_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_15 prof) (Sp.skip 36) (c_17 prof))

def W_48 : Wpt := fun F Wl Q => wp F Wl o4 (Q 50)
theorem c_48 (prof : Profile) : Sp prof fcp fcp_at 48 W_48 := Sp.blk_then (blk_48 prof) (Sp.skip 50)

def W_24 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → W_48 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 36 g (rfz f) V)
theorem c_24 (prof : Profile) : Sp prof fcp fcp_at 24 W_24 :=
  Sp.blk_then (blk_24 prof) (Sp.jcc_then (spj_34 prof) (c_48 prof) (Sp.skip 36))

def W_40 : Wpt := fun F Wl Q => wp F Wl o3 (Q 45)
theorem c_40 (prof : Profile) : Sp prof fcp fcp_at 40 W_40 := Sp.blk_then (blk_40 prof) (Sp.skip 45)

def W_36 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → W_24 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → W_40 F Wl Q g (rfz f) V)
theorem c_36 (prof : Profile) : Sp prof fcp fcp_at 36 W_36 :=
  Sp.blk_then (blk_36 prof) (Sp.jcc_then (spj_38 prof) (c_24 prof) (c_40 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 36]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 36 then W_36 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof fcp fcp_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_36 prof) <|
  Sp.never ℓ

end FV7z.Fcp
