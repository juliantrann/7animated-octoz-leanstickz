import FV7z.Raf.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__register_atfork` (PLAN.md G3, startup)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (43, 170, 191, 192, 238, 280, 313, 336, 378, 404; the `ret`).
`Wt` is the table of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Raf
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_38 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 43)
theorem c_38 (prof : Profile) (fb : Addr) : SpF prof raf raf_at fb 38 (W_38 fb) :=
  SpF.blk_then (blk_38 prof) (SpF.skip 43)

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) fun g f V =>
    (f.cond 5 = true → Q 280 g (rfz f) V) ∧
    (f.cond 5 = false → W_38 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof raf raf_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.jcc_then (spj_32 prof fb) (SpF.skip 280) (c_38 prof fb))

def W_131 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 (Q 154)
theorem c_131 (prof : Profile) (fb : Addr) : SpF prof raf raf_at fb 131 (W_131 fb) :=
  SpF.blk_then (blk_131 prof) (SpF.skip 154)

def W_101 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → Q 154 g (rfz f) V) ∧
    (f.cond 4 = false → W_131 fb F Wl Q g (rfz f) V)
theorem c_101 (prof : Profile) (fb : Addr) : SpF prof raf raf_at fb 101 (W_101 fb) :=
  SpF.blkA_then (blk_101 prof) (SpF.jcc_then (spj_129 prof fb) (SpF.skip 154) (c_131 prof fb))

def W_63 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (W_101 fb F Wl Q)
theorem c_63 (prof : Profile) (fb : Addr) : SpF prof raf raf_at fb 63 (W_63 fb) :=
  SpF.blkA_then (blk_63 prof) (c_101 prof fb)

def W_50 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 192 g (rfz f) V) ∧
    (f.cond 5 = false → W_63 fb F Wl Q g (rfz f) V)
theorem c_50 (prof : Profile) (fb : Addr) : SpF prof raf raf_at fb 50 (W_50 fb) :=
  SpF.blkA_then (blk_50 prof) (SpF.jcc_then (spj_57 prof fb) (SpF.skip 192) (c_63 prof fb))

def W_154 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o6 fb) fun g f V =>
    (f.cond 5 = true → Q 336 g (rfz f) V) ∧
    (f.cond 5 = false → Q 170 g (rfz f) V)
theorem c_154 (prof : Profile) (fb : Addr) : SpF prof raf raf_at fb 154 (W_154 fb) :=
  SpF.blkF_then (blk_154 prof fb) (SpF.jcc_then (spj_164 prof fb) (SpF.skip 336) (SpF.skip 170))

def W_177 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o7 (Q 191)
theorem c_177 (prof : Profile) (fb : Addr) : SpF prof raf raf_at fb 177 (W_177 fb) :=
  SpF.blk_then (blk_177 prof) (SpF.skip 191)

/-- The cut points. -/
def cuts : List Nat := [0, 50, 154, 177]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 50 then W_50 fb else
  if ℓ = 154 then W_154 fb else
  if ℓ = 177 then W_177 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof raf raf_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_50 prof fb) <|
  SpF.table (c_154 prof fb) <|
  SpF.table (c_177 prof fb) <|
  SpF.never ℓ

end FV7z.Raf
