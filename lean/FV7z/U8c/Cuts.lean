def W_15 : Wpt := fun F Wl Q => wp F Wl o1 (Q 24)
theorem c_15 (prof : Profile) : Sp prof u8c u8c_at 15 W_15 := Sp.blk_then (blk_15 prof) (Sp.skip 24)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 122 g (rfz f) V) ∧
    (f.cond 4 = false → W_15 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof u8c u8c_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_13 prof) (Sp.skip 122) (c_15 prof))

