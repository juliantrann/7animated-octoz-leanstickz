/-- The cut points. -/
def cuts : List Nat := [0, 24, 67, 128, 131, 184, 224]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 24 then W_24 else
  if ℓ = 67 then W_67 else
  if ℓ = 128 then W_128 else
  if ℓ = 131 then W_131 else
  if ℓ = 184 then W_184 else
  if ℓ = 224 then W_224 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof u8c u8c_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_24 prof) <|
  Sp.table (c_67 prof) <|
  Sp.table (c_128 prof) <|
  Sp.table (c_131 prof) <|
  Sp.table (c_184 prof) <|
  Sp.table (c_224 prof) <|
  Sp.never ℓ

