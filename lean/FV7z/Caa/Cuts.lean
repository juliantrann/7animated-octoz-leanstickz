import FV7z.Caa.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NWildcard::CCensorNode::AreAllAllowed` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (33, 47; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Caa
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_40 : Wpt := fun F Wl Q => wp F Wl o5 (Q 47)
theorem c_40 (prof : Profile) : Sp prof caa caa_at 40 W_40 := Sp.blk_then (blk_40 prof) (Sp.skip 47)

def W_25 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → W_40 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 31 g (rfz f) V)
theorem c_25 (prof : Profile) : Sp prof caa caa_at 25 W_25 :=
  Sp.blk_then (blk_25 prof) (Sp.jcc_then (spj_29 prof) (c_40 prof) (Sp.skip 31))

def W_18 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 31 g (rfz f) V) ∧
    (f.cond 5 = false → W_25 F Wl Q g (rfz f) V)
theorem c_18 (prof : Profile) : Sp prof caa caa_at 18 W_18 :=
  Sp.blk_then (blk_18 prof) (Sp.jcc_then (spj_23 prof) (Sp.skip 31) (c_25 prof))

def W_11 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 31 g (rfz f) V) ∧
    (f.cond 5 = false → W_18 F Wl Q g (rfz f) V)
theorem c_11 (prof : Profile) : Sp prof caa caa_at 11 W_11 :=
  Sp.blk_then (blk_11 prof) (Sp.jcc_then (spj_16 prof) (Sp.skip 31) (c_18 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → Q 31 g (rfz f) V) ∧
    (f.cond 5 = false → W_11 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof caa caa_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_9 prof) (Sp.skip 31) (c_11 prof))

def W_31 : Wpt := fun F Wl Q => wp F Wl o4 (Q 33)
theorem c_31 (prof : Profile) : Sp prof caa caa_at 31 W_31 := Sp.blk_then (blk_31 prof) (Sp.skip 33)

/-- The cut points. -/
def cuts : List Nat := [0, 31]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 31 then W_31 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof caa caa_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_31 prof) <|
  Sp.never ℓ

end FV7z.Caa
