import FV7z.Trl.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `_ZThn24 Release` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (34, 47, 62; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Trl
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_27 : Wpt := fun F Wl Q => wp F Wl o1 (Q 34)
theorem c_27 (prof : Profile) : Sp prof trl trl_at 27 W_27 := Sp.blk_then (blk_27 prof) (Sp.skip 34)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → Q 52 g (rfz f) V) ∧
    (f.cond 5 = false → W_27 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof trl trl_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_25 prof) (Sp.skip 52) (c_27 prof))

def W_39 : Wpt := fun F Wl Q => wp F Wl o2 (Q 47)
theorem c_39 (prof : Profile) : Sp prof trl trl_at 39 W_39 := Sp.blk_then (blk_39 prof) (Sp.skip 47)

def W_52 : Wpt := fun F Wl Q => wp F Wl o3 (Q 62)
theorem c_52 (prof : Profile) : Sp prof trl trl_at 52 W_52 := Sp.blk_then (blk_52 prof) (Sp.skip 62)

/-- The cut points. -/
def cuts : List Nat := [0, 39, 52]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 39 then W_39 else
  if ℓ = 52 then W_52 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof trl trl_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_39 prof) <|
  Sp.table (c_52 prof) <|
  Sp.never ℓ

end FV7z.Trl
