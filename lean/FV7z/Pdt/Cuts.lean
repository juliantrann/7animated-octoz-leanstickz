import FV7z.Pdt.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CPropVariant::Detach` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (45, 51; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Pdt
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_48 : Wpt := fun F Wl Q => wp F Wl o3 (Q 51)
theorem c_48 (prof : Profile) : Sp prof pdt pdt_at 48 W_48 := Sp.blk_then (blk_48 prof) (Sp.skip 51)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → W_48 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → Q 22 g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof pdt pdt_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_20 prof) (c_48 prof) (Sp.skip 22))

def W_22 : Wpt := fun F Wl Q => wp F Wl o1 (Q 39)
theorem c_22 (prof : Profile) : Sp prof pdt pdt_at 22 W_22 := Sp.blk_then (blk_22 prof) (Sp.skip 39)

def W_39 : Wpt := fun F Wl Q => wp F Wl o2 (Q 45)
theorem c_39 (prof : Profile) : Sp prof pdt pdt_at 39 W_39 := Sp.blk_then (blk_39 prof) (Sp.skip 45)

def W_60 : Wpt := fun F Wl Q g f V =>
    Q 39 g (rfz f) V
theorem c_60 (prof : Profile) : Sp prof pdt pdt_at 60 W_60 :=
  Sp.jmp_then (spj_60 prof) (Sp.skip 39)

def W_56 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 9 = true → Q 22 g (rfz f) V) ∧
    (f.cond 9 = false → W_60 F Wl Q g (rfz f) V)
theorem c_56 (prof : Profile) : Sp prof pdt pdt_at 56 W_56 :=
  Sp.blk_then (blk_56 prof) (Sp.jcc_then (spj_58 prof) (Sp.skip 22) (c_60 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 22, 39, 56]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 22 then W_22 else
  if ℓ = 39 then W_39 else
  if ℓ = 56 then W_56 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof pdt pdt_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_22 prof) <|
  Sp.table (c_39 prof) <|
  Sp.table (c_56 prof) <|
  Sp.never ℓ

end FV7z.Pdt
