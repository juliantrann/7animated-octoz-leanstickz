import FV7z.Eli.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `elision_init` (PLAN.md G3, startup)

The 7 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (45, 65, 85, 105, 125, 171, 172; the `ret`). `Wt` is the table
of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Eli
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 45)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof eli eli_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 45)

def W_50 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 65)
theorem c_50 (prof : Profile) (fb : Addr) : SpF prof eli eli_at fb 50 (W_50 fb) :=
  SpF.blkA_then (blk_50 prof) (SpF.skip 65)

def W_70 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 85)
theorem c_70 (prof : Profile) (fb : Addr) : SpF prof eli eli_at fb 70 (W_70 fb) :=
  SpF.blkA_then (blk_70 prof) (SpF.skip 85)

def W_90 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 105)
theorem c_90 (prof : Profile) (fb : Addr) : SpF prof eli eli_at fb 90 (W_90 fb) :=
  SpF.blkA_then (blk_90 prof) (SpF.skip 105)

def W_110 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 (Q 125)
theorem c_110 (prof : Profile) (fb : Addr) : SpF prof eli eli_at fb 110 (W_110 fb) :=
  SpF.blkA_then (blk_110 prof) (SpF.skip 125)

def W_140 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o6 (Q 150)
theorem c_140 (prof : Profile) (fb : Addr) : SpF prof eli eli_at fb 140 (W_140 fb) :=
  SpF.blkA_then (blk_140 prof) (SpF.skip 150)

def W_130 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 5 = true → Q 150 g (rfz f) V) ∧
    (f.cond 5 = false → W_140 fb F Wl Q g (rfz f) V)
theorem c_130 (prof : Profile) (fb : Addr) : SpF prof eli eli_at fb 130 (W_130 fb) :=
  SpF.blkA_then (blk_130 prof) (SpF.jcc_then (spj_138 prof fb) (SpF.skip 150) (c_140 prof fb))

def W_166 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o8 (Q 171)
theorem c_166 (prof : Profile) (fb : Addr) : SpF prof eli eli_at fb 166 (W_166 fb) :=
  SpF.blk_then (blk_166 prof) (SpF.skip 171)

def W_150 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o7 fb) fun g f V =>
    (f.cond 5 = true → Q 172 g (rfz f) V) ∧
    (f.cond 5 = false → W_166 fb F Wl Q g (rfz f) V)
theorem c_150 (prof : Profile) (fb : Addr) : SpF prof eli eli_at fb 150 (W_150 fb) :=
  SpF.blkF_then (blk_150 prof fb) (SpF.jcc_then (spj_164 prof fb) (SpF.skip 172) (c_166 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 50, 70, 90, 110, 130, 150]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 50 then W_50 fb else
  if ℓ = 70 then W_70 fb else
  if ℓ = 90 then W_90 fb else
  if ℓ = 110 then W_110 fb else
  if ℓ = 130 then W_130 fb else
  if ℓ = 150 then W_150 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof eli eli_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_50 prof fb) <|
  SpF.table (c_70 prof fb) <|
  SpF.table (c_90 prof fb) <|
  SpF.table (c_110 prof fb) <|
  SpF.table (c_130 prof fb) <|
  SpF.table (c_150 prof fb) <|
  SpF.never ℓ

end FV7z.Eli
