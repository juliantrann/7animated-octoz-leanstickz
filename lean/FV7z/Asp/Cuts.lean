import FV7z.Asp.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `AString::Add_Space` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (36, 40; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Asp
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 40 g (rfz f) V) ∧
    (f.cond 4 = false → Q 16 g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof asp asp_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_14 prof) (Sp.skip 40) (Sp.skip 16))

def W_16 : Wpt := fun F Wl Q => wp F Wl o1 (Q 36)
theorem c_16 (prof : Profile) : Sp prof asp asp_at 16 W_16 := Sp.blk_then (blk_16 prof) (Sp.skip 36)

def W_45 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    Q 16 g (rfz f) V
theorem c_45 (prof : Profile) : Sp prof asp asp_at 45 W_45 :=
  Sp.blk_then (blk_45 prof) (Sp.jmp_then (spj_48 prof) (Sp.skip 16))

/-- The cut points. -/
def cuts : List Nat := [0, 16, 45]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 16 then W_16 else
  if ℓ = 45 then W_45 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof asp asp_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_16 prof) <|
  Sp.table (c_45 prof) <|
  Sp.never ℓ

end FV7z.Asp
