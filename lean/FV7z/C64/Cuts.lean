import FV7z.C64.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `ConvertUInt64ToString` (PLAN.md §M, M1)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (172, 196, 201; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.C64
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_50 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 56)
theorem c_50 (prof : Profile) (fb : Addr) : SpF prof c64 c64_at fb 50 (W_50 fb) :=
  SpF.blk_then (blk_50 prof) (SpF.skip 56)

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) fun g f V =>
    (f.cond 6 = true → Q 176 g (rfz f) V) ∧
    (f.cond 6 = false → W_50 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof c64 c64_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.jcc_then (spj_48 prof fb) (SpF.skip 176) (c_50 prof fb))

def W_102 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    Q 131 g (rfz f) V
theorem c_102 (prof : Profile) (fb : Addr) : SpF prof c64 c64_at fb 102 (W_102 fb) :=
  SpF.blk_then (blk_102 prof) (SpF.jmp_then (spj_119 prof fb) (SpF.skip 131))

def W_56 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 7 = true → Q 56 g (rfz f) V) ∧
    (f.cond 7 = false → W_102 fb F Wl Q g (rfz f) V)
theorem c_56 (prof : Profile) (fb : Addr) : SpF prof c64 c64_at fb 56 (W_56 fb) :=
  SpF.blk_then (blk_56 prof) (SpF.jcc_then (spj_100 prof fb) (SpF.skip 56) (c_102 prof fb))

def W_128 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 (Q 131)
theorem c_128 (prof : Profile) (fb : Addr) : SpF prof c64 c64_at fb 128 (W_128 fb) :=
  SpF.blk_then (blk_128 prof) (SpF.skip 131)

def W_131 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 5 = true → W_128 fb F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → Q 146 g (rfz f) V)
theorem c_131 (prof : Profile) (fb : Addr) : SpF prof c64 c64_at fb 131 (W_131 fb) :=
  SpF.blk_then (blk_131 prof) (SpF.jcc_then (spj_144 prof fb) (c_128 prof fb) (SpF.skip 146))

def W_168 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o7 (Q 172)
theorem c_168 (prof : Profile) (fb : Addr) : SpF prof c64 c64_at fb 168 (W_168 fb) :=
  SpF.blk_then (blk_168 prof) (SpF.skip 172)

def W_146 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o6 fb) fun g f V =>
    (f.cond 5 = true → Q 201 g (rfz f) V) ∧
    (f.cond 5 = false → W_168 fb F Wl Q g (rfz f) V)
theorem c_146 (prof : Profile) (fb : Addr) : SpF prof c64 c64_at fb 146 (W_146 fb) :=
  SpF.blkF_then (blk_146 prof fb) (SpF.jcc_then (spj_166 prof fb) (SpF.skip 201) (c_168 prof fb))

def W_192 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o7 (Q 196)
theorem c_192 (prof : Profile) (fb : Addr) : SpF prof c64 c64_at fb 192 (W_192 fb) :=
  SpF.blk_then (blk_192 prof) (SpF.skip 196)

def W_176 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o8 fb) fun g f V =>
    (f.cond 5 = true → Q 201 g (rfz f) V) ∧
    (f.cond 5 = false → W_192 fb F Wl Q g (rfz f) V)
theorem c_176 (prof : Profile) (fb : Addr) : SpF prof c64 c64_at fb 176 (W_176 fb) :=
  SpF.blkF_then (blk_176 prof fb) (SpF.jcc_then (spj_190 prof fb) (SpF.skip 201) (c_192 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 56, 131, 146, 176]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 56 then W_56 fb else
  if ℓ = 131 then W_131 fb else
  if ℓ = 146 then W_146 fb else
  if ℓ = 176 then W_176 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof c64 c64_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_56 prof fb) <|
  SpF.table (c_131 prof fb) <|
  SpF.table (c_146 prof fb) <|
  SpF.table (c_176 prof fb) <|
  SpF.never ℓ

end FV7z.C64
