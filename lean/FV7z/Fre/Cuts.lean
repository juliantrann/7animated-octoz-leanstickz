/-- The cut points. -/
def cuts : List Nat := [0, 57, 80, 123]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 57 then W_57 fb else
  if ℓ = 80 then W_80 fb else
  if ℓ = 123 then W_123 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof fre fre_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_57 prof fb) <|
  SpF.table (c_80 prof fb) <|
  SpF.table (c_123 prof fb) <|
  SpF.never ℓ

end FV7z.Fre
