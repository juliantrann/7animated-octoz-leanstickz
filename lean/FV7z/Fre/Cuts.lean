def W_152 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o12 (Q 161)
theorem c_152 (prof : Profile) (fb : Addr) : SpF prof fre fre_at fb 152 (W_152 fb) :=
  SpF.blk_then (blk_152 prof) (SpF.skip 161)

