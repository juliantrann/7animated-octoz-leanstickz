import FV7z.Cua.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CStdOutStream::Convert_UString_to_AString` (PLAN.md §M, M1)

The 1 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (33, 38, 56, 61, 70; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Cua
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_48 : Wpt := fun F Wl Q => wp F Wl o3 (Q 56)
theorem c_48 (prof : Profile) : Sp prof cua cua_at 48 W_48 := Sp.blk_then (blk_48 prof) (Sp.skip 56)

def W_64 : Wpt := fun F Wl Q => wp F Wl o4 (Q 70)
theorem c_64 (prof : Profile) : Sp prof cua cua_at 64 W_64 := Sp.blk_then (blk_64 prof) (Sp.skip 70)

def W_30 : Wpt := fun F Wl Q => wp F Wl o2 (Q 33)
theorem c_30 (prof : Profile) : Sp prof cua cua_at 30 W_30 := Sp.blk_then (blk_30 prof) (Sp.skip 33)

def W_22 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → W_64 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_30 F Wl Q g (rfz f) V)
theorem c_22 (prof : Profile) : Sp prof cua cua_at 22 W_22 :=
  Sp.blk_then (blk_22 prof) (Sp.jcc_then (spj_28 prof) (c_64 prof) (c_30 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → W_48 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_22 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof cua cua_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_20 prof) (c_48 prof) (c_22 prof))

/-- The cut points. -/
def cuts : List Nat := [0]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof cua cua_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.never ℓ

end FV7z.Cua
