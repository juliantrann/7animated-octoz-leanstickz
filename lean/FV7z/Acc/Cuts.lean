import FV7z.Acc.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `AString::AString (const char *)` (PLAN.md §M, M1)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (47, 85; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Acc
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_26 : Wpt := fun F Wl Q => wp F Wl o1 (Q 32)
theorem c_26 (prof : Profile) : Sp prof acc acc_at 26 W_26 := Sp.blk_then (blk_26 prof) (Sp.skip 32)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 44 g (rfz f) V) ∧
    (f.cond 4 = false → W_26 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof acc acc_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_24 prof) (Sp.skip 44) (c_26 prof))

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 32 g (rfz f) V) ∧
    (f.cond 5 = false → Q 44 g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof acc acc_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_42 prof) (Sp.skip 32) (Sp.skip 44))

def W_44 : Wpt := fun F Wl Q => wp F Wl o3 (Q 47)
theorem c_44 (prof : Profile) : Sp prof acc acc_at 44 W_44 := Sp.blk_then (blk_44 prof) (Sp.skip 47)

def W_52 : Wpt := fun F Wl Q => wp F Wl o4 (Q 64)
theorem c_52 (prof : Profile) : Sp prof acc acc_at 52 W_52 := Sp.blk_then (blk_52 prof) (Sp.skip 64)

def W_79 : Wpt := fun F Wl Q => wp F Wl o6 (Q 85)
theorem c_79 (prof : Profile) : Sp prof acc acc_at 79 W_79 := Sp.blk_then (blk_79 prof) (Sp.skip 85)

def W_64 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 5 = true → Q 64 g (rfz f) V) ∧
    (f.cond 5 = false → W_79 F Wl Q g (rfz f) V)
theorem c_64 (prof : Profile) : Sp prof acc acc_at 64 W_64 :=
  Sp.blk_then (blk_64 prof) (Sp.jcc_then (spj_77 prof) (Sp.skip 64) (c_79 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 32, 44, 52, 64]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 32 then W_32 else
  if ℓ = 44 then W_44 else
  if ℓ = 52 then W_52 else
  if ℓ = 64 then W_64 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof acc acc_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_32 prof) <|
  Sp.table (c_44 prof) <|
  Sp.table (c_52 prof) <|
  Sp.table (c_64 prof) <|
  Sp.never ℓ

end FV7z.Acc
