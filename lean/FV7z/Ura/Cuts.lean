import FV7z.Ura.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UString::ReAlloc` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (24, 44, 57, 72; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ura
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 24)
theorem c_0 (prof : Profile) : Sp prof ura ura_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 24)

def W_29 : Wpt := fun F Wl Q => wp F Wl o1 (Q 44)
theorem c_29 (prof : Profile) : Sp prof ura ura_at 29 W_29 := Sp.blk_then (blk_29 prof) (Sp.skip 44)

def W_49 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 62 g (rfz f) V) ∧
    (f.cond 4 = false → Q 57 g (rfz f) V)
theorem c_49 (prof : Profile) : Sp prof ura ura_at 49 W_49 :=
  Sp.blk_then (blk_49 prof) (Sp.jcc_then (spj_55 prof) (Sp.skip 62) (Sp.skip 57))

def W_62 : Wpt := fun F Wl Q => wp F Wl o3 (Q 72)
theorem c_62 (prof : Profile) : Sp prof ura ura_at 62 W_62 := Sp.blk_then (blk_62 prof) (Sp.skip 72)

/-- The cut points. -/
def cuts : List Nat := [0, 29, 49, 62]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 29 then W_29 else
  if ℓ = 49 then W_49 else
  if ℓ = 62 then W_62 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ura ura_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_29 prof) <|
  Sp.table (c_49 prof) <|
  Sp.table (c_62 prof) <|
  Sp.never ℓ

end FV7z.Ura
