import FV7z.Cxd.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CObjectVector<CXmlProp>::~CObjectVector` (PLAN.md §M, M1)

The 7 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (50, 64, 77, 105, 116; the `ret`). `Wt` is the table of the
cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Cxd
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_21 : Wpt := fun F Wl Q => wp F Wl o1 (Q 32)
theorem c_21 (prof : Profile) : Sp prof cxd cxd_at 21 W_21 := Sp.blk_then (blk_21 prof) (Sp.skip 32)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 96 g (rfz f) V) ∧
    (f.cond 4 = false → W_21 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof cxd cxd_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_19 prof) (Sp.skip 96) (c_21 prof))

def W_41 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 55 g (rfz f) V) ∧
    (f.cond 4 = false → Q 50 g (rfz f) V)
theorem c_41 (prof : Profile) : Sp prof cxd cxd_at 41 W_41 :=
  Sp.blk_then (blk_41 prof) (Sp.jcc_then (spj_48 prof) (Sp.skip 55) (Sp.skip 50))

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 86 g (rfz f) V) ∧
    (f.cond 4 = false → W_41 F Wl Q g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof cxd cxd_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_39 prof) (Sp.skip 86) (c_41 prof))

def W_55 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → Q 69 g (rfz f) V) ∧
    (f.cond 4 = false → Q 64 g (rfz f) V)
theorem c_55 (prof : Profile) : Sp prof cxd cxd_at 55 W_55 :=
  Sp.blk_then (blk_55 prof) (Sp.jcc_then (spj_62 prof) (Sp.skip 69) (Sp.skip 64))

def W_69 : Wpt := fun F Wl Q => wp F Wl o5 (Q 77)
theorem c_69 (prof : Profile) : Sp prof cxd cxd_at 69 W_69 := Sp.blk_then (blk_69 prof) (Sp.skip 77)

def W_82 : Wpt := fun F Wl Q => wp F Wl o6 (Q 86)
theorem c_82 (prof : Profile) : Sp prof cxd cxd_at 82 W_82 := Sp.blk_then (blk_82 prof) (Sp.skip 86)

def W_86 : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    (f.cond 5 = true → Q 32 g (rfz f) V) ∧
    (f.cond 5 = false → Q 96 g (rfz f) V)
theorem c_86 (prof : Profile) : Sp prof cxd cxd_at 86 W_86 :=
  Sp.blk_then (blk_86 prof) (Sp.jcc_then (spj_94 prof) (Sp.skip 32) (Sp.skip 96))

def W_112 : Wpt := fun F Wl Q => wp F Wl o9 (Q 116)
theorem c_112 (prof : Profile) : Sp prof cxd cxd_at 112 W_112 := Sp.blk_then (blk_112 prof) (Sp.skip 116)

def W_101 : Wpt := fun F Wl Q => wp F Wl o9 (Q 105)
theorem c_101 (prof : Profile) : Sp prof cxd cxd_at 101 W_101 := Sp.blk_then (blk_101 prof) (Sp.skip 105)

def W_96 : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    (f.cond 4 = true → W_112 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_101 F Wl Q g (rfz f) V)
theorem c_96 (prof : Profile) : Sp prof cxd cxd_at 96 W_96 :=
  Sp.blk_then (blk_96 prof) (Sp.jcc_then (spj_99 prof) (c_112 prof) (c_101 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 32, 55, 69, 82, 86, 96]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 32 then W_32 else
  if ℓ = 55 then W_55 else
  if ℓ = 69 then W_69 else
  if ℓ = 82 then W_82 else
  if ℓ = 86 then W_86 else
  if ℓ = 96 then W_96 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof cxd cxd_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_32 prof) <|
  Sp.table (c_55 prof) <|
  Sp.table (c_69 prof) <|
  Sp.table (c_82 prof) <|
  Sp.table (c_86 prof) <|
  Sp.table (c_96 prof) <|
  Sp.never ℓ

end FV7z.Cxd
