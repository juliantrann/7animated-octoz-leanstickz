import FV7z.Fls.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CStdOutStream::Flush` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (11, 25; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Fls
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 11)
theorem c_0 (prof : Profile) : Sp prof fls fls_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 11)

def W_16 : Wpt := fun F Wl Q => wp F Wl o1 (Q 25)
theorem c_16 (prof : Profile) : Sp prof fls fls_at 16 W_16 := Sp.blk_then (blk_16 prof) (Sp.skip 25)

/-- The cut points. -/
def cuts : List Nat := [0, 16]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 16 then W_16 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof fls fls_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_16 prof) <|
  Sp.never ℓ

end FV7z.Fls
