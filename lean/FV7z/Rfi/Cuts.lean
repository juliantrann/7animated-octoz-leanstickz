import FV7z.Rfi.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__register_frame_info` (PLAN.md G3, startup)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (55, 106, 118, 144, 168, 208; the `ret`). `Wt` is the table of
the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Rfi
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_128 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    Q 88 g (rfz f) V
theorem c_128 (prof : Profile) : Sp prof rfi rfi_at 128 W_128 :=
  Sp.blkA_then (blk_128 prof) (Sp.jmp_then (spj_138 prof) (Sp.skip 88))

def W_60 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → W_128 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 88 g (rfz f) V)
theorem c_60 (prof : Profile) : Sp prof rfi rfi_at 60 W_60 :=
  Sp.blkA_then (blk_60 prof) (Sp.jcc_then (spj_86 prof) (c_128 prof) (Sp.skip 88))

def W_112 : Wpt := fun F Wl Q => wp F Wl o5 (Q 118)
theorem c_112 (prof : Profile) : Sp prof rfi rfi_at 112 W_112 := Sp.blk_then (blk_112 prof) (Sp.skip 118)

def W_93 : Wpt := fun F Wl Q => wp F Wl o4 (Q 106)
theorem c_93 (prof : Profile) : Sp prof rfi rfi_at 93 W_93 := Sp.blkA_then (blk_93 prof) (Sp.skip 106)

def W_88 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → W_112 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_93 F Wl Q g (rfz f) V)
theorem c_88 (prof : Profile) : Sp prof rfi rfi_at 88 W_88 :=
  Sp.blk_then (blk_88 prof) (Sp.jcc_then (spj_91 prof) (c_112 prof) (c_93 prof))

def W_48 : Wpt := fun F Wl Q => wp F Wl o1 (Q 55)
theorem c_48 (prof : Profile) : Sp prof rfi rfi_at 48 W_48 := Sp.blkA_then (blk_48 prof) (Sp.skip 55)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 60 g (rfz f) V) ∧
    (f.cond 4 = false → W_48 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof rfi rfi_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_46 prof) (Sp.skip 60) (c_48 prof))

def W_191 : Wpt := fun F Wl Q => wp F Wl o9 fun g f V =>
    W_0 F Wl Q g (rfz f) V
theorem c_191 (prof : Profile) : Sp prof rfi rfi_at 191 W_191 :=
  Sp.blk_then (blk_191 prof) (Sp.jmp_then (spj_195 prof) (c_0 prof))

def W_185 : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    (f.cond 4 = true → Q 208 g (rfz f) V) ∧
    (f.cond 4 = false → W_191 F Wl Q g (rfz f) V)
theorem c_185 (prof : Profile) : Sp prof rfi rfi_at 185 W_185 :=
  Sp.blk_then (blk_185 prof) (Sp.jcc_then (spj_189 prof) (Sp.skip 208) (c_191 prof))

def W_176 : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    (f.cond 4 = true → Q 208 g (rfz f) V) ∧
    (f.cond 4 = false → W_185 F Wl Q g (rfz f) V)
theorem c_176 (prof : Profile) : Sp prof rfi rfi_at 176 W_176 :=
  Sp.blk_then (blk_176 prof) (Sp.jcc_then (spj_183 prof) (Sp.skip 208) (c_185 prof))

/-- The cut points. -/
def cuts : List Nat := [60, 88, 176]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 60 then W_60 else
  if ℓ = 88 then W_88 else
  if ℓ = 176 then W_176 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof rfi rfi_at ℓ (Wt ℓ) :=
  Sp.table (c_60 prof) <|
  Sp.table (c_88 prof) <|
  Sp.table (c_176 prof) <|
  Sp.never ℓ

end FV7z.Rfi
