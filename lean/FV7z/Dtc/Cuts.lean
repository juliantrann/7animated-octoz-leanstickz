import FV7z.Dtc.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `deregister_tm_clones` (PLAN.md G3, startup)

The 1 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (28, 32; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Dtc
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_23 : Wpt := fun F Wl Q => wp F Wl o2 (Q 28)
theorem c_23 (prof : Profile) : Sp prof dtc dtc_at 23 W_23 := Sp.blk_then (blk_23 prof) (Sp.skip 28)

def W_13 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 32 g (rfz f) V) ∧
    (f.cond 4 = false → W_23 F Wl Q g (rfz f) V)
theorem c_13 (prof : Profile) : Sp prof dtc dtc_at 13 W_13 :=
  Sp.blk_then (blk_13 prof) (Sp.jcc_then (spj_21 prof) (Sp.skip 32) (c_23 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 32 g (rfz f) V) ∧
    (f.cond 4 = false → W_13 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof dtc dtc_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_11 prof) (Sp.skip 32) (c_13 prof))

/-- The cut points. -/
def cuts : List Nat := [0]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof dtc dtc_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.never ℓ

end FV7z.Dtc
