import FV7z.Mck.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `munmap_chunk` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (71, 84, 99, 104, 112, 119, 124, 150; the `ret`). `Wt` is the
table of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Mck
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_27 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 112 g (rfz f) V) ∧
    (f.cond 5 = false → Q 71 g (rfz f) V)
theorem c_27 (prof : Profile) (fb : Addr) : SpF prof mck mck_at fb 27 (W_27 fb) :=
  SpF.blk_then (blk_27 prof) (SpF.jcc_then (spj_69 prof fb) (SpF.skip 112) (SpF.skip 71))

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 124 g (rfz f) V) ∧
    (f.cond 4 = false → W_27 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof mck mck_at fb 0 (W_0 fb) :=
  SpF.blkA_then (blk_0 prof) (SpF.jcc_then (spj_25 prof fb) (SpF.skip 124) (c_27 prof fb))

def W_78 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 84)
theorem c_78 (prof : Profile) (fb : Addr) : SpF prof mck mck_at fb 78 (W_78 fb) :=
  SpF.blk_then (blk_78 prof) (SpF.skip 84)

def W_92 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 99)
theorem c_92 (prof : Profile) (fb : Addr) : SpF prof mck mck_at fb 92 (W_92 fb) :=
  SpF.blk_then (blk_92 prof) (SpF.skip 99)

/-- The cut points. -/
def cuts : List Nat := [0, 78, 92]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 78 then W_78 fb else
  if ℓ = 92 then W_92 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof mck mck_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_78 prof fb) <|
  SpF.table (c_92 prof fb) <|
  SpF.never ℓ

end FV7z.Mck
