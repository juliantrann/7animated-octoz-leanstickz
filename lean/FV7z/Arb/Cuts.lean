import FV7z.Arb.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `AString::ReAlloc2` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (14, 31, 50, 72; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Arb
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 14)
theorem c_0 (prof : Profile) : Sp prof arb arb_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 14)

def W_20 : Wpt := fun F Wl Q => wp F Wl o1 (Q 31)
theorem c_20 (prof : Profile) : Sp prof arb arb_at 20 W_20 := Sp.blk_then (blk_20 prof) (Sp.skip 31)

def W_36 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 55 g (rfz f) V) ∧
    (f.cond 4 = false → Q 50 g (rfz f) V)
theorem c_36 (prof : Profile) : Sp prof arb arb_at 36 W_36 :=
  Sp.blk_then (blk_36 prof) (Sp.jcc_then (spj_48 prof) (Sp.skip 55) (Sp.skip 50))

def W_55 : Wpt := fun F Wl Q => wp F Wl o3 (Q 72)
theorem c_55 (prof : Profile) : Sp prof arb arb_at 55 W_55 := Sp.blk_then (blk_55 prof) (Sp.skip 72)

/-- The cut points. -/
def cuts : List Nat := [0, 20, 36, 55]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 20 then W_20 else
  if ℓ = 36 then W_36 else
  if ℓ = 55 then W_55 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof arb arb_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_20 prof) <|
  Sp.table (c_36 prof) <|
  Sp.table (c_55 prof) <|
  Sp.never ℓ

end FV7z.Arb
