import FV7z.Udl.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UString::Delete` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (37, 79, 84, 93; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Udl
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_48 : Wpt := fun F Wl Q => wp F Wl o2 (Q 79)
theorem c_48 (prof : Profile) : Sp prof udl udl_at 48 W_48 := Sp.blk_then (blk_48 prof) (Sp.skip 79)

def W_31 : Wpt := fun F Wl Q => wp F Wl o1 (Q 37)
theorem c_31 (prof : Profile) : Sp prof udl udl_at 31 W_31 := Sp.blk_then (blk_31 prof) (Sp.skip 37)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → W_48 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → W_31 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof udl udl_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_29 prof) (c_48 prof) (c_31 prof))

def W_87 : Wpt := fun F Wl Q => wp F Wl o1 (Q 93)
theorem c_87 (prof : Profile) : Sp prof udl udl_at 87 W_87 := Sp.blk_then (blk_87 prof) (Sp.skip 93)

/-- The cut points. -/
def cuts : List Nat := [0, 87]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 87 then W_87 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof udl udl_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_87 prof) <|
  Sp.never ℓ

end FV7z.Udl
