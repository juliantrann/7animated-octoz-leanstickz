import FV7z.Ssj.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__sigsetjmp` (PLAN.md G3, startup)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (89, 130, 136, 144; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ssj
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 89)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof ssj ssj_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 89)

def W_124 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 130)
theorem c_124 (prof : Profile) (fb : Addr) : SpF prof ssj ssj_at fb 124 (W_124 fb) :=
  SpF.blk_then (blk_124 prof) (SpF.skip 130)

def W_112 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 136 g (rfz f) V) ∧
    (f.cond 5 = false → W_124 fb F Wl Q g (rfz f) V)
theorem c_112 (prof : Profile) (fb : Addr) : SpF prof ssj ssj_at fb 112 (W_112 fb) :=
  SpF.blk_then (blk_112 prof) (SpF.jcc_then (spj_122 prof fb) (SpF.skip 136) (c_124 prof fb))

def W_94 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    W_112 fb F Wl Q g (rfz f) V
theorem c_94 (prof : Profile) (fb : Addr) : SpF prof ssj ssj_at fb 94 (W_94 fb) :=
  SpF.blk_then (blk_94 prof) (SpF.jmp_then (spj_98 prof fb) (c_112 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 94]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 94 then W_94 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof ssj ssj_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_94 prof fb) <|
  SpF.never ℓ

end FV7z.Ssj
