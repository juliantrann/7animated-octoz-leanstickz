import FV7z.Uaw.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UString::operator=(const wchar_t*)` (PLAN.md §M, M1)

The 6 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (75, 91, 104, 121; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Uaw
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_144 : Wpt := fun F Wl Q => wp F Wl o10 fun g f V =>
    Q 62 g (rfz f) V
theorem c_144 (prof : Profile) : Sp prof uaw uaw_at 144 W_144 :=
  Sp.blk_then (blk_144 prof) (Sp.jmp_then (spj_153 prof) (Sp.skip 62))

def W_26 : Wpt := fun F Wl Q => wp F Wl o1 (Q 32)
theorem c_26 (prof : Profile) : Sp prof uaw uaw_at 26 W_26 := Sp.blk_then (blk_26 prof) (Sp.skip 32)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → W_144 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_26 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof uaw uaw_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_24 prof) (c_144 prof) (c_26 prof))

def W_96 : Wpt := fun F Wl Q => wp F Wl o7 (Q 104)
theorem c_96 (prof : Profile) : Sp prof uaw uaw_at 96 W_96 := Sp.blk_then (blk_96 prof) (Sp.skip 104)

def W_58 : Wpt := fun F Wl Q => wp F Wl o4 (Q 62)
theorem c_58 (prof : Profile) : Sp prof uaw uaw_at 58 W_58 := Sp.blk_then (blk_58 prof) (Sp.skip 62)

def W_52 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 2 = true → W_96 F Wl Q g (rfz f) V) ∧
    (f.cond 2 = false → W_58 F Wl Q g (rfz f) V)
theorem c_52 (prof : Profile) : Sp prof uaw uaw_at 52 W_52 :=
  Sp.blk_then (blk_52 prof) (Sp.jcc_then (spj_56 prof) (c_96 prof) (c_58 prof))

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 32 g (rfz f) V) ∧
    (f.cond 5 = false → W_52 F Wl Q g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof uaw uaw_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_50 prof) (Sp.skip 32) (c_52 prof))

def W_62 : Wpt := fun F Wl Q => wp F Wl o5 (Q 75)
theorem c_62 (prof : Profile) : Sp prof uaw uaw_at 62 W_62 := Sp.blk_then (blk_62 prof) (Sp.skip 75)

def W_80 : Wpt := fun F Wl Q => wp F Wl o6 (Q 91)
theorem c_80 (prof : Profile) : Sp prof uaw uaw_at 80 W_80 := Sp.blk_then (blk_80 prof) (Sp.skip 91)

def W_109 : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    (f.cond 4 = true → Q 126 g (rfz f) V) ∧
    (f.cond 4 = false → Q 121 g (rfz f) V)
theorem c_109 (prof : Profile) : Sp prof uaw uaw_at 109 W_109 :=
  Sp.blk_then (blk_109 prof) (Sp.jcc_then (spj_119 prof) (Sp.skip 126) (Sp.skip 121))

def W_126 : Wpt := fun F Wl Q => wp F Wl o9 fun g f V =>
    Q 62 g (rfz f) V
theorem c_126 (prof : Profile) : Sp prof uaw uaw_at 126 W_126 :=
  Sp.blk_then (blk_126 prof) (Sp.jmp_then (spj_134 prof) (Sp.skip 62))

/-- The cut points. -/
def cuts : List Nat := [0, 32, 62, 80, 109, 126]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 32 then W_32 else
  if ℓ = 62 then W_62 else
  if ℓ = 80 then W_80 else
  if ℓ = 109 then W_109 else
  if ℓ = 126 then W_126 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof uaw uaw_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_32 prof) <|
  Sp.table (c_62 prof) <|
  Sp.table (c_80 prof) <|
  Sp.table (c_109 prof) <|
  Sp.table (c_126 prof) <|
  Sp.never ℓ

end FV7z.Uaw
