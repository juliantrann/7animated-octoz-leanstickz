import FV7z.Mpr.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__mprotect` (PLAN.md G3, startup)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (9, 19, 20; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Mpr
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 9)
theorem c_0 (prof : Profile) : Sp prof mpr mpr_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 9)

def W_11 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 3 = true → Q 20 g (rfz f) V) ∧
    (f.cond 3 = false → Q 19 g (rfz f) V)
theorem c_11 (prof : Profile) : Sp prof mpr mpr_at 11 W_11 :=
  Sp.blk_then (blk_11 prof) (Sp.jcc_then (spj_17 prof) (Sp.skip 20) (Sp.skip 19))

/-- The cut points. -/
def cuts : List Nat := [0, 11]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 11 then W_11 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof mpr mpr_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_11 prof) <|
  Sp.never ℓ

end FV7z.Mpr
