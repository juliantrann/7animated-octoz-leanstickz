import FV7z.Dnw.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `DoesNameContainWildcard` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (59, 64, 67; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Dnw
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_65 : Wpt := fun F Wl Q => wp F Wl o4 (Q 67)
theorem c_65 (prof : Profile) : Sp prof dnw dnw_at 65 W_65 := Sp.blk_then (blk_65 prof) (Sp.skip 67)

def W_11 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    Q 41 g (rfz f) V
theorem c_11 (prof : Profile) : Sp prof dnw dnw_at 11 W_11 :=
  Sp.blk_then (blk_11 prof) (Sp.jmp_then (spj_22 prof) (Sp.skip 41))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → W_65 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_11 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof dnw dnw_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_9 prof) (c_65 prof) (c_11 prof))

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 64 g (rfz f) V) ∧
    (f.cond 4 = false → Q 41 g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof dnw dnw_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_39 prof) (Sp.skip 64) (Sp.skip 41))

def W_41 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → W_32 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 59 g (rfz f) V)
theorem c_41 (prof : Profile) : Sp prof dnw dnw_at 41 W_41 :=
  Sp.blk_then (blk_41 prof) (Sp.jcc_then (spj_57 prof) (c_32 prof) (Sp.skip 59))

/-- The cut points. -/
def cuts : List Nat := [0, 41]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 41 then W_41 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof dnw dnw_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_41 prof) <|
  Sp.never ℓ

end FV7z.Dnw
