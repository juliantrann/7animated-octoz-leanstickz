import FV7z.Pcl.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NWindows::NCOM::PropVariant_Clear` (PLAN.md §M, M1)

The 6 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (45, 61, 91; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Pcl
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_26 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 2 = true → Q 62 g (rfz f) V) ∧
    (f.cond 2 = false → Q 42 g (rfz f) V)
theorem c_26 (prof : Profile) : Sp prof pcl pcl_at 26 W_26 :=
  Sp.blk_then (blk_26 prof) (Sp.jcc_then (spj_40 prof) (Sp.skip 62) (Sp.skip 42))

def W_17 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 7 = true → Q 42 g (rfz f) V) ∧
    (f.cond 7 = false → W_26 F Wl Q g (rfz f) V)
theorem c_17 (prof : Profile) : Sp prof pcl pcl_at 17 W_17 :=
  Sp.blk_then (blk_17 prof) (Sp.jcc_then (spj_24 prof) (Sp.skip 42) (c_26 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 6 = true → Q 62 g (rfz f) V) ∧
    (f.cond 6 = false → W_17 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof pcl pcl_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_15 prof) (Sp.skip 62) (c_17 prof))

def W_42 : Wpt := fun F Wl Q => wp F Wl o3 (Q 45)
theorem c_42 (prof : Profile) : Sp prof pcl pcl_at 42 W_42 := Sp.blk_then (blk_42 prof) (Sp.skip 45)

def W_54 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 4 = true → Q 67 g (rfz f) V) ∧
    (f.cond 4 = false → Q 60 g (rfz f) V)
theorem c_54 (prof : Profile) : Sp prof pcl pcl_at 54 W_54 :=
  Sp.blk_then (blk_54 prof) (Sp.jcc_then (spj_58 prof) (Sp.skip 67) (Sp.skip 60))

def W_50 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 5 = true → Q 60 g (rfz f) V) ∧
    (f.cond 5 = false → W_54 F Wl Q g (rfz f) V)
theorem c_50 (prof : Profile) : Sp prof pcl pcl_at 50 W_50 :=
  Sp.blk_then (blk_50 prof) (Sp.jcc_then (spj_52 prof) (Sp.skip 60) (c_54 prof))

def W_60 : Wpt := fun F Wl Q => wp F Wl o6 (Q 61)
theorem c_60 (prof : Profile) : Sp prof pcl pcl_at 60 W_60 := Sp.blk_then (blk_60 prof) (Sp.skip 61)

def W_62 : Wpt := fun F Wl Q => wp F Wl o7 (Q 67)
theorem c_62 (prof : Profile) : Sp prof pcl pcl_at 62 W_62 := Sp.blk_then (blk_62 prof) (Sp.skip 67)

def W_67 : Wpt := fun F Wl Q => wp F Wl o8 (Q 91)
theorem c_67 (prof : Profile) : Sp prof pcl pcl_at 67 W_67 := Sp.blk_then (blk_67 prof) (Sp.skip 91)

/-- The cut points. -/
def cuts : List Nat := [0, 42, 50, 60, 62, 67]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 42 then W_42 else
  if ℓ = 50 then W_50 else
  if ℓ = 60 then W_60 else
  if ℓ = 62 then W_62 else
  if ℓ = 67 then W_67 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof pcl pcl_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_42 prof) <|
  Sp.table (c_50 prof) <|
  Sp.table (c_60 prof) <|
  Sp.table (c_62 prof) <|
  Sp.table (c_67 prof) <|
  Sp.never ℓ

end FV7z.Pcl
