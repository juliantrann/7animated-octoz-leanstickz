/-- The cut points. -/
def cuts : List Nat := [0, 25, 30, 47, 56, 73, 82, 130, 149, 238, 261, 350, 373]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 25 then W_25 fb else
  if ℓ = 30 then W_30 fb else
  if ℓ = 47 then W_47 fb else
  if ℓ = 56 then W_56 fb else
  if ℓ = 73 then W_73 fb else
  if ℓ = 82 then W_82 fb else
  if ℓ = 130 then W_130 fb else
  if ℓ = 149 then W_149 fb else
  if ℓ = 238 then W_238 fb else
  if ℓ = 261 then W_261 fb else
  if ℓ = 350 then W_350 fb else
  if ℓ = 373 then W_373 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof cfd cfd_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_25 prof fb) <|
  SpF.table (c_30 prof fb) <|
  SpF.table (c_47 prof fb) <|
  SpF.table (c_56 prof fb) <|
  SpF.table (c_73 prof fb) <|
  SpF.table (c_82 prof fb) <|
  SpF.table (c_130 prof fb) <|
  SpF.table (c_149 prof fb) <|
  SpF.table (c_238 prof fb) <|
  SpF.table (c_261 prof fb) <|
  SpF.table (c_350 prof fb) <|
  SpF.table (c_373 prof fb) <|
  SpF.never ℓ

