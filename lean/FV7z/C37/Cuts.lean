import FV7z.C37.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `csuTg 37` (PLAN.md G3, constructors)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (644; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.C37
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf
open FV7z.Ctor (sti sti_at sti_length)

def W_576 : Wpt := fun F Wl Q => wp F Wl o0 (Q 592)
theorem c_576 (prof : Profile) : Sp prof sti sti_at 576 W_576 := Sp.blkA_then (blk_576 prof) (Sp.skip 592)

def W_592 : Wpt := fun F Wl Q => wp F Wl o1 (Q 599)
theorem c_592 (prof : Profile) : Sp prof sti sti_at 592 W_592 := Sp.blk_then (blk_592 prof) (Sp.skip 599)

def W_637 : Wpt := fun F Wl Q => wp F Wl o4 (Q 644)
theorem c_637 (prof : Profile) : Sp prof sti sti_at 637 W_637 := Sp.blkA_then (blk_637 prof) (Sp.skip 644)

def W_620 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 5 = true → Q 592 g (rfz f) V) ∧
    (f.cond 5 = false → W_637 F Wl Q g (rfz f) V)
theorem c_620 (prof : Profile) : Sp prof sti sti_at 620 W_620 :=
  Sp.blk_then (blk_620 prof) (Sp.jcc_then (spj_635 prof) (Sp.skip 592) (c_637 prof))

def W_599 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 599 g (rfz f) V) ∧
    (f.cond 5 = false → W_620 F Wl Q g (rfz f) V)
theorem c_599 (prof : Profile) : Sp prof sti sti_at 599 W_599 :=
  Sp.blk_then (blk_599 prof) (Sp.jcc_then (spj_618 prof) (Sp.skip 599) (c_620 prof))

/-- The cut points. -/
def cuts : List Nat := [576, 592, 599]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 576 then W_576 else
  if ℓ = 592 then W_592 else
  if ℓ = 599 then W_599 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof sti sti_at ℓ (Wt ℓ) :=
  Sp.table (c_576 prof) <|
  Sp.table (c_592 prof) <|
  Sp.table (c_599 prof) <|
  Sp.never ℓ

end FV7z.C37
