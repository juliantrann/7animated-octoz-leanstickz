import FV7z.Ckw.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NCrypto::N7z::CKey::Wipe` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (49, 62; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ckw
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_56 : Wpt := fun F Wl Q => wp F Wl o2 (Q 62)
theorem c_56 (prof : Profile) : Sp prof ckw ckw_at 56 W_56 := Sp.blk_then (blk_56 prof) (Sp.skip 62)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → W_56 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → Q 17 g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof ckw ckw_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_15 prof) (c_56 prof) (Sp.skip 17))

def W_17 : Wpt := fun F Wl Q => wp F Wl o1 (Q 49)
theorem c_17 (prof : Profile) : Sp prof ckw ckw_at 17 W_17 := Sp.blk_then (blk_17 prof) (Sp.skip 49)

def W_67 : Wpt := fun F Wl Q g f V =>
    Q 17 g (rfz f) V
theorem c_67 (prof : Profile) : Sp prof ckw ckw_at 67 W_67 :=
  Sp.jmp_then (spj_67 prof) (Sp.skip 17)

/-- The cut points. -/
def cuts : List Nat := [0, 17, 67]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 17 then W_17 else
  if ℓ = 67 then W_67 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ckw ckw_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_17 prof) <|
  Sp.table (c_67 prof) <|
  Sp.never ℓ

end FV7z.Ckw
