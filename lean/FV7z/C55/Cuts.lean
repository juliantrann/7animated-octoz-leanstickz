import FV7z.C55.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `csuTg 55` (PLAN.md G3, constructors)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (1123; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.C55
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf
open FV7z.Ctor (sti sti_at sti_length)

def W_1056 : Wpt := fun F Wl Q => wp F Wl o0 (Q 1072)
theorem c_1056 (prof : Profile) : Sp prof sti sti_at 1056 W_1056 := Sp.blkA_then (blk_1056 prof) (Sp.skip 1072)

def W_1072 : Wpt := fun F Wl Q => wp F Wl o1 (Q 1079)
theorem c_1072 (prof : Profile) : Sp prof sti sti_at 1072 W_1072 := Sp.blk_then (blk_1072 prof) (Sp.skip 1079)

def W_1116 : Wpt := fun F Wl Q => wp F Wl o4 (Q 1123)
theorem c_1116 (prof : Profile) : Sp prof sti sti_at 1116 W_1116 := Sp.blkA_then (blk_1116 prof) (Sp.skip 1123)

def W_1100 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 5 = true → Q 1072 g (rfz f) V) ∧
    (f.cond 5 = false → W_1116 F Wl Q g (rfz f) V)
theorem c_1100 (prof : Profile) : Sp prof sti sti_at 1100 W_1100 :=
  Sp.blk_then (blk_1100 prof) (Sp.jcc_then (spj_1114 prof) (Sp.skip 1072) (c_1116 prof))

def W_1079 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 1079 g (rfz f) V) ∧
    (f.cond 5 = false → W_1100 F Wl Q g (rfz f) V)
theorem c_1079 (prof : Profile) : Sp prof sti sti_at 1079 W_1079 :=
  Sp.blk_then (blk_1079 prof) (Sp.jcc_then (spj_1098 prof) (Sp.skip 1079) (c_1100 prof))

/-- The cut points. -/
def cuts : List Nat := [1056, 1072, 1079]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 1056 then W_1056 else
  if ℓ = 1072 then W_1072 else
  if ℓ = 1079 then W_1079 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof sti sti_at ℓ (Wt ℓ) :=
  Sp.table (c_1056 prof) <|
  Sp.table (c_1072 prof) <|
  Sp.table (c_1079 prof) <|
  Sp.never ℓ

end FV7z.C55
