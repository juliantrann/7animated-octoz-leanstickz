import FV7z.C78.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CBZip2Crc::InitTable` (PLAN.md G3, constructors)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (67; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.C78
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 24)
theorem c_0 (prof : Profile) : Sp prof c78 c78_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 24)

def W_24 : Wpt := fun F Wl Q => wp F Wl o1 (Q 32)
theorem c_24 (prof : Profile) : Sp prof c78 c78_at 24 W_24 := Sp.blk_then (blk_24 prof) (Sp.skip 32)

def W_50 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 5 = true → Q 24 g (rfz f) V) ∧
    (f.cond 5 = false → Q 67 g (rfz f) V)
theorem c_50 (prof : Profile) : Sp prof c78 c78_at 50 W_50 :=
  Sp.blk_then (blk_50 prof) (Sp.jcc_then (spj_65 prof) (Sp.skip 24) (Sp.skip 67))

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 32 g (rfz f) V) ∧
    (f.cond 5 = false → W_50 F Wl Q g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof c78 c78_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_48 prof) (Sp.skip 32) (c_50 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 24, 32]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 24 then W_24 else
  if ℓ = 32 then W_32 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof c78 c78_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_24 prof) <|
  Sp.table (c_32 prof) <|
  Sp.never ℓ

end FV7z.C78
