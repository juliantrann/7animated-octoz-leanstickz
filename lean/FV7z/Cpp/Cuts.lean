def W_17 : Wpt := fun F Wl Q => wp F Wl o2 (Q 30)
theorem c_17 (prof : Profile) : Sp prof cpp cpp_at 17 W_17 := Sp.blk_then (blk_17 prof) (Sp.skip 30)

