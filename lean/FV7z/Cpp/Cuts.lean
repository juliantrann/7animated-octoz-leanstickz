    (f.cond 4 = false → Q 37 g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof cpp cpp_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_35 prof) (c_144 prof) (Sp.skip 37))

def W_10 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
