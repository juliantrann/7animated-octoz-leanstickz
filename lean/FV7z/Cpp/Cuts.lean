/-- The cut points. -/
def cuts : List Nat := [0, 17, 37, 66, 77, 112, 130]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 17 then W_17 else
  if ℓ = 37 then W_37 else
  if ℓ = 66 then W_66 else
  if ℓ = 77 then W_77 else
  if ℓ = 112 then W_112 else
  if ℓ = 130 then W_130 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof cpp cpp_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_17 prof) <|
  Sp.table (c_37 prof) <|
  Sp.table (c_66 prof) <|
  Sp.table (c_77 prof) <|
  Sp.table (c_112 prof) <|
  Sp.table (c_130 prof) <|
  Sp.never ℓ

end FV7z.Cpp
