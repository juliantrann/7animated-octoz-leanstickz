import FV7z.Cpp.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `Correct_PathPart` (PLAN.md §M, M1)

The 7 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (30, 101, 142; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Cpp
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_151 : Wpt := fun F Wl Q g f V =>
    Q 17 g (rfz f) V
theorem c_151 (prof : Profile) : Sp prof cpp cpp_at 151 W_151 :=
  Sp.jmp_then (spj_151 prof) (Sp.skip 17)

def W_144 : Wpt := fun F Wl Q => wp F Wl o15 fun g f V =>
    (f.cond 5 = true → Q 37 g (rfz f) V) ∧
    (f.cond 5 = false → W_151 F Wl Q g (rfz f) V)
theorem c_144 (prof : Profile) : Sp prof cpp cpp_at 144 W_144 :=
  Sp.blk_then (blk_144 prof) (Sp.jcc_then (spj_149 prof) (Sp.skip 37) (c_151 prof))

def W_32 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
