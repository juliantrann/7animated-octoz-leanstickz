import FV7z.Dsh.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `_dl_setup_hash` (PLAN.md G3, startup)

The 1 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (97, 147, 148, 175; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Dsh
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_113 : Wpt := fun F Wl Q => wp F Wl o4 (Q 147)
theorem c_113 (prof : Profile) : Sp prof dsh dsh_at 113 W_113 := Sp.blk_then (blk_113 prof) (Sp.skip 147)

def W_104 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 147 g (rfz f) V) ∧
    (f.cond 4 = false → W_113 F Wl Q g (rfz f) V)
theorem c_104 (prof : Profile) : Sp prof dsh dsh_at 104 W_104 :=
  Sp.blk_then (blk_104 prof) (Sp.jcc_then (spj_111 prof) (Sp.skip 147) (c_113 prof))

def W_43 : Wpt := fun F Wl Q => wp F Wl o2 (Q 97)
theorem c_43 (prof : Profile) : Sp prof dsh dsh_at 43 W_43 := Sp.blk_then (blk_43 prof) (Sp.skip 97)

def W_16 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 148 g (rfz f) V) ∧
    (f.cond 5 = false → W_43 F Wl Q g (rfz f) V)
theorem c_16 (prof : Profile) : Sp prof dsh dsh_at 16 W_16 :=
  Sp.blk_then (blk_16 prof) (Sp.jcc_then (spj_41 prof) (Sp.skip 148) (c_43 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → W_104 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_16 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof dsh dsh_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_14 prof) (c_104 prof) (c_16 prof))

/-- The cut points. -/
def cuts : List Nat := [0]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof dsh dsh_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.never ℓ

end FV7z.Dsh
