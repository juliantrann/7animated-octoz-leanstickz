import FV7z.Lap.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `LzmaDec_AllocateProbs2` (PLAN.md §M, M1)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (46, 59, 91; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Lap
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_33 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 87 g (rfz f) V) ∧
    (f.cond 4 = false → Q 40 g (rfz f) V)
theorem c_33 (prof : Profile) : Sp prof lap lap_at 33 W_33 :=
  Sp.blk_then (blk_33 prof) (Sp.jcc_then (spj_38 prof) (Sp.skip 87) (Sp.skip 40))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 40 g (rfz f) V) ∧
    (f.cond 4 = false → W_33 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof lap lap_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_31 prof) (Sp.skip 40) (c_33 prof))

def W_40 : Wpt := fun F Wl Q => wp F Wl o2 (Q 46)
theorem c_40 (prof : Profile) : Sp prof lap lap_at 40 W_40 := Sp.blk_then (blk_40 prof) (Sp.skip 46)

def W_51 : Wpt := fun F Wl Q => wp F Wl o3 (Q 59)
theorem c_51 (prof : Profile) : Sp prof lap lap_at 51 W_51 := Sp.blk_then (blk_51 prof) (Sp.skip 59)

def W_96 : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    Q 87 g (rfz f) V
theorem c_96 (prof : Profile) : Sp prof lap lap_at 96 W_96 :=
  Sp.blk_then (blk_96 prof) (Sp.jmp_then (spj_101 prof) (Sp.skip 87))

def W_72 : Wpt := fun F Wl Q => wp F Wl o5 (Q 87)
theorem c_72 (prof : Profile) : Sp prof lap lap_at 72 W_72 := Sp.blk_then (blk_72 prof) (Sp.skip 87)

def W_63 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 4 = true → W_96 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_72 F Wl Q g (rfz f) V)
theorem c_63 (prof : Profile) : Sp prof lap lap_at 63 W_63 :=
  Sp.blk_then (blk_63 prof) (Sp.jcc_then (spj_70 prof) (c_96 prof) (c_72 prof))

def W_87 : Wpt := fun F Wl Q => wp F Wl o6 (Q 91)
theorem c_87 (prof : Profile) : Sp prof lap lap_at 87 W_87 := Sp.blk_then (blk_87 prof) (Sp.skip 91)

/-- The cut points. -/
def cuts : List Nat := [0, 40, 51, 63, 87]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 40 then W_40 else
  if ℓ = 51 then W_51 else
  if ℓ = 63 then W_63 else
  if ℓ = 87 then W_87 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof lap lap_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_40 prof) <|
  Sp.table (c_51 prof) <|
  Sp.table (c_63 prof) <|
  Sp.table (c_87 prof) <|
  Sp.never ℓ

end FV7z.Lap
