import FV7z.Fcl.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NWindows::NFile::NIO::CFileBase::Close` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (20, 47; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Fcl
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 46 g (rfz f) V) ∧
    (f.cond 4 = false → Q 20 g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof fcl fcl_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_18 prof) (Sp.skip 46) (Sp.skip 20))

def W_35 : Wpt := fun F Wl Q => wp F Wl o2 (Q 46)
theorem c_35 (prof : Profile) : Sp prof fcl fcl_at 35 W_35 := Sp.blk_then (blk_35 prof) (Sp.skip 46)

def W_25 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 46 g (rfz f) V) ∧
    (f.cond 5 = false → W_35 F Wl Q g (rfz f) V)
theorem c_25 (prof : Profile) : Sp prof fcl fcl_at 25 W_25 :=
  Sp.blk_then (blk_25 prof) (Sp.jcc_then (spj_33 prof) (Sp.skip 46) (c_35 prof))

def W_46 : Wpt := fun F Wl Q => wp F Wl o3 (Q 47)
theorem c_46 (prof : Profile) : Sp prof fcl fcl_at 46 W_46 := Sp.blk_then (blk_46 prof) (Sp.skip 47)

/-- The cut points. -/
def cuts : List Nat := [0, 25, 46]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 25 then W_25 else
  if ℓ = 46 then W_46 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof fcl fcl_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_25 prof) <|
  Sp.table (c_46 prof) <|
  Sp.never ℓ

end FV7z.Fcl
