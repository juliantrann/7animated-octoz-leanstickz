import FV7z.Eex.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NWildcard::CCensor::ExtendExclude` (PLAN.md §M, M1)

The 6 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (106, 131, 150; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Eex
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_24 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    Q 55 g (rfz f) V
theorem c_24 (prof : Profile) : Sp prof eex eex_at 24 W_24 :=
  Sp.blk_then (blk_24 prof) (Sp.jmp_then (spj_33 prof) (Sp.skip 55))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 121 g (rfz f) V) ∧
    (f.cond 4 = false → W_24 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof eex eex_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_22 prof) (Sp.skip 121) (c_24 prof))

def W_140 : Wpt := fun F Wl Q => wp F Wl o9 (Q 150)
theorem c_140 (prof : Profile) : Sp prof eex eex_at 140 W_140 := Sp.blk_then (blk_140 prof) (Sp.skip 150)

def W_136 : Wpt := fun F Wl Q => wp F Wl o10 fun g f V =>
    (f.cond 5 = true → Q 68 g (rfz f) V) ∧
    (f.cond 5 = false → W_140 F Wl Q g (rfz f) V)
theorem c_136 (prof : Profile) : Sp prof eex eex_at 136 W_136 :=
  Sp.blk_then (blk_136 prof) (Sp.jcc_then (spj_138 prof) (Sp.skip 68) (c_140 prof))

def W_52 : Wpt := fun F Wl Q => wp F Wl o3 (Q 55)
theorem c_52 (prof : Profile) : Sp prof eex eex_at 52 W_52 := Sp.blk_then (blk_52 prof) (Sp.skip 55)

def W_40 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → W_136 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_52 F Wl Q g (rfz f) V)
theorem c_40 (prof : Profile) : Sp prof eex eex_at 40 W_40 :=
  Sp.blk_then (blk_40 prof) (Sp.jcc_then (spj_50 prof) (c_136 prof) (c_52 prof))

def W_55 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 5 = true → W_40 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → Q 68 g (rfz f) V)
theorem c_55 (prof : Profile) : Sp prof eex eex_at 55 W_55 :=
  Sp.blk_then (blk_55 prof) (Sp.jcc_then (spj_66 prof) (c_40 prof) (Sp.skip 68))

def W_68 : Wpt := fun F Wl Q => wp F Wl o5 (Q 80)
theorem c_68 (prof : Profile) : Sp prof eex eex_at 68 W_68 := Sp.blk_then (blk_68 prof) (Sp.skip 80)

def W_84 : Wpt := fun F Wl Q => wp F Wl o7 (Q 106)
theorem c_84 (prof : Profile) : Sp prof eex eex_at 84 W_84 := Sp.blk_then (blk_84 prof) (Sp.skip 106)

def W_80 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    (f.cond 4 = true → Q 111 g (rfz f) V) ∧
    (f.cond 4 = false → W_84 F Wl Q g (rfz f) V)
theorem c_80 (prof : Profile) : Sp prof eex eex_at 80 W_80 :=
  Sp.blk_then (blk_80 prof) (Sp.jcc_then (spj_82 prof) (Sp.skip 111) (c_84 prof))

def W_111 : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    (f.cond 2 = true → Q 80 g (rfz f) V) ∧
    (f.cond 2 = false → Q 121 g (rfz f) V)
theorem c_111 (prof : Profile) : Sp prof eex eex_at 111 W_111 :=
  Sp.blk_then (blk_111 prof) (Sp.jcc_then (spj_119 prof) (Sp.skip 80) (Sp.skip 121))

def W_121 : Wpt := fun F Wl Q => wp F Wl o9 (Q 131)
theorem c_121 (prof : Profile) : Sp prof eex eex_at 121 W_121 := Sp.blk_then (blk_121 prof) (Sp.skip 131)

/-- The cut points. -/
def cuts : List Nat := [0, 55, 68, 80, 111, 121]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 55 then W_55 else
  if ℓ = 68 then W_68 else
  if ℓ = 80 then W_80 else
  if ℓ = 111 then W_111 else
  if ℓ = 121 then W_121 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof eex eex_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_55 prof) <|
  Sp.table (c_68 prof) <|
  Sp.table (c_80 prof) <|
  Sp.table (c_111 prof) <|
  Sp.table (c_121 prof) <|
  Sp.never ℓ

end FV7z.Eex
