import FV7z.Ucc.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UString::UString(const UString&)` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (19, 43; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ucc
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 19)
theorem c_0 (prof : Profile) : Sp prof ucc ucc_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 19)

def W_24 : Wpt := fun F Wl Q => wp F Wl o1 (Q 43)
theorem c_24 (prof : Profile) : Sp prof ucc ucc_at 24 W_24 := Sp.blk_then (blk_24 prof) (Sp.skip 43)

/-- The cut points. -/
def cuts : List Nat := [0, 24]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 24 then W_24 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ucc ucc_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_24 prof) <|
  Sp.never ℓ

end FV7z.Ucc
