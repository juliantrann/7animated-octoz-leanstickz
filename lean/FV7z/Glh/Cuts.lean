import FV7z.Glh.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `GetLastError_noZero_HRESULT()` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (8, 35; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Glh
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 8)
theorem c_0 (prof : Profile) : Sp prof glh glh_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 8)

def W_40 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    Q 31 g (rfz f) V
theorem c_40 (prof : Profile) : Sp prof glh glh_at 40 W_40 :=
  Sp.blk_then (blk_40 prof) (Sp.jmp_then (spj_45 prof) (Sp.skip 31))

def W_17 : Wpt := fun F Wl Q => wp F Wl o2 (Q 31)
theorem c_17 (prof : Profile) : Sp prof glh glh_at 17 W_17 := Sp.blk_then (blk_17 prof) (Sp.skip 31)

def W_13 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → W_40 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_17 F Wl Q g (rfz f) V)
theorem c_13 (prof : Profile) : Sp prof glh glh_at 13 W_13 :=
  Sp.blk_then (blk_13 prof) (Sp.jcc_then (spj_15 prof) (c_40 prof) (c_17 prof))

def W_31 : Wpt := fun F Wl Q => wp F Wl o3 (Q 35)
theorem c_31 (prof : Profile) : Sp prof glh glh_at 31 W_31 := Sp.blk_then (blk_31 prof) (Sp.skip 35)

/-- The cut points. -/
def cuts : List Nat := [0, 13, 31]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 13 then W_13 else
  if ℓ = 31 then W_31 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof glh glh_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_13 prof) <|
  Sp.table (c_31 prof) <|
  Sp.never ℓ

end FV7z.Glh
