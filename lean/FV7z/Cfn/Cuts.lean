/-- The cut points. -/
def cuts : List Nat := [0, 34, 86, 97, 103, 125, 175, 205, 208, 238, 241, 328, 361, 400]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 34 then W_34 else
  if ℓ = 86 then W_86 else
  if ℓ = 97 then W_97 else
  if ℓ = 103 then W_103 else
  if ℓ = 125 then W_125 else
  if ℓ = 175 then W_175 else
  if ℓ = 205 then W_205 else
  if ℓ = 208 then W_208 else
  if ℓ = 238 then W_238 else
  if ℓ = 241 then W_241 else
  if ℓ = 328 then W_328 else
  if ℓ = 361 then W_361 else
  if ℓ = 400 then W_400 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof cfn cfn_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_34 prof) <|
  Sp.table (c_86 prof) <|
  Sp.table (c_97 prof) <|
  Sp.table (c_103 prof) <|
  Sp.table (c_125 prof) <|
  Sp.table (c_175 prof) <|
  Sp.table (c_205 prof) <|
  Sp.table (c_208 prof) <|
  Sp.table (c_238 prof) <|
  Sp.table (c_241 prof) <|
  Sp.table (c_328 prof) <|
  Sp.table (c_361 prof) <|
  Sp.table (c_400 prof) <|
  Sp.never ℓ

