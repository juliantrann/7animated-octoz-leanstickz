/-- The cut points. -/
def cuts : List Nat := [0, 55, 80, 153, 165, 219, 270, 280, 322, 337, 371]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 55 then W_55 fb else
  if ℓ = 80 then W_80 fb else
  if ℓ = 153 then W_153 fb else
  if ℓ = 165 then W_165 fb else
  if ℓ = 219 then W_219 fb else
  if ℓ = 270 then W_270 fb else
  if ℓ = 280 then W_280 fb else
  if ℓ = 322 then W_322 fb else
  if ℓ = 337 then W_337 fb else
  if ℓ = 371 then W_371 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof opd opd_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_55 prof fb) <|
  SpF.table (c_80 prof fb) <|
  SpF.table (c_153 prof fb) <|
  SpF.table (c_165 prof fb) <|
  SpF.table (c_219 prof fb) <|
  SpF.table (c_270 prof fb) <|
  SpF.table (c_280 prof fb) <|
  SpF.table (c_322 prof fb) <|
  SpF.table (c_337 prof fb) <|
  SpF.table (c_371 prof fb) <|
  SpF.never ℓ

