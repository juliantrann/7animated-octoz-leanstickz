import FV7z.Lemmas.Wp
/-!
# The cut points of `__opendir` (PLAN.md §M, M1)

The 11 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (50, 75, 148, 254, 275, 317, 332, 366; the `ret`). `Wt` is the
table of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Opd
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_288 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o13 fb) fun g f V =>
    Q 219 g (rfz f) V
theorem c_288 (prof : Profile) (fb : Addr) : SpF prof opd opd_at fb 288 (W_288 fb) :=
  SpF.blkF_then (blk_288 prof fb) (SpF.jmp_then (spj_305 prof fb) (SpF.skip 219))

def W_45 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 50)
theorem c_45 (prof : Profile) (fb : Addr) : SpF prof opd opd_at fb 45 (W_45 fb) :=
  SpF.blk_then (blk_45 prof) (SpF.skip 50)

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) fun g f V =>
    (f.cond 4 = true → W_288 fb F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_45 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof opd opd_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.jcc_then (spj_39 prof fb) (c_288 prof fb) (c_45 prof fb))

