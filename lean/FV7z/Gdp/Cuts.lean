import FV7z.Gdp.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CArc::GetItem_DefaultPath` (PLAN.md §M, M1)

The 9 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (65, 119, 140, 179, 208, 243, 256, 263; the `ret`). `Wt` is
the table of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Gdp
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 65)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof gdp gdp_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 65)

def W_128 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 (Q 140)
theorem c_128 (prof : Profile) (fb : Addr) : SpF prof gdp gdp_at fb 128 (W_128 fb) :=
  SpF.blk_then (blk_128 prof) (SpF.skip 140)

def W_77 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → W_128 fb F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 84 g (rfz f) V)
theorem c_77 (prof : Profile) (fb : Addr) : SpF prof gdp gdp_at fb 77 (W_77 fb) :=
  SpF.blk_then (blk_77 prof) (SpF.jcc_then (spj_82 prof fb) (c_128 prof fb) (SpF.skip 84))

def W_70 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 84 g (rfz f) V) ∧
    (f.cond 5 = false → W_77 fb F Wl Q g (rfz f) V)
theorem c_70 (prof : Profile) (fb : Addr) : SpF prof gdp gdp_at fb 70 (W_70 fb) :=
  SpF.blk_then (blk_70 prof) (SpF.jcc_then (spj_75 prof fb) (SpF.skip 84) (c_77 prof fb))

def W_104 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 (Q 119)
theorem c_104 (prof : Profile) (fb : Addr) : SpF prof gdp gdp_at fb 104 (W_104 fb) :=
  SpF.blk_then (blk_104 prof) (SpF.skip 119)

def W_84 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o3 fb) fun g f V =>
    (f.cond 5 = true → Q 263 g (rfz f) V) ∧
    (f.cond 5 = false → W_104 fb F Wl Q g (rfz f) V)
theorem c_84 (prof : Profile) (fb : Addr) : SpF prof gdp gdp_at fb 84 (W_84 fb) :=
  SpF.blkF_then (blk_84 prof fb) (SpF.jcc_then (spj_98 prof fb) (SpF.skip 263) (c_104 prof fb))

def W_145 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o6 (Q 179)
theorem c_145 (prof : Profile) (fb : Addr) : SpF prof gdp gdp_at fb 145 (W_145 fb) :=
  SpF.blk_then (blk_145 prof) (SpF.skip 179)

def W_240 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o11 (Q 243)
theorem c_240 (prof : Profile) (fb : Addr) : SpF prof gdp gdp_at fb 240 (W_240 fb) :=
  SpF.blk_then (blk_240 prof) (SpF.skip 243)

def W_224 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o10 fun g f V =>
    Q 205 g (rfz f) V
theorem c_224 (prof : Profile) (fb : Addr) : SpF prof gdp gdp_at fb 224 (W_224 fb) :=
  SpF.blk_then (blk_224 prof) (SpF.jmp_then (spj_230 prof fb) (SpF.skip 205))

def W_200 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    (f.cond 5 = true → W_224 fb F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → Q 205 g (rfz f) V)
theorem c_200 (prof : Profile) (fb : Addr) : SpF prof gdp gdp_at fb 200 (W_200 fb) :=
  SpF.blk_then (blk_200 prof) (SpF.jcc_then (spj_203 prof fb) (c_224 prof fb) (SpF.skip 205))

def W_189 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    (f.cond 4 = true → W_240 fb F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_200 fb F Wl Q g (rfz f) V)
theorem c_189 (prof : Profile) (fb : Addr) : SpF prof gdp gdp_at fb 189 (W_189 fb) :=
  SpF.blk_then (blk_189 prof) (SpF.jcc_then (spj_198 prof fb) (c_240 prof fb) (c_200 prof fb))

def W_182 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 205 g (rfz f) V) ∧
    (f.cond 5 = false → W_189 fb F Wl Q g (rfz f) V)
theorem c_182 (prof : Profile) (fb : Addr) : SpF prof gdp gdp_at fb 182 (W_182 fb) :=
  SpF.blk_then (blk_182 prof) (SpF.jcc_then (spj_187 prof fb) (SpF.skip 205) (c_189 prof fb))

def W_205 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o9 (Q 208)
theorem c_205 (prof : Profile) (fb : Addr) : SpF prof gdp gdp_at fb 205 (W_205 fb) :=
  SpF.blk_then (blk_205 prof) (SpF.skip 208)

def W_213 (fb : Addr) : Wpt := fun F Wl Q g f V =>
    Q 84 g (rfz f) V
theorem c_213 (prof : Profile) (fb : Addr) : SpF prof gdp gdp_at fb 213 (W_213 fb) :=
  SpF.jmp_then (spj_213 prof fb) (SpF.skip 84)

def W_248 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o12 (Q 256)
theorem c_248 (prof : Profile) (fb : Addr) : SpF prof gdp gdp_at fb 248 (W_248 fb) :=
  SpF.blk_then (blk_248 prof) (SpF.skip 256)

def W_261 (fb : Addr) : Wpt := fun F Wl Q g f V =>
    Q 205 g (rfz f) V
theorem c_261 (prof : Profile) (fb : Addr) : SpF prof gdp gdp_at fb 261 (W_261 fb) :=
  SpF.jmp_then (spj_261 prof fb) (SpF.skip 205)

/-- The cut points. -/
def cuts : List Nat := [0, 70, 84, 145, 182, 205, 213, 248, 261]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 70 then W_70 fb else
  if ℓ = 84 then W_84 fb else
  if ℓ = 145 then W_145 fb else
  if ℓ = 182 then W_182 fb else
  if ℓ = 205 then W_205 fb else
  if ℓ = 213 then W_213 fb else
  if ℓ = 248 then W_248 fb else
  if ℓ = 261 then W_261 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof gdp gdp_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_70 prof fb) <|
  SpF.table (c_84 prof fb) <|
  SpF.table (c_145 prof fb) <|
  SpF.table (c_182 prof fb) <|
  SpF.table (c_205 prof fb) <|
  SpF.table (c_213 prof fb) <|
  SpF.table (c_248 prof fb) <|
  SpF.table (c_261 prof fb) <|
  SpF.never ℓ

end FV7z.Gdp
