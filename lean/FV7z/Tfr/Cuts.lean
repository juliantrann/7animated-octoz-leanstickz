import FV7z.Tfr.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NWindows::NFile::NDir::CTempFile::Remove()` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (14, 24, 37; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Tfr
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_16 : Wpt := fun F Wl Q => wp F Wl o2 (Q 24)
theorem c_16 (prof : Profile) : Sp prof tfr tfr_at 16 W_16 := Sp.blk_then (blk_16 prof) (Sp.skip 24)

def W_9 : Wpt := fun F Wl Q => wp F Wl o1 (Q 14)
theorem c_9 (prof : Profile) : Sp prof tfr tfr_at 9 W_9 := Sp.blk_then (blk_9 prof) (Sp.skip 14)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → W_16 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → W_9 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof tfr tfr_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_7 prof) (c_16 prof) (c_9 prof))

def W_29 : Wpt := fun F Wl Q => wp F Wl o3 (Q 37)
theorem c_29 (prof : Profile) : Sp prof tfr tfr_at 29 W_29 := Sp.blk_then (blk_29 prof) (Sp.skip 37)

/-- The cut points. -/
def cuts : List Nat := [0, 29]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 29 then W_29 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof tfr tfr_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_29 prof) <|
  Sp.never ℓ

end FV7z.Tfr
