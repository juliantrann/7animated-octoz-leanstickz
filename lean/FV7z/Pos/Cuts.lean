/-- The cut points. -/
def cuts : List Nat := [0, 45, 49, 94, 168, 191, 201, 231]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 45 then W_45 fb else
  if ℓ = 49 then W_49 fb else
  if ℓ = 94 then W_94 fb else
  if ℓ = 168 then W_168 fb else
  if ℓ = 191 then W_191 fb else
  if ℓ = 201 then W_201 fb else
  if ℓ = 231 then W_231 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof pos pos_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_45 prof fb) <|
  SpF.table (c_49 prof fb) <|
  SpF.table (c_94 prof fb) <|
  SpF.table (c_168 prof fb) <|
  SpF.table (c_191 prof fb) <|
  SpF.table (c_201 prof fb) <|
  SpF.table (c_231 prof fb) <|
  SpF.never ℓ

end FV7z.Pos
