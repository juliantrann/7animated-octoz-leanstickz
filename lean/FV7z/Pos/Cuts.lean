import FV7z.Lemmas.Wp
/-!
# The cut points of `__pthread_once_slow` (PLAN.md §M, M1)

The 8 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (79, 89, 118, 149, 156, 184, 189, 196, 229, 256; the `ret`).
`Wt` is the table of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Pos
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_42 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 45)
theorem c_42 (prof : Profile) (fb : Addr) : SpF prof pos pos_at fb 42 (W_42 fb) :=
  SpF.blk_then (blk_42 prof) (SpF.skip 45)

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (W_42 fb F Wl Q)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof pos pos_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (c_42 prof fb)

def W_80 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 (Q 89)
theorem c_80 (prof : Profile) (fb : Addr) : SpF prof pos pos_at fb 80 (W_80 fb) :=
  SpF.blkA_then (blk_80 prof) (SpF.skip 89)

def W_45 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → W_80 fb F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 49 g (rfz f) V)
theorem c_45 (prof : Profile) (fb : Addr) : SpF prof pos pos_at fb 45 (W_45 fb) :=
  SpF.blk_then (blk_45 prof) (SpF.jcc_then (spj_47 prof fb) (c_80 prof fb) (SpF.skip 49))

