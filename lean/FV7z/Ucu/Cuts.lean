import FV7z.Ucu.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UString::UString(unsigned, const UString&)` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (27, 43, 63; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ucu
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 27)
theorem c_0 (prof : Profile) : Sp prof ucu ucu_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 27)

def W_32 : Wpt := fun F Wl Q => wp F Wl o1 (Q 43)
theorem c_32 (prof : Profile) : Sp prof ucu ucu_at 32 W_32 := Sp.blk_then (blk_32 prof) (Sp.skip 43)

def W_48 : Wpt := fun F Wl Q => wp F Wl o2 (Q 63)
theorem c_48 (prof : Profile) : Sp prof ucu ucu_at 48 W_48 := Sp.blk_then (blk_48 prof) (Sp.skip 63)

/-- The cut points. -/
def cuts : List Nat := [0, 32, 48]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 32 then W_32 else
  if ℓ = 48 then W_48 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ucu ucu_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_32 prof) <|
  Sp.table (c_48 prof) <|
  Sp.never ℓ

end FV7z.Ucu
