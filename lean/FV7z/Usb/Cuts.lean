import FV7z.Usb.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UString::SetFromBstr` (PLAN.md §M, M1)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (23, 61, 82, 99; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Usb
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 23)
theorem c_0 (prof : Profile) : Sp prof usb usb_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 23)

def W_72 : Wpt := fun F Wl Q => wp F Wl o4 (Q 82)
theorem c_72 (prof : Profile) : Sp prof usb usb_at 72 W_72 := Sp.blk_then (blk_72 prof) (Sp.skip 82)

def W_35 : Wpt := fun F Wl Q => wp F Wl o2 (Q 39)
theorem c_35 (prof : Profile) : Sp prof usb usb_at 35 W_35 := Sp.blk_then (blk_35 prof) (Sp.skip 39)

def W_28 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 2 = true → W_72 F Wl Q g (rfz f) V) ∧
    (f.cond 2 = false → W_35 F Wl Q g (rfz f) V)
theorem c_28 (prof : Profile) : Sp prof usb usb_at 28 W_28 :=
  Sp.blk_then (blk_28 prof) (Sp.jcc_then (spj_33 prof) (c_72 prof) (c_35 prof))

def W_39 : Wpt := fun F Wl Q => wp F Wl o3 (Q 61)
theorem c_39 (prof : Profile) : Sp prof usb usb_at 39 W_39 := Sp.blk_then (blk_39 prof) (Sp.skip 61)

def W_87 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 4 = true → Q 104 g (rfz f) V) ∧
    (f.cond 4 = false → Q 99 g (rfz f) V)
theorem c_87 (prof : Profile) : Sp prof usb usb_at 87 W_87 :=
  Sp.blk_then (blk_87 prof) (Sp.jcc_then (spj_97 prof) (Sp.skip 104) (Sp.skip 99))

def W_104 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    Q 39 g (rfz f) V
theorem c_104 (prof : Profile) : Sp prof usb usb_at 104 W_104 :=
  Sp.blk_then (blk_104 prof) (Sp.jmp_then (spj_111 prof) (Sp.skip 39))

/-- The cut points. -/
def cuts : List Nat := [0, 28, 39, 87, 104]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 28 then W_28 else
  if ℓ = 39 then W_39 else
  if ℓ = 87 then W_87 else
  if ℓ = 104 then W_104 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof usb usb_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_28 prof) <|
  Sp.table (c_39 prof) <|
  Sp.table (c_87 prof) <|
  Sp.table (c_104 prof) <|
  Sp.never ℓ

end FV7z.Usb
