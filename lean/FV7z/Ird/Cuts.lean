import FV7z.Ird.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CInFileStream::Read` (PLAN.md §M, M1)

The 6 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (33, 54, 64, 80, 113, 121; the `ret`). `Wt` is the table of
the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ird
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_24 : Wpt := fun F Wl Q => wp F Wl o1 (Q 33)
theorem c_24 (prof : Profile) : Sp prof ird ird_at 24 W_24 := Sp.blk_then (blk_24 prof) (Sp.skip 33)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 64 g (rfz f) V) ∧
    (f.cond 4 = false → W_24 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof ird ird_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_22 prof) (Sp.skip 64) (c_24 prof))

def W_44 : Wpt := fun F Wl Q => wp F Wl o3 (Q 48)
theorem c_44 (prof : Profile) : Sp prof ird ird_at 44 W_44 := Sp.blk_then (blk_44 prof) (Sp.skip 48)

def W_38 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 80 g (rfz f) V) ∧
    (f.cond 4 = false → W_44 F Wl Q g (rfz f) V)
theorem c_38 (prof : Profile) : Sp prof ird ird_at 38 W_38 :=
  Sp.blk_then (blk_38 prof) (Sp.jcc_then (spj_42 prof) (Sp.skip 80) (c_44 prof))

def W_48 : Wpt := fun F Wl Q => wp F Wl o4 (Q 54)
theorem c_48 (prof : Profile) : Sp prof ird ird_at 48 W_48 := Sp.blk_then (blk_48 prof) (Sp.skip 54)

def W_69 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 5 = true → Q 48 g (rfz f) V) ∧
    (f.cond 5 = false → Q 80 g (rfz f) V)
theorem c_69 (prof : Profile) : Sp prof ird ird_at 69 W_69 :=
  Sp.blk_then (blk_69 prof) (Sp.jcc_then (spj_78 prof) (Sp.skip 48) (Sp.skip 80))

def W_153 : Wpt := fun F Wl Q => wp F Wl o10 fun g f V =>
    Q 48 g (rfz f) V
theorem c_153 (prof : Profile) : Sp prof ird ird_at 153 W_153 :=
  Sp.blk_then (blk_153 prof) (Sp.jmp_then (spj_158 prof) (Sp.skip 48))

def W_132 : Wpt := fun F Wl Q => wp F Wl o9 fun g f V =>
    Q 48 g (rfz f) V
theorem c_132 (prof : Profile) : Sp prof ird ird_at 132 W_132 :=
  Sp.blk_then (blk_132 prof) (Sp.jmp_then (spj_151 prof) (Sp.skip 48))

def W_128 : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    (f.cond 4 = true → W_153 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_132 F Wl Q g (rfz f) V)
theorem c_128 (prof : Profile) : Sp prof ird ird_at 128 W_128 :=
  Sp.blk_then (blk_128 prof) (Sp.jcc_then (spj_130 prof) (c_153 prof) (c_132 prof))

def W_100 : Wpt := fun F Wl Q => wp F Wl o7 (Q 113)
theorem c_100 (prof : Profile) : Sp prof ird ird_at 100 W_100 := Sp.blk_then (blk_100 prof) (Sp.skip 113)

def W_85 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    (f.cond 4 = true → W_128 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_100 F Wl Q g (rfz f) V)
theorem c_85 (prof : Profile) : Sp prof ird ird_at 85 W_85 :=
  Sp.blk_then (blk_85 prof) (Sp.jcc_then (spj_98 prof) (c_128 prof) (c_100 prof))

def W_115 : Wpt := fun F Wl Q => wp F Wl o4 (Q 121)
theorem c_115 (prof : Profile) : Sp prof ird ird_at 115 W_115 := Sp.blk_then (blk_115 prof) (Sp.skip 121)

/-- The cut points. -/
def cuts : List Nat := [0, 38, 48, 69, 85, 115]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 38 then W_38 else
  if ℓ = 48 then W_48 else
  if ℓ = 69 then W_69 else
  if ℓ = 85 then W_85 else
  if ℓ = 115 then W_115 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ird ird_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_38 prof) <|
  Sp.table (c_48 prof) <|
  Sp.table (c_69 prof) <|
  Sp.table (c_85 prof) <|
  Sp.table (c_115 prof) <|
  Sp.never ℓ

end FV7z.Ird
