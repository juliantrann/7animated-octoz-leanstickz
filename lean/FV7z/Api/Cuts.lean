import FV7z.Api.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NWildcard::CCensor::AddPreItem` (PLAN.md §M, M1)

The 11 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (43, 80, 120, 131, 166, 207, 223, 236; the `ret`). `Wt` is the
table of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Api
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_38 : Wpt := fun F Wl Q => wp F Wl o1 (Q 43)
theorem c_38 (prof : Profile) : Sp prof api api_at 38 W_38 := Sp.blk_then (blk_38 prof) (Sp.skip 43)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → Q 115 g (rfz f) V) ∧
    (f.cond 5 = false → W_38 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof api api_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_36 prof) (Sp.skip 115) (c_38 prof))

def W_49 : Wpt := fun F Wl Q => wp F Wl o2 (Q 80)
theorem c_49 (prof : Profile) : Sp prof api api_at 49 W_49 := Sp.blk_then (blk_49 prof) (Sp.skip 80)

def W_208 : Wpt := fun F Wl Q => wp F Wl o10 (Q 223)
theorem c_208 (prof : Profile) : Sp prof api api_at 208 W_208 := Sp.blk_then (blk_208 prof) (Sp.skip 223)

def W_99 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 5 = true → Q 233 g (rfz f) V) ∧
    (f.cond 5 = false → Q 108 g (rfz f) V)
theorem c_99 (prof : Profile) : Sp prof api api_at 99 W_99 :=
  Sp.blk_then (blk_99 prof) (Sp.jcc_then (spj_102 prof) (Sp.skip 233) (Sp.skip 108))

def W_85 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 5 = true → W_208 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → W_99 F Wl Q g (rfz f) V)
theorem c_85 (prof : Profile) : Sp prof api api_at 85 W_85 :=
  Sp.blk_then (blk_85 prof) (Sp.jcc_then (spj_97 prof) (c_208 prof) (c_99 prof))

def W_108 : Wpt := fun F Wl Q => wp F Wl o5 (Q 115)
theorem c_108 (prof : Profile) : Sp prof api api_at 108 W_108 := Sp.blk_then (blk_108 prof) (Sp.skip 115)

def W_115 : Wpt := fun F Wl Q => wp F Wl o6 (Q 120)
theorem c_115 (prof : Profile) : Sp prof api api_at 115 W_115 := Sp.blk_then (blk_115 prof) (Sp.skip 120)

def W_125 : Wpt := fun F Wl Q => wp F Wl o7 (Q 131)
theorem c_125 (prof : Profile) : Sp prof api api_at 125 W_125 := Sp.blk_then (blk_125 prof) (Sp.skip 131)

def W_136 : Wpt := fun F Wl Q => wp F Wl o8 (Q 166)
theorem c_136 (prof : Profile) : Sp prof api api_at 136 W_136 := Sp.blk_then (blk_136 prof) (Sp.skip 166)

def W_171 : Wpt := fun F Wl Q => wp F Wl o9 (Q 207)
theorem c_171 (prof : Profile) : Sp prof api api_at 171 W_171 := Sp.blk_then (blk_171 prof) (Sp.skip 207)

def W_228 : Wpt := fun F Wl Q => wp F Wl o11 (Q 233)
theorem c_228 (prof : Profile) : Sp prof api api_at 228 W_228 := Sp.blk_then (blk_228 prof) (Sp.skip 233)

def W_233 : Wpt := fun F Wl Q => wp F Wl o12 (Q 236)
theorem c_233 (prof : Profile) : Sp prof api api_at 233 W_233 := Sp.blk_then (blk_233 prof) (Sp.skip 236)

def W_241 : Wpt := fun F Wl Q g f V =>
    Q 108 g (rfz f) V
theorem c_241 (prof : Profile) : Sp prof api api_at 241 W_241 :=
  Sp.jmp_then (spj_241 prof) (Sp.skip 108)

/-- The cut points. -/
def cuts : List Nat := [0, 49, 85, 108, 115, 125, 136, 171, 228, 233, 241]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 49 then W_49 else
  if ℓ = 85 then W_85 else
  if ℓ = 108 then W_108 else
  if ℓ = 115 then W_115 else
  if ℓ = 125 then W_125 else
  if ℓ = 136 then W_136 else
  if ℓ = 171 then W_171 else
  if ℓ = 228 then W_228 else
  if ℓ = 233 then W_233 else
  if ℓ = 241 then W_241 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof api api_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_49 prof) <|
  Sp.table (c_85 prof) <|
  Sp.table (c_108 prof) <|
  Sp.table (c_115 prof) <|
  Sp.table (c_125 prof) <|
  Sp.table (c_136 prof) <|
  Sp.table (c_171 prof) <|
  Sp.table (c_228 prof) <|
  Sp.table (c_233 prof) <|
  Sp.table (c_241 prof) <|
  Sp.never ℓ

end FV7z.Api
