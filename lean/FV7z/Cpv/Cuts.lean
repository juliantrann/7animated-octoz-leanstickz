import FV7z.Cpv.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `ConvertPropVariantToShortString` (PLAN.md §M, M1)

The 12 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (40, 64, 91, 100, 116, 131, 148, 168, 181, 198, 212, 228; the
`ret`). `Wt` is the table of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by
`tools/blk_gen.py`.
-/
namespace FV7z.Cpv
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_13 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    ∃ tgt, tgt < cpv.length ∧ g.get (regOf 0) = Addr.add cpv_at tgt ∧ Q tgt g (rfz f) V
theorem c_13 (prof : Profile) : Sp prof cpv cpv_at 13 W_13 :=
  Sp.blkA_then (blk_13 prof) (spj_30 prof)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 7 = true → Q 48 g (rfz f) V) ∧
    (f.cond 7 = false → W_13 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof cpv cpv_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_11 prof) (Sp.skip 48) (c_13 prof))

def W_48 : Wpt := fun F Wl Q => wp F Wl o2 (Q 64)
theorem c_48 (prof : Profile) : Sp prof cpv cpv_at 48 W_48 := Sp.blk_then (blk_48 prof) (Sp.skip 64)

def W_72 : Wpt := fun F Wl Q => wp F Wl o3 (Q 91)
theorem c_72 (prof : Profile) : Sp prof cpv cpv_at 72 W_72 := Sp.blk_then (blk_72 prof) (Sp.skip 91)

def W_96 : Wpt := fun F Wl Q => wp F Wl o4 (Q 100)
theorem c_96 (prof : Profile) : Sp prof cpv cpv_at 96 W_96 := Sp.blk_then (blk_96 prof) (Sp.skip 100)

def W_112 : Wpt := fun F Wl Q => wp F Wl o5 (Q 116)
theorem c_112 (prof : Profile) : Sp prof cpv cpv_at 112 W_112 := Sp.blk_then (blk_112 prof) (Sp.skip 116)

def W_128 : Wpt := fun F Wl Q => wp F Wl o6 (Q 131)
theorem c_128 (prof : Profile) : Sp prof cpv cpv_at 128 W_128 := Sp.blk_then (blk_128 prof) (Sp.skip 131)

def W_144 : Wpt := fun F Wl Q => wp F Wl o7 (Q 148)
theorem c_144 (prof : Profile) : Sp prof cpv cpv_at 144 W_144 := Sp.blk_then (blk_144 prof) (Sp.skip 148)

def W_160 : Wpt := fun F Wl Q => wp F Wl o8 (Q 168)
theorem c_160 (prof : Profile) : Sp prof cpv cpv_at 160 W_160 := Sp.blk_then (blk_160 prof) (Sp.skip 168)

def W_176 : Wpt := fun F Wl Q => wp F Wl o9 (Q 181)
theorem c_176 (prof : Profile) : Sp prof cpv cpv_at 176 W_176 := Sp.blk_then (blk_176 prof) (Sp.skip 181)

def W_192 : Wpt := fun F Wl Q => wp F Wl o10 (Q 198)
theorem c_192 (prof : Profile) : Sp prof cpv cpv_at 192 W_192 := Sp.blk_then (blk_192 prof) (Sp.skip 198)

def W_208 : Wpt := fun F Wl Q => wp F Wl o11 (Q 212)
theorem c_208 (prof : Profile) : Sp prof cpv cpv_at 208 W_208 := Sp.blk_then (blk_208 prof) (Sp.skip 212)

def W_224 : Wpt := fun F Wl Q => wp F Wl o11 (Q 228)
theorem c_224 (prof : Profile) : Sp prof cpv cpv_at 224 W_224 := Sp.blk_then (blk_224 prof) (Sp.skip 228)

/-- The cut points. -/
def cuts : List Nat := [0, 48, 72, 96, 112, 128, 144, 160, 176, 192, 208, 224]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 48 then W_48 else
  if ℓ = 72 then W_72 else
  if ℓ = 96 then W_96 else
  if ℓ = 112 then W_112 else
  if ℓ = 128 then W_128 else
  if ℓ = 144 then W_144 else
  if ℓ = 160 then W_160 else
  if ℓ = 176 then W_176 else
  if ℓ = 192 then W_192 else
  if ℓ = 208 then W_208 else
  if ℓ = 224 then W_224 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof cpv cpv_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_48 prof) <|
  Sp.table (c_72 prof) <|
  Sp.table (c_96 prof) <|
  Sp.table (c_112 prof) <|
  Sp.table (c_128 prof) <|
  Sp.table (c_144 prof) <|
  Sp.table (c_160 prof) <|
  Sp.table (c_176 prof) <|
  Sp.table (c_192 prof) <|
  Sp.table (c_208 prof) <|
  Sp.table (c_224 prof) <|
  Sp.never ℓ

end FV7z.Cpv
