import FV7z.Read.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__libc_read` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (16, 26, 32, 50, 74, 92, 131; the `ret`). `Wt` is the table of
the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Read
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) fun g f V =>
    (f.cond 5 = true → Q 32 g (rfz f) V) ∧
    (f.cond 5 = false → Q 16 g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof rd rd_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.jcc_then (spj_14 prof fb) (SpF.skip 32) (SpF.skip 16))

def W_112 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o2 fb) (Q 131)
theorem c_112 (prof : Profile) (fb : Addr) : SpF prof rd rd_at fb 112 (W_112 fb) :=
  SpF.blkF_then (blk_112 prof fb) (SpF.skip 131)

def W_18 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 7 = true → W_112 fb F Wl Q g (rfz f) V) ∧
    (f.cond 7 = false → Q 26 g (rfz f) V)
theorem c_18 (prof : Profile) (fb : Addr) : SpF prof rd rd_at fb 18 (W_18 fb) :=
  SpF.blk_then (blk_18 prof) (SpF.jcc_then (spj_24 prof fb) (c_112 prof fb) (SpF.skip 26))

/-- The cut points. -/
def cuts : List Nat := [0, 18]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 18 then W_18 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof rd rd_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_18 prof fb) <|
  SpF.never ℓ

end FV7z.Read
