import FV7z.Um2.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UnicodeStringToMultiByte2` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (34, 59, 60; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Um2
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 34)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof um2 um2_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 34)

def W_55 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 59)
theorem c_55 (prof : Profile) (fb : Addr) : SpF prof um2 um2_at fb 55 (W_55 fb) :=
  SpF.blk_then (blk_55 prof) (SpF.skip 59)

def W_39 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o1 fb) fun g f V =>
    (f.cond 5 = true → Q 60 g (rfz f) V) ∧
    (f.cond 5 = false → W_55 fb F Wl Q g (rfz f) V)
theorem c_39 (prof : Profile) (fb : Addr) : SpF prof um2 um2_at fb 39 (W_39 fb) :=
  SpF.blkF_then (blk_39 prof fb) (SpF.jcc_then (spj_53 prof fb) (SpF.skip 60) (c_55 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 39]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 39 then W_39 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof um2 um2_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_39 prof fb) <|
  SpF.never ℓ

end FV7z.Um2
