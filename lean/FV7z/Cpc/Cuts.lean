import FV7z.Cpc.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NCommandLineParser::CParser::CParser` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (52, 61, 76; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Cpc
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 52)
theorem c_0 (prof : Profile) : Sp prof cpc cpc_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 52)

def W_57 : Wpt := fun F Wl Q => wp F Wl o1 (Q 61)
theorem c_57 (prof : Profile) : Sp prof cpc cpc_at 57 W_57 := Sp.blk_then (blk_57 prof) (Sp.skip 61)

def W_66 : Wpt := fun F Wl Q => wp F Wl o2 (Q 76)
theorem c_66 (prof : Profile) : Sp prof cpc cpc_at 66 W_66 := Sp.blk_then (blk_66 prof) (Sp.skip 76)

/-- The cut points. -/
def cuts : List Nat := [0, 57, 66]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 57 then W_57 else
  if ℓ = 66 then W_66 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof cpc cpc_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_57 prof) <|
  Sp.table (c_66 prof) <|
  Sp.never ℓ

end FV7z.Cpc
