/-- The cut points. -/
def cuts : List Nat := [0, 8, 41, 54, 96, 98, 160, 224, 312]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 8 then W_8 else
  if ℓ = 41 then W_41 else
  if ℓ = 54 then W_54 else
  if ℓ = 96 then W_96 else
  if ℓ = 98 then W_98 else
  if ℓ = 160 then W_160 else
  if ℓ = 224 then W_224 else
  if ℓ = 312 then W_312 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof hca hca_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_8 prof) <|
  Sp.table (c_41 prof) <|
  Sp.table (c_54 prof) <|
  Sp.table (c_96 prof) <|
  Sp.table (c_98 prof) <|
  Sp.table (c_160 prof) <|
  Sp.table (c_224 prof) <|
  Sp.table (c_312 prof) <|
  Sp.never ℓ

