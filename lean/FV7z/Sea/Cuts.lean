import FV7z.Sea.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `StringsAreEqual_Ascii` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (49, 58; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Sea
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_13 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    Q 40 g (rfz f) V
theorem c_13 (prof : Profile) : Sp prof sea sea_at 13 W_13 :=
  Sp.blk_then (blk_13 prof) (Sp.jmp_then (spj_15 prof) (Sp.skip 40))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → Q 56 g (rfz f) V) ∧
    (f.cond 5 = false → W_13 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof sea sea_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_11 prof) (Sp.skip 56) (c_13 prof))

def W_24 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 56 g (rfz f) V) ∧
    (f.cond 5 = false → Q 40 g (rfz f) V)
theorem c_24 (prof : Profile) : Sp prof sea sea_at 24 W_24 :=
  Sp.blk_then (blk_24 prof) (Sp.jcc_then (spj_38 prof) (Sp.skip 56) (Sp.skip 40))

def W_44 : Wpt := fun F Wl Q => wp F Wl o4 (Q 49)
theorem c_44 (prof : Profile) : Sp prof sea sea_at 44 W_44 := Sp.blk_then (blk_44 prof) (Sp.skip 49)

def W_40 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 5 = true → W_24 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → W_44 F Wl Q g (rfz f) V)
theorem c_40 (prof : Profile) : Sp prof sea sea_at 40 W_40 :=
  Sp.blk_then (blk_40 prof) (Sp.jcc_then (spj_42 prof) (c_24 prof) (c_44 prof))

def W_56 : Wpt := fun F Wl Q => wp F Wl o1 (Q 58)
theorem c_56 (prof : Profile) : Sp prof sea sea_at 56 W_56 := Sp.blk_then (blk_56 prof) (Sp.skip 58)

/-- The cut points. -/
def cuts : List Nat := [0, 40, 56]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 40 then W_40 else
  if ℓ = 56 then W_56 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof sea sea_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_40 prof) <|
  Sp.table (c_56 prof) <|
  Sp.never ℓ

end FV7z.Sea
