import FV7z.Acs.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `AString::AString (s1, num1, s2, num2)` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (30, 45, 70; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Acs
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 30)
theorem c_0 (prof : Profile) : Sp prof acs acs_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 30)

def W_35 : Wpt := fun F Wl Q => wp F Wl o1 (Q 45)
theorem c_35 (prof : Profile) : Sp prof acs acs_at 35 W_35 := Sp.blk_then (blk_35 prof) (Sp.skip 45)

def W_50 : Wpt := fun F Wl Q => wp F Wl o2 (Q 70)
theorem c_50 (prof : Profile) : Sp prof acs acs_at 50 W_50 := Sp.blk_then (blk_50 prof) (Sp.skip 70)

/-- The cut points. -/
def cuts : List Nat := [0, 35, 50]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 35 then W_35 else
  if ℓ = 50 then W_50 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof acs acs_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_35 prof) <|
  Sp.table (c_50 prof) <|
  Sp.never ℓ

end FV7z.Acs
