import FV7z.C75.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `csuTg 75` (PLAN.md G3, constructors)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (1665; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.C75
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf
open FV7z.Ctor (sti sti_at sti_length)

def W_1584 : Wpt := fun F Wl Q => wp F Wl o0 (Q 1600)
theorem c_1584 (prof : Profile) : Sp prof sti sti_at 1584 W_1584 := Sp.blk_then (blk_1584 prof) (Sp.skip 1600)

def W_1600 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 1600 g (rfz f) V) ∧
    (f.cond 5 = false → Q 1665 g (rfz f) V)
theorem c_1600 (prof : Profile) : Sp prof sti sti_at 1600 W_1600 :=
  Sp.blk_then (blk_1600 prof) (Sp.jcc_then (spj_1663 prof) (Sp.skip 1600) (Sp.skip 1665))

/-- The cut points. -/
def cuts : List Nat := [1584, 1600]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 1584 then W_1584 else
  if ℓ = 1600 then W_1600 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof sti sti_at ℓ (Wt ℓ) :=
  Sp.table (c_1584 prof) <|
  Sp.table (c_1600 prof) <|
  Sp.never ℓ

end FV7z.C75
