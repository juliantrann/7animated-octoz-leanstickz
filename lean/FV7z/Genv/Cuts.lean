import FV7z.Genv.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `getenv` (PLAN.md G3, startup)

The 6 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (57, 113, 120, 183, 199, 208; the `ret`). `Wt` is the table of
the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Genv
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_48 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 120 g (rfz f) V) ∧
    (f.cond 5 = false → Q 57 g (rfz f) V)
theorem c_48 (prof : Profile) : Sp prof gev gev_at 48 W_48 :=
  Sp.blk_then (blk_48 prof) (Sp.jcc_then (spj_55 prof) (Sp.skip 120) (Sp.skip 57))

def W_34 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 208 g (rfz f) V) ∧
    (f.cond 4 = false → W_48 F Wl Q g (rfz f) V)
theorem c_34 (prof : Profile) : Sp prof gev gev_at 34 W_34 :=
  Sp.blk_then (blk_34 prof) (Sp.jcc_then (spj_42 prof) (Sp.skip 208) (c_48 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 208 g (rfz f) V) ∧
    (f.cond 4 = false → W_34 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof gev gev_at 0 W_0 :=
  Sp.blkA_then (blk_0 prof) (Sp.jcc_then (spj_28 prof) (Sp.skip 208) (c_34 prof))

def W_96 : Wpt := fun F Wl Q => wp F Wl o3 (Q 113)
theorem c_96 (prof : Profile) : Sp prof gev gev_at 96 W_96 := Sp.blk_then (blk_96 prof) (Sp.skip 113)

def W_146 : Wpt := fun F Wl Q g f V =>
    Q 96 g (rfz f) V
theorem c_146 (prof : Profile) : Sp prof gev gev_at 146 W_146 :=
  Sp.jmp_then (spj_146 prof) (Sp.skip 96)

def W_125 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 5 = true → Q 165 g (rfz f) V) ∧
    (f.cond 5 = false → W_146 F Wl Q g (rfz f) V)
theorem c_125 (prof : Profile) : Sp prof gev gev_at 125 W_125 :=
  Sp.blk_then (blk_125 prof) (Sp.jcc_then (spj_144 prof) (Sp.skip 165) (c_146 prof))

def W_152 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 4 = true → Q 96 g (rfz f) V) ∧
    (f.cond 4 = false → Q 165 g (rfz f) V)
theorem c_152 (prof : Profile) : Sp prof gev gev_at 152 W_152 :=
  Sp.blk_then (blk_152 prof) (Sp.jcc_then (spj_163 prof) (Sp.skip 96) (Sp.skip 165))

def W_172 : Wpt := fun F Wl Q => wp F Wl o7 (Q 183)
theorem c_172 (prof : Profile) : Sp prof gev gev_at 172 W_172 := Sp.blk_then (blk_172 prof) (Sp.skip 183)

def W_165 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    (f.cond 5 = true → Q 152 g (rfz f) V) ∧
    (f.cond 5 = false → W_172 F Wl Q g (rfz f) V)
theorem c_165 (prof : Profile) : Sp prof gev gev_at 165 W_165 :=
  Sp.blk_then (blk_165 prof) (Sp.jcc_then (spj_170 prof) (Sp.skip 152) (c_172 prof))

def W_192 : Wpt := fun F Wl Q => wp F Wl o9 fun g f V =>
    (f.cond 5 = true → Q 152 g (rfz f) V) ∧
    (f.cond 5 = false → Q 199 g (rfz f) V)
theorem c_192 (prof : Profile) : Sp prof gev gev_at 192 W_192 :=
  Sp.blk_then (blk_192 prof) (Sp.jcc_then (spj_197 prof) (Sp.skip 152) (Sp.skip 199))

def W_188 : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    (f.cond 5 = true → Q 152 g (rfz f) V) ∧
    (f.cond 5 = false → W_192 F Wl Q g (rfz f) V)
theorem c_188 (prof : Profile) : Sp prof gev gev_at 188 W_188 :=
  Sp.blk_then (blk_188 prof) (Sp.jcc_then (spj_190 prof) (Sp.skip 152) (c_192 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 96, 125, 152, 165, 188]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 96 then W_96 else
  if ℓ = 125 then W_125 else
  if ℓ = 152 then W_152 else
  if ℓ = 165 then W_165 else
  if ℓ = 188 then W_188 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof gev gev_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_96 prof) <|
  Sp.table (c_125 prof) <|
  Sp.table (c_152 prof) <|
  Sp.table (c_165 prof) <|
  Sp.table (c_188 prof) <|
  Sp.never ℓ

end FV7z.Genv
