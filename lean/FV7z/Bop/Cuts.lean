/-- The cut points. -/
def cuts : List Nat := [0, 35, 69, 127, 135, 165, 180, 192, 205, 221, 223, 240, 267]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 35 then W_35 else
  if ℓ = 69 then W_69 else
  if ℓ = 127 then W_127 else
  if ℓ = 135 then W_135 else
  if ℓ = 165 then W_165 else
  if ℓ = 180 then W_180 else
  if ℓ = 192 then W_192 else
  if ℓ = 205 then W_205 else
  if ℓ = 221 then W_221 else
  if ℓ = 223 then W_223 else
  if ℓ = 240 then W_240 else
  if ℓ = 267 then W_267 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof bop bop_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_35 prof) <|
  Sp.table (c_69 prof) <|
  Sp.table (c_127 prof) <|
  Sp.table (c_135 prof) <|
  Sp.table (c_165 prof) <|
  Sp.table (c_180 prof) <|
  Sp.table (c_192 prof) <|
  Sp.table (c_205 prof) <|
  Sp.table (c_221 prof) <|
  Sp.table (c_223 prof) <|
  Sp.table (c_240 prof) <|
  Sp.table (c_267 prof) <|
  Sp.never ℓ

