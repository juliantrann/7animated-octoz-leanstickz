import FV7z.Pst.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `PrintString` (PLAN.md §M, M1)

The 6 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (24, 63, 87, 109, 133, 156; the `ret`). `Wt` is the table of
the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Pst
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 24)
theorem c_0 (prof : Profile) : Sp prof pst pst_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 24)

def W_144 : Wpt := fun F Wl Q => wp F Wl o10 fun g f V =>
    Q 128 g (rfz f) V
theorem c_144 (prof : Profile) : Sp prof pst pst_at 144 W_144 :=
  Sp.blk_then (blk_144 prof) (Sp.jmp_then (spj_154 prof) (Sp.skip 128))

def W_120 : Wpt := fun F Wl Q => wp F Wl o8 (Q 128)
theorem c_120 (prof : Profile) : Sp prof pst pst_at 120 W_120 := Sp.blk_then (blk_120 prof) (Sp.skip 128)

def W_44 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → W_120 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 50 g (rfz f) V)
theorem c_44 (prof : Profile) : Sp prof pst pst_at 44 W_44 :=
  Sp.blk_then (blk_44 prof) (Sp.jcc_then (spj_48 prof) (c_120 prof) (Sp.skip 50))

def W_33 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → W_144 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_44 F Wl Q g (rfz f) V)
theorem c_33 (prof : Profile) : Sp prof pst pst_at 33 W_33 :=
  Sp.blk_then (blk_33 prof) (Sp.jcc_then (spj_42 prof) (c_144 prof) (c_44 prof))

def W_29 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 3 = true → Q 50 g (rfz f) V) ∧
    (f.cond 3 = false → W_33 F Wl Q g (rfz f) V)
theorem c_29 (prof : Profile) : Sp prof pst pst_at 29 W_29 :=
  Sp.blk_then (blk_29 prof) (Sp.jcc_then (spj_31 prof) (Sp.skip 50) (c_33 prof))

def W_50 : Wpt := fun F Wl Q => wp F Wl o4 (Q 63)
theorem c_50 (prof : Profile) : Sp prof pst pst_at 50 W_50 := Sp.blk_then (blk_50 prof) (Sp.skip 63)

def W_96 : Wpt := fun F Wl Q => wp F Wl o7 (Q 109)
theorem c_96 (prof : Profile) : Sp prof pst pst_at 96 W_96 := Sp.blk_then (blk_96 prof) (Sp.skip 109)

def W_77 : Wpt := fun F Wl Q => wp F Wl o6 (Q 87)
theorem c_77 (prof : Profile) : Sp prof pst pst_at 77 W_77 := Sp.blk_then (blk_77 prof) (Sp.skip 87)

def W_68 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 6 = true → W_96 F Wl Q g (rfz f) V) ∧
    (f.cond 6 = false → W_77 F Wl Q g (rfz f) V)
theorem c_68 (prof : Profile) : Sp prof pst pst_at 68 W_68 :=
  Sp.blk_then (blk_68 prof) (Sp.jcc_then (spj_75 prof) (c_96 prof) (c_77 prof))

def W_128 : Wpt := fun F Wl Q => wp F Wl o9 fun g f V =>
    (f.cond 7 = true → Q 50 g (rfz f) V) ∧
    (f.cond 7 = false → Q 133 g (rfz f) V)
theorem c_128 (prof : Profile) : Sp prof pst pst_at 128 W_128 :=
  Sp.blk_then (blk_128 prof) (Sp.jcc_then (spj_131 prof) (Sp.skip 50) (Sp.skip 133))

def W_138 : Wpt := fun F Wl Q g f V =>
    Q 50 g (rfz f) V
theorem c_138 (prof : Profile) : Sp prof pst pst_at 138 W_138 :=
  Sp.jmp_then (spj_138 prof) (Sp.skip 50)

/-- The cut points. -/
def cuts : List Nat := [0, 29, 50, 68, 128, 138]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 29 then W_29 else
  if ℓ = 50 then W_50 else
  if ℓ = 68 then W_68 else
  if ℓ = 128 then W_128 else
  if ℓ = 138 then W_138 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof pst pst_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_29 prof) <|
  Sp.table (c_50 prof) <|
  Sp.table (c_68 prof) <|
  Sp.table (c_128 prof) <|
  Sp.table (c_138 prof) <|
  Sp.never ℓ

end FV7z.Pst
