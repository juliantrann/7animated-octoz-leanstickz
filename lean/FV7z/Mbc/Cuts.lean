import FV7z.Mbc.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `MultiByteToUnicodeString (const char *, UINT)` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (41, 55, 69, 102, 103; the `ret`). `Wt` is the table of the
cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Mbc
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 41)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof mbc mbc_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 41)

def W_46 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 55)
theorem c_46 (prof : Profile) (fb : Addr) : SpF prof mbc mbc_at fb 46 (W_46 fb) :=
  SpF.blk_then (blk_46 prof) (SpF.skip 55)

def W_60 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 74 g (rfz f) V) ∧
    (f.cond 4 = false → Q 69 g (rfz f) V)
theorem c_60 (prof : Profile) (fb : Addr) : SpF prof mbc mbc_at fb 60 (W_60 fb) :=
  SpF.blk_then (blk_60 prof) (SpF.jcc_then (spj_67 prof fb) (SpF.skip 74) (SpF.skip 69))

def W_90 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 (Q 102)
theorem c_90 (prof : Profile) (fb : Addr) : SpF prof mbc mbc_at fb 90 (W_90 fb) :=
  SpF.blk_then (blk_90 prof) (SpF.skip 102)

def W_74 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o3 fb) fun g f V =>
    (f.cond 5 = true → Q 103 g (rfz f) V) ∧
    (f.cond 5 = false → W_90 fb F Wl Q g (rfz f) V)
theorem c_74 (prof : Profile) (fb : Addr) : SpF prof mbc mbc_at fb 74 (W_74 fb) :=
  SpF.blkF_then (blk_74 prof fb) (SpF.jcc_then (spj_88 prof fb) (SpF.skip 103) (c_90 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 46, 60, 74]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 46 then W_46 fb else
  if ℓ = 60 then W_60 fb else
  if ℓ = 74 then W_74 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof mbc mbc_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_46 prof fb) <|
  SpF.table (c_60 prof fb) <|
  SpF.table (c_74 prof fb) <|
  SpF.never ℓ

end FV7z.Mbc
