import FV7z.Ppc.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CPercentPrinter::CPercentPrinter` (PLAN.md §M, M1)

The 10 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (41, 50, 85, 94, 103, 115, 160, 172, 184, 193, 221, 229, 241,
258, 272, 286, 300, 308, 316, 394; the `ret`). `Wt` is the table of the cut points' conditions, `spAll` its `Sp`s, for
`Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ppc
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 41)
theorem c_0 (prof : Profile) : Sp prof ppc ppc_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 41)

def W_46 : Wpt := fun F Wl Q => wp F Wl o1 (Q 50)
theorem c_46 (prof : Profile) : Sp prof ppc ppc_at 46 W_46 := Sp.blk_then (blk_46 prof) (Sp.skip 50)

def W_55 : Wpt := fun F Wl Q => wp F Wl o2 (Q 85)
theorem c_55 (prof : Profile) : Sp prof ppc ppc_at 55 W_55 := Sp.blk_then (blk_55 prof) (Sp.skip 85)

def W_90 : Wpt := fun F Wl Q => wp F Wl o3 (Q 94)
theorem c_90 (prof : Profile) : Sp prof ppc ppc_at 90 W_90 := Sp.blk_then (blk_90 prof) (Sp.skip 94)

def W_99 : Wpt := fun F Wl Q => wp F Wl o4 (Q 103)
theorem c_99 (prof : Profile) : Sp prof ppc ppc_at 99 W_99 := Sp.blk_then (blk_99 prof) (Sp.skip 103)

def W_108 : Wpt := fun F Wl Q => wp F Wl o5 (Q 115)
theorem c_108 (prof : Profile) : Sp prof ppc ppc_at 108 W_108 := Sp.blk_then (blk_108 prof) (Sp.skip 115)

def W_120 : Wpt := fun F Wl Q => wp F Wl o6 (Q 160)
theorem c_120 (prof : Profile) : Sp prof ppc ppc_at 120 W_120 := Sp.blk_then (blk_120 prof) (Sp.skip 160)

def W_165 : Wpt := fun F Wl Q => wp F Wl o7 (Q 172)
theorem c_165 (prof : Profile) : Sp prof ppc ppc_at 165 W_165 := Sp.blk_then (blk_165 prof) (Sp.skip 172)

def W_177 : Wpt := fun F Wl Q => wp F Wl o8 (Q 184)
theorem c_177 (prof : Profile) : Sp prof ppc ppc_at 177 W_177 := Sp.blk_then (blk_177 prof) (Sp.skip 184)

def W_189 : Wpt := fun F Wl Q => wp F Wl o9 (Q 193)
theorem c_189 (prof : Profile) : Sp prof ppc ppc_at 189 W_189 := Sp.blk_then (blk_189 prof) (Sp.skip 193)

/-- The cut points. -/
def cuts : List Nat := [0, 46, 55, 90, 99, 108, 120, 165, 177, 189]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 46 then W_46 else
  if ℓ = 55 then W_55 else
  if ℓ = 90 then W_90 else
  if ℓ = 99 then W_99 else
  if ℓ = 108 then W_108 else
  if ℓ = 120 then W_120 else
  if ℓ = 165 then W_165 else
  if ℓ = 177 then W_177 else
  if ℓ = 189 then W_189 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ppc ppc_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_46 prof) <|
  Sp.table (c_55 prof) <|
  Sp.table (c_90 prof) <|
  Sp.table (c_99 prof) <|
  Sp.table (c_108 prof) <|
  Sp.table (c_120 prof) <|
  Sp.table (c_165 prof) <|
  Sp.table (c_177 prof) <|
  Sp.table (c_189 prof) <|
  Sp.never ℓ

end FV7z.Ppc
