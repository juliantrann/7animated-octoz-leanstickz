import FV7z.Mxi.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__pthread_mutex_init` (PLAN.md G3, constructors)

The 1 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (42, 472; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Mxi
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_160 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 170)
theorem c_160 (prof : Profile) (fb : Addr) : SpF prof mxi mxi_at fb 160 (W_160 fb) :=
  SpF.blk_then (blk_160 prof) (SpF.skip 170)

def W_140 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o2 fb) fun g f V =>
    (f.cond 5 = true → Q 472 g (rfz f) V) ∧
    (f.cond 5 = false → W_160 fb F Wl Q g (rfz f) V)
theorem c_140 (prof : Profile) (fb : Addr) : SpF prof mxi mxi_at fb 140 (W_140 fb) :=
  SpF.blkF_then (blk_140 prof fb) (SpF.jcc_then (spj_154 prof fb) (SpF.skip 472) (c_160 prof fb))

def W_134 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (W_140 fb F Wl Q)
theorem c_134 (prof : Profile) (fb : Addr) : SpF prof mxi mxi_at fb 134 (W_134 fb) :=
  SpF.blk_then (blk_134 prof) (c_140 prof fb)

def W_240 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    W_134 fb F Wl Q g (rfz f) V
theorem c_240 (prof : Profile) (fb : Addr) : SpF prof mxi mxi_at fb 240 (W_240 fb) :=
  SpF.blk_then (blk_240 prof) (SpF.jmp_then (spj_261 prof fb) (c_134 prof fb))

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) fun g f V =>
    (f.cond 4 = true → W_240 fb F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 42 g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof mxi mxi_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.jcc_then (spj_36 prof fb) (c_240 prof fb) (SpF.skip 42))

/-- The cut points. -/
def cuts : List Nat := [0]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof mxi mxi_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.never ℓ

end FV7z.Mxi
