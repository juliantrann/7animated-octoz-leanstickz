import FV7z.Dr2.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `LzmaDec_DecodeReal2` (PLAN.md §M, M1)

The 4 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (40, 64; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Dr2
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_11 : Wpt := fun F Wl Q => wp F Wl o1 (Q 37)
theorem c_11 (prof : Profile) : Sp prof dr2 dr2_at 11 W_11 := Sp.blk_then (blk_11 prof) (Sp.skip 37)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → Q 37 g (rfz f) V) ∧
    (f.cond 5 = false → W_11 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof dr2 dr2_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_9 prof) (Sp.skip 37) (c_11 prof))

def W_37 : Wpt := fun F Wl Q => wp F Wl o2 (Q 40)
theorem c_37 (prof : Profile) : Sp prof dr2 dr2_at 37 W_37 := Sp.blk_then (blk_37 prof) (Sp.skip 40)

def W_60 : Wpt := fun F Wl Q => wp F Wl o5 (Q 63)
theorem c_60 (prof : Profile) : Sp prof dr2 dr2_at 60 W_60 := Sp.blk_then (blk_60 prof) (Sp.skip 63)

def W_52 : Wpt := fun F Wl Q => wp F Wl o4 fun g f V =>
    (f.cond 2 = true → Q 63 g (rfz f) V) ∧
    (f.cond 2 = false → W_60 F Wl Q g (rfz f) V)
theorem c_52 (prof : Profile) : Sp prof dr2 dr2_at 52 W_52 :=
  Sp.blk_then (blk_52 prof) (Sp.jcc_then (spj_58 prof) (Sp.skip 63) (c_60 prof))

def W_45 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 5 = true → Q 63 g (rfz f) V) ∧
    (f.cond 5 = false → W_52 F Wl Q g (rfz f) V)
theorem c_45 (prof : Profile) : Sp prof dr2 dr2_at 45 W_45 :=
  Sp.blk_then (blk_45 prof) (Sp.jcc_then (spj_50 prof) (Sp.skip 63) (c_52 prof))

def W_63 : Wpt := fun F Wl Q => wp F Wl o6 (Q 64)
theorem c_63 (prof : Profile) : Sp prof dr2 dr2_at 63 W_63 := Sp.blk_then (blk_63 prof) (Sp.skip 64)

/-- The cut points. -/
def cuts : List Nat := [0, 37, 45, 63]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 37 then W_37 else
  if ℓ = 45 then W_45 else
  if ℓ = 63 then W_63 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof dr2 dr2_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_37 prof) <|
  Sp.table (c_45 prof) <|
  Sp.table (c_63 prof) <|
  Sp.never ℓ

end FV7z.Dr2
