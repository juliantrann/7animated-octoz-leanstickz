import FV7z.Ptt.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CFieldPrinter::PrintTitle` (PLAN.md §M, M1)

The 6 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (52, 85, 100, 104; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ptt
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_11 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    Q 64 g (rfz f) V
theorem c_11 (prof : Profile) : Sp prof ptt ptt_at 11 W_11 :=
  Sp.blk_then (blk_11 prof) (Sp.jmp_then (spj_20 prof) (Sp.skip 64))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 104 g (rfz f) V) ∧
    (f.cond 4 = false → W_11 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof ptt ptt_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_9 prof) (Sp.skip 104) (c_11 prof))

def W_43 : Wpt := fun F Wl Q => wp F Wl o3 (Q 46)
theorem c_43 (prof : Profile) : Sp prof ptt ptt_at 43 W_43 := Sp.blk_then (blk_43 prof) (Sp.skip 46)

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 46 g (rfz f) V) ∧
    (f.cond 4 = false → W_43 F Wl Q g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof ptt ptt_at 32 W_32 :=
  Sp.blk_then (blk_32 prof) (Sp.jcc_then (spj_41 prof) (Sp.skip 46) (c_43 prof))

def W_46 : Wpt := fun F Wl Q => wp F Wl o4 (Q 52)
theorem c_46 (prof : Profile) : Sp prof ptt ptt_at 46 W_46 := Sp.blk_then (blk_46 prof) (Sp.skip 52)

def W_96 : Wpt := fun F Wl Q => wp F Wl o7 (Q 100)
theorem c_96 (prof : Profile) : Sp prof ptt ptt_at 96 W_96 := Sp.blk_then (blk_96 prof) (Sp.skip 100)

def W_57 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 6 = true → W_96 F Wl Q g (rfz f) V) ∧
    (f.cond 6 = false → Q 64 g (rfz f) V)
theorem c_57 (prof : Profile) : Sp prof ptt ptt_at 57 W_57 :=
  Sp.blk_then (blk_57 prof) (Sp.jcc_then (spj_62 prof) (c_96 prof) (Sp.skip 64))

def W_64 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    (f.cond 7 = true → Q 32 g (rfz f) V) ∧
    (f.cond 7 = false → Q 85 g (rfz f) V)
theorem c_64 (prof : Profile) : Sp prof ptt ptt_at 64 W_64 :=
  Sp.blk_then (blk_64 prof) (Sp.jcc_then (spj_83 prof) (Sp.skip 32) (Sp.skip 85))

def W_90 : Wpt := fun F Wl Q g f V =>
    Q 32 g (rfz f) V
theorem c_90 (prof : Profile) : Sp prof ptt ptt_at 90 W_90 :=
  Sp.jmp_then (spj_90 prof) (Sp.skip 32)

/-- The cut points. -/
def cuts : List Nat := [0, 32, 46, 57, 64, 90]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 32 then W_32 else
  if ℓ = 46 then W_46 else
  if ℓ = 57 then W_57 else
  if ℓ = 64 then W_64 else
  if ℓ = 90 then W_90 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ptt ptt_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_32 prof) <|
  Sp.table (c_46 prof) <|
  Sp.table (c_57 prof) <|
  Sp.table (c_64 prof) <|
  Sp.table (c_90 prof) <|
  Sp.never ℓ

end FV7z.Ptt
