import FV7z.Aaa.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NWildcard::CItem::AreAllAllowed` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (30, 48; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Aaa
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_32 : Wpt := fun F Wl Q => wp F Wl o5 (Q 48)
theorem c_32 (prof : Profile) : Sp prof aaa aaa_at 32 W_32 := Sp.blkA_then (blk_32 prof) (Sp.skip 48)

def W_22 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → W_32 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 28 g (rfz f) V)
theorem c_22 (prof : Profile) : Sp prof aaa aaa_at 22 W_22 :=
  Sp.blk_then (blk_22 prof) (Sp.jcc_then (spj_26 prof) (c_32 prof) (Sp.skip 28))

def W_16 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 28 g (rfz f) V) ∧
    (f.cond 4 = false → W_22 F Wl Q g (rfz f) V)
theorem c_16 (prof : Profile) : Sp prof aaa aaa_at 16 W_16 :=
  Sp.blk_then (blk_16 prof) (Sp.jcc_then (spj_20 prof) (Sp.skip 28) (c_22 prof))

def W_10 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 28 g (rfz f) V) ∧
    (f.cond 4 = false → W_16 F Wl Q g (rfz f) V)
theorem c_10 (prof : Profile) : Sp prof aaa aaa_at 10 W_10 :=
  Sp.blk_then (blk_10 prof) (Sp.jcc_then (spj_14 prof) (Sp.skip 28) (c_16 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 28 g (rfz f) V) ∧
    (f.cond 4 = false → W_10 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof aaa aaa_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_8 prof) (Sp.skip 28) (c_10 prof))

def W_28 : Wpt := fun F Wl Q => wp F Wl o4 (Q 30)
theorem c_28 (prof : Profile) : Sp prof aaa aaa_at 28 W_28 := Sp.blk_then (blk_28 prof) (Sp.skip 30)

/-- The cut points. -/
def cuts : List Nat := [0, 28]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 28 then W_28 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof aaa aaa_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_28 prof) <|
  Sp.never ℓ

end FV7z.Aaa
