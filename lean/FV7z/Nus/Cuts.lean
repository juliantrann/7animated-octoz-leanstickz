def W_116 : Wpt := fun F Wl Q => wp F Wl o11 (Q 128)
theorem c_116 (prof : Profile) : Sp prof nus nus_at 116 W_116 := Sp.blk_then (blk_116 prof) (Sp.skip 128)

def W_112 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 4 = true → Q 148 g (rfz f) V) ∧
    (f.cond 4 = false → W_116 F Wl Q g (rfz f) V)
theorem c_112 (prof : Profile) : Sp prof nus nus_at 112 W_112 :=
  Sp.blk_then (blk_112 prof) (Sp.jcc_then (spj_114 prof) (Sp.skip 148) (c_116 prof))

