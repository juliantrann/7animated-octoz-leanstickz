/-- The cut points. -/
def cuts : List Nat := [0, 80, 89, 96, 128, 139]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 80 then W_80 else
  if ℓ = 89 then W_89 else
  if ℓ = 96 then W_96 else
  if ℓ = 128 then W_128 else
  if ℓ = 139 then W_139 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof nus nus_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_80 prof) <|
  Sp.table (c_89 prof) <|
  Sp.table (c_96 prof) <|
  Sp.table (c_128 prof) <|
  Sp.table (c_139 prof) <|
  Sp.never ℓ

