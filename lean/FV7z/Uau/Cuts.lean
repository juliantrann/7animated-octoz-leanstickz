import FV7z.Uau.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `UString::operator=(const UString&)` (PLAN.md §M, M1)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (50, 68, 82, 99; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Uau
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_72 : Wpt := fun F Wl Q => wp F Wl o5 (Q 82)
theorem c_72 (prof : Profile) : Sp prof uau uau_at 72 W_72 := Sp.blk_then (blk_72 prof) (Sp.skip 82)

def W_33 : Wpt := fun F Wl Q => wp F Wl o2 (Q 36)
theorem c_33 (prof : Profile) : Sp prof uau uau_at 33 W_33 := Sp.blk_then (blk_33 prof) (Sp.skip 36)

def W_22 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 2 = true → W_72 F Wl Q g (rfz f) V) ∧
    (f.cond 2 = false → W_33 F Wl Q g (rfz f) V)
theorem c_22 (prof : Profile) : Sp prof uau uau_at 22 W_22 :=
  Sp.blk_then (blk_22 prof) (Sp.jcc_then (spj_31 prof) (c_72 prof) (c_33 prof))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 55 g (rfz f) V) ∧
    (f.cond 4 = false → W_22 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof uau uau_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_20 prof) (Sp.skip 55) (c_22 prof))

def W_36 : Wpt := fun F Wl Q => wp F Wl o3 (Q 50)
theorem c_36 (prof : Profile) : Sp prof uau uau_at 36 W_36 := Sp.blk_then (blk_36 prof) (Sp.skip 50)

def W_55 : Wpt := fun F Wl Q => wp F Wl o4 (Q 68)
theorem c_55 (prof : Profile) : Sp prof uau uau_at 55 W_55 := Sp.blk_then (blk_55 prof) (Sp.skip 68)

def W_87 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    (f.cond 4 = true → Q 104 g (rfz f) V) ∧
    (f.cond 4 = false → Q 99 g (rfz f) V)
theorem c_87 (prof : Profile) : Sp prof uau uau_at 87 W_87 :=
  Sp.blk_then (blk_87 prof) (Sp.jcc_then (spj_97 prof) (Sp.skip 104) (Sp.skip 99))

def W_104 : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    Q 36 g (rfz f) V
theorem c_104 (prof : Profile) : Sp prof uau uau_at 104 W_104 :=
  Sp.blk_then (blk_104 prof) (Sp.jmp_then (spj_113 prof) (Sp.skip 36))

/-- The cut points. -/
def cuts : List Nat := [0, 36, 55, 87, 104]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 36 then W_36 else
  if ℓ = 55 then W_55 else
  if ℓ = 87 then W_87 else
  if ℓ = 104 then W_104 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof uau uau_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_36 prof) <|
  Sp.table (c_55 prof) <|
  Sp.table (c_87 prof) <|
  Sp.table (c_104 prof) <|
  Sp.never ℓ

end FV7z.Uau
