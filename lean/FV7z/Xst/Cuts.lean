import FV7z.Xst.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__xstat` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (24, 34, 35, 57, 58, 83; the `ret`). `Wt` is the table of the
cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Xst
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_64 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o4 fb) (Q 83)
theorem c_64 (prof : Profile) (fb : Addr) : SpF prof xst xst_at fb 64 (W_64 fb) :=
  SpF.blkF_then (blk_64 prof fb) (SpF.skip 83)

def W_19 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 24)
theorem c_19 (prof : Profile) (fb : Addr) : SpF prof xst xst_at fb 19 (W_19 fb) :=
  SpF.blk_then (blk_19 prof) (SpF.skip 24)

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 7 = true → W_64 fb F Wl Q g (rfz f) V) ∧
    (f.cond 7 = false → W_19 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof xst xst_at fb 0 (W_0 fb) :=
  SpF.blk_then (blk_0 prof) (SpF.jcc_then (spj_17 prof fb) (c_64 prof fb) (c_19 prof fb))

def W_40 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o3 fb) (Q 57)
theorem c_40 (prof : Profile) (fb : Addr) : SpF prof xst xst_at fb 40 (W_40 fb) :=
  SpF.blkF_then (blk_40 prof fb) (SpF.skip 57)

def W_26 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 7 = true → W_40 fb F Wl Q g (rfz f) V) ∧
    (f.cond 7 = false → Q 34 g (rfz f) V)
theorem c_26 (prof : Profile) (fb : Addr) : SpF prof xst xst_at fb 26 (W_26 fb) :=
  SpF.blk_then (blk_26 prof) (SpF.jcc_then (spj_32 prof fb) (c_40 prof fb) (SpF.skip 34))

/-- The cut points. -/
def cuts : List Nat := [0, 26]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 26 then W_26 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof xst xst_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_26 prof fb) <|
  SpF.never ℓ

end FV7z.Xst
