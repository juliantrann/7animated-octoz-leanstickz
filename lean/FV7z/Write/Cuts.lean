import FV7z.Write.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__libc_write` (PLAN.md §M, M1)

The 2 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (21, 31, 32, 50, 77, 95, 131; the `ret`). `Wt` is the table of
the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Write
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_16 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 (Q 21)
theorem c_16 (prof : Profile) (fb : Addr) : SpF prof wrt wrt_at fb 16 (W_16 fb) :=
  SpF.blk_then (blk_16 prof) (SpF.skip 21)

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) fun g f V =>
    (f.cond 5 = true → Q 32 g (rfz f) V) ∧
    (f.cond 5 = false → W_16 fb F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof wrt wrt_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.jcc_then (spj_14 prof fb) (SpF.skip 32) (c_16 prof fb))

def W_112 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o3 fb) (Q 131)
theorem c_112 (prof : Profile) (fb : Addr) : SpF prof wrt wrt_at fb 112 (W_112 fb) :=
  SpF.blkF_then (blk_112 prof fb) (SpF.skip 131)

def W_23 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 7 = true → W_112 fb F Wl Q g (rfz f) V) ∧
    (f.cond 7 = false → Q 31 g (rfz f) V)
theorem c_23 (prof : Profile) (fb : Addr) : SpF prof wrt wrt_at fb 23 (W_23 fb) :=
  SpF.blk_then (blk_23 prof) (SpF.jcc_then (spj_29 prof fb) (c_112 prof fb) (SpF.skip 31))

/-- The cut points. -/
def cuts : List Nat := [0, 23]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 23 then W_23 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof wrt wrt_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_23 prof fb) <|
  SpF.never ℓ

end FV7z.Write
