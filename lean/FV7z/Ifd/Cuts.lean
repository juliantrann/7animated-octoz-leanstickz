import FV7z.Ifd.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CInFileStream::~CInFileStream` (PLAN.md §M, M1)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (87, 102, 119, 128, 134; the `ret`). `Wt` is the table of the
cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ifd
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_74 : Wpt := fun F Wl Q => wp F Wl o1 (Q 87)
theorem c_74 (prof : Profile) : Sp prof ifd ifd_at 74 W_74 := Sp.blk_then (blk_74 prof) (Sp.skip 87)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 90 g (rfz f) V) ∧
    (f.cond 4 = false → W_74 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof ifd ifd_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_72 prof) (Sp.skip 90) (c_74 prof))

def W_90 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 107 g (rfz f) V) ∧
    (f.cond 4 = false → Q 102 g (rfz f) V)
theorem c_90 (prof : Profile) : Sp prof ifd ifd_at 90 W_90 :=
  Sp.blk_then (blk_90 prof) (Sp.jcc_then (spj_100 prof) (Sp.skip 107) (Sp.skip 102))

def W_107 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → Q 124 g (rfz f) V) ∧
    (f.cond 4 = false → Q 119 g (rfz f) V)
theorem c_107 (prof : Profile) : Sp prof ifd ifd_at 107 W_107 :=
  Sp.blk_then (blk_107 prof) (Sp.jcc_then (spj_117 prof) (Sp.skip 124) (Sp.skip 119))

def W_124 : Wpt := fun F Wl Q => wp F Wl o4 (Q 128)
theorem c_124 (prof : Profile) : Sp prof ifd ifd_at 124 W_124 := Sp.blk_then (blk_124 prof) (Sp.skip 128)

def W_133 : Wpt := fun F Wl Q => wp F Wl o5 (Q 134)
theorem c_133 (prof : Profile) : Sp prof ifd ifd_at 133 W_133 := Sp.blk_then (blk_133 prof) (Sp.skip 134)

/-- The cut points. -/
def cuts : List Nat := [0, 90, 107, 124, 133]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 90 then W_90 else
  if ℓ = 107 then W_107 else
  if ℓ = 124 then W_124 else
  if ℓ = 133 then W_133 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ifd ifd_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_90 prof) <|
  Sp.table (c_107 prof) <|
  Sp.table (c_124 prof) <|
  Sp.table (c_133 prof) <|
  Sp.never ℓ

end FV7z.Ifd
