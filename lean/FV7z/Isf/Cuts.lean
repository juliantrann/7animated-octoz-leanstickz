import FV7z.Isf.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__init_sched_fifo_prio` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (13, 29, 44; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Isf
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 13)
theorem c_0 (prof : Profile) : Sp prof isf isf_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 13)

def W_18 : Wpt := fun F Wl Q => wp F Wl o1 (Q 29)
theorem c_18 (prof : Profile) : Sp prof isf isf_at 18 W_18 := Sp.blkA_then (blk_18 prof) (Sp.skip 29)

def W_34 : Wpt := fun F Wl Q => wp F Wl o2 (Q 44)
theorem c_34 (prof : Profile) : Sp prof isf isf_at 34 W_34 := Sp.blkA_then (blk_34 prof) (Sp.skip 44)

/-- The cut points. -/
def cuts : List Nat := [0, 18, 34]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 18 then W_18 else
  if ℓ = 34 then W_34 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof isf isf_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_18 prof) <|
  Sp.table (c_34 prof) <|
  Sp.never ℓ

end FV7z.Isf
