import FV7z.Sbrk.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__sbrk` (PLAN.md G3, startup)

The 5 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (56, 70, 98, 120, 140; the `ret`). `Wt` is the table of the
cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Sbrk
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_26 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 96 g (rfz f) V) ∧
    (f.cond 5 = false → Q 36 g (rfz f) V)
theorem c_26 (prof : Profile) : Sp prof sbk sbk_at 26 W_26 :=
  Sp.blkA_then (blk_26 prof) (Sp.jcc_then (spj_34 prof) (Sp.skip 96) (Sp.skip 36))

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 96 g (rfz f) V) ∧
    (f.cond 4 = false → W_26 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof sbk sbk_at 0 W_0 :=
  Sp.blkA_then (blk_0 prof) (Sp.jcc_then (spj_24 prof) (Sp.skip 96) (c_26 prof))

def W_77 : Wpt := fun F Wl Q => wp F Wl o4 (Q 87)
theorem c_77 (prof : Profile) : Sp prof sbk sbk_at 77 W_77 := Sp.blk_then (blk_77 prof) (Sp.skip 87)

def W_136 : Wpt := fun F Wl Q => wp F Wl o7 (Q 140)
theorem c_136 (prof : Profile) : Sp prof sbk sbk_at 136 W_136 := Sp.blk_then (blk_136 prof) (Sp.skip 140)

def W_43 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 4 = true → W_136 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → Q 56 g (rfz f) V)
theorem c_43 (prof : Profile) : Sp prof sbk sbk_at 43 W_43 :=
  Sp.blk_then (blk_43 prof) (Sp.jcc_then (spj_54 prof) (c_136 prof) (Sp.skip 56))

def W_41 : Wpt := fun F Wl Q g f V =>
    (f.cond 14 = true → Q 120 g (rfz f) V) ∧
    (f.cond 14 = false → W_43 F Wl Q g (rfz f) V)
theorem c_41 (prof : Profile) : Sp prof sbk sbk_at 41 W_41 :=
  Sp.jcc_then (spj_41 prof) (Sp.skip 120) (c_43 prof)

def W_36 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → W_77 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_41 F Wl Q g (rfz f) V)
theorem c_36 (prof : Profile) : Sp prof sbk sbk_at 36 W_36 :=
  Sp.blk_then (blk_36 prof) (Sp.jcc_then (spj_39 prof) (c_77 prof) (c_41 prof))

def W_96 : Wpt := fun F Wl Q => wp F Wl o5 (Q 98)
theorem c_96 (prof : Profile) : Sp prof sbk sbk_at 96 W_96 := Sp.blk_then (blk_96 prof) (Sp.skip 98)

def W_114 : Wpt := fun F Wl Q g f V =>
    Q 70 g (rfz f) V
theorem c_114 (prof : Profile) : Sp prof sbk sbk_at 114 W_114 :=
  Sp.jmp_then (spj_114 prof) (Sp.skip 70)

def W_103 : Wpt := fun F Wl Q => wp F Wl o6 fun g f V =>
    (f.cond 9 = true → Q 36 g (rfz f) V) ∧
    (f.cond 9 = false → W_114 F Wl Q g (rfz f) V)
theorem c_103 (prof : Profile) : Sp prof sbk sbk_at 103 W_103 :=
  Sp.blkA_then (blk_103 prof) (Sp.jcc_then (spj_112 prof) (Sp.skip 36) (c_114 prof))

def W_149 : Wpt := fun F Wl Q => wp F Wl o4 (Q 159)
theorem c_149 (prof : Profile) : Sp prof sbk sbk_at 149 W_149 := Sp.blk_then (blk_149 prof) (Sp.skip 159)

def W_145 : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    (f.cond 8 = true → Q 70 g (rfz f) V) ∧
    (f.cond 8 = false → W_149 F Wl Q g (rfz f) V)
theorem c_145 (prof : Profile) : Sp prof sbk sbk_at 145 W_145 :=
  Sp.blk_then (blk_145 prof) (Sp.jcc_then (spj_147 prof) (Sp.skip 70) (c_149 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 36, 96, 103, 145]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 36 then W_36 else
  if ℓ = 96 then W_96 else
  if ℓ = 103 then W_103 else
  if ℓ = 145 then W_145 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof sbk sbk_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_36 prof) <|
  Sp.table (c_96 prof) <|
  Sp.table (c_103 prof) <|
  Sp.table (c_145 prof) <|
  Sp.never ℓ

end FV7z.Sbrk
