import FV7z.Acp.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `AString::AString (const AString &)` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (19, 61; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Acp
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 19)
theorem c_0 (prof : Profile) : Sp prof acp acp_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 19)

def W_24 : Wpt := fun F Wl Q => wp F Wl o1 (Q 40)
theorem c_24 (prof : Profile) : Sp prof acp acp_at 24 W_24 := Sp.blk_then (blk_24 prof) (Sp.skip 40)

def W_55 : Wpt := fun F Wl Q => wp F Wl o3 (Q 61)
theorem c_55 (prof : Profile) : Sp prof acp acp_at 55 W_55 := Sp.blk_then (blk_55 prof) (Sp.skip 61)

def W_40 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 40 g (rfz f) V) ∧
    (f.cond 5 = false → W_55 F Wl Q g (rfz f) V)
theorem c_40 (prof : Profile) : Sp prof acp acp_at 40 W_40 :=
  Sp.blk_then (blk_40 prof) (Sp.jcc_then (spj_53 prof) (Sp.skip 40) (c_55 prof))

/-- The cut points. -/
def cuts : List Nat := [0, 24, 40]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 24 then W_24 else
  if ℓ = 40 then W_40 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof acp acp_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_24 prof) <|
  Sp.table (c_40 prof) <|
  Sp.never ℓ

end FV7z.Acp
