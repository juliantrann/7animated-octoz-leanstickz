/-- The cut points. -/
def cuts : List Nat := [0, 69, 80, 136, 156, 176, 196, 216, 236, 256, 276, 296, 316, 336, 356]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 69 then W_69 fb else
  if ℓ = 80 then W_80 fb else
  if ℓ = 136 then W_136 fb else
  if ℓ = 156 then W_156 fb else
  if ℓ = 176 then W_176 fb else
  if ℓ = 196 then W_196 fb else
  if ℓ = 216 then W_216 fb else
  if ℓ = 236 then W_236 fb else
  if ℓ = 256 then W_256 fb else
  if ℓ = 276 then W_276 fb else
  if ℓ = 296 then W_296 fb else
  if ℓ = 316 then W_316 fb else
  if ℓ = 336 then W_336 fb else
  if ℓ = 356 then W_356 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof pmi pmi_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_69 prof fb) <|
  SpF.table (c_80 prof fb) <|
  SpF.table (c_136 prof fb) <|
  SpF.table (c_156 prof fb) <|
  SpF.table (c_176 prof fb) <|
  SpF.table (c_196 prof fb) <|
  SpF.table (c_216 prof fb) <|
  SpF.table (c_236 prof fb) <|
  SpF.table (c_256 prof fb) <|
  SpF.table (c_276 prof fb) <|
  SpF.table (c_296 prof fb) <|
  SpF.table (c_316 prof fb) <|
  SpF.table (c_336 prof fb) <|
  SpF.table (c_356 prof fb) <|
  SpF.never ℓ

