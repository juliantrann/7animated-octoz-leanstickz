import FV7z.Sjs.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__sigjmp_save` (PLAN.md G3, startup)

The 1 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (18, 24; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Sjs
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_12 : Wpt := fun F Wl Q => wp F Wl o1 (Q 18)
theorem c_12 (prof : Profile) : Sp prof sjs sjs_at 12 W_12 := Sp.blk_then (blk_12 prof) (Sp.skip 18)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 5 = true → Q 24 g (rfz f) V) ∧
    (f.cond 5 = false → W_12 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof sjs sjs_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_10 prof) (Sp.skip 24) (c_12 prof))

/-- The cut points. -/
def cuts : List Nat := [0]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof sjs sjs_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.never ℓ

end FV7z.Sjs
