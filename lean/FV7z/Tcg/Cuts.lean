import FV7z.Tcg.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__tcgetattr` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (40, 75, 80, 134, 138, 166, 167, 196; the `ret`). `Wt` is the
table of the cut points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Tcg
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 40)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof tcg tcg_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 40)

def W_176 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o6 fb) fun g f V =>
    Q 143 g (rfz f) V
theorem c_176 (prof : Profile) (fb : Addr) : SpF prof tcg tcg_at fb 176 (W_176 fb) :=
  SpF.blkF_then (blk_176 prof fb) (SpF.jmp_then (spj_194 prof fb) (SpF.skip 143))

def W_57 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o3 (Q 75)
theorem c_57 (prof : Profile) (fb : Addr) : SpF prof tcg tcg_at fb 57 (W_57 fb) :=
  SpF.blk_then (blk_57 prof) (SpF.skip 75)

def W_50 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → Q 143 g (rfz f) V) ∧
    (f.cond 5 = false → W_57 fb F Wl Q g (rfz f) V)
theorem c_50 (prof : Profile) (fb : Addr) : SpF prof tcg tcg_at fb 50 (W_50 fb) :=
  SpF.blk_then (blk_50 prof) (SpF.jcc_then (spj_55 prof fb) (SpF.skip 143) (c_57 prof fb))

def W_42 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 7 = true → W_176 fb F Wl Q g (rfz f) V) ∧
    (f.cond 7 = false → W_50 fb F Wl Q g (rfz f) V)
theorem c_42 (prof : Profile) (fb : Addr) : SpF prof tcg tcg_at fb 42 (W_42 fb) :=
  SpF.blk_then (blk_42 prof) (SpF.jcc_then (spj_48 prof fb) (c_176 prof fb) (c_50 prof fb))

def W_159 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 (Q 166)
theorem c_159 (prof : Profile) (fb : Addr) : SpF prof tcg tcg_at fb 159 (W_159 fb) :=
  SpF.blk_then (blk_159 prof) (SpF.skip 166)

def W_143 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o4 fb) fun g f V =>
    (f.cond 5 = true → Q 196 g (rfz f) V) ∧
    (f.cond 5 = false → W_159 fb F Wl Q g (rfz f) V)
theorem c_143 (prof : Profile) (fb : Addr) : SpF prof tcg tcg_at fb 143 (W_143 fb) :=
  SpF.blkF_then (blk_143 prof fb) (SpF.jcc_then (spj_157 prof fb) (SpF.skip 196) (c_159 prof fb))

/-- The cut points. -/
def cuts : List Nat := [0, 42, 143]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 42 then W_42 fb else
  if ℓ = 143 then W_143 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof tcg tcg_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_42 prof fb) <|
  SpF.table (c_143 prof fb) <|
  SpF.never ℓ

end FV7z.Tcg
