import FV7z.Sdf.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CFiTimesCAM::SetDirTime_to_FS` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (47; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Sdf
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_15 : Wpt := fun F Wl Q => wp F Wl o1 (Q 19)
theorem c_15 (prof : Profile) : Sp prof sdf sdf_at 15 W_15 := Sp.blk_then (blk_15 prof) (Sp.skip 19)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 19 g (rfz f) V) ∧
    (f.cond 4 = false → W_15 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof sdf sdf_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_13 prof) (Sp.skip 19) (c_15 prof))

def W_27 : Wpt := fun F Wl Q => wp F Wl o3 (Q 31)
theorem c_27 (prof : Profile) : Sp prof sdf sdf_at 27 W_27 := Sp.blk_then (blk_27 prof) (Sp.skip 31)

def W_19 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → Q 31 g (rfz f) V) ∧
    (f.cond 4 = false → W_27 F Wl Q g (rfz f) V)
theorem c_19 (prof : Profile) : Sp prof sdf sdf_at 19 W_19 :=
  Sp.blk_then (blk_19 prof) (Sp.jcc_then (spj_25 prof) (Sp.skip 31) (c_27 prof))

def W_31 : Wpt := fun F Wl Q => wp F Wl o4 (Q 47)
theorem c_31 (prof : Profile) : Sp prof sdf sdf_at 31 W_31 := Sp.blk_then (blk_31 prof) (Sp.skip 47)

/-- The cut points. -/
def cuts : List Nat := [0, 19, 31]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 19 then W_19 else
  if ℓ = 31 then W_31 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof sdf sdf_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_19 prof) <|
  Sp.table (c_31 prof) <|
  Sp.never ℓ

end FV7z.Sdf
