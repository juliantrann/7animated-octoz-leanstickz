import FV7z.TcgC.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__tcgetattr` (PLAN.md §M, M1)

The 1 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (134; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.TcgC
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf
open FV7z.Tcg (tcg tcg_at tcg_length)

def W_86 : Wpt := fun F Wl Q => wp F Wl o0 (Q 134)
theorem c_86 (prof : Profile) : Sp prof tcg tcg_at 86 W_86 := Sp.blk_then (blk_86 prof) (Sp.skip 134)

/-- The cut points. -/
def cuts : List Nat := [86]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 86 then W_86 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof tcg tcg_at ℓ (Wt ℓ) :=
  Sp.table (c_86 prof) <|
  Sp.never ℓ

end FV7z.TcgC
