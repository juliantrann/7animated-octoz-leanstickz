import FV7z.Fni.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `fini` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (31, 42, 47, 64; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Fni
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_16 : Wpt := fun F Wl Q => wp F Wl o1 (Q 31)
theorem c_16 (prof : Profile) : Sp prof fni fni_at 16 W_16 := Sp.blkA_then (blk_16 prof) (Sp.skip 31)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 42 g (rfz f) V) ∧
    (f.cond 4 = false → W_16 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof fni fni_at 0 W_0 :=
  Sp.blkA_then (blk_0 prof) (Sp.jcc_then (spj_14 prof) (Sp.skip 42) (c_16 prof))

def W_43 : Wpt := fun F Wl Q => wp F Wl o3 (Q 47)
theorem c_43 (prof : Profile) : Sp prof fni fni_at 43 W_43 := Sp.blk_then (blk_43 prof) (Sp.skip 47)

def W_33 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 5 = true → W_43 F Wl Q g (rfz f) V) ∧
    (f.cond 5 = false → Q 42 g (rfz f) V)
theorem c_33 (prof : Profile) : Sp prof fni fni_at 33 W_33 :=
  Sp.blk_then (blk_33 prof) (Sp.jcc_then (spj_40 prof) (c_43 prof) (Sp.skip 42))

def W_52 : Wpt := fun F Wl Q => wp F Wl o4 (Q 64)
theorem c_52 (prof : Profile) : Sp prof fni fni_at 52 W_52 := Sp.blkA_then (blk_52 prof) (Sp.skip 64)

/-- The cut points. -/
def cuts : List Nat := [0, 33, 52]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 33 then W_33 else
  if ℓ = 52 then W_52 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof fni fni_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_33 prof) <|
  Sp.table (c_52 prof) <|
  Sp.never ℓ

end FV7z.Fni
