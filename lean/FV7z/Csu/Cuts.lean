import FV7z.Csu.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `__libc_csu_init` (PLAN.md G3, startup)

The 8 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (64, 91, 120, 147; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Csu
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_49 : Wpt := fun F Wl Q => wp F Wl o1 (Q 56)
theorem c_49 (prof : Profile) : Sp prof csu csu_at 49 W_49 := Sp.blk_then (blk_49 prof) (Sp.skip 56)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 77 g (rfz f) V) ∧
    (f.cond 4 = false → W_49 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof csu csu_at 0 W_0 :=
  Sp.blkA_then (blk_0 prof) (Sp.jcc_then (spj_47 prof) (Sp.skip 77) (c_49 prof))

def W_56 : Wpt := fun F Wl Q => wp F Wl o2 (Q 64)
theorem c_56 (prof : Profile) : Sp prof csu csu_at 56 W_56 := Sp.blk_then (blk_56 prof) (Sp.skip 64)

def W_68 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 5 = true → Q 56 g (rfz f) V) ∧
    (f.cond 5 = false → Q 77 g (rfz f) V)
theorem c_68 (prof : Profile) : Sp prof csu csu_at 68 W_68 :=
  Sp.blk_then (blk_68 prof) (Sp.jcc_then (spj_75 prof) (Sp.skip 56) (Sp.skip 77))

def W_77 : Wpt := fun F Wl Q => wp F Wl o4 (Q 91)
theorem c_77 (prof : Profile) : Sp prof csu csu_at 77 W_77 := Sp.blkA_then (blk_77 prof) (Sp.skip 91)

def W_105 : Wpt := fun F Wl Q => wp F Wl o1 (Q 112)
theorem c_105 (prof : Profile) : Sp prof csu csu_at 105 W_105 := Sp.blk_then (blk_105 prof) (Sp.skip 112)

def W_96 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 4 = true → Q 133 g (rfz f) V) ∧
    (f.cond 4 = false → W_105 F Wl Q g (rfz f) V)
theorem c_96 (prof : Profile) : Sp prof csu csu_at 96 W_96 :=
  Sp.blk_then (blk_96 prof) (Sp.jcc_then (spj_103 prof) (Sp.skip 133) (c_105 prof))

def W_112 : Wpt := fun F Wl Q => wp F Wl o2 (Q 120)
theorem c_112 (prof : Profile) : Sp prof csu csu_at 112 W_112 := Sp.blk_then (blk_112 prof) (Sp.skip 120)

def W_124 : Wpt := fun F Wl Q => wp F Wl o3 fun g f V =>
    (f.cond 5 = true → Q 112 g (rfz f) V) ∧
    (f.cond 5 = false → Q 133 g (rfz f) V)
theorem c_124 (prof : Profile) : Sp prof csu csu_at 124 W_124 :=
  Sp.blk_then (blk_124 prof) (Sp.jcc_then (spj_131 prof) (Sp.skip 112) (Sp.skip 133))

def W_133 : Wpt := fun F Wl Q => wp F Wl o6 (Q 147)
theorem c_133 (prof : Profile) : Sp prof csu csu_at 133 W_133 := Sp.blk_then (blk_133 prof) (Sp.skip 147)

/-- The cut points. -/
def cuts : List Nat := [0, 56, 68, 77, 96, 112, 124, 133]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 56 then W_56 else
  if ℓ = 68 then W_68 else
  if ℓ = 77 then W_77 else
  if ℓ = 96 then W_96 else
  if ℓ = 112 then W_112 else
  if ℓ = 124 then W_124 else
  if ℓ = 133 then W_133 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof csu csu_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_56 prof) <|
  Sp.table (c_68 prof) <|
  Sp.table (c_77 prof) <|
  Sp.table (c_96 prof) <|
  Sp.table (c_112 prof) <|
  Sp.table (c_124 prof) <|
  Sp.table (c_133 prof) <|
  Sp.never ℓ

end FV7z.Csu
