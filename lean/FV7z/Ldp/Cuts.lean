import FV7z.Ldp.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `NCompress::NLzma::CDecoder::SetDecoderProperties2` (PLAN.md §M, M1)

The 3 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (22, 49, 62, 71, 77; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Ldp
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 (Q 22)
theorem c_0 (prof : Profile) : Sp prof ldp ldp_at 0 W_0 := Sp.blk_then (blk_0 prof) (Sp.skip 22)

def W_56 : Wpt := fun F Wl Q => wp F Wl o4 (Q 62)
theorem c_56 (prof : Profile) : Sp prof ldp ldp_at 56 W_56 := Sp.blk_then (blk_56 prof) (Sp.skip 62)

def W_64 : Wpt := fun F Wl Q => wp F Wl o5 (Q 71)
theorem c_64 (prof : Profile) : Sp prof ldp ldp_at 64 W_64 := Sp.blk_then (blk_64 prof) (Sp.skip 71)

def W_48 : Wpt := fun F Wl Q => wp F Wl o3 (Q 49)
theorem c_48 (prof : Profile) : Sp prof ldp ldp_at 48 W_48 := Sp.blk_then (blk_48 prof) (Sp.skip 49)

def W_32 : Wpt := fun F Wl Q => wp F Wl o2 fun g f V =>
    (f.cond 4 = true → W_64 F Wl Q g (rfz f) V) ∧
    (f.cond 4 = false → W_48 F Wl Q g (rfz f) V)
theorem c_32 (prof : Profile) : Sp prof ldp ldp_at 32 W_32 :=
  Sp.blkA_then (blk_32 prof) (Sp.jcc_then (spj_46 prof) (c_64 prof) (c_48 prof))

def W_27 : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 7 = true → W_56 F Wl Q g (rfz f) V) ∧
    (f.cond 7 = false → W_32 F Wl Q g (rfz f) V)
theorem c_27 (prof : Profile) : Sp prof ldp ldp_at 27 W_27 :=
  Sp.blk_then (blk_27 prof) (Sp.jcc_then (spj_30 prof) (c_56 prof) (c_32 prof))

def W_76 : Wpt := fun F Wl Q => wp F Wl o3 (Q 77)
theorem c_76 (prof : Profile) : Sp prof ldp ldp_at 76 W_76 := Sp.blk_then (blk_76 prof) (Sp.skip 77)

/-- The cut points. -/
def cuts : List Nat := [0, 27, 76]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 27 then W_27 else
  if ℓ = 76 then W_76 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof ldp ldp_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_27 prof) <|
  Sp.table (c_76 prof) <|
  Sp.never ℓ

end FV7z.Ldp
