theorem c_108 (prof : Profile) : Sp prof lhp lhp_at 108 W_108 :=
  Sp.blk_then (blk_108 prof) (Sp.jmp_then (spj_120 prof) (Sp.skip 144))

def W_94 : Wpt := fun F Wl Q => wp F Wl o8 fun g f V =>
    (f.cond 4 = true → Q 64 g (rfz f) V) ∧
    (f.cond 4 = false → W_108 F Wl Q g (rfz f) V)
theorem c_94 (prof : Profile) : Sp prof lhp lhp_at 94 W_94 :=
  Sp.blk_then (blk_94 prof) (Sp.jcc_then (spj_106 prof) (Sp.skip 64) (c_108 prof))

def W_72 : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    (f.cond 6 = true → Q 64 g (rfz f) V) ∧
    (f.cond 6 = false → W_94 F Wl Q g (rfz f) V)
theorem c_72 (prof : Profile) : Sp prof lhp lhp_at 72 W_72 :=
  Sp.blk_then (blk_72 prof) (Sp.jcc_then (spj_92 prof) (Sp.skip 64) (c_94 prof))

def W_58 : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 6 = true → W_72 F Wl Q g (rfz f) V) ∧
    (f.cond 6 = false → Q 64 g (rfz f) V)
theorem c_58 (prof : Profile) : Sp prof lhp lhp_at 58 W_58 :=
