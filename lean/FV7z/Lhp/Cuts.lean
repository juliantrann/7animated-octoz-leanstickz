import FV7z.Lhp.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CHeader_Parse` (PLAN.md §M, M1)

The 6 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one
piece (`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition,
or `Q` at a cut point or at an offset the proof does not go past (67; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Lhp
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_12 : Wpt := fun F Wl Q => wp F Wl o1 (Q 22)
theorem c_12 (prof : Profile) : Sp prof lhp lhp_at 12 W_12 := Sp.blk_then (blk_12 prof) (Sp.skip 22)

def W_0 : Wpt := fun F Wl Q => wp F Wl o0 fun g f V =>
    (f.cond 4 = true → Q 22 g (rfz f) V) ∧
    (f.cond 4 = false → W_12 F Wl Q g (rfz f) V)
theorem c_0 (prof : Profile) : Sp prof lhp lhp_at 0 W_0 :=
  Sp.blk_then (blk_0 prof) (Sp.jcc_then (spj_10 prof) (Sp.skip 22) (c_12 prof))

def W_22 : Wpt := fun F Wl Q => wp F Wl o2 (Q 24)
theorem c_22 (prof : Profile) : Sp prof lhp lhp_at 22 W_22 := Sp.blk_then (blk_22 prof) (Sp.skip 24)

