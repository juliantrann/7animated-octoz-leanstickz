  Sp.blk_then (blk_152 prof) (Sp.jmp_then (spj_158 prof) (Sp.skip 64))

/-- The cut points. -/
def cuts : List Nat := [0, 22, 24, 64, 144, 152]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 else
  if ℓ = 22 then W_22 else
  if ℓ = 24 then W_24 else
  if ℓ = 64 then W_64 else
  if ℓ = 144 then W_144 else
  if ℓ = 152 then W_152 else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (ℓ : Nat) : Sp prof lhp lhp_at ℓ (Wt ℓ) :=
  Sp.table (c_0 prof) <|
  Sp.table (c_22 prof) <|
  Sp.table (c_24 prof) <|
  Sp.table (c_64 prof) <|
  Sp.table (c_144 prof) <|
  Sp.table (c_152 prof) <|
  Sp.never ℓ

end FV7z.Lhp
