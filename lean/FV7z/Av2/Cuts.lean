import FV7z.Av2.Blocks
import FV7z.Lemmas.Wp
/-!
# The cut points of `CPU_IsSupported_AVX2` (PLAN.md §M, M1)

The 6 cut points: the entry and where two ways meet. From each, the blocks up to the next cut points as one piece
(`W_*`, with its `Sp`, `c_*`): a block's straight-line code, then at its jump's exits the next block's condition, or `Q`
at a cut point or at an offset the proof does not go past (24, 55, 64, 82, 99; the `ret`). `Wt` is the table of the cut
points' conditions, `spAll` its `Sp`s, for `Seg.cfg`. Generated by `tools/blk_gen.py`.
-/
namespace FV7z.Av2
set_option linter.unusedVariables false
open ZellicX86 Decode FV7z.Leaf

def W_0 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o0 fb) (Q 24)
theorem c_0 (prof : Profile) (fb : Addr) : SpF prof av2 av2_at fb 0 (W_0 fb) :=
  SpF.blkF_then (blk_0 prof fb) (SpF.skip 24)

def W_29 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o1 fun g f V =>
    (f.cond 5 = true → Q 64 g (rfz f) V) ∧
    (f.cond 5 = false → Q 33 g (rfz f) V)
theorem c_29 (prof : Profile) (fb : Addr) : SpF prof av2 av2_at fb 29 (W_29 fb) :=
  SpF.blk_then (blk_29 prof) (SpF.jcc_then (spj_31 prof fb) (SpF.skip 64) (SpF.skip 33))

def W_33 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o2 (Q 35)
theorem c_33 (prof : Profile) (fb : Addr) : SpF prof av2 av2_at fb 33 (W_33 fb) :=
  SpF.blk_then (blk_33 prof) (SpF.skip 35)

def W_51 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o4 (Q 55)
theorem c_51 (prof : Profile) (fb : Addr) : SpF prof av2 av2_at fb 51 (W_51 fb) :=
  SpF.blk_then (blk_51 prof) (SpF.skip 55)

def W_35 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl (o3 fb) fun g f V =>
    (f.cond 5 = true → Q 99 g (rfz f) V) ∧
    (f.cond 5 = false → W_51 fb F Wl Q g (rfz f) V)
theorem c_35 (prof : Profile) (fb : Addr) : SpF prof av2 av2_at fb 35 (W_35 fb) :=
  SpF.blkF_then (blk_35 prof fb) (SpF.jcc_then (spj_49 prof fb) (SpF.skip 99) (c_51 prof fb))

def W_74 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o6 (Q 82)
theorem c_74 (prof : Profile) (fb : Addr) : SpF prof av2 av2_at fb 74 (W_74 fb) :=
  SpF.blk_then (blk_74 prof) (SpF.skip 82)

def W_69 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o5 fun g f V =>
    (f.cond 6 = true → Q 33 g (rfz f) V) ∧
    (f.cond 6 = false → W_74 fb F Wl Q g (rfz f) V)
theorem c_69 (prof : Profile) (fb : Addr) : SpF prof av2 av2_at fb 69 (W_69 fb) :=
  SpF.blk_then (blk_69 prof) (SpF.jcc_then (spj_72 prof fb) (SpF.skip 33) (c_74 prof fb))

def W_87 (fb : Addr) : Wpt := fun F Wl Q => wp F Wl o7 fun g f V =>
    Q 35 g (rfz f) V
theorem c_87 (prof : Profile) (fb : Addr) : SpF prof av2 av2_at fb 87 (W_87 fb) :=
  SpF.blk_then (blk_87 prof) (SpF.jmp_then (spj_97 prof fb) (SpF.skip 35))

/-- The cut points. -/
def cuts : List Nat := [0, 29, 33, 35, 69, 87]

/-- What the code from a cut point needs for `Q` at the next ones. -/
def Wt (fb : Addr) (ℓ : Nat) : Wpt :=
  if ℓ = 0 then W_0 fb else
  if ℓ = 29 then W_29 fb else
  if ℓ = 33 then W_33 fb else
  if ℓ = 35 then W_35 fb else
  if ℓ = 69 then W_69 fb else
  if ℓ = 87 then W_87 fb else
  fun _ _ _ _ _ _ => False

theorem spAll (prof : Profile) (fb : Addr) (ℓ : Nat) : SpF prof av2 av2_at fb ℓ (Wt fb ℓ) :=
  SpF.table (c_0 prof fb) <|
  SpF.table (c_29 prof fb) <|
  SpF.table (c_33 prof fb) <|
  SpF.table (c_35 prof fb) <|
  SpF.table (c_69 prof fb) <|
  SpF.table (c_87 prof fb) <|
  SpF.never ℓ

end FV7z.Av2
