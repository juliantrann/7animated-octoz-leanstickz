@@ -0,0 +1,72 @@
+import ZellicX86.Spec.Linux.Syscall.Common
+/-!
+# Linux system calls: the system's names and statistics, the working directory, the creation mask (FV_7zip G1)
+
+`uname`, `sysinfo`, `getcwd` and `umask`. The system's names and statistics and the working directory's path are the
+environment's answers (`Request.uname`, `Request.sysinfo`, `Request.cwd`): the model has no kernel configuration, no
+memory accounting and no file system. The file mode creation mask is the process's (`Proc.umask`). What the kernel
+computes itself is modelled: the layout of the structures it writes, the size checks, and the copies to the process's
+memory.
+
+Sources: Linux v6.18 `kernel/sys.c` (`newuname`, `override_release`, `override_architecture`, `umask`,
+`do_sysinfo`, `sysinfo`), `fs/d_path.c` (`getcwd`, `prepend_path`), `include/uapi/linux/utsname.h`,
+`include/uapi/linux/sysinfo.h`, `include/uapi/asm-generic/errno-base.h`.
+-/
+namespace ZellicX86
+
+/-- Math result not representable: `getcwd`'s buffer is too small (`include/uapi/asm-generic/errno-base.h`). -/
+def ERANGE : Nat := 34
+
+/-- `uname(buf)` (`kernel/sys.c` `newuname`): the system's names (`Request.uname`: `struct new_utsname`, 390 bytes)
+are copied to `buf` (`EFAULT`, with the bytes before the fault copied, `copyOut`); the result is 0. With the
+`UNAME26` personality the kernel then writes a release again (`override_release`) over the bytes the copy has just
+written, so it cannot fault, and the bytes it leaves are again a `struct new_utsname` with a NUL ending each field,
+which the answer covers (`UtsnameOk`). So it does for the `PER_LINUX32` personality (`linux32(8)`), which `execve`
+keeps (`set_personality_64bit` clears only `READ_IMPLIES_EXEC`): `override_architecture` then writes `i686` and three
+NULs (`sizeof(COMPAT_UTS_MACHINE)`, 7 bytes) over the start of `machine`. -/
+def sysUname (prof : Profile) (s : State) : Req StepResult := do
+  let u ← Req.request .uname
+  let (s', k, all) ← copyOut prof s s.cpu.gpr.rdi u.val
+  Pure.pure (sysReturn s' (if all then 0 else errRet EFAULT) [] (u.val.take k))
+
+/-- `struct sysinfo` as the kernel writes it (`include/uapi/linux/sysinfo.h`, x86-64): 112 bytes, the fields
+little-endian at offsets 0 (`uptime`), 8 to 24 (`loads`), 32 (`totalram`), 40 (`freeram`), 48 (`sharedram`), 56
+(`bufferram`), 64 (`totalswap`), 72 (`freeswap`), 80 (`procs`, 2 bytes), 88 (`totalhigh`), 96 (`freehigh`) and 104
+(`mem_unit`, 4 bytes); the rest, `pad` at 82, the alignment up to 88 and from 108 on (`_f` is empty on a 64-bit
+kernel), is zero (`do_sysinfo` clears the structure first). -/
+def SysInfo.bytes (i : SysInfo) : List Byte :=
+  toBytesLE i.uptime 8 ++ toBytesLE i.loads.1 8 ++ toBytesLE i.loads.2.1 8 ++ toBytesLE i.loads.2.2 8 ++
+  toBytesLE i.totalram 8 ++ toBytesLE i.freeram 8 ++ toBytesLE i.sharedram 8 ++ toBytesLE i.bufferram 8 ++
+  toBytesLE i.totalswap 8 ++ toBytesLE i.freeswap 8 ++ toBytesLE i.procs 2 ++ toBytesLE (0 : BitVec 48) 6 ++
+  toBytesLE i.totalhigh 8 ++ toBytesLE i.freehigh 8 ++ toBytesLE i.memUnit 4 ++ toBytesLE (0 : BitVec 32) 4
+
+/-- `sysinfo(info)` (`kernel/sys.c`): the system's statistics (`Request.sysinfo`) as `struct sysinfo`
+(`SysInfo.bytes`), copied to `info` (`EFAULT`); the result is 0. -/
+def sysSysinfo (prof : Profile) (s : State) : Req StepResult := do
+  let i ← Req.request .sysinfo
+  let bs := i.bytes
+  let (s', k, all) ← copyOut prof s s.cpu.gpr.rdi bs
+  Pure.pure (sysReturn s' (if all then 0 else errRet EFAULT) [] (bs.take k))
+
+/-- `umask(mask)` (`kernel/sys.c`); `mask` is an `int`. The process's mask becomes its permission bits
+(`mask & S_IRWXUGO`, the low 9 bits) and the result is the mask it had. It cannot fail. -/
+def sysUmask (s : State) : Req StepResult :=
+  Pure.pure (sysReturn { s with proc.umask := s.cpu.gpr.rdi.setWidth 9 } (s.proc.umask.setWidth 64) [] [])
+
+/-- `getcwd(buf, size)` (`fs/d_path.c`); `size` is an `unsigned long`. The working directory's path or an error
+is the environment's (`Request.cwd`: `ENOENT` for an unlinked directory, `ENOMEM` when the kernel has no page for
+the path). The path with its NUL must fit in `PATH_MAX` bytes (`ENAMETOOLONG`: `prepend` ran out of the page) and in
+`size` bytes (`ERANGE`); it is copied to `buf` (`EFAULT`), and its length with the NUL is the result. -/
+def sysGetcwd (prof : Profile) (s : State) : Req StepResult := do
+  let fail (e : Nat) : Req StepResult := Pure.pure (sysReturn s (errRet e) [] [])
+  match ← Req.request .cwd with
+  | .error e => fail e.val
+  | .path p =>
