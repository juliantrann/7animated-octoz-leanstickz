+    let m ← memRef mo
+    alignedTo m 64 .write 576 false
+    let rfbm ← xRfbm prof
+    if rfbm &&& ~~~xInsnHeld ≠ 0 then unmodelled (.feature "XSAVE of a state component outside xInsnHeld") else do
+    if compacted && prof.xCompAligned rfbm then unmodelled (.feature "XSAVEC: an aligned component") else do
+    let (x, v) ← readXRegs
+    let u ← undefined 64
+    let inuse := xInuseOf x v rfbm u
+    let save := if compacted then inuse ||| (if v.mxcsr ≠ 0x1F80 then rfbm &&& 2 else 0) else rfbm
+    let hdr : List (Nat × List Byte) ←
+      if compacted then
+        Pure.pure [(512, toBytesLE save 8), (520, toBytesLE (rfbm ||| ((1 : BitVec 64) <<< 63)) 8)]
+      else do
+        let old : BitVec 64 ← read ⟨m.addr.add 512, m.stack⟩ 64
+        Pure.pure [(512, toBytesLE ((old &&& ~~~rfbm) ||| inuse) 8)]
+    let rsv : BitVec 23296 ← undefined 23296
+    let runs := xsaveRuns prof x v 0 save rsv (i.opsz = 64)
+    -- `XSAVEC` saves `MXCSR` with SSE state only (its Operation: "store SSE state ... saves the XMM registers,
+    -- MXCSR, and MXCSR_MASK")
+    let runs := if compacted && !save.getLsbD 1 then runs.filter (fun (o, _) => o != 24 && o != 28) else runs
+    let runs := hdr ++ (if compacted then xCompact prof rfbm runs else runs)
+    let n := xRunsEnd runs
+    let (sel, val) := xRunsSel runs n
+    -- the bytes of the components requested but not saved are checked or not (`Profile.xTouched`)
+    let all ← choice 1
+    checkAccesses ((prof.xTouched compacted rfbm (if all.val = 1 then rfbm else save)).map
+      fun (o, k) => (⟨m.addr.add o, m.stack⟩, .write, k))
+    writeSel m n sel val
+    done
+  | _ => formNotModelled i
+
+/-- `XRSTOR mem` (`REX.W`: `XRSTOR64`) (SDM Vol. 2, "XRSTOR", Operation; Vol. 1, 13.8): `#UD` as `xEnabled`,
+`#GP(0)` unless the area is 64-byte aligned; a requested-feature bitmap (`xRfbm`) with a component outside
+`xInsnHeld` is not modelled. It reads the header (bytes 512–575), then the bytes its plan loads (`XPlan.reads`), and
+loads the state as `xrstorRegs` says (`#GP(0)` where that does), the compacted form only on a CPU that supports it;
+a fault on the bytes `Profile.xTouched` gives (of the components loaded, or of every component requested) comes before
+the `#GP` or after it.
+`XINUSE` and `XRSTOR_INFO` are not state of the model (`xInuseOf`, `XSAVEOPT` and `XSAVES` are not modelled). -/
+def Sem.xrstor (prof : Profile) (i : Inst) : Prog Ctl :=
+  match i.ops with
+  | [.mem mo] => do
+    xEnabled prof false
+    let m ← memRef mo
+    alignedTo m 64 .read 576 false
+    let rfbm ← xRfbm prof
+    if rfbm &&& ~~~xInsnHeld ≠ 0 then unmodelled (.feature "XRSTOR of a state component outside xInsnHeld") else do
+    let hdr : BitVec 512 ← read ⟨m.addr.add 512, m.stack⟩ 512
+    let comp := hdr.extractLsb' 64 64
+    let p := xPlan (hdr.setWidth 64) comp rfbm
+    let cpu ← choice (prof.cpus - 1)
+    let xsavec := (prof.cpuid cpu.val 0xD 1).eax.getLsbD 1
+    let n := p.size prof
+    -- the bytes of the components requested but not loaded are checked or not (`Profile.xTouched`)
+    let all ← choice 1
+    let touched := (prof.xTouched p.compact p.fmt
+      (if all.val = 0 then p.restore else if p.compact then rfbm &&& p.fmt else rfbm)).map
+      fun (o, k) => (⟨m.addr.add o, m.stack⟩, Access.read, k)
+    let (x, v) ← readXRegs
+    -- whether a fault on the bytes `touched` comes before a `#GP` of the header or `MXCSR`: the manuals leave the
+    -- priority open (as `Prog.run`'s `checkAligned`); an Intel Core i7-14650HX raises the fault, an AMD EPYC 9V45
+    -- the `#GP` (measured). The `#GP` depends on the legacy region and the header only.
+    let first ← choice 1
+    if first.val = 1 then checkAccesses touched
+    let leg : BitVec 4096 ← read m 4096
+    let rdLow (o : Nat) : Byte :=
+      if o < 512 then leg.extractLsb' (8 * o) 8 else if o < 576 then hdr.extractLsb' (8 * (o - 512)) 8 else 0
+    if let .gp := xrstorRegs prof x v rdLow rfbm (i.opsz = 64) xsavec then throw (.gp 0)
+    let img ← readSel m n (ofBits n fun o => p.reads prof o)
+    let rd (o : Nat) : Byte := if 512 ≤ o && o < 576 then hdr.extractLsb' (8 * (o - 512)) 8 else img.extractLsb' (8 * o) 8
+    match xrstorRegs prof x v rd rfbm (i.opsz = 64) xsavec with
+    | .gp => throw (.gp 0)
+    | .notModelled w => unmodelled (.feature w)
+    | .ok (x', v') => do
+      checkAccesses touched
+      writeX87 x'
+      writeMxcsr v'.mxcsr
+      for j in List.range 32 do
+        writeZmm (Fin.ofNat 32 j) (v'.zmm (Fin.ofNat 32 j))
+      for j in List.range 8 do
+        writeK (Fin.ofNat 8 j) (v'.k (Fin.ofNat 8 j))
+      done
+  | _ => formNotModelled i
+
