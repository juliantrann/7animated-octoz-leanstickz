+/-- The `n` bytes from the area's start that runs `runs` write, as the selection of a masked store and its value:
+each byte of a run is selected, the first run with it giving its value. -/
+def xRunsSel (runs : List (Nat × List Byte)) (n : Nat) : BitVec n × BitVec (8 * n) :=
+  let byteAt (o : Nat) : Option Byte := runs.findSome? fun (p, bs) => if p ≤ o then bs[o - p]? else none
+  ((List.range n).foldl (fun acc o => if (byteAt o).isSome then acc ||| ((1 : BitVec n) <<< o) else acc) 0,
+   ofBytesLE (8 * n) ((List.range n).map fun o => (byteAt o).getD 0))
