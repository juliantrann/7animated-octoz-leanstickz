+/-- Interleave the low (`hi = false`) or high `e`-bit elements of the two sources in each 128-bit lane (VEX
+`VPUNPCKLDQ`, `VPUNPCKHDQ`: SDM Vol. 2B, "PUNPCKLBW/PUNPCKLWD/PUNPCKLDQ/PUNPCKLQDQ",
+"PUNPCKHBW/PUNPCKHWD/PUNPCKHDQ/PUNPCKHQDQ", VEX Operation; `vunpackQ` is the case `e = 64`). -/
+def vunpack (e : Nat) (hi : Bool) (i : Inst) : Prog Ctl :=
+  match i.ops with
+  | [d, s₁, s₂] => do
+    let w := d.width
+    let a ← readOp w s₁
+    let b ← readOp w s₂
+    let n := 128 / e
+    writeOp d (ofElems w e fun j =>
+      elem e (if j % 2 = 0 then a else b) (j / n * n + j % n / 2 + if hi then n / 2 else 0))
+    done
+  | _ => formNotModelled i
+
+/-- VEX `VPUNPCKLDQ` (`vunpack`). -/
+def Sem.vpunpckldq (i : Inst) : Prog Ctl := vunpack 32 false i
+/-- VEX `VPUNPCKHDQ` (`vunpack`). -/
+def Sem.vpunpckhdq (i : Inst) : Prog Ctl := vunpack 32 true i
+
+/-- VEX `VPSHUFD`: doubleword `j` of each lane is the source lane's doubleword the immediate's 2-bit field `j`
+chooses (SDM Vol. 2B, "PSHUFD", VEX.256 Operation). -/
+def Sem.vpshufd (i : Inst) : Prog Ctl :=
+  match i.ops with
+  | [d, s, .imm _ k] => do
+    let w := d.width
+    let b ← readOp w s
+    writeOp d (ofElems w 32 fun j => elem 32 b (j / 4 * 4 + k / 4 ^ (j % 4) % 4))
+    done
+  | _ => formNotModelled i
+
+/-- VEX `VPALIGNR`: in each lane, the low 128 bits of `src1:src2` shifted right by `imm8` bytes (SDM Vol. 2B,
+"PALIGNR", VEX.256 Operation). -/
+def Sem.vpalignr (i : Inst) : Prog Ctl :=
