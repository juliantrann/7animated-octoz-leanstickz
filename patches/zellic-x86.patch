+/-- One past the last byte plan `p` reads, at least 576. -/
+def XPlan.size (p : XPlan) (prof : Profile) : Nat :=
+  xExtComps.foldl (fun n i => if p.restore.getLsbD i then max n (p.off prof i + prof.xSize i) else n) 576
