+def xPlan (bv comp rfbm : BitVec 64) : XPlan :=
+  let compact := comp.getLsbD 63
+  let fmt := comp &&& ~~~((1 : BitVec 64) <<< 63)
+  if compact then
+    let restore := rfbm &&& fmt &&& bv
+    { compact, fmt, restore, init := (rfbm &&& ~~~bv) ||| (rfbm &&& ~~~fmt), loadsMx := restore.getLsbD 1 }
+  else
+    { compact, fmt, restore := rfbm &&& bv, init := rfbm &&& ~~~bv, loadsMx := rfbm.getLsbD 1 || rfbm.getLsbD 2 }
