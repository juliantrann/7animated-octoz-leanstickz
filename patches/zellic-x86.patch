+    else if bs.length > s.cpu.gpr.rsi.toNat then fail ERANGE
+    else do
+      let (s', k, all) ← copyOut prof s s.cpu.gpr.rdi bs
+      Pure.pure (sysReturn s' (if all then BitVec.ofNat 64 bs.length else errRet EFAULT) [] (bs.take k))
+
+end ZellicX86
