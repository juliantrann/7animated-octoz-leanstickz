+/-- The end of the runs `runs`: one past their last byte, at least 576 (the legacy region and the header). -/
+def xRunsEnd (runs : List (Nat × List Byte)) : Nat :=
+  runs.foldl (fun n (o, bs) => max n (o + bs.length)) 576
