+/-- `#UD` unless the OS enabled `XSAVE` (`CR4.OSXSAVE`; the profile's `XCR0`), and with `compacted` unless the
+executing CPU supports `XSAVEC` (`CPUID.(EAX=0DH,ECX=1):EAX[1]`) (SDM Vol. 2, "XSAVE", "XSAVEC", Exceptions). -/
+def xEnabled (prof : Profile) (compacted : Bool) : Prog Unit := do
+  if prof.xcr0.isNone then throw .ud
